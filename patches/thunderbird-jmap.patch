+
+add_task(async function test_destroy_chunking_and_aggregation() {
+  const mail = makeMail({ maxObjectsInSet: 2 });
+  const result = await new JmapMutator({ mail }).destroy([
+    "e1",
+    "e2",
+    "e3",
+    "e4",
+    "e5",
+  ]);
+
+  Assert.equal(mail.calls.length, 3);
+  Assert.deepEqual(mail.calls[0].destroy, ["e1", "e2"]);
+  Assert.deepEqual(mail.calls[2].destroy, ["e5"]);
+  Assert.deepEqual(result.destroyed, ["e1", "e2", "e3", "e4", "e5"]);
+});
+
+add_task(async function test_duplicate_ids_are_ignored() {
+  const mail = makeMail();
+  await new JmapMutator({ mail }).setRead(["e1", "e1", null, ""], true);
+
+  Assert.deepEqual(Object.keys(mail.calls[0].update), ["e1"]);
+});
+
+add_task(async function test_empty_operation_does_nothing() {
+  const mail = makeMail();
+  const mutator = new JmapMutator({ mail });
+
+  await mutator.setRead([], true);
+  await mutator.destroy([]);
+
+  Assert.equal(mail.calls.length, 0);
+});
+
+add_task(async function test_state_mismatch_retries_without_state() {
+  const mail = makeMail({
+    onSet: (args, index) => {
+      if (index === 0) {
+        throw new JmapMethodError("stale state", {
+          type: JmapMethodErrorType.StateMismatch,
+        });
+      }
+      return undefined;
+    },
+  });
+  const mutator = new JmapMutator({ mail });
+
+  const result = await mutator.setRead(["e1"], true, {
+    ifInState: "stale",
+  });
+
+  Assert.equal(mail.calls.length, 2);
+  Assert.equal(mail.calls[0].ifInState, "stale");
+  Assert.ok(!("ifInState" in mail.calls[1]));
+  Assert.ok("e1" in result.updated);
+});
+
+add_task(async function test_other_errors_are_not_retried() {
+  const error = new JmapMethodError("not allowed", {
+    type: JmapMethodErrorType.Forbidden,
+  });
+  const mail = makeMail({
+    onSet: () => {
+      throw error;
+    },
+  });
+
+  const caught = await expectRejection(
+    new JmapMutator({ mail }).setRead(["e1"], true, {
+      ifInState: "state",
+    }),
+    JmapMethodError,
+    "non-state errors propagate"
+  );
+
+  Assert.equal(caught.type, JmapMethodErrorType.Forbidden);
+  Assert.equal(mail.calls.length, 1);
+});
+
+add_task(async function test_copy() {
+  const mail = makeMail();
+  await new JmapMutator({ mail }).copy(["e1", "e2"], {
+    fromAccountId: "a1",
+    toAccountId: "a2",
+    toMailboxId: "inbox",
+  });
+
+  Assert.deepEqual(mail.calls[0], {
+    fromAccountId: "a1",
+    ids: ["e1", "e2"],
+    toAccountId: "a2",
