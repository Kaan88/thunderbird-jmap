+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Low-level RFC 5322 / MIME encoding helpers.
+ *
+ * Everything in this module is pure and byte-oriented so it can be tested
+ * without a running Thunderbird.
+ */
+
+const encoder = new TextEncoder();
+
+const BASE64_ALPHABET =
+  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+const DAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+const MONTHS = [
+  "Jan",
+  "Feb",
+  "Mar",
+  "Apr",
+  "May",
+  "Jun",
+  "Jul",
+  "Aug",
+  "Sep",
+  "Oct",
+  "Nov",
+  "Dec",
+];
+
+/**
+ * Strip characters which could inject extra header lines.
+ *
+ * @param {*} value
+ * @returns {string}
+ */
+export function sanitizeHeaderValue(value) {
+  return String(value ?? "")
+    .replace(/[\r\n\0]+/g, " ")
+    .trim();
+}
+
+/**
+ * @param {string} value
+ * @returns {boolean}
+ */
+export function isAscii(value) {
+  return /^[\x00-\x7F]*$/.test(value);
+}
+
+/**
+ * Base64 encode bytes, optionally wrapped at a fixed line length.
+ *
+ * @param {Uint8Array} bytes
+ * @param {number} [lineLength=76] - 0 disables line wrapping.
+ * @returns {string}
+ */
+export function base64String(bytes, lineLength = 0) {
+  const chunks = [];
+  let line = "";
+
+  for (let index = 0; index < bytes.length; index += 3) {
+    const b0 = bytes[index];
+    const b1 = index + 1 < bytes.length ? bytes[index + 1] : undefined;
+    const b2 = index + 2 < bytes.length ? bytes[index + 2] : undefined;
+    const triple = (b0 << 16) | ((b1 ?? 0) << 8) | (b2 ?? 0);
+
+    const chars = [
+      BASE64_ALPHABET[(triple >> 18) & 0x3f],
+      BASE64_ALPHABET[(triple >> 12) & 0x3f],
+      b1 === undefined ? "=" : BASE64_ALPHABET[(triple >> 6) & 0x3f],
+      b2 === undefined ? "=" : BASE64_ALPHABET[triple & 0x3f],
+    ];
+
+    for (const char of chars) {
+      if (lineLength && line.length === lineLength) {
+        chunks.push(line);
+        line = "";
+      }
+      line += char;
+    }
+  }
+
+  if (line) {
+    chunks.push(line);
+  }
+  return chunks.join("\r\n");
+}
+
+/**
+ * Base64 encode bytes with 76-character lines, as a byte array.
+ *
+ * @param {Uint8Array} bytes
+ * @returns {Uint8Array}
+ */
+export function encodeBase64(bytes) {
+  return encoder.encode(base64String(bytes, 76));
+}
+
+/**
+ * Normalize all line endings to CRLF.
+ *
+ * @param {string} value
+ * @returns {string}
+ */
+export function normalizeNewlines(value) {
+  return value.replace(/\r\n|\r|\n/g, "\r\n");
+}
+
+/**
+ * Encode text as quoted-printable.
+ *
+ * @param {string} text - Must already use CRLF line endings.
+ * @returns {Uint8Array}
+ */
+export function encodeQuotedPrintable(text) {
+  const bytes = encoder.encode(text);
+  const lines = [];
+  let line = "";
+
+  const flush = () => {
+    // Trailing whitespace must be encoded or it is lost in transit.
+    line = line.replace(/[ \t]$/u, char => {
+      return `=${char.charCodeAt(0).toString(16).toUpperCase()}`;
+    });
+    lines.push(line);
+    line = "";
+  };
+
+  const append = token => {
+    if (line.length + token.length > 75) {
+      lines.push(`${line}=`);
+      line = "";
+    }
+    line += token;
+  };
+
+  for (let index = 0; index < bytes.length; index++) {
+    const byte = bytes[index];
+
+    if (byte === 0x0d && bytes[index + 1] === 0x0a) {
+      flush();
+      index++;
+      continue;
+    }
+    if (byte === 0x0a) {
+      flush();
+      continue;
+    }
+
+    const printable =
+      byte === 0x3d ||
+      (byte < 0x20 && byte !== 0x09) ||
+      byte > 0x7e;
+    append(
+      printable
+        ? `=${byte.toString(16).toUpperCase().padStart(2, "0")}`
+        : String.fromCharCode(byte)
+    );
+  }
+
+  if (line) {
+    flush();
+  }
+
+  return encoder.encode(lines.join("\r\n"));
+}
+
+/**
+ * Encode a single word as an RFC 2047 encoded-word (or a sequence of them).
+ *
+ * @param {string} word
+ * @returns {string}
+ */
+export function encodeWord(word) {
+  const chunks = [];
+  let current = "";
+
+  for (const char of word) {
+    const next = current + char;
+    if (current && encoder.encode(next).length > 45) {
+      chunks.push(current);
+      current = char;
+    } else {
+      current = next;
+    }
+  }
+  if (current) {
+    chunks.push(current);
+  }
+
+  return chunks
+    .map(chunk => `=?UTF-8?B?${base64String(encoder.encode(chunk))}?=`)
+    .join(" ");
+}
+
+/**
+ * Fold a header at word boundaries.
+ *
+ * @param {string} name
+ * @param {string} value - Must already be free of CR/LF.
+ * @param {number} [limit=78]
+ * @returns {string}
+ */
+export function foldHeader(name, value, limit = 78) {
+  if (!value) {
+    return `${name}:`;
+  }
+
+  const lines = [];
+  let line = `${name}:`;
+
+  for (const word of value.split(" ")) {
+    if (!word) {
+      continue;
+    }
+    if (
+      line !== `${name}:` &&
+      line.length + 1 + word.length > limit
+    ) {
+      lines.push(line);
+      line = ` ${word}`;
+    } else {
+      line += ` ${word}`;
+    }
+  }
+
+  lines.push(line);
+  return lines.join("\r\n");
+}
+
+/**
+ * Encode a header value: ASCII is folded as-is, anything else becomes
+ * RFC 2047 encoded-words.
+ *
+ * @param {string} value
+ * @returns {string}
+ */
+export function encodeHeaderValue(value) {
+  const clean = sanitizeHeaderValue(value);
+  if (!clean) {
+    return "";
+  }
+  if (isAscii(clean)) {
+    return clean;
+  }
+
+  return clean
+    .split(/(\s+)/)
+    .map(part => {
+      if (!part || /^\s+$/.test(part)) {
+        return " ";
+      }
+      return isAscii(part) ? part : encodeWord(part);
+    })
+    .join("")
+    .trim();
+}
+
+/**
+ * Encode a single address for use in From/To/Cc/...
+ *
+ * @param {{name?: ?string, email?: ?string}} address
+ * @returns {string} An empty string when the address is unusable.
+ */
+export function encodeAddress(address) {
+  const email = sanitizeHeaderValue(address?.email);
+  if (!email || !email.includes("@")) {
+    return "";
+  }
+  // Reject addr-specs which would break the header structure.
+  if (/[\s<>(),;:]/.test(email)) {
+    return "";
+  }
