+++ b/mailnews/protocols/jmap/src/JmapMessageCopyHandler.h
@@ -0,0 +1,104 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPMESSAGECOPYHANDLER_H_
+#define COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPMESSAGECOPYHANDLER_H_
+
+#include "IJmapClient.h"
+#include "nsCOMPtr.h"
+#include "nsICopyMessageListener.h"
+#include "nsIFile.h"
+#include "nsIMsgCopyServiceListener.h"
+#include "nsIMsgFolder.h"
+#include "nsIMsgHdr.h"
+#include "nsIMsgWindow.h"
+#include "nsIOutputStream.h"
+#include "nsString.h"
+#include "nsTArray.h"
+
+/**
+ * Copies messages into a JMAP mailbox by uploading them and calling
+ * Email/import. Modelled on ExchangeMessageCopyHandler.
+ *
+ * The source is either a set of messages in a folder of another account (or
+ * another protocol), streamed one at a time into a temporary file through
+ * the source's message service, or a single message file, for example a
+ * draft or a sent message being saved.
+ *
+ * Local headers are not created here: once every message has been imported,
+ * an account sync creates them, exactly like for messages which arrived from
+ * elsewhere. The copy service is notified after that sync so the caller can
+ * find the new header (SetMessageKey is called for file copies).
+ */
+class JmapMessageCopyHandler final : public nsICopyMessageListener {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSICOPYMESSAGELISTENER
+
+  /** Copy or move `headers` from `srcFolder`. */
+  JmapMessageCopyHandler(nsIMsgFolder* srcFolder, nsIMsgFolder* dstFolder,
+                         const nsTArray<RefPtr<nsIMsgDBHdr>>& headers,
+                         bool isMove, nsIMsgWindow* window,
+                         const nsACString& dstMailboxId, IJmapClient* client,
+                         nsIMsgCopyServiceListener* copyServiceListener);
+
+  /** Import the message in `srcFile` with the given keywords. */
+  JmapMessageCopyHandler(nsIFile* srcFile, nsIMsgFolder* dstFolder,
+                         const nsTArray<nsCString>& keywords,
+                         nsIMsgWindow* window, const nsACString& dstMailboxId,
+                         IJmapClient* client,
+                         nsIMsgCopyServiceListener* copyServiceListener);
+
+  /** Start (or continue with) the next message. */
+  nsresult StartCopyingNextMessage();
+
+  /**
+   * Finish the operation with `status`: notify the source folder, the folder
+   * notification service and the copy service. Also call this when the
+   * operation could not be started.
+   */
+  nsresult OnCopyCompleted(nsresult status);
+
+  /** Called when Email/import for the current message finished. */
+  nsresult OnImportFinished(nsresult status, const nsACString& newId);
+
+ private:
+  ~JmapMessageCopyHandler();
+
+  /** Upload `file` and import it with `keywords` and `receivedAt`. */
+  nsresult Import(nsIFile* file, const nsTArray<nsCString>& keywords,
+                  PRTime receivedAt);
+
+  /** Remove the temporary file of the current message, if any. */
+  void RemoveTempFile();
+
+  /** Sync the account, then call OnCopyCompleted. */
+  nsresult SyncAndComplete();
+
+  nsCOMPtr<nsIMsgFolder> mSrcFolder;
+  nsCOMPtr<nsIMsgFolder> mDstFolder;
+  const nsTArray<RefPtr<nsIMsgDBHdr>> mHeaders;
+  const bool mIsMove;
+  nsCOMPtr<nsIMsgWindow> mWindow;
+  nsCOMPtr<nsIFile> mSrcFile;
+  const nsTArray<nsCString> mFileKeywords;
+  const nsCString mDstMailboxId;
+  nsCOMPtr<IJmapClient> mClient;
+  nsCOMPtr<nsIMsgCopyServiceListener> mCopyServiceListener;
+
+  /** Index into mHeaders of the message being copied. */
+  size_t mCurIndex;
+
+  /** Temporary file and stream for the message being streamed. */
+  nsCOMPtr<nsIFile> mTempFile;
+  nsCOMPtr<nsIOutputStream> mTempStream;
+
+  /** JMAP ids of the imported emails. */
+  nsTArray<nsCString> mNewIds;
+
+  /** Whether OnCopyCompleted has run. */
+  bool mCompleted;
+};
+
+#endif  // COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPMESSAGECOPYHANDLER_H_
