+
+NS_IMETHODIMP JmapFolder::MarkAllMessagesRead(nsIMsgWindow* aMsgWindow) {
+  // Collect the unread messages before the database marks them, otherwise the
+  // whole folder would be sent to the server.
+  nsTArray<nsCString> ids;
+  nsresult rv = GetDatabase();
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  if (mDatabase) {
+    nsCOMPtr<nsIMsgEnumerator> enumerator;
+    rv = mDatabase->EnumerateMessages(getter_AddRefs(enumerator));
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    bool hasMore = false;
+    while (enumerator &&
+           NS_SUCCEEDED(enumerator->HasMoreElements(&hasMore)) && hasMore) {
+      nsCOMPtr<nsIMsgDBHdr> header;
+      enumerator->GetNext(getter_AddRefs(header));
+      if (!header) {
+        continue;
+      }
+
+      uint32_t flags = 0;
+      if (NS_FAILED(header->GetFlags(&flags)) ||
+          (flags & nsMsgMessageFlags::Read)) {
+        continue;
+      }
+
+      nsCString id;
+      if (NS_SUCCEEDED(header->GetStringProperty("jmapId", id)) &&
+          !id.IsEmpty()) {
+        ids.AppendElement(id);
+      }
+    }
+  }
+
+  rv = nsMsgDBFolder::MarkAllMessagesRead(aMsgWindow);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  if (ids.IsEmpty()) {
+    return NS_OK;
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  rv = GetClientForMutation(client);
+  if (NS_FAILED(rv) || !client) {
+    NS_WARNING("Could not reach the JMAP client to mark the folder read");
+    return NS_OK;
+  }
+
+  rv = client->SetMessagesRead(ids, true, nullptr);
+  if (NS_FAILED(rv)) {
+    nsPrintfCString message(
+        "JMAP mark-all-read failed: 0x%08x", static_cast<uint32_t>(rv));
+    NS_WARNING(message.get());
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapFolder::DeleteMessages(
+    const nsTArray<RefPtr<nsIMsgDBHdr>>& messages, nsIMsgWindow* msgWindow,
+    bool deleteStorage, bool isMove, nsIMsgCopyServiceListener* listener,
+    bool allowUndo) {
+  if (listener) {
+    listener->OnStartCopy();
+  }
+
+  if (WeAreOffline()) {
+    if (listener) {
+      listener->OnStopCopy(NS_MSG_ERROR_OFFLINE);
+    }
+    NotifyFolderEvent(kDeleteOrMoveMsgFailed);
+    return NS_MSG_ERROR_OFFLINE;
+  }
+
+  // `isMove` means the message was already copied elsewhere by the caller
+  // (for example into a local folder), so the server copy is removed rather
+  // than moved to Trash. Moves between two JMAP mailboxes never reach this
+  // path: `CopyMessages` performs the membership change and updates the
+  // source locally.
+  if (isMove) {
+    deleteStorage = true;
+  }
+
+  // Deleting from Trash is always permanent.
+  if (IsInTrash()) {
+    deleteStorage = true;
+  }
+
+  nsCOMPtr<nsIMsgFolder> trashFolder;
+  if (!deleteStorage) {
+    GetTrashFolder(getter_AddRefs(trashFolder));
+    if (!trashFolder) {
+      // No trash mailbox: fall back to a permanent delete, which is what
+      // IMAP does as well.
+      deleteStorage = true;
+    }
+  }
+
+  // Every failure after OnStartCopy must still end the copy for `listener`.
+  auto fail = [&](nsresult status) {
+    if (listener) {
+      listener->OnStopCopy(status);
+    }
+    NotifyFolderEvent(kDeleteOrMoveMsgFailed);
+    return status;
+  };
+
+  nsTArray<nsCString> ids;
+  nsresult rv = CollectJmapIds(messages, ids);
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+
+  if (ids.IsEmpty()) {
+    LocalDeleteMessages(this, messages);
+    if (listener) {
+      listener->OnStopCopy(NS_OK);
+    }
+    NotifyFolderEvent(kDeleteOrMoveMsgCompleted);
+    return NS_OK;
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  rv = GetClientForMutation(client);
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+
+  nsCString sourceMailboxId;
+  rv = GetJmapId(sourceMailboxId);
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+
+  nsCString trashMailboxId;
+  if (!deleteStorage) {
+    nsCOMPtr<IJmapFolder> trashJmap = do_QueryInterface(trashFolder, &rv);
+    if (NS_FAILED(rv)) {
+      return fail(rv);
+    }
+    rv = trashJmap->GetJmapId(trashMailboxId);
+    if (NS_FAILED(rv)) {
+      return fail(rv);
+    }
+  }
+
+  RefPtr<JmapMutationListener> mutationListener = new JmapMutationListener(
+      this, nullptr, messages, listener, false, true, false);
+
+  if (deleteStorage || trashMailboxId.IsEmpty()) {
+    if (sourceMailboxId.IsEmpty()) {
+      rv = client->DeleteMessages(ids, mutationListener);
+    } else {
+      // An email can be in several mailboxes (a copy within the account only
+      // adds a membership). An empty destination makes the server side
+      // remove the emails from this mailbox only, destroying those that are
+      // in no other mailbox.
+      rv = client->MoveMessages(ids, sourceMailboxId, EmptyCString(),
+                                mutationListener);
+    }
+    return NS_FAILED(rv) ? fail(rv) : rv;
+  }
+
+  if (sourceMailboxId.IsEmpty()) {
+    rv = client->DeleteMessages(ids, mutationListener);
+    return NS_FAILED(rv) ? fail(rv) : rv;
+  }
+
+  if (allowUndo && msgWindow) {
+    RefPtr<JmapCopyMoveTransaction> txn = new JmapCopyMoveTransaction(
+        this, trashFolder, ids, sourceMailboxId, trashMailboxId, true);
+    txn->SetTransactionType(nsIMsgTransactionService::eDeleteMsg);
+    mutationListener->SetUndoTransaction(txn);
+  }
+
+  rv = client->MoveMessages(ids, sourceMailboxId, trashMailboxId,
+                            mutationListener);
+  return NS_FAILED(rv) ? fail(rv) : rv;
+}
+
+NS_IMETHODIMP JmapFolder::CopyMessages(
+    nsIMsgFolder* srcFolder, const nsTArray<RefPtr<nsIMsgDBHdr>>& messages,
+    bool isMove, nsIMsgWindow* msgWindow,
+    nsIMsgCopyServiceListener* listener, bool isFolder, bool allowUndo) {
+  NS_ENSURE_ARG_POINTER(srcFolder);
+
+  nsCOMPtr<nsIMsgCopyService> copyService =
+      mozilla::components::Copy::Service();
+  auto fail = [&](nsresult status) {
+    srcFolder->NotifyFolderEvent(kDeleteOrMoveMsgFailed);
+    copyService->NotifyCompletion(srcFolder, this, status);
+    return status;
+  };
+
+  if (isFolder) {
+    return fail(NS_ERROR_NOT_IMPLEMENTED);
+  }
+
+  bool isServer = false;
+  GetIsServer(&isServer);
+  if (isServer) {
+    NS_ERROR("Destination is the root folder. Cannot move/copy here");
+    return fail(NS_ERROR_FILE_COPY_OR_MOVE_FAILED);
+  }
+
+  if (WeAreOffline()) {
+    return fail(NS_MSG_ERROR_OFFLINE);
+  }
+
+  nsCString destMailboxId;
+  nsresult rv = GetJmapId(destMailboxId);
+  if (NS_SUCCEEDED(rv) && destMailboxId.IsEmpty()) {
+    rv = NS_ERROR_UNEXPECTED;
+  }
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  rv = GetClientForMutation(client);
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+
+  bool sameServer = false;
+  rv = FoldersOnSameServer(srcFolder, this, &sameServer);
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+
+  nsCOMPtr<IJmapFolder> sourceJmap = do_QueryInterface(srcFolder);
+  if (!sameServer || !sourceJmap) {
+    // Another account or protocol: stream every message and Email/import it.
+    RefPtr<JmapMessageCopyHandler> handler =
+        new JmapMessageCopyHandler(srcFolder, this, messages, isMove,
+                                   msgWindow, destMailboxId, client, listener);
+    rv = handler->StartCopyingNextMessage();
+    if (NS_FAILED(rv)) {
+      handler->OnCopyCompleted(rv);
+    }
+    return rv;
+  }
+
+  if (listener) {
+    listener->OnStartCopy();
+  }
+
+  nsTArray<nsCString> ids;
+  rv = CollectJmapIds(messages, ids);
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+
+  nsCString sourceMailboxId;
+  rv = sourceJmap->GetJmapId(sourceMailboxId);
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+  if (sourceMailboxId.IsEmpty()) {
+    return fail(NS_ERROR_UNEXPECTED);
+  }
+
+  RefPtr<JmapMutationListener> mutationListener = new JmapMutationListener(
+      srcFolder, this, messages, listener, isMove, isMove, true);
+
+  if (allowUndo && msgWindow) {
+    RefPtr<JmapCopyMoveTransaction> txn =
+        new JmapCopyMoveTransaction(srcFolder, this, ids, sourceMailboxId,
+                                    destMailboxId, isMove);
+    txn->SetTransactionType(isMove ? nsIMsgTransactionService::eMoveMsg
+                                   : nsIMsgTransactionService::eCopyMsg);
+    mutationListener->SetUndoTransaction(txn);
+  }
+
+  if (isMove) {
+    return client->MoveMessages(ids, sourceMailboxId, destMailboxId,
+                                mutationListener);
+  }
+
+  // A copy within one account adds the destination mailbox to the emails:
+  // JMAP emails can be in several mailboxes, and Email/copy only works
+  // between accounts.
+  nsAutoCString args;
+  JmapBuildMailboxMembershipArgs(ids, destMailboxId, true, args);
+  nsCOMPtr<nsIUrlListener> urlListener = mutationListener.get();
+  RefPtr<JmapOperationListener> copyListener = new JmapOperationListener(
+      [urlListener](const nsACString&) {
+        return urlListener->OnStopRunningUrl(nullptr, NS_OK);
+      },
+      [urlListener](nsresult status, const nsACString&) {
+        return urlListener->OnStopRunningUrl(nullptr, status);
+      });
+  return client->CallMethod("Email/set"_ns, args, copyListener);
+}
+
+NS_IMETHODIMP JmapFolder::SetJunkScoreForMessages(
+    const nsTArray<RefPtr<nsIMsgDBHdr>>& messages, nsMsgJunkScore junkScore,
+    const nsACString& junkScoreOrigin, int32_t junkPercent) {
+  nsresult rv = nsMsgDBFolder::SetJunkScoreForMessages(
+      messages, junkScore, junkScoreOrigin, junkPercent);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  // Intermediate scores are classifier output rather than a user decision;
+  // leave the server-side classification alone for those.
+  bool junk;
+  if (junkScore == nsIJunkMailPlugin::IS_SPAM_SCORE) {
+    junk = true;
+  } else if (junkScore == nsIJunkMailPlugin::IS_HAM_SCORE) {
+    junk = false;
+  } else {
+    return NS_OK;
+  }
+
+  nsTArray<nsCString> ids;
+  rv = CollectJmapIds(messages, ids);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (ids.IsEmpty()) {
+    return NS_OK;
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  rv = GetClientForMutation(client);
+  if (NS_FAILED(rv) || !client) {
+    NS_WARNING("Could not reach the JMAP client to update junk state");
+    return NS_OK;
+  }
+
+  rv = client->SetMessagesJunk(ids, junk, nullptr);
+  if (NS_FAILED(rv)) {
+    nsPrintfCString message(
+        "JMAP junk state update failed: 0x%08x", static_cast<uint32_t>(rv));
+    NS_WARNING(message.get());
+  }
+  return NS_OK;
+}
+
+// Filters and junk classification for new mail.
+
+NS_IMETHODIMP JmapFolder::OnNewMessages(const nsTArray<nsMsgKey>& keys) {
+  if (keys.IsEmpty()) {
+    return NS_OK;
+  }
+
+  SetHasNewMessages(true);
+  SetNumNewMessages(static_cast<int32_t>(keys.Length()));
+  SetBiffState(nsIMsgFolder::nsMsgBiffState_NewMail);
+
+  for (nsMsgKey key : keys) {
+    if (!mFilterQueue.Contains(key)) {
+      mFilterQueue.AppendElement(key);
+    }
+  }
+
+  return PerformFiltering();
+}
+
+NS_IMETHODIMP JmapFolder::HandleDownloadedMessages() {
+  // Filters which need the full message may be able to run now.
+  return PerformFiltering();
+}
+
+nsresult JmapFolder::PerformFiltering() {
+  bool incomingFiltersRequireBody = false;
+  {
+    nsCOMPtr<nsIMsgFilterList> filterList;
+    nsresult rv = GetFilterList(nullptr, getter_AddRefs(filterList));
+    if (NS_SUCCEEDED(rv) && filterList) {
+      filterList->DoFiltersNeedMessageBody(nsMsgFilterType::Incoming,
+                                           &incomingFiltersRequireBody);
+    }
+  }
+
+  nsTArray<RefPtr<nsIMsgDBHdr>> targetMsgs;
+  nsTArray<nsMsgKey> remaining;
+  for (nsMsgKey key : mFilterQueue) {
+    nsCOMPtr<nsIMsgDBHdr> msg;
+    GetMsgHdr(key, getter_AddRefs(msg));
+    if (!msg) {
+      // The message was deleted in the meantime.
+      continue;
+    }
+    if (incomingFiltersRequireBody) {
+      uint32_t flags = 0;
+      msg->GetFlags(&flags);
+      if (!(flags & nsMsgMessageFlags::Offline)) {
+        // The full message is not available yet; leave it for later.
+        remaining.AppendElement(key);
+        continue;
+      }
+    }
+    targetMsgs.AppendElement(msg);
+  }
+  mFilterQueue = std::move(remaining);
+
+  if (targetMsgs.IsEmpty()) {
+    return NS_OK;
+  }
+
+  RefPtr<JmapFolder> self = this;
+  auto doneFunc = [self](nsresult status,
+                         const nsTArray<RefPtr<nsIMsgDBHdr>>& msgs) {
+    nsresult rv = self->NotifyFolderEvent(kFiltersApplied);
+    NS_ENSURE_SUCCESS(rv, rv);
+    // Run the junk classifier; it reports back through
+    // OnMessageClassified().
+    bool filtersRun = false;
+    return self->CallFilterPlugins(nullptr, &filtersRun);
+  };
+  RefPtr<MsgOperationListener> listener =
+      new MsgOperationListener(targetMsgs, doneFunc);
+
+  // The messages are already in the database, so the protocol-agnostic
+  // ApplyFilters implements every filter action, like for EWS. JMAP has no
+  // raw header blocks at this point.
+  nsTArray<RefPtr<IHeaderBlock>> rawHeaders;
+  nsCOMPtr<nsIMsgFilterService> filterService =
+      mozilla::components::Filter::Service();
+  return filterService->ApplyFilters(nsMsgFilterType::Inbox, targetMsgs,
+                                     rawHeaders, this, nullptr, listener);
+}
+
+// Called by CallFilterPlugins() once per classified message, then once more
+// with an empty URI at the end of the batch. Same as ExchangeFolder.
+NS_IMETHODIMP JmapFolder::OnMessageClassified(const nsACString& aMsgURI,
+                                              nsMsgJunkStatus aClassification,
+                                              uint32_t aJunkPercent) {
+  nsCOMPtr<nsIMsgIncomingServer> server;
+  nsresult rv = GetServer(getter_AddRefs(server));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<nsISpamSettings> spamSettings;
+  rv = server->GetSpamSettings(getter_AddRefs(spamSettings));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCString spamFolderURI;
+  rv = spamSettings->GetSpamFolderURI(spamFolderURI);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  if (!aMsgURI.IsEmpty()) {
+    nsCOMPtr<nsIMsgDBHdr> msgHdr;
+    rv = GetMsgDBHdrFromURI(aMsgURI, getter_AddRefs(msgHdr));
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    nsMsgKey msgKey;
+    rv = msgHdr->GetMessageKey(&msgKey);
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    uint32_t processingFlags = 0;
+    GetProcessingFlags(msgKey, &processingFlags);
+
+    if (processingFlags & nsMsgProcessingFlags::ClassifyJunk) {
+      nsMsgDBFolder::OnMessageClassified(aMsgURI, aClassification,
+                                         aJunkPercent);
+
+      if (aClassification == nsIJunkMailPlugin::JUNK) {
+        bool willMoveMessage = false;
+
+        // Don't move messages out of the Junk or Trash folders.
+        if (!(mFlags & (nsMsgFolderFlags::Junk | nsMsgFolderFlags::Trash))) {
+          bool moveOnSpam = false;
+          rv = spamSettings->GetMoveOnSpam(&moveOnSpam);
+          NS_ENSURE_SUCCESS(rv, rv);
+          if (moveOnSpam) {
+            nsCOMPtr<nsIMsgFolder> folder;
+            rv = FindFolder(spamFolderURI, getter_AddRefs(folder));
+            NS_ENSURE_SUCCESS(rv, rv);
+            if (folder) {
+              rv = folder->SetFlag(nsMsgFolderFlags::Junk);
+              NS_ENSURE_SUCCESS(rv, rv);
+              mSpamKeysToMove.AppendElement(msgKey);
+              willMoveMessage = true;
+            } else {
+              rv = GetOrCreateJunkFolder(spamFolderURI, nullptr);
+              NS_ASSERTION(NS_SUCCEEDED(rv), "GetOrCreateJunkFolder failed");
+            }
+          }
+        }
+        rv = spamSettings->LogJunkHit(msgHdr, willMoveMessage);
+        NS_ENSURE_SUCCESS(rv, rv);
+      }
+    }
+    return NS_OK;
+  }
+
+  // End of batch: the parent applies post-classification filters.
+  nsMsgDBFolder::OnMessageClassified(EmptyCString(),
+                                     nsIJunkMailPlugin::UNCLASSIFIED, 0);
+  nsTArray<RefPtr<nsIMsgDBHdr>> messages;
+  if (!mSpamKeysToMove.IsEmpty()) {
+    nsCOMPtr<nsIMsgFolder> folder;
+    if (!spamFolderURI.IsEmpty()) {
+      rv = FindFolder(spamFolderURI, getter_AddRefs(folder));
+      NS_ENSURE_SUCCESS(rv, rv);
+    }
+    for (nsMsgKey msgKey : mSpamKeysToMove) {
+      // If an upstream filter moved this message, don't move it here.
+      nsMsgProcessingFlagType processingFlags = 0;
+      GetProcessingFlags(msgKey, &processingFlags);
+      if (folder && !(processingFlags & nsMsgProcessingFlags::FilterToMove)) {
+        nsCOMPtr<nsIMsgDBHdr> mailHdr;
+        rv = GetMsgHdr(msgKey, getter_AddRefs(mailHdr));
+        if (NS_SUCCEEDED(rv) && mailHdr) {
+          messages.AppendElement(mailHdr);
+        }
+      } else {
+        AndProcessingFlags(msgKey, ~nsMsgProcessingFlags::FilterToMove);
+      }
+    }
+
+    if (folder && !messages.IsEmpty()) {
+      nsCOMPtr<nsIMsgCopyService> copyService =
+          mozilla::components::Copy::Service();
+      rv = copyService->CopyMessages(this, messages, folder, true, nullptr,
+                                     nullptr, false);
+      if (NS_FAILED(rv)) {
+        nsAutoCString logMsg(
+            "failed to copy junk messages to junk folder rv = ");
+        logMsg.AppendInt(static_cast<uint32_t>(rv), 16);
+        spamSettings->LogJunkString(logMsg.get());
+      }
+    }
+  }
+
+  int32_t numNewMessages = 0;
+  GetNumNewMessages(false, &numNewMessages);
+  SetNumNewMessages(numNewMessages - static_cast<int32_t>(messages.Length()));
+  mSpamKeysToMove.Clear();
+  if (mFlags & nsMsgFolderFlags::Inbox) {
+    PerformBiffNotifications();
+  }
+  return NS_OK;
+}
+
+// Quota.
+
+void JmapFolder::RefreshQuota() {
+  if (WeAreOffline()) {
+    return;
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  if (NS_FAILED(GetClientForMutation(client)) || !client) {
+    return;
+  }
+
+  mQuotaRequested = true;
+  RefPtr<JmapFolder> self = this;
+  RefPtr<JmapOperationListener> listener = new JmapOperationListener(
+      [self](const nsACString& result) {
+        self->mQuotaJSON = result;
+        return NS_OK;
+      },
+      nullptr);
+  client->GetQuota(listener);
+}
+
+NS_IMETHODIMP JmapFolder::GetQuota(nsTArray<RefPtr<nsIMsgQuota>>& aQuota) {
+  aQuota.Clear();
+
+  // The quota is per account; the root folder holds the cache.
+  nsCOMPtr<nsIMsgFolder> rootFolder;
+  nsresult rv = GetRootFolder(getter_AddRefs(rootFolder));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<IJmapFolder> jmapRoot = do_QueryInterface(rootFolder);
+  NS_ENSURE_TRUE(jmapRoot, NS_ERROR_UNEXPECTED);
+  JmapFolder* root = static_cast<JmapFolder*>(jmapRoot.get());
+
+  if (!root->mQuotaRequested) {
+    // First access: fetch it for next time.
+    root->RefreshQuota();
+  }
+
+  // The JSON is the array produced by JmapXPCOMClient.getQuota(), one flat
+  // object per quota.
+  const nsCString& json = root->mQuotaJSON;
+  int32_t pos = 0;
+  while (true) {
+    int32_t start = json.FindChar('{', pos);
+    if (start < 0) {
+      break;
+    }
+    int32_t end = json.FindChar('}', start);
+    if (end < 0) {
+      break;
+    }
+    const nsDependentCSubstring object(json, start, end - start + 1);
+    pos = end + 1;
+
+    nsAutoCString resourceType = JmapJsonStringField(object, "resourceType");
+    nsAutoCString name = JmapJsonStringField(object, "name");
+    if (name.IsEmpty()) {
+      name = resourceType;
+    }
+    uint64_t used = JmapJsonNumberField(object, "used");
+    uint64_t limit = JmapJsonNumberField(object, "hardLimit");
+
+    // Thunderbird expects storage in KB, like IMAP's STORAGE resource.
+    if (resourceType.EqualsLiteral("octets")) {
+      used /= 1024;
+      limit /= 1024;
+      if (name.Equals(resourceType)) {
+        name.AssignLiteral("STORAGE");
+      }
+    }
+
+    RefPtr<nsIMsgQuota> quota = new JmapQuota(name, used, limit);
+    aQuota.AppendElement(quota);
+  }
+  return NS_OK;
+}
