diff --git a/mailnews/base/prefs/content/am-jmap.js b/mailnews/base/prefs/content/am-jmap.js
new file mode 100644
index 00000000000..186e4b3d91f
--- /dev/null
+++ b/mailnews/base/prefs/content/am-jmap.js
@@ -0,0 +1,506 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* import-globals-from am-prefs.js */
+/* import-globals-from amUtils.js */
+
+/**
+ * Account settings pane for JMAP accounts: quota, push, vacation responder
+ * and Sieve filter scripts.
+ */
+
+var { MailServices } = ChromeUtils.importESModule(
+  "resource:///modules/MailServices.sys.mjs"
+);
+
+const CAP = {
+  Mail: "urn:ietf:params:jmap:mail",
+  Vacation: "urn:ietf:params:jmap:vacationresponse",
+  Sieve: "urn:ietf:params:jmap:sieve",
+  Quota: "urn:ietf:params:jmap:quota",
+};
+
+/** @type {nsIMsgIncomingServer} */
+var gServer = null;
+/** Sieve script currently in the editor (null = new script). */
+var gEditingScript = null;
+var gScripts = [];
+
+/**
+ * Get the shared JS JMAP client for the server (null if unavailable).
+ *
+ * @returns {Promise<?object>}
+ */
+async function getJsClient() {
+  try {
+    const { JmapAccountRegistry } = ChromeUtils.importESModule(
+      "resource:///modules/jmap/JmapAccountRegistry.sys.mjs"
+    );
+    return await JmapAccountRegistry.getClient(gServer.key);
+  } catch (e) {
+    console.warn("JMAP: JS client unavailable", e);
+    return null;
+  }
+}
+
+/**
+ * Get the XPCOM IJmapClient for the server.
+ *
+ * @returns {?IJmapClient}
+ */
+function getXpcomClient() {
+  try {
+    return gServer.QueryInterface(Ci.IJmapIncomingServer).getProtocolClient();
+  } catch (e) {
+    return null;
+  }
+}
+
+/**
+ * Wrap an IJmapOperationListener call in a promise.
+ *
+ * @param {Function} fn - Called with the listener.
+ * @returns {Promise<any>} Parsed JSON result.
+ */
+function xpcomOperation(fn) {
+  return new Promise((resolve, reject) => {
+    fn({
+      QueryInterface: ChromeUtils.generateQI(["IJmapOperationListener"]),
+      onSuccess(result) {
+        try {
+          resolve(result ? JSON.parse(result) : null);
+        } catch (e) {
+          resolve(result);
+        }
+      },
+      onFailure(status, message) {
+        reject(new Error(message || `JMAP error 0x${status.toString(16)}`));
+      },
+    });
+  });
+}
+
+/**
+ * Call a JMAP method. Uses the JS client when available (it knows account
+ * ids), else IJmapClient.callMethod().
+ *
+ * @param {string} method - e.g. "VacationResponse/get".
+ * @param {object} args - Method arguments (without accountId).
+ * @param {string} capability - Capability for the accountId lookup.
+ * @returns {Promise<object>} The method response arguments.
+ */
+async function jmapCall(method, args, capability) {
+  const client = await getJsClient();
+  if (client) {
+    const accountId =
+      client.getAccountId(capability) ?? client.getAccountId(CAP.Mail);
+    const response = await client.call(method, { accountId, ...args }, {
+      using: [capability],
+    });
+    if (response.method == "error" || response.name == "error") {
+      throw new Error(response.args?.description || response.args?.type);
+    }
+    return response.args;
+  }
+  const xpcom = getXpcomClient();
+  if (!xpcom) {
+    throw new Error("No JMAP client available");
+  }
+  const result = await xpcomOperation(listener =>
+    xpcom.callMethod(method, JSON.stringify(args), listener)
+  );
+  // callMethod may return the bare args or a [name, args, id] triple.
+  return Array.isArray(result) ? result[1] : result;
+}
+
+/**
+ * Whether the session advertises a capability (true if unknown).
+ *
+ * @param {string} capability
+ * @returns {Promise<boolean>}
+ */
+async function supports(capability) {
+  const client = await getJsClient();
+  if (!client) {
+    return true;
+  }
+  try {
+    return client.supports(capability);
+  } catch (e) {
+    return true;
+  }
+}
+
+function setStatus(id, l10nId, args, isError = false) {
+  const el = document.getElementById(id);
+  if (!l10nId) {
+    el.textContent = "";
+    el.removeAttribute("data-l10n-id");
+    return;
+  }
+  document.l10n.setAttributes(el, l10nId, args);
+  el.classList.toggle("error", isError);
+}
+
+function setErrorStatus(id, error) {
+  console.error(error);
+  setStatus(id, "jmap-error", { message: String(error?.message ?? error) }, true);
+}
+
+// ---------------------------------------------------------------------------
+// Account manager hooks.
+
+function onPreInit(account) {
+  gServer = account.incomingServer;
+}
+
+function onInit() {
+  // getBoolValue returns false (not an error) for a missing pref, so fall
+  // back to the global default when the server has no value of its own.
+  const push =
+    Services.prefs.prefHasUserValue(
+      `mail.server.${gServer.key}.jmap_push_enabled`
+    )
+      ? gServer.getBoolValue("jmap_push_enabled")
+      : Services.prefs.getBoolPref("mail.jmap.push.enabled", true);
+  document.getElementById("jmapPushEnabled").checked = push;
+  document.getElementById("jmapSessionUrl").value =
+    gServer.getStringValue("jmap_session_url") || "";
+
+  loadQuota();
+  loadVacation();
+  loadSieve();
+}
+
+function onSave() {
+  gServer.setBoolValue(
+    "jmap_push_enabled",
+    document.getElementById("jmapPushEnabled").checked
+  );
+  const sessionUrl = document.getElementById("jmapSessionUrl").value.trim();
+  if (sessionUrl && URL.canParse(sessionUrl)) {
+    try {
+      gServer.QueryInterface(Ci.IJmapIncomingServer).jmapSessionUrl =
+        sessionUrl;
+    } catch (e) {
+      gServer.setStringValue("jmap_session_url", sessionUrl);
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Quota.
+
+function formatBytes(n) {
+  const units = ["B", "KB", "MB", "GB", "TB"];
+  let i = 0;
+  while (n >= 1024 && i < units.length - 1) {
+    n /= 1024;
+    i++;
+  }
+  return `${n.toFixed(i ? 1 : 0)} ${units[i]}`;
+}
+
+async function loadQuota() {
+  const list = document.getElementById("jmapQuotaList");
+  list.replaceChildren();
+  setStatus("jmapQuotaStatus", "jmap-loading");
+  try {
+    let quotas;
+    const xpcom = getXpcomClient();
+    if (xpcom) {
+      const result = await xpcomOperation(l => xpcom.getQuota(l));
+      quotas = result?.list ?? result;
+    } else {
+      if (!(await supports(CAP.Quota))) {
+        setStatus("jmapQuotaStatus", "jmap-quota-unsupported");
+        return;
+      }
+      quotas = (await jmapCall("Quota/get", { ids: null }, CAP.Quota)).list;
+    }
+    if (!Array.isArray(quotas) || !quotas.length) {
+      setStatus("jmapQuotaStatus", "jmap-quota-unsupported");
+      return;
+    }
+    setStatus("jmapQuotaStatus", null);
+    for (const q of quotas) {
+      const row = document.createElement("li");
+      const label = document.createElement("span");
+      const meter = document.createElement("progress");
+      const isOctets = (q.resourceType ?? "octets") == "octets";
+      const fmt = v => (isOctets ? formatBytes(v) : String(v));
+      label.textContent = `${q.name || q.resourceType || ""}: ${fmt(
+        q.used ?? 0
+      )}${q.hardLimit ? " / " + fmt(q.hardLimit) : ""}`;
+      if (q.hardLimit) {
+        meter.max = q.hardLimit;
+        meter.value = q.used ?? 0;
+      } else {
+        meter.hidden = true;
+      }
+      row.append(label, meter);
+      list.appendChild(row);
+    }
+  } catch (e) {
+    setErrorStatus("jmapQuotaStatus", e);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Vacation responder (RFC 8621 section 8).
+
+function toLocalInput(utcDate) {
+  if (!utcDate) {
+    return "";
+  }
+  const d = new Date(utcDate);
+  const pad = n => String(n).padStart(2, "0");
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(
+    d.getDate()
+  )}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
+}
+
+function fromLocalInput(value) {
+  return value ? new Date(value).toISOString().replace(/\.\d{3}Z$/, "Z") : null;
+}
+
+async function loadVacation() {
+  const box = document.getElementById("jmapVacation");
+  if (!(await supports(CAP.Vacation))) {
+    box.disabled = true;
+    setStatus("jmapVacationStatus", "jmap-vacation-unsupported");
+    return;
+  }
+  setStatus("jmapVacationStatus", "jmap-loading");
+  try {
+    const { list } = await jmapCall(
+      "VacationResponse/get",
+      { ids: ["singleton"] },
+      CAP.Vacation
+    );
+    const v = list?.[0] ?? {};
+    document.getElementById("jmapVacationEnabled").checked = !!v.isEnabled;
+    document.getElementById("jmapVacationSubject").value = v.subject ?? "";
+    document.getElementById("jmapVacationText").value = v.textBody ?? "";
+    document.getElementById("jmapVacationHtml").value = v.htmlBody ?? "";
+    document.getElementById("jmapVacationFrom").value = toLocalInput(
+      v.fromDate
+    );
+    document.getElementById("jmapVacationTo").value = toLocalInput(v.toDate);
+    setStatus("jmapVacationStatus", null);
+  } catch (e) {
+    setErrorStatus("jmapVacationStatus", e);
+  }
+}
+
+async function saveVacation() {
+  setStatus("jmapVacationStatus", "jmap-saving");
+  const html = document.getElementById("jmapVacationHtml").value;
+  const patch = {
+    isEnabled: document.getElementById("jmapVacationEnabled").checked,
+    subject: document.getElementById("jmapVacationSubject").value || null,
+    textBody: document.getElementById("jmapVacationText").value || null,
+    htmlBody: html || null,
+    fromDate: fromLocalInput(document.getElementById("jmapVacationFrom").value),
+    toDate: fromLocalInput(document.getElementById("jmapVacationTo").value),
+  };
+  try {
+    const result = await jmapCall(
+      "VacationResponse/set",
+      { update: { singleton: patch } },
+      CAP.Vacation
+    );
+    const err = result?.notUpdated?.singleton;
+    if (err) {
+      throw new Error(err.description || err.type);
+    }
+    setStatus("jmapVacationStatus", "jmap-saved");
+  } catch (e) {
+    setErrorStatus("jmapVacationStatus", e);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Sieve scripts (RFC 9661).
+
+async function loadSieve() {
+  const box = document.getElementById("jmapSieve");
+  if (!(await supports(CAP.Sieve))) {
+    box.disabled = true;
+    setStatus("jmapSieveStatus", "jmap-sieve-unsupported");
+    return;
+  }
+  setStatus("jmapSieveStatus", "jmap-loading");
+  try {
+    const { list } = await jmapCall("SieveScript/get", { ids: null }, CAP.Sieve);
+    gScripts = list ?? [];
+    renderScripts();
+    setStatus("jmapSieveStatus", null);
+  } catch (e) {
+    setErrorStatus("jmapSieveStatus", e);
+  }
+}
+
+function renderScripts() {
+  const list = document.getElementById("jmapSieveList");
+  list.replaceChildren();
+  for (const script of gScripts) {
+    const row = document.createElement("li");
+    const name = document.createElement("span");
+    name.textContent = script.name || script.id;
+    if (script.isActive) {
+      const badge = document.createElement("span");
+      badge.className = "jmap-active-badge";
+      document.l10n.setAttributes(badge, "jmap-sieve-active");
+      name.append(" ", badge);
+    }
+    const mk = (l10nId, handler) => {
+      const b = document.createElement("button");
+      document.l10n.setAttributes(b, l10nId);
+      b.addEventListener("click", handler);
+      return b;
+    };
+    row.append(
+      name,
+      mk("jmap-sieve-edit", () => editScript(script)),
+      script.isActive
+        ? mk("jmap-sieve-deactivate", () => setActive(null))
+        : mk("jmap-sieve-activate", () => setActive(script.id)),
+      mk("jmap-sieve-delete", () => deleteScript(script))
+    );
+    list.appendChild(row);
+  }
+}
+
+async function sieveSet(args) {
+  const result = await jmapCall("SieveScript/set", args, CAP.Sieve);
+  for (const key of ["notCreated", "notUpdated", "notDestroyed"]) {
+    const errs = result?.[key];
+    if (errs && Object.keys(errs).length) {
+      const err = Object.values(errs)[0];
+      throw new Error(err.description || err.type);
+    }
+  }
+  return result;
+}
+
+async function setActive(id) {
+  try {
+    await sieveSet(
+      id
+        ? { onSuccessActivateScript: id }
+        : { onSuccessDeactivateScript: true }
+    );
+    await loadSieve();
+  } catch (e) {
+    setErrorStatus("jmapSieveStatus", e);
+  }
+}
+
+async function deleteScript(script) {
+  const [title, msg] = await document.l10n.formatValues([
+    { id: "jmap-sieve-delete-title" },
+    { id: "jmap-sieve-delete-confirm", args: { name: script.name || "" } },
+  ]);
+  if (!Services.prompt.confirm(window, title, msg)) {
+    return;
+  }
+  try {
+    if (script.isActive) {
+      await sieveSet({ onSuccessDeactivateScript: true });
+    }
+    await sieveSet({ destroy: [script.id] });
+    await loadSieve();
+  } catch (e) {
+    setErrorStatus("jmapSieveStatus", e);
+  }
+}
+
+async function editScript(script) {
+  gEditingScript = script;
+  document.getElementById("jmapSieveName").value = script?.name ?? "";
+  const editor = document.getElementById("jmapSieveEditor");
+  editor.value = "";
+  document.getElementById("jmapSieveEditBox").hidden = false;
+  if (!script?.blobId) {
+    return;
+  }
+  try {
+    const client = await getJsClient();
+    if (!client) {
+      throw new Error("No JMAP client available");
+    }
+    const accountId = client.getAccountId(CAP.Sieve);
+    const data = await client.download(script.blobId, {
+      accountId,
+      type: "application/sieve",
+      name: `${script.name || "script"}.siv`,
+    });
+    editor.value = data?.blob ? await data.blob.text() : String(data ?? "");
+  } catch (e) {
+    setErrorStatus("jmapSieveStatus", e);
+  }
+}
+
+async function saveScript() {
+  const text = document.getElementById("jmapSieveEditor").value;
+  const name = document.getElementById("jmapSieveName").value.trim() || null;
+  setStatus("jmapSieveStatus", "jmap-saving");
+  try {
+    const client = await getJsClient();
+    if (!client) {
+      // Uploading requires the JS session (auth + uploadUrl).
+      throw new Error("Saving scripts requires the JMAP session client");
+    }
+    const accountId = client.getAccountId(CAP.Sieve);
+    const { blobId } = await client.upload(text, "application/sieve", {
+      accountId,
+    });
+    const validation = await jmapCall(
+      "SieveScript/validate",
+      { blobId },
+      CAP.Sieve
+    );
+    if (validation?.error) {
+      setStatus(
+        "jmapSieveStatus",
+        "jmap-sieve-invalid",
+        { message: validation.error.description || validation.error.type },
+        true
+      );
+      return;
+    }
+    if (gEditingScript) {
+      await sieveSet({ update: { [gEditingScript.id]: { name, blobId } } });
+    } else {
+      await sieveSet({ create: { new1: { name, blobId } } });
+    }
+    document.getElementById("jmapSieveEditBox").hidden = true;
+    gEditingScript = null;
+    await loadSieve();
+    setStatus("jmapSieveStatus", "jmap-saved");
+  } catch (e) {
+    setErrorStatus("jmapSieveStatus", e);
+  }
+}
+
+window.addEventListener("load", () => {
+  document
+    .getElementById("jmapVacationSave")
+    .addEventListener("click", saveVacation);
+  document
+    .getElementById("jmapQuotaRefresh")
+    .addEventListener("click", loadQuota);
+  document
+    .getElementById("jmapSieveNew")
+    .addEventListener("click", () => editScript(null));
+  document
+    .getElementById("jmapSieveSave")
+    .addEventListener("click", saveScript);
+  document.getElementById("jmapSieveCancel").addEventListener("click", () => {
+    document.getElementById("jmapSieveEditBox").hidden = true;
+    gEditingScript = null;
+  });
+  parent.onPanelLoaded("am-jmap.xhtml");
+});
