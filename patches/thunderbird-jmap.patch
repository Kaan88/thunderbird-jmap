+/**
+ * Completion listener for a remote JMAP message mutation.
+ *
+ * Mirrors the server result into the local folders: the source headers are
+ * removed for deletes and moves, the account is synchronized so copies and
+ * moves appear in their destination, an undo transaction is registered, and
+ * the copy service (or the caller's listener) and folder listeners are
+ * notified.
+ */
+class JmapMutationListener final : public nsIUrlListener {
+ public:
+  NS_DECL_ISUPPORTS
+
+  JmapMutationListener(nsIMsgFolder* sourceFolder, nsIMsgFolder* destFolder,
+                       const nsTArray<RefPtr<nsIMsgDBHdr>>& messages,
+                       nsIMsgCopyServiceListener* copyListener, bool move,
+                       bool removeSource, bool notifyCopyService)
+      : mSourceFolder(sourceFolder),
+        mDestFolder(destFolder),
+        mMessages(messages.Clone()),
+        mCopyListener(copyListener),
+        mMove(move),
+        mRemoveSource(removeSource),
+        mNotifyCopyService(notifyCopyService) {}
+
+  /** Transaction to register with the undo stack once the mutation worked. */
+  void SetUndoTransaction(nsITransaction* transaction) {
+    mUndoTransaction = transaction;
+  }
+
+  NS_IMETHOD OnStartRunningUrl(nsIURI*) override { return NS_OK; }
+
+  NS_IMETHOD OnStopRunningUrl(nsIURI*, nsresult status) override {
+    nsCOMPtr<nsIMsgFolder> notifyFolder =
+        mSourceFolder ? mSourceFolder.get() : mDestFolder.get();
+
+    if (NS_SUCCEEDED(status) && mRemoveSource && mSourceFolder) {
+      LocalDeleteMessages(mSourceFolder.get(), mMessages);
+    }
+
+    // Let the sync engine create the destination headers and reconcile the
+    // mailbox membership the server just changed.
+    if (NS_SUCCEEDED(status) && notifyFolder) {
+      JmapSyncAccountForFolder(notifyFolder, nullptr);
+    }
+
+    if (NS_SUCCEEDED(status) && mUndoTransaction) {
+      nsCOMPtr<nsIMsgTransactionService> txns =
+          mozilla::components::Txns::Service();
+      nsCOMPtr<nsITransactionManager> txnMgr;
+      if (txns) {
+        txns->GetTransactionManager(getter_AddRefs(txnMgr));
+      }
+      if (txnMgr) {
+        txnMgr->DoTransaction(mUndoTransaction);
+      }
+    }
+
+    if (NS_SUCCEEDED(status) && mDestFolder) {
+      nsCOMPtr<nsIMsgFolderNotificationService> notifier =
+          mozilla::components::FolderNotification::Service();
+      if (notifier) {
+        nsTArray<RefPtr<nsIMsgDBHdr>> newHeaders;
+        notifier->NotifyMsgsMoveCopyCompleted(mMove, mMessages,
+                                              mDestFolder.get(), newHeaders);
+      }
+    }
+
+    if (notifyFolder) {
+      notifyFolder->NotifyFolderEvent(NS_SUCCEEDED(status)
+                                          ? kDeleteOrMoveMsgCompleted
+                                          : kDeleteOrMoveMsgFailed);
+    }
+
+    if (mNotifyCopyService && mSourceFolder && mDestFolder) {
+      // The copy service calls OnStopCopy on the request's listener and
+      // starts the next queued request.
+      nsCOMPtr<nsIMsgCopyService> copyService =
+          mozilla::components::Copy::Service();
+      copyService->NotifyCompletion(mSourceFolder, mDestFolder, status);
+    } else if (mCopyListener) {
+      mCopyListener->OnStopCopy(status);
+    }
+    return NS_OK;
+  }
+
+ private:
+  ~JmapMutationListener() = default;
+
+  nsCOMPtr<nsIMsgFolder> mSourceFolder;
+  nsCOMPtr<nsIMsgFolder> mDestFolder;
+  nsTArray<RefPtr<nsIMsgDBHdr>> mMessages;
+  nsCOMPtr<nsIMsgCopyServiceListener> mCopyListener;
+  nsCOMPtr<nsITransaction> mUndoTransaction;
+  bool mMove;
+  bool mRemoveSource;
+  bool mNotifyCopyService;
+};
