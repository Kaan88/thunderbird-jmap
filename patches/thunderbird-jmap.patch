+  Assert.equal(mailbox.folderFlags, Ci.nsMsgFolderFlags.Inbox);
+  Assert.equal(mailbox.totalEmails, 42);
+  Assert.equal(mailbox.unreadEmails, 3);
+  Assert.equal(mailbox.totalThreads, 10);
+  Assert.equal(mailbox.unreadThreads, 1);
+  Assert.equal(mailbox.QueryInterface(Ci.IJmapMailbox), mailbox);
+});
+
+add_task(function test_mailbox_defaults() {
+  const mailbox = new JmapMailbox({ id: "mb1", name: "Custom" });
+
+  Assert.equal(mailbox.parentId, "");
+  Assert.equal(mailbox.role, "");
+  Assert.equal(mailbox.sortOrder, 0);
+  Assert.equal(mailbox.folderFlags, 0);
+  Assert.equal(mailbox.totalEmails, 0);
+  Assert.equal(mailbox.unreadEmails, 0);
+  Assert.equal(mailbox.totalThreads, 0);
+  Assert.equal(mailbox.unreadThreads, 0);
+});
+
+add_task(function test_sort_mailboxes_by_depth() {
+  const mailboxes = [
+    { id: "child", parentId: "parent", name: "Child" },
+    { id: "parent", name: "Parent" },
+    { id: "grandchild", parentId: "child", name: "Grandchild" },
+    { id: "orphan", parentId: "missing", name: "Orphan" },
+  ];
+
+  const sorted = sortMailboxesByDepth(mailboxes);
+  Assert.deepEqual(
+    sorted.map(mailbox => mailbox.id),
+    ["parent", "orphan", "child", "grandchild"],
+    "parents come before their children"
+  );
+  Assert.equal(mailboxes[0].id, "child", "the input array is not mutated");
+});
+
+add_task(function test_sort_mailboxes_with_cycle() {
+  const sorted = sortMailboxesByDepth([
+    { id: "a", parentId: "b" },
+    { id: "b", parentId: "a" },
+  ]);
+  Assert.equal(sorted.length, 2, "a cycle does not lose mailboxes");
+});
+
+add_task(async function test_sync_mailboxes() {
+  const events = [];
+  const listener = {
+    onMailbox(mailbox) {
+      events.push(`mailbox:${mailbox.id}`);
+    },
+    onComplete(state) {
+      events.push(`complete:${state}`);
+    },
+    onError(status, message) {
+      Assert.ok(false, `unexpected error: ${message}`);
+    },
+  };
+
+  const result = await syncMailboxes(
+    {
+      async getMailboxes() {
+        return {
+          list: [{ id: "mb1", name: "Inbox" }, { id: "mb2", name: "Archive" }],
+          state: "state-1",
+        };
+      },
+    },
+    listener
+  );
+
+  Assert.deepEqual(events, [
+    "mailbox:mb1",
+    "mailbox:mb2",
+    "complete:state-1",
+  ]);
+  Assert.equal(result.count, 2);
+  Assert.equal(result.state, "state-1");
+});
+
+add_task(async function test_sync_mailboxes_without_state() {
+  const events = [];
+  const result = await syncMailboxes(
+    {
+      async getMailboxes() {
+        return { list: [] };
+      },
+    },
+    {
+      onMailbox() {
+        Assert.ok(false, "no mailbox expected");
+      },
+      onComplete(state) {
+        events.push(state);
+      },
+      onError(status, message) {
+        Assert.ok(false, `unexpected error: ${message}`);
+      },
+    }
+  );
+
+  Assert.deepEqual(events, [""]);
+  Assert.equal(result.count, 0);
+  Assert.equal(result.state, "");
+});
+
+add_task(function test_to_nsresult() {
+  Assert.equal(
+    toNsresult(new JmapAuthError("auth")),
+    Cr.NS_ERROR_FAILURE
+  );
+  Assert.equal(
+    toNsresult(new JmapNetworkError("network")),
+    Cr.NS_ERROR_NOT_AVAILABLE
+  );
+  Assert.equal(
+    toNsresult(new JmapSessionError("session")),
+    Cr.NS_ERROR_UNEXPECTED
+  );
+  Assert.equal(toNsresult(new Error("generic")), Cr.NS_ERROR_FAILURE);
+});
