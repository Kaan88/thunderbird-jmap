diff --git a/mail/components/accountcreation/modules/JmapDiscovery.sys.mjs b/mail/components/accountcreation/modules/JmapDiscovery.sys.mjs
new file mode 100644
index 00000000000..4d59c960064
--- /dev/null
+++ b/mail/components/accountcreation/modules/JmapDiscovery.sys.mjs
@@ -0,0 +1,327 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * JMAP (RFC 8620) service discovery for account setup.
+ *
+ * JMAP is discovered by probing `https://<host>/.well-known/jmap` on the email
+ * domain and on every hostname we learned from other discovery mechanisms
+ * (autoconfig, MX, guessing). A server is considered to speak JMAP if the
+ * well-known URL (after following redirects) either
+ *  - answers 401/403 (authentication required, e.g. Stalwart redirects
+ *    /.well-known/jmap with 307 to /jmap/session which then requires auth), or
+ *  - answers 200 with a JSON session object (has `apiUrl`).
+ * The final URL after redirects is used as the session URL.
+ */
+
+import { AccountCreationUtils } from "resource:///modules/accountcreation/AccountCreationUtils.sys.mjs";
+import { clearTimeout, setTimeout } from "resource://gre/modules/Timer.sys.mjs";
+
+const { gAccountSetupLogger } = AccountCreationUtils;
+
+export const JMAP_CAPABILITY = {
+  Core: "urn:ietf:params:jmap:core",
+  Mail: "urn:ietf:params:jmap:mail",
+  Submission: "urn:ietf:params:jmap:submission",
+  VacationResponse: "urn:ietf:params:jmap:vacationresponse",
+  Sieve: "urn:ietf:params:jmap:sieve",
+  Quota: "urn:ietf:params:jmap:quota",
+  Contacts: "urn:ietf:params:jmap:contacts",
+  Calendars: "urn:ietf:params:jmap:calendars",
+  FileNode: "urn:ietf:params:jmap:filenode",
+};
+
+const PROBE_TIMEOUT_MS = 10000;
+
+/**
+ * Overridable for tests.
+ */
+export const JmapDiscoveryInternal = {
+  fetch: (...args) => fetch(...args),
+};
+
+/**
+ * Normalize a hostname (strip port/whitespace/trailing dot, lower-case).
+ *
+ * @param {string} host
+ * @returns {?string}
+ */
+function normalizeHost(host) {
+  if (!host || typeof host != "string") {
+    return null;
+  }
+  host = host.trim().toLowerCase().replace(/\.$/, "");
+  if (!host || host.startsWith("%") || /[\s/]/.test(host)) {
+    return null;
+  }
+  return host;
+}
+
+/**
+ * Build the de-duplicated, ordered list of hosts to probe.
+ *
+ * @param {string} domain - The email domain.
+ * @param {string[]} [extraHosts] - Hostnames found by other mechanisms.
+ * @returns {string[]}
+ */
+export function candidateHosts(domain, extraHosts = []) {
+  const hosts = [];
+  for (const h of [domain, ...extraHosts, `jmap.${domain}`]) {
+    const n = normalizeHost(h);
+    if (n && !hosts.includes(n)) {
+      hosts.push(n);
+    }
+  }
+  return hosts;
+}
+
+/**
+ * Probe a single host's `/.well-known/jmap`.
+ *
+ * @param {string} host
+ * @param {AbortSignal} [signal]
+ * @returns {Promise<?{host: string, sessionUrl: string, needsAuth: boolean,
+ *   session: ?object}>} null if the host does not appear to speak JMAP.
+ */
+export async function probeHost(host, signal) {
+  const url = `https://${host}/.well-known/jmap`;
+  // AbortSignal.timeout()/any() need a window, which modules don't have.
+  const controller = new AbortController();
+  const timer = setTimeout(
+    () =>
+      controller.abort(new DOMException("JMAP probe timed out", "TimeoutError")),
+    PROBE_TIMEOUT_MS
+  );
+  const onAbort = () => controller.abort(signal.reason);
+  signal?.addEventListener("abort", onAbort, { once: true });
+  const combined = controller.signal;
+  try {
+    return await probeUrl(host, url, combined);
+  } finally {
+    clearTimeout(timer);
+    signal?.removeEventListener("abort", onAbort);
+  }
+}
+
+/**
+ * Whether a 401/403 answer to a probe plausibly comes from a JMAP server,
+ * rather than from site-wide HTTP auth or a WAF rejecting unknown paths.
+ *
+ * @param {Response} response
+ * @param {string} url - The probed URL.
+ * @param {string} sessionUrl - The final URL after redirects.
+ * @returns {boolean}
+ */
+function looksLikeJmapAuthResponse(response, url, sessionUrl) {
+  const header = name => response.headers?.get?.(name) || "";
+  // A bare WWW-Authenticate is not enough: a site behind HTTP auth sends it
+  // for every path. Require a JSON problem response or a JMAP redirect.
+  if (/json/i.test(header("Content-Type"))) {
+    return true;
+  }
+  // Redirected from /.well-known/jmap to a JMAP-looking path.
+  try {
+    return (
+      sessionUrl != url && new URL(sessionUrl).pathname.includes("jmap")
+    );
+  } catch (e) {
+    return false;
+  }
+}
+
+async function probeUrl(host, url, combined) {
+  let response;
+  try {
+    response = await JmapDiscoveryInternal.fetch(url, {
+      method: "GET",
+      redirect: "follow",
+      credentials: "omit",
+      cache: "no-store",
+      headers: { Accept: "application/json" },
+      signal: combined,
+    });
+  } catch (e) {
+    gAccountSetupLogger.debug(`JMAP probe of ${url} failed: ${e}`);
+    return null;
+  }
+  // `response.url` is the final URL after redirects (e.g. /jmap/session).
+  const sessionUrl = response.url || url;
+  if (
+    (response.status == 401 || response.status == 403) &&
+    looksLikeJmapAuthResponse(response, url, sessionUrl)
+  ) {
+    gAccountSetupLogger.info(`JMAP found at ${sessionUrl} (auth required)`);
+    return { host, sessionUrl, needsAuth: true, session: null };
+  }
+  if (response.ok) {
+    try {
+      const session = await response.json();
+      if (session && typeof session == "object" && session.apiUrl) {
+        return { host, sessionUrl, needsAuth: false, session };
+      }
+    } catch (e) {
+      // Not JSON: not JMAP.
+    }
+  }
+  gAccountSetupLogger.debug(
+    `JMAP probe of ${url} → ${response.status}: not JMAP`
+  );
+  return null;
+}
+
+/**
+ * Probe all candidate hosts in parallel and return the first (in priority
+ * order of `hosts`) that speaks JMAP.
+ *
+ * @param {string[]} hosts
+ * @param {AbortSignal} [signal]
+ * @returns {Promise<?object>} @see probeHost
+ */
+export async function probeHosts(hosts, signal) {
+  const results = await Promise.all(hosts.map(h => probeHost(h, signal)));
+  return results.find(Boolean) ?? null;
+}
+
+/**
+ * Collect hostnames from an AccountConfig (incoming, alternatives, outgoing).
+ *
+ * @param {?AccountConfig} config
+ * @returns {string[]}
+ */
+export function hostsFromConfig(config) {
+  if (!config) {
+    return [];
+  }
+  return [
+    config.incoming,
+    ...(config.incomingAlternatives || []),
+    config.outgoing,
+    ...(config.outgoingAlternatives || []),
+  ]
+    .filter(Boolean)
+    .map(s => s.hostname);
+}
+
+/**
+ * Make an incoming config object for JMAP.
+ *
+ * @param {AccountConfig} config - Used for `createNewIncoming()`.
+ * @param {object} found - Result of probeHost().
+ * @returns {object}
+ */
+export function makeJmapIncoming(config, found) {
+  const incoming = config.createNewIncoming();
+  const url = new URL(found.sessionUrl);
+  incoming.type = "jmap";
+  incoming.hostname = url.hostname;
+  incoming.port = url.port ? parseInt(url.port, 10) : 443;
+  incoming.socketType =
+    url.protocol == "http:"
+      ? Ci.nsMsgSocketType.plain
+      : Ci.nsMsgSocketType.SSL;
+  incoming.sessionUrl = found.sessionUrl;
+  incoming.username = "%EMAILADDRESS%";
+  incoming.auth = Ci.nsMsgAuthMethod.passwordCleartext;
+  incoming.authAlternatives = [];
+  if (found.session?.capabilities) {
+    incoming.jmapCapabilities = Object.keys(found.session.capabilities);
+  }
+  return incoming;
+}
+
+/**
+ * Merge a JMAP finding into a config (adding JMAP as the preferred incoming
+ * protocol). Does nothing if the config already has a JMAP incoming config
+ * with a session URL.
+ *
+ * @param {AccountConfig} config
+ * @param {object} found
+ */
+export function addJmapToConfig(config, found) {
+  const all = [config.incoming, ...config.incomingAlternatives];
+  const existing = all.find(i => i?.type == "jmap");
+  if (existing) {
+    existing.sessionUrl ||= found.sessionUrl;
+  } else if (!config.incoming?.type) {
+    config.incoming = makeJmapIncoming(config, found);
+  } else {
+    config.incomingAlternatives.push(makeJmapIncoming(config, found));
+  }
+  config.preferJmap();
+}
+
+/**
+ * Fetch the JMAP session object with credentials (HTTP Basic).
+ *
+ * @param {string} sessionUrl
+ * @param {string} username
+ * @param {string} password
+ * @param {AbortSignal} [signal]
+ * @returns {Promise<object>} The session object.
+ * @throws {Error} with `.status` on HTTP errors (401 = wrong credentials).
+ */
+export async function fetchSession(sessionUrl, username, password, signal) {
+  const auth = btoa(
+    String.fromCharCode(...new TextEncoder().encode(`${username}:${password}`))
+  );
+  const response = await JmapDiscoveryInternal.fetch(sessionUrl, {
+    method: "GET",
+    redirect: "follow",
+    credentials: "omit",
+    cache: "no-store",
+    headers: { Accept: "application/json", Authorization: `Basic ${auth}` },
+    signal,
+  });
+  if (!response.ok) {
+    const error = new Error(
+      `JMAP session request failed with HTTP ${response.status}`
+    );
+    error.status = response.status;
+    throw error;
+  }
+  const session = await response.json();
+  if (!session?.apiUrl || !session.capabilities) {
+    throw new Error("Invalid JMAP session object");
+  }
+  return session;
+}
+
+/**
+ * Summarize what a JMAP session offers, for the setup UI.
+ *
+ * @param {object|string[]} sessionOrCaps - Session object or capability list.
+ * @returns {{mail: boolean, submission: boolean, contacts: boolean,
+ *   calendars: boolean, files: boolean, vacation: boolean, sieve: boolean,
+ *   quota: boolean}}
+ */
+export function summarizeCapabilities(sessionOrCaps) {
+  const caps = Array.isArray(sessionOrCaps)
+    ? sessionOrCaps
+    : Object.keys(sessionOrCaps?.capabilities || {});
+  const has = c => caps.includes(c);
+  return {
+    mail: has(JMAP_CAPABILITY.Mail),
+    submission: has(JMAP_CAPABILITY.Submission),
+    contacts: has(JMAP_CAPABILITY.Contacts),
+    calendars: has(JMAP_CAPABILITY.Calendars),
+    files: has(JMAP_CAPABILITY.FileNode),
+    vacation: has(JMAP_CAPABILITY.VacationResponse),
+    sieve: has(JMAP_CAPABILITY.Sieve),
+    quota: has(JMAP_CAPABILITY.Quota),
+  };
+}
+
+export const JmapDiscovery = {
+  candidateHosts,
+  probeHost,
+  probeHosts,
+  hostsFromConfig,
+  makeJmapIncoming,
+  addJmapToConfig,
+  fetchSession,
+  summarizeCapabilities,
+  isEnabled() {
+    return Services.prefs.getBoolPref("mail.jmap.enabled", false);
+  },
+};
