+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPMESSAGECHANNEL_H_
+#define COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPMESSAGECHANNEL_H_
+
+#include "nsHashPropertyBag.h"
+#include "nsIChannel.h"
+#include "nsIInputStreamPump.h"
+#include "nsIMsgHdr.h"
+#include "nsMailChannel.h"
+
+/**
+ * A channel which streams the content of a JMAP message out of the local
+ * message store.
+ *
+ * The URI is expected to use the form:
+ *   x-moz-jmap://{user}@{server}/{Path/To/Folder}/{MessageKey}
+ *
+ * The message key lives in the path (rather than the URI ref) so that DocShell
+ * opens a new channel for every message, instead of treating messages in the
+ * same folder as the same document.
+ */
+class JmapMessageChannel : public nsMailChannel,
+                           public nsIChannel,
+                           public nsHashPropertyBag {
+ public:
+  NS_DECL_ISUPPORTS_INHERITED
+
+  NS_DECL_NSIREQUEST
+  NS_DECL_NSICHANNEL
+
+  /**
+   * @param uri - The x-moz-jmap URI of the message.
+   * @param convert - Whether the message/rfc822 stream converter should be
+   *   run (needed for display and for extracting MIME parts).
+   */
+  explicit JmapMessageChannel(nsIURI* uri, bool convert);
+
+ protected:
+  virtual ~JmapMessageChannel();
+
+ private:
+  /** Starts asynchronously reading the message from the local store. */
+  nsresult StartMessageReadFromStore(nsIStreamListener* streamListener);
+
+  bool mConvert;
+
+  nsCOMPtr<nsIURI> mURI;
+  nsCOMPtr<nsIMsgDBHdr> mHdr;
+  nsCOMPtr<nsIRequest> mReadRequest;
+
+  nsAutoCStringN<255> mContentType;
+  nsAutoCString mCharset;
+  uint32_t mContentDisposition;
+  nsString mContentDispositionFilename;
+  int64_t mContentLength;
+  RefPtr<nsILoadGroup> mLoadGroup;
+  nsLoadFlags mLoadFlags;
+  nsCOMPtr<nsIInterfaceRequestor> mNotificationCallbacks;
+  nsCOMPtr<nsISupports> mOwner;
+  nsCOMPtr<nsILoadInfo> mLoadInfo;
+  bool mPending;
+  nsresult mStatus;
+  RefPtr<mozilla::dom::ParentProcessChannelHandle> mParentProcessChannelHandle;
+};
+
+#endif  // COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPMESSAGECHANNEL_H_
diff --git a/mailnews/protocols/jmap/src/JmapMessageCopyHandler.cpp b/mailnews/protocols/jmap/src/JmapMessageCopyHandler.cpp
new file mode 100644
index 00000000000..c031a211d55
--- /dev/null
+++ b/mailnews/protocols/jmap/src/JmapMessageCopyHandler.cpp
@@ -0,0 +1,304 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "JmapMessageCopyHandler.h"
+
+#include <algorithm>
+
+#include "CopyMessageStreamListener.h"
+#include "JmapListeners.h"
+#include "mozilla/Components.h"
+#include "nsDirectoryServiceDefs.h"
+#include "nsDirectoryServiceUtils.h"
+#include "nsIInputStream.h"
+#include "nsIMsgCopyService.h"
+#include "nsIMsgFolderNotificationService.h"
+#include "nsIMsgMessageService.h"
+#include "nsMsgDBFolder.h"
+#include "nsMsgUtils.h"
+#include "nsNetUtil.h"
+
+NS_IMPL_ISUPPORTS(JmapMessageCopyHandler, nsICopyMessageListener)
+
+JmapMessageCopyHandler::JmapMessageCopyHandler(
+    nsIMsgFolder* srcFolder, nsIMsgFolder* dstFolder,
+    const nsTArray<RefPtr<nsIMsgDBHdr>>& headers, bool isMove,
+    nsIMsgWindow* window, const nsACString& dstMailboxId, IJmapClient* client,
+    nsIMsgCopyServiceListener* copyServiceListener)
+    : mSrcFolder(srcFolder),
+      mDstFolder(dstFolder),
+      mHeaders(headers.Clone()),
+      mIsMove(isMove),
+      mWindow(window),
+      mDstMailboxId(dstMailboxId),
+      mClient(client),
+      mCopyServiceListener(copyServiceListener),
+      mCurIndex(0),
+      mCompleted(false) {}
+
+JmapMessageCopyHandler::JmapMessageCopyHandler(
+    nsIFile* srcFile, nsIMsgFolder* dstFolder,
+    const nsTArray<nsCString>& keywords, nsIMsgWindow* window,
+    const nsACString& dstMailboxId, IJmapClient* client,
+    nsIMsgCopyServiceListener* copyServiceListener)
+    : mDstFolder(dstFolder),
+      mIsMove(false),
+      mWindow(window),
+      mSrcFile(srcFile),
+      mFileKeywords(keywords.Clone()),
+      mDstMailboxId(dstMailboxId),
+      mClient(client),
+      mCopyServiceListener(copyServiceListener),
+      mCurIndex(0),
+      mCompleted(false) {}
+
+JmapMessageCopyHandler::~JmapMessageCopyHandler() { RemoveTempFile(); }
+
+// nsICopyMessageListener, called while the source message service streams
+// the current message.
+
+NS_IMETHODIMP JmapMessageCopyHandler::BeginCopy() {
+  RemoveTempFile();
+
+  nsCOMPtr<nsIFile> file;
+  nsresult rv = NS_GetSpecialDirectory(NS_OS_TEMP_DIR, getter_AddRefs(file));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  rv = file->AppendNative("jmapcopy.eml"_ns);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  rv = file->CreateUnique(nsIFile::NORMAL_FILE_TYPE, 0600);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  rv = NS_NewLocalFileOutputStream(getter_AddRefs(mTempStream), file);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  mTempFile = file;
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapMessageCopyHandler::StartMessage() { return NS_OK; }
+
+NS_IMETHODIMP JmapMessageCopyHandler::CopyData(nsIInputStream* aIStream,
+                                               int32_t aLength) {
+  NS_ENSURE_ARG_POINTER(aIStream);
+  NS_ENSURE_STATE(mTempStream);
+
+  char buffer[4096];
+  uint32_t remaining = aLength > 0 ? static_cast<uint32_t>(aLength) : 0;
+  while (remaining > 0) {
+    uint32_t wanted =
+        std::min(remaining, static_cast<uint32_t>(sizeof(buffer)));
+    uint32_t bytesRead = 0;
+    nsresult rv = aIStream->Read(buffer, wanted, &bytesRead);
+    NS_ENSURE_SUCCESS(rv, rv);
+    if (bytesRead == 0) {
+      break;
+    }
+
+    uint32_t offset = 0;
+    while (offset < bytesRead) {
+      uint32_t written = 0;
+      rv = mTempStream->Write(buffer + offset, bytesRead - offset, &written);
+      NS_ENSURE_SUCCESS(rv, rv);
+      NS_ENSURE_TRUE(written > 0, NS_ERROR_FAILURE);
+      offset += written;
+    }
+    remaining -= bytesRead;
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapMessageCopyHandler::EndMessage(nsMsgKey key) {
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapMessageCopyHandler::EndCopy(bool aCopySucceeded) {
+  if (mTempStream) {
+    mTempStream->Close();
+    mTempStream = nullptr;
+  }
+
+  if (!aCopySucceeded || !mTempFile || mCurIndex >= mHeaders.Length()) {
+    return OnCopyCompleted(NS_ERROR_FAILURE);
+  }
+
+  nsIMsgDBHdr* header = mHeaders[mCurIndex];
+  nsTArray<nsCString> keywords;
+  JmapKeywordsForHeader(header, keywords);
+
+  PRTime date = 0;
+  header->GetDate(&date);
+
+  nsresult rv = Import(mTempFile, keywords, date);
+  if (NS_FAILED(rv)) {
+    return OnCopyCompleted(rv);
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapMessageCopyHandler::EndMove(bool aMoveSucceeded) {
+  // The source is deleted in OnImportFinished, once the import succeeded.
+  return NS_OK;
+}
+
+nsresult JmapMessageCopyHandler::Import(nsIFile* file,
+                                        const nsTArray<nsCString>& keywords,
+                                        PRTime receivedAt) {
+  NS_ENSURE_STATE(mClient);
+
+  nsTArray<nsCString> mailboxIds;
+  mailboxIds.AppendElement(mDstMailboxId);
+
+  RefPtr<JmapMessageCopyHandler> self = this;
+  RefPtr<JmapOperationListener> listener = new JmapOperationListener(
+      [self](const nsACString& id) {
+        return self->OnImportFinished(NS_OK, id);
+      },
+      [self](nsresult status, const nsACString&) {
+        return self->OnImportFinished(status, ""_ns);
+      });
+
+  return mClient->ImportMessage(file, mailboxIds, keywords, receivedAt,
+                                listener);
+}
+
+nsresult JmapMessageCopyHandler::StartCopyingNextMessage() {
+  if (mSrcFile) {
+    // Saving a draft, template or sent message: one message, already in a
+    // file.
+    NS_ENSURE_ARG_POINTER(mCopyServiceListener);
+    return Import(mSrcFile, mFileKeywords, 0);
+  }
+
+  NS_ENSURE_STATE(mSrcFolder);
+  if (mCurIndex >= mHeaders.Length()) {
+    return SyncAndComplete();
+  }
+
+  if (mCopyServiceListener && mHeaders.Length() > 1) {
+    mCopyServiceListener->OnProgress(mCurIndex + 1, mHeaders.Length());
+  }
+
+  nsCString uri;
+  nsresult rv = mSrcFolder->GetUriForMsg(mHeaders[mCurIndex], uri);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<nsIMsgMessageService> messageService;
+  rv = GetMessageServiceFromURI(uri, getter_AddRefs(messageService));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  RefPtr<CopyMessageStreamListener> streamListener =
+      new CopyMessageStreamListener(this, mIsMove);
+
+  return messageService->CopyMessage(uri, streamListener, mIsMove, nullptr,
+                                     mWindow);
+}
+
+nsresult JmapMessageCopyHandler::OnImportFinished(nsresult status,
+                                                  const nsACString& newId) {
+  if (!mSrcFile) {
+    RemoveTempFile();
+  }
+
+  if (NS_FAILED(status)) {
+    return OnCopyCompleted(status);
+  }
+
+  mNewIds.AppendElement(newId);
+
+  if (mSrcFile) {
+    return SyncAndComplete();
+  }
+
+  if (mIsMove && mCurIndex < mHeaders.Length()) {
+    RefPtr<nsIMsgDBHdr> header = mHeaders[mCurIndex];
+    nsresult rv = mSrcFolder->DeleteMessages({header}, mWindow, true, true,
+                                             nullptr, false);
+    if (NS_FAILED(rv)) {
+      NS_WARNING("JMAP move: could not delete the source message");
+    }
+  }
+
+  mCurIndex++;
+  nsresult rv = StartCopyingNextMessage();
+  if (NS_FAILED(rv)) {
+    return OnCopyCompleted(rv);
+  }
+  return NS_OK;
+}
+
+nsresult JmapMessageCopyHandler::SyncAndComplete() {
+  RefPtr<JmapMessageCopyHandler> self = this;
+  RefPtr<JmapUrlStopListener> listener =
+      new JmapUrlStopListener([self](nsresult status) {
+        // A failed sync does not undo the import; the next sync picks the
+        // message up.
+        if (self->mSrcFile && self->mCopyServiceListener &&
+            !self->mNewIds.IsEmpty()) {
+          nsCOMPtr<nsIMsgDBHdr> header;
+          JmapFindHeaderByEmailId(self->mDstFolder, self->mNewIds[0],
+                                  getter_AddRefs(header));
+          if (header) {
+            nsMsgKey key = nsMsgKey_None;
+            header->GetMessageKey(&key);
+            self->mCopyServiceListener->SetMessageKey(key);
+          }
+        }
+        return self->OnCopyCompleted(NS_OK);
+      });
+
+  nsresult rv = JmapSyncAccountForFolder(mDstFolder, listener);
+  if (NS_FAILED(rv)) {
+    return OnCopyCompleted(NS_OK);
+  }
+  return NS_OK;
+}
+
+nsresult JmapMessageCopyHandler::OnCopyCompleted(nsresult status) {
+  if (mCompleted) {
+    return NS_OK;
+  }
+  mCompleted = true;
+  RemoveTempFile();
+
+  if (mIsMove && mSrcFolder) {
+    mSrcFolder->NotifyFolderEvent(NS_SUCCEEDED(status)
+                                      ? kDeleteOrMoveMsgCompleted
+                                      : kDeleteOrMoveMsgFailed);
+  }
+
+  if (mSrcFolder && NS_SUCCEEDED(status)) {
+    nsCOMPtr<nsIMsgFolderNotificationService> notifier =
+        mozilla::components::FolderNotification::Service();
+    if (notifier) {
+      nsTArray<RefPtr<nsIMsgDBHdr>> newHeaders;
+      notifier->NotifyMsgsMoveCopyCompleted(mIsMove, mHeaders, mDstFolder,
+                                            newHeaders);
+    }
+  }
+
+  nsCOMPtr<nsISupports> srcSupports;
+  if (mSrcFile) {
+    srcSupports = do_QueryInterface(mSrcFile);
+  } else {
+    srcSupports = do_QueryInterface(mSrcFolder);
+  }
+
+  // NotifyCompletion calls OnStopCopy on the listener of the request.
+  nsCOMPtr<nsIMsgCopyService> copyService =
+      mozilla::components::Copy::Service();
+  return copyService->NotifyCompletion(srcSupports, mDstFolder, status);
+}
+
+void JmapMessageCopyHandler::RemoveTempFile() {
+  if (mTempStream) {
+    mTempStream->Close();
+    mTempStream = nullptr;
+  }
+  if (mTempFile) {
+    mTempFile->Remove(false);
+    mTempFile = nullptr;
+  }
+}
diff --git a/mailnews/protocols/jmap/src/JmapMessageCopyHandler.h b/mailnews/protocols/jmap/src/JmapMessageCopyHandler.h
new file mode 100644
