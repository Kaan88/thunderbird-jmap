+
+var { applyIdentity, pushIdentity } = ChromeUtils.importESModule(
+  "resource:///modules/jmap/JmapIdentities.sys.mjs"
+);
+var { MailServices } = ChromeUtils.importESModule(
+  "resource:///modules/MailServices.sys.mjs"
+);
+
+add_task(async function test_apply_and_push_identity() {
+  const identity = MailServices.accounts.createIdentity();
+  identity.email = "user@example.com";
+
+  const changed = applyIdentity(
+    {
+      id: "I1",
+      email: "user@example.com",
+      name: "Test User",
+      replyTo: [{ name: "Help", email: "help@example.com" }],
+      bcc: [{ name: null, email: "archive@example.com" }],
+      htmlSignature: "<b>sig</b>",
+    },
+    identity
+  );
+  Assert.ok(changed);
+  Assert.equal(identity.fullName, "Test User");
+  Assert.equal(identity.replyTo, "Help <help@example.com>");
+  Assert.equal(identity.bccList, "archive@example.com");
+  Assert.ok(identity.doBcc);
+  Assert.ok(identity.htmlSigFormat);
+  Assert.equal(identity.htmlSigText, "<b>sig</b>");
+
+  // A local signature is never replaced.
+  identity.htmlSigText = "mine";
+  applyIdentity({ id: "I1", textSignature: "server" }, identity);
+  Assert.equal(identity.htmlSigText, "mine");
+
+  const { client, transport } = await makeClient((url, options) => {
+    const [[name, args, callId]] = JSON.parse(options.body).methodCalls;
+    const id = Object.keys(args.update)[0];
+    return jmapResponse([[name, { updated: { [id]: null } }, callId]]);
+  });
+  await pushIdentity(client, identity);
+  const [[name, args]] = requestBody(transport).methodCalls;
+  Assert.equal(name, "Identity/set");
+  Assert.deepEqual(args.update.I1, {
+    name: "Test User",
+    replyTo: [{ name: "Help", email: "help@example.com" }],
+    bcc: [{ name: null, email: "archive@example.com" }],
+    htmlSignature: "mine",
+  });
+});
diff --git a/mailnews/protocols/jmap/test/unit/test_jmap_keywords_and_store.js b/mailnews/protocols/jmap/test/unit/test_jmap_keywords_and_store.js
