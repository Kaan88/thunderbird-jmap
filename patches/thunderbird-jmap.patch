+/**
+ * Destroy the mailboxes in `ids` one after another (children must come
+ * before their parents), then call `done`.
+ */
+void JmapDestroyMailboxChain(RefPtr<IJmapClient> client,
+                             CopyableTArray<nsCString> ids, size_t index,
+                             std::function<nsresult(nsresult)> done) {
+  if (index >= ids.Length()) {
+    done(NS_OK);
+    return;
+  }
+
+  nsCString id = ids[index];
+  RefPtr<JmapOperationListener> listener = new JmapOperationListener(
+      [client, ids, index, done](const nsACString&) {
+        JmapDestroyMailboxChain(client, ids, index + 1, done);
+        return NS_OK;
+      },
+      [done](nsresult status, const nsACString&) { return done(status); });
+
+  nsresult rv = client->DestroyMailbox(id, true, listener);
+  if (NS_FAILED(rv)) {
+    done(rv);
+  }
+}
+
+/** JMAP ids of `folder` and its descendants, children before parents. */
+nsresult JmapMailboxIdsDeepestFirst(nsIMsgFolder* folder, bool includeSelf,
+                                    nsTArray<nsCString>& ids) {
+  nsTArray<RefPtr<nsIMsgFolder>> descendants;
+  nsresult rv = folder->GetDescendants(descendants);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  for (size_t i = descendants.Length(); i > 0; i--) {
+    nsCString id;
+    descendants[i - 1]->GetStringProperty("jmapId", id);
+    if (!id.IsEmpty()) {
+      ids.AppendElement(id);
+    }
+  }
+
+  if (includeSelf) {
+    nsCString id;
+    folder->GetStringProperty("jmapId", id);
+    if (!id.IsEmpty()) {
+      ids.AppendElement(id);
+    }
+  }
+  return NS_OK;
+}
