+add_task(async function test_push_dispatch() {
+  const { client } = await makeClient(() => {
+    throw new Error("no API calls expected");
+  });
+  const encoder = new TextEncoder();
+  let push;
+  const stream = new ReadableStream({
+    start(controller) {
+      push = text => controller.enqueue(encoder.encode(text));
+    },
+  });
+  let requestedUrl;
+  let requestedHeaders;
+  const fakeFetch = async (url, { headers }) => {
+    requestedUrl = url;
+    requestedHeaders = headers;
+    return { ok: true, status: 200, body: stream };
+  };
+
+  let mailSyncs = 0;
+  const contactChanges = [];
+  const remove = JmapPush.addListener("push1", ["ContactCard"], changed =>
+    contactChanges.push(changed)
+  );
+  JmapPush.start("push1", client, {
+    fetch: fakeFetch,
+    getAuthHeaders: async () => ({ Authorization: "Bearer t" }),
+    onMailChange: () => mailSyncs++,
+  });
+
+  await TestUtils.waitForCondition(() => JmapPush.isConnected("push1"));
+  Assert.equal(
+    requestedUrl,
+    "https://jmap.example.com/eventsource/?types=*&closeafter=no&ping=60"
+  );
+  Assert.equal(requestedHeaders.Authorization, "Bearer t");
+  Assert.equal(requestedHeaders.Accept, "text/event-stream");
+
+  push(
+    'event: state\ndata: {"@type":"StateChange","changed":{"u1":{"Email":"s2"}}}\n\n'
+  );
+  await TestUtils.waitForCondition(() => mailSyncs == 1);
+  Assert.equal(contactChanges.length, 0);
+
+  push(
+    'event: state\ndata: {"@type":"StateChange","changed":{"u1":{"ContactCard":"c2","Email":"s3"}}}\n\n'
+  );
+  await TestUtils.waitForCondition(() => contactChanges.length == 1);
+  Assert.deepEqual(contactChanges[0], { u1: { ContactCard: "c2" } });
+  Assert.equal(mailSyncs, 2);
+
+  remove();
+  JmapPush.stop("push1");
+  Assert.ok(!JmapPush.isConnected("push1"));
+});
