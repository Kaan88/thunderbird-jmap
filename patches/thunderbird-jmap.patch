+      h => h && h.toLowerCase() != domain.toLowerCase()
+    );
+    if (extraHosts.length) {
+      found = await lazy.JmapDiscovery.probeHosts(
+        lazy.JmapDiscovery.candidateHosts(domain, extraHosts).filter(
+          h => h != domain.toLowerCase() && h != `jmap.${domain.toLowerCase()}`
+        ),
+        abortSignal
+      ).catch(() => null);
+    }
+  }
+
+  if (abortSignal.aborted) {
+    return config;
+  }
+  if (!found && !fromXml) {
+    return config;
+  }
+  if (!config) {
+    config = new lazy.AccountConfig();
+    config.source = lazy.AccountConfig.kSourceGuess;
+  }
+  if (found) {
+    lazy.JmapDiscovery.addJmapToConfig(config, found);
+  } else {
+    config.preferJmap();
+  }
+  gAccountSetupLogger.info(
+    `JMAP preferred, session URL ${config.incoming.sessionUrl}`
+  );
