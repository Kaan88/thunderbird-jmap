diff --git a/mailnews/protocols/jmap/src/IJmapClient.idl b/mailnews/protocols/jmap/src/IJmapClient.idl
new file mode 100644
index 00000000000..4b7146b8d4c
--- /dev/null
+++ b/mailnews/protocols/jmap/src/IJmapClient.idl
@@ -0,0 +1,368 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsISupports.idl"
+
+interface IJmapMailbox;
+interface IJmapMailboxListener;
+interface IJmapMessageFetchListener;
+interface nsIFile;
+interface nsIInputStream;
+interface nsIMsgIncomingServer;
+interface nsIUrlListener;
+
+/**
+ * A single JMAP mailbox, as returned by `Mailbox/get`.
+ *
+ * This interface exists so the C++ account and folder classes can consume
+ * mailbox metadata without knowing anything about JSON or the JavaScript
+ * client implementation.
+ */
+[scriptable, uuid(8d9e2b74-3f1a-4c55-9a0e-6b2d7c4f1a01)]
+interface IJmapMailbox : nsISupports {
+  /** JMAP mailbox id, unique within the account. */
+  readonly attribute AUTF8String id;
+
+  /** Parent mailbox id, or an empty string for top-level mailboxes. */
+  readonly attribute AUTF8String parentId;
+
+  /** Display name of the mailbox. */
+  readonly attribute AUTF8String name;
+
+  /**
+   * Standard role of the mailbox, such as `inbox`, `trash` or `sent`, or an
+   * empty string if the mailbox has no role.
+   */
+  readonly attribute AUTF8String role;
+
+  /** Server-defined sort order. */
+  readonly attribute long sortOrder;
+
+  /**
+   * Thunderbird folder flags derived from `role` (for example
+   * `nsMsgFolderFlags::Inbox`), or 0 if the mailbox has no special role.
+   */
+  readonly attribute unsigned long folderFlags;
+
+  /** Total number of emails in the mailbox. */
+  readonly attribute unsigned long totalEmails;
+
+  /** Number of unread emails in the mailbox. */
+  readonly attribute unsigned long unreadEmails;
+
+  /** Total number of threads in the mailbox. */
+  readonly attribute unsigned long totalThreads;
+
+  /** Number of threads with at least one unread email. */
+  readonly attribute unsigned long unreadThreads;
+};
+
+/**
+ * Callback for `IJmapClient.syncMailboxes`.
+ *
+ * The client calls `onMailbox` once per mailbox, then either `onComplete` or
+ * `onError`. After `onError`, no further callbacks are made.
+ */
+[scriptable, uuid(3c7a5e10-9d42-4b8f-a1c3-2e5f6d7b8c02)]
+interface IJmapMailboxListener : nsISupports {
+  /**
+   * Called for each mailbox in the account.
+   *
+   * @param mailbox - The mailbox metadata.
+   */
+  void onMailbox(in IJmapMailbox mailbox);
+
+  /**
+   * Called when every mailbox has been delivered.
+   *
+   * @param state - The JMAP state token for the mailbox list, which callers
+   *   can persist and later pass to `Mailbox/changes`.
+   */
+  void onComplete(in AUTF8String state);
+
+  /**
+   * Called when the mailbox list could not be fetched.
+   *
+   * @param status - An XPCOM error code.
+   * @param message - A human-readable description, for logging.
+   */
+  void onError(in nsresult status, in AUTF8String message);
+};
+
+/**
+ * Callback for `IJmapClient.getMessage`.
+ *
+ * The client calls `onFetchedDataAvailable` with the message bytes, followed
+ * by `onFetchStop`. Both callbacks run on the main thread and, when the
+ * message is available immediately, in the same task.
+ */
+[scriptable, uuid(5e2f8a13-7c94-4d6b-8f2a-9c1d3e5b7a04)]
+interface IJmapMessageFetchListener : nsISupports {
+  /**
+   * Called with a stream containing (part of) the raw RFC 5322 message.
+   *
+   * @param inputStream - The message bytes.
+   */
+  void onFetchedDataAvailable(in nsIInputStream inputStream);
+
+  /**
+   * Called when the message has been delivered, or when the fetch failed.
+   *
+   * @param status - An XPCOM error code.
+   */
+  void onFetchStop(in nsresult status);
+};
+
+/**
+ * Completion callback for operations that return a value.
+ *
+ * Exactly one of the two methods is called, on the main thread.
+ */
+[scriptable, uuid(6b1d4e2a-0c7f-4f3e-9d5a-1a2b3c4d5e06)]
+interface IJmapOperationListener : nsISupports {
+  /**
+   * @param result - Operation-specific result: a new object id, or a JSON
+   *   document for structured results (documented per method).
+   */
+  void onSuccess(in AUTF8String result);
+
+  /**
+   * @param status - An XPCOM error code.
+   * @param message - A human-readable description, for logging and alerts.
+   */
+  void onFailure(in nsresult status, in AUTF8String message);
+};
+
+/**
+ * The JMAP protocol client used by the incoming server and folder classes.
+ *
+ * The implementation lives in JavaScript (`JmapXPCOMClient.sys.mjs`) and wraps
+ * the `JmapClient`/`JmapMailClient` modules. Keeping this boundary narrow
+ * means the client can be replaced by a Rust implementation later without
+ * touching the account, folder or sync code.
+ */
+[scriptable, uuid(a4f1c2d3-5b6e-4a7f-8c9d-0e1f2a3b4c03)]
+interface IJmapClient : nsISupports {
+  /**
+   * Initialize the client for an account.
+   *
+   * This does not perform any network request; the session is fetched lazily
+   * when the first operation runs. Calling `initialize` again resets the
+   * client and drops any cached session.
+   *
+   * @param incomingServer - The account this client belongs to.
+   * @param sessionUrl - The JMAP session resource URL. If empty, the client
+   *   may derive it from the account's hostname using `/.well-known/jmap`.
+   */
+  void initialize(in nsIMsgIncomingServer incomingServer,
+                  in AUTF8String sessionUrl);
+
+  /** Key of the incoming server this client is attached to. */
+  readonly attribute AUTF8String incomingServerKey;
+
+  /** Whether the client has a session or is currently fetching one. */
+  readonly attribute boolean running;
+
+  /**
+   * Whether the client is connected and not processing any operation.
+   * Always false when `running` is false.
+   */
+  readonly attribute boolean idle;
+
+  /** Shut down the client and drop the cached session. */
+  void shutdown();
+
+  /**
+   * Fetch the complete mailbox list for the account.
+   *
+   * The callback receives every mailbox, then the mailbox list state token.
+   * Errors, including authentication and network failures, are reported
+   * through `IJmapMailboxListener.onError`.
+   */
+  void syncMailboxes(in IJmapMailboxListener listener);
+
+  /**
+   * Synchronize message metadata for the whole account.
+   *
+   * On the first run this mirrors every message of every mailbox into the
+   * local folder databases. Later runs use `Email/changes`. Missing folders
+   * are created as needed.
+   *
+   * The listener is notified through `onStartRunningUrl`/`onStopRunningUrl`
+   * (with a null URI). `onStopRunningUrl` receives the error code if the
+   * synchronization failed.
+   *
+   * @param listener - Completion listener, may be null.
+   */
+  void syncAccount(in nsIUrlListener listener);
+
+  /**
+   * Fetch the raw RFC 5322 content of a message.
+   *
+   * The message is delivered to `listener` as a stream. If the server does
+   * not expose a raw message blob, the client reconstructs an RFC 5322
+   * message from the `Email` body values.
+   *
+   * @param listener - Receives the message data and the completion status.
+   * @param id - The JMAP email id.
+   */
+  void getMessage(in IJmapMessageFetchListener listener, in AUTF8String id);
+
+  /**
+   * Mark messages read or unread on the server.
+   *
+   * The local message database is not touched; callers update it first.
+   *
+   * @param ids - JMAP email ids.
+   * @param read - Whether the messages are read.
+   * @param listener - Optional completion listener.
+   */
+  void setMessagesRead(in Array<ACString> ids, in boolean read,
+                       in nsIUrlListener listener);
+
+  /**
+   * Flag or unflag messages on the server.
+   *
+   * @param ids - JMAP email ids.
+   * @param flagged - Whether the messages are flagged.
+   * @param listener - Optional completion listener.
+   */
+  void setMessagesFlagged(in Array<ACString> ids, in boolean flagged,
+                          in nsIUrlListener listener);
+
+  /**
+   * Permanently delete messages (remove them from the account).
+   *
+   * @param ids - JMAP email ids.
+   * @param listener - Optional completion listener.
+   */
+  void deleteMessages(in Array<ACString> ids, in nsIUrlListener listener);
+
+  /**
+   * Move messages between mailboxes by changing their membership.
+   *
+   * The messages keep their identity; this is not a copy followed by a
+   * delete.
+   *
+   * @param ids - JMAP email ids.
+   * @param fromMailboxId - Mailbox the messages currently belong to.
+   * @param toMailboxId - Destination mailbox.
+   * @param listener - Optional completion listener.
+   */
+  void moveMessages(in Array<ACString> ids, in AUTF8String fromMailboxId,
+                    in AUTF8String toMailboxId, in nsIUrlListener listener);
+
+  /**
+   * Copy messages into another mailbox of the same account.
+   *
+   * The server assigns new email ids to the copies.
+   *
+   * @param ids - JMAP email ids.
+   * @param toMailboxId - Destination mailbox.
+   * @param listener - Optional completion listener.
+   */
+  void copyMessages(in Array<ACString> ids, in AUTF8String toMailboxId,
+                    in nsIUrlListener listener);
+
+  /**
+   * Set or clear the junk classification of messages.
+   *
+   * @param ids - JMAP email ids.
+   * @param junk - Whether the messages are junk.
+   * @param listener - Optional completion listener.
+   */
+  void setMessagesJunk(in Array<ACString> ids, in boolean junk,
+                       in nsIUrlListener listener);
+
+  /**
+   * Verify that the account can establish a JMAP session.
+   *
+   * Used by account setup. The listener is notified through
+   * `onStartRunningUrl`/`onStopRunningUrl`; the URI arguments are always null
+   * because JMAP does not have a folder-oriented URL for this operation.
+   */
+  void checkConnectivity(in nsIUrlListener listener);
+
+  /**
+   * Create a mailbox. `onSuccess` receives the new mailbox id.
+   *
+   * @param name - Display name.
+   * @param parentId - Parent mailbox id, empty for a top-level mailbox.
+   */
+  void createMailbox(in AUTF8String name, in AUTF8String parentId,
+                     in IJmapOperationListener listener);
+
+  /**
+   * Rename and/or reparent a mailbox. `onSuccess` receives the mailbox id.
+   *
+   * @param id - Mailbox id.
+   * @param name - New name, or empty to keep the current one.
+   * @param parentId - New parent id; "-" keeps the current parent and an
+   *   empty string makes the mailbox top-level.
+   */
+  void updateMailbox(in AUTF8String id, in AUTF8String name,
+                     in AUTF8String parentId,
+                     in IJmapOperationListener listener);
+
+  /**
+   * Destroy a mailbox. Child mailboxes must be destroyed first.
+   *
+   * @param removeEmails - Also destroy emails only in this mailbox
+   *   (`onDestroyRemoveEmails`).
+   */
+  void destroyMailbox(in AUTF8String id, in boolean removeEmails,
+                      in IJmapOperationListener listener);
+
+  /**
+   * Destroy every email in a mailbox (Empty Trash / Empty Junk).
+   */
+  void emptyMailbox(in AUTF8String id, in IJmapOperationListener listener);
+
+  /**
+   * Upload an RFC 5322 message file and `Email/import` it.
+   * `onSuccess` receives the new email id.
+   *
+   * @param file - The message file.
+   * @param mailboxIds - Mailboxes the email is placed in.
+   * @param keywords - JMAP keywords to set, for example `$seen`, `$draft`.
+   * @param receivedAt - PRTime in microseconds, 0 for now.
+   */
+  void importMessage(in nsIFile file, in Array<AUTF8String> mailboxIds,
+                     in Array<AUTF8String> keywords, in PRTime receivedAt,
+                     in IJmapOperationListener listener);
+
+  /**
+   * Add and remove keywords (Thunderbird tags) on messages.
+   */
+  void setKeywords(in Array<ACString> ids, in Array<AUTF8String> add,
+                   in Array<AUTF8String> remove, in nsIUrlListener listener);
+
+  /**
+   * Run `Email/query`. `onSuccess` receives a JSON array of email ids.
+   *
+   * @param filterJSON - A JMAP `FilterCondition`/`FilterOperator` as JSON.
+   * @param limit - Maximum number of ids, 0 for no limit.
+   */
+  void queryEmails(in AUTF8String filterJSON, in unsigned long limit,
+                   in IJmapOperationListener listener);
+
+  /**
+   * Fetch quotas (RFC 9425). `onSuccess` receives a JSON array of
+   * `{name, used, hardLimit, resourceType, scope}`; empty when the server
+   * has no quota capability.
+   */
+  void getQuota(in IJmapOperationListener listener);
+
+  /**
+   * Run an arbitrary JMAP method on this account's session and return its
+   * response arguments as JSON. Used by settings panes (VacationResponse,
+   * SieveScript, Identity) so they don't need a dedicated method each.
+   *
+   * @param method - JMAP method name, for example `VacationResponse/get`.
+   * @param argsJSON - Arguments as JSON; `accountId` defaults to the
+   *   account for the method's capability.
+   */
+  void callMethod(in AUTF8String method, in AUTF8String argsJSON,
+                  in IJmapOperationListener listener);
+};
