+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsISupports.idl"
+#include "MailNewsTypes2.idl"
+
+interface nsIMsgQuota;
+
+/**
+ * Specialized interface for folders in a JMAP account.
+ */
+[scriptable, uuid(8c3f5e0b-7d2a-4b94-8f6e-4b9c2d3e5f21)]
+interface IJmapFolder : nsISupports {
+  /**
+   * The JMAP mailbox id this folder represents. Empty for the account's
+   * synthetic root folder.
+   */
+  readonly attribute AUTF8String jmapId;
+
+  /**
+   * Called by the sync engine after it added headers for messages which
+   * arrived since the previous sync. The folder queues them for incoming
+   * filters and junk classification.
+   *
+   * @param keys - Message keys of the new headers in this folder.
+   */
+  void onNewMessages(in Array<nsMsgKey> keys);
+
+  /**
+   * Called when message bodies were downloaded to the offline store, so
+   * filters which need the full message can run.
+   */
+  void handleDownloadedMessages();
+
+  /**
+   * The account quotas last reported by the server (RFC 9425). The value is
+   * cached; it is refreshed after every sync. Empty when the server has no
+   * quota support or the quota was not fetched yet.
+   */
+  Array<nsIMsgQuota> getQuota();
+};
diff --git a/mailnews/protocols/jmap/src/IJmapIncomingServer.idl b/mailnews/protocols/jmap/src/IJmapIncomingServer.idl
new file mode 100644
index 00000000000..3e8912f0be8
--- /dev/null
+++ b/mailnews/protocols/jmap/src/IJmapIncomingServer.idl
@@ -0,0 +1,73 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsISupports.idl"
+
+interface IJmapClient;
+interface nsIMsgWindow;
+interface nsIUrlListener;
+
+/**
+ * Account-level operations for a JMAP incoming server.
+ *
+ * This interface exists because a folder created through the folder lookup
+ * service does not have a direct handle to its incoming server. Folders use
+ * it to request folder-hierarchy synchronization and to obtain the shared
+ * protocol client.
+ */
+[scriptable, uuid(7b2e4d9a-6c1f-4a83-9e5d-3a8b1c2d4e10)]
+interface IJmapIncomingServer : nsISupports {
+  /** Whether the protocol client currently has a session or is connecting. */
+  readonly attribute boolean protocolClientRunning;
+
+  /** Whether the protocol client is connected and idle. */
+  readonly attribute boolean protocolClientIdle;
+
+  /**
+   * Get the protocol client for this account, creating it if needed.
+   *
+   * @returns The shared `IJmapClient` instance.
+   */
+  IJmapClient getProtocolClient();
+
+  /**
+   * Synchronize the mailbox hierarchy with the server.
+   *
+   * The listener is notified through `onStartRunningUrl`/`onStopRunningUrl`
+   * (with a null URI) when the operation completes. `onStopRunningUrl` receives
+   * the error code if the synchronization failed.
+   *
+   * @param listener - Completion listener, may be null.
+   * @param msgWindow - Window for any UI the operation may need.
+   */
+  void syncFolderHierarchy(in nsIUrlListener listener,
+                           in nsIMsgWindow msgWindow);
+
+  /**
+   * Synchronize message metadata for this account.
+   *
+   * The listener is notified through `onStartRunningUrl`/`onStopRunningUrl`
+   * (with a null URI) when the operation completes. `onStopRunningUrl`
+   * receives the error code if the synchronization failed.
+   *
+   * @param listener - Completion listener, may be null.
+   */
+  void syncMessages(in nsIUrlListener listener);
+
+  /**
+   * Create the local folder mirroring a JMAP mailbox, if it does not exist.
+   *
+   * Folder creation is idempotent and safe to call on every sync.
+   *
+   * @param id - JMAP mailbox id.
+   * @param parentId - Parent mailbox id, empty for top-level mailboxes.
+   * @param name - Display name of the mailbox.
+   * @param flags - Combination of `nsMsgFolderFlags` values.
+   */
+  void createFolderForMailbox(in ACString id, in ACString parentId,
+                              in ACString name, in unsigned long flags);
+
+  /** URL of the JMAP session resource for this account. */
+  attribute AUTF8String jmapSessionUrl;
+};
diff --git a/mailnews/protocols/jmap/src/JmapCopyMoveTransaction.cpp b/mailnews/protocols/jmap/src/JmapCopyMoveTransaction.cpp
new file mode 100644
index 00000000000..25c7b187fd8
--- /dev/null
+++ b/mailnews/protocols/jmap/src/JmapCopyMoveTransaction.cpp
@@ -0,0 +1,74 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "JmapCopyMoveTransaction.h"
+
+#include "IJmapClient.h"
+#include "JmapListeners.h"
+#include "nsMsgDBFolder.h"
+#include "nsMsgUtils.h"
+
+JmapCopyMoveTransaction::JmapCopyMoveTransaction(
+    nsIMsgFolder* sourceFolder, nsIMsgFolder* destFolder,
+    const nsTArray<nsCString>& emailIds, const nsACString& sourceMailboxId,
+    const nsACString& destMailboxId, bool isMove)
+    : mSourceFolder(sourceFolder),
+      mDestFolder(destFolder),
+      mEmailIds(emailIds.Clone()),
+      mSourceMailboxId(sourceMailboxId),
+      mDestMailboxId(destMailboxId),
+      mIsMove(isMove) {}
+
+NS_IMETHODIMP JmapCopyMoveTransaction::UndoTransaction() {
+  return Perform(true);
+}
+
+NS_IMETHODIMP JmapCopyMoveTransaction::RedoTransaction() {
+  return Perform(false);
+}
+
+nsresult JmapCopyMoveTransaction::Perform(bool undo) {
+  if (WeAreOffline()) {
+    return NS_MSG_ERROR_OFFLINE;
+  }
+  if (mEmailIds.IsEmpty()) {
+    return NS_OK;
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  nsresult rv = JmapClientForFolder(mDestFolder, getter_AddRefs(client));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  // Every step is followed by a sync, which removes and creates the local
+  // headers to match the new mailbox membership.
+  nsCOMPtr<nsIMsgFolder> notifyFolder = undo ? mDestFolder : mSourceFolder;
+  nsCOMPtr<nsIMsgFolder> syncFolder = mDestFolder;
+  auto onDone = [notifyFolder, syncFolder](nsresult status) -> nsresult {
+    if (NS_SUCCEEDED(status)) {
+      JmapSyncAccountForFolder(syncFolder, nullptr);
+    }
+    if (notifyFolder) {
+      notifyFolder->NotifyFolderEvent(NS_SUCCEEDED(status)
+                                          ? kDeleteOrMoveMsgCompleted
+                                          : kDeleteOrMoveMsgFailed);
+    }
+    return NS_OK;
+  };
+
+  if (mIsMove) {
+    RefPtr<JmapUrlStopListener> listener = new JmapUrlStopListener(onDone);
+    return undo ? client->MoveMessages(mEmailIds, mDestMailboxId,
+                                       mSourceMailboxId, listener)
+                : client->MoveMessages(mEmailIds, mSourceMailboxId,
+                                       mDestMailboxId, listener);
+  }
+
+  // Undoing a copy drops the destination membership; redoing adds it back.
+  nsAutoCString args;
+  JmapBuildMailboxMembershipArgs(mEmailIds, mDestMailboxId, !undo, args);
+  RefPtr<JmapOperationListener> listener = new JmapOperationListener(
+      [onDone](const nsACString&) { return onDone(NS_OK); },
+      [onDone](nsresult status, const nsACString&) { return onDone(status); });
+  return client->CallMethod("Email/set"_ns, args, listener);
+}
diff --git a/mailnews/protocols/jmap/src/JmapCopyMoveTransaction.h b/mailnews/protocols/jmap/src/JmapCopyMoveTransaction.h
new file mode 100644
index 00000000000..f4c1ec3c632
--- /dev/null
+++ b/mailnews/protocols/jmap/src/JmapCopyMoveTransaction.h
@@ -0,0 +1,58 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPCOPYMOVETRANSACTION_H_
+#define COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPCOPYMOVETRANSACTION_H_
+
+#include "nsCOMPtr.h"
+#include "nsIMsgFolder.h"
+#include "nsMsgTxn.h"
+#include "nsString.h"
+#include "nsTArray.h"
+
+/**
+ * Undo/redo transaction for a copy, move or delete-to-trash between two
+ * mailboxes of the same JMAP account.
+ *
+ * Unlike EWS, a JMAP email keeps its id when it changes mailboxes, and a
+ * same-account copy only adds a mailbox membership. The transaction can
+ * therefore be expressed purely in terms of email ids and mailbox ids; the
+ * local headers are recreated by the sync which follows every step.
+ */
+class JmapCopyMoveTransaction final : public nsMsgTxn {
+ public:
+  /**
+   * @param sourceFolder - Folder the messages came from.
+   * @param destFolder - Folder the messages were copied or moved to.
+   * @param emailIds - JMAP ids of the affected emails.
+   * @param sourceMailboxId - JMAP id of `sourceFolder`.
+   * @param destMailboxId - JMAP id of `destFolder`.
+   * @param isMove - Whether the original operation was a move.
+   */
+  JmapCopyMoveTransaction(nsIMsgFolder* sourceFolder, nsIMsgFolder* destFolder,
+                          const nsTArray<nsCString>& emailIds,
+                          const nsACString& sourceMailboxId,
+                          const nsACString& destMailboxId, bool isMove);
+
+  NS_IMETHOD UndoTransaction() override;
+  NS_IMETHOD RedoTransaction() override;
+
+ private:
+  ~JmapCopyMoveTransaction() = default;
+
+  /**
+   * Move the emails from `fromMailbox` to `toMailbox`, or, for a copy, add
+   * or remove the membership of the destination mailbox.
+   */
+  nsresult Perform(bool undo);
+
+  nsCOMPtr<nsIMsgFolder> mSourceFolder;
+  nsCOMPtr<nsIMsgFolder> mDestFolder;
+  const nsTArray<nsCString> mEmailIds;
+  const nsCString mSourceMailboxId;
+  const nsCString mDestMailboxId;
+  const bool mIsMove;
+};
+
+#endif  // COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPCOPYMOVETRANSACTION_H_
