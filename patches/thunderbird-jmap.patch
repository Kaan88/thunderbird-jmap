+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, you can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Conversion between JSContact Card objects (RFC 9553), as used by JMAP for
+ * Contacts (RFC 9610), and the vCard 4.0 text Thunderbird stores in `_vCard`.
+ *
+ * Properties this mapper does not understand are returned separately as
+ * "extra" and merged back when converting the other way, so they survive a
+ * round trip through Thunderbird.
+ */
+
+import ICAL from "resource:///modules/calendar/Ical.sys.mjs";
+
+/** JSContact properties handled by the mapper (or owned by the server). */
+const KNOWN_PROPERTIES = new Set([
+  "@type",
+  "version",
+  "uid",
+  "kind",
+  "name",
+  "nicknames",
+  "emails",
+  "phones",
+  "addresses",
+  "organizations",
+  "titles",
+  "onlineServices",
+  "links",
+  "anniversaries",
+  "notes",
+  "media",
+  "members",
+  // JMAP server-set properties.
+  "id",
+  "addressBookIds",
+  "blobId",
+  "updated",
+]);
+
+const NAME_KINDS = {
+  surname: 0,
+  given: 1,
+  given2: 2,
+  title: 3,
+  credential: 4,
+  generation: 4,
+};
+
+// vCard ADR: pobox, ext, street, locality, region, code, country.
+const ADR_KINDS = {
+  postOfficeBox: 0,
+  apartment: 1,
+  room: 1,
+  floor: 1,
+  building: 1,
+  number: 2,
+  name: 2,
+  block: 2,
+  locality: 3,
+  district: 3,
+  subdistrict: 3,
+  region: 4,
+  postcode: 5,
+  country: 6,
+};
+
+const PHONE_FEATURES = {
+  mobile: "cell",
+  fax: "fax",
+  pager: "pager",
+  voice: "voice",
+  video: "video",
+  text: "text",
+  textphone: "textphone",
+};
+
+function contextsToType(contexts) {
+  const types = [];
+  if (contexts?.work) {
+    types.push("work");
+  }
+  if (contexts?.private) {
+    types.push("home");
+  }
+  return types;
+}
+
+function typeToContexts(params) {
+  const types = [params.type ?? []].flat().map(t => t.toLowerCase());
+  const contexts = {};
+  if (types.includes("work")) {
+    contexts.work = true;
+  }
+  if (types.includes("home")) {
+    contexts.private = true;
+  }
+  return { types, contexts: Object.keys(contexts).length ? contexts : null };
+}
+
+function prefParam(params, pref) {
+  if (Number.isInteger(pref)) {
+    params.pref = String(pref);
+  }
+}
+
+function setTypes(params, types) {
+  if (types.length == 1) {
+    params.type = types[0];
+  } else if (types.length) {
+    params.type = types;
+  }
+}
+
+/** Sorted entries of a JSContact Id-keyed map, by `pref` then key. */
+function sortedEntries(map) {
+  return Object.entries(map ?? {}).sort(
+    ([ka, a], [kb, b]) =>
+      (a?.pref ?? 101) - (b?.pref ?? 101) || ka.localeCompare(kb)
+  );
+}
+
+/** Format a JSContact date as a jCard date-and-or-time value. */
+function formatDate(date) {
+  if (!date) {
+    return null;
+  }
+  if (typeof date == "string") {
+    // UTCDateTime: keep the date part.
+    return date.slice(0, 10);
+  }
+  const pad = (n, l = 2) => String(n).padStart(l, "0");
+  if (!date.year) {
+    return date.month && date.day ? `--${pad(date.month)}-${pad(date.day)}` : null;
+  }
+  let value = pad(date.year, 4);
+  if (date.month) {
+    value += `-${pad(date.month)}`;
+    if (date.day) {
+      value += `-${pad(date.day)}`;
+    }
+  }
+  return value;
+}
+
+function parseDate(value) {
+  value = String(value).replace(/T.*$/, "");
+  let match = /^(\d{4})-?(\d{2})-?(\d{2})$/.exec(value);
+  if (match) {
+    return { "@type": "PartialDate", year: +match[1], month: +match[2], day: +match[3] };
+  }
+  match = /^--(\d{2})-?(\d{2})$/.exec(value);
+  if (match) {
+    return { "@type": "PartialDate", month: +match[1], day: +match[2] };
+  }
+  match = /^(\d{4})(?:-(\d{2}))?$/.exec(value);
+  if (match) {
+    const date = { "@type": "PartialDate", year: +match[1] };
+    if (match[2]) {
+      date.month = +match[2];
+    }
+    return date;
+  }
+  return null;
+}
+
+export const JmapJSContact = {
+  KNOWN_PROPERTIES,
+
+  /**
+   * Convert a JSContact Card to vCard 4.0 text.
+   *
+   * @param {object} card - JSContact Card (JMAP ContactCard).
+   * @param {object} [options]
+   * @param {Map<string,string>} [options.photos] - Data URLs for media
+   *   entries that only have a blobId, keyed by media id.
+   * @returns {{vCard: string, extra: object}} `extra` holds the properties
+   *   not represented in the vCard.
+   */
+  toVCard(card, { photos } = {}) {
+    const props = [["version", {}, "text", "4.0"]];
+    const add = (name, params, type, value) => {
+      if (value !== null && value !== undefined && value !== "") {
+        props.push([name, params, type, value]);
+      }
+    };
+
+    if (card.kind && card.kind != "individual") {
+      add("kind", {}, "text", card.kind);
+    }
+
+    // Name.
+    const name = card.name ?? {};
+    const n = ["", "", "", "", ""];
+    for (const component of name.components ?? []) {
+      const index = NAME_KINDS[component.kind];
+      if (index !== undefined) {
+        n[index] = n[index] ? `${n[index]} ${component.value}` : component.value;
+      }
+    }
+    if (n.some(Boolean)) {
+      add("n", {}, "text", n);
+    }
+    let fn = name.full;
+    if (!fn) {
+      fn = [n[3], n[1], n[2], n[0], n[4]].filter(Boolean).join(" ");
+    }
+    if (!fn) {
+      fn = Object.values(card.organizations ?? {})[0]?.name;
+    }
+    add("fn", {}, "text", fn || "");
+
+    for (const [, nick] of sortedEntries(card.nicknames)) {
+      add("nickname", {}, "text", nick.name);
+    }
+
+    for (const [, email] of sortedEntries(card.emails)) {
+      const params = {};
+      setTypes(params, contextsToType(email.contexts));
+      prefParam(params, email.pref);
+      add("email", params, "text", email.address);
+    }
+
+    for (const [, phone] of sortedEntries(card.phones)) {
+      const params = {};
+      const types = contextsToType(phone.contexts);
+      for (const feature of Object.keys(phone.features ?? {})) {
+        if (PHONE_FEATURES[feature]) {
+          types.push(PHONE_FEATURES[feature]);
+        }
+      }
+      setTypes(params, types);
+      prefParam(params, phone.pref);
+      const value = phone.number ?? "";
+      add("tel", params, /^[a-z]+:/i.test(value) ? "uri" : "text", value);
+    }
+
+    for (const [, address] of sortedEntries(card.addresses)) {
+      const adr = ["", "", "", "", "", "", ""];
+      const streetParts = [];
+      for (const component of address.components ?? []) {
+        if (component.kind == "separator") {
+          continue;
+        }
+        const index = ADR_KINDS[component.kind];
+        if (index === 2) {
+          streetParts.push(component.value);
+        } else if (index !== undefined && !adr[index]) {
+          adr[index] = component.value;
+        }
+      }
+      adr[2] = streetParts.join(" ");
+      if (!adr.some(Boolean) && address.full) {
+        adr[2] = address.full;
+      }
+      const params = {};
+      setTypes(params, contextsToType(address.contexts));
+      prefParam(params, address.pref);
+      if (address.full) {
+        params.label = address.full;
+      }
+      if (address.countryCode) {
+        params.cc = address.countryCode;
+      }
+      add("adr", params, "text", adr);
+    }
+
+    for (const [, org] of sortedEntries(card.organizations)) {
+      const value = [org.name ?? "", ...(org.units ?? []).map(u => u.name)];
+      add("org", {}, "text", value.length > 1 ? value : value[0]);
+    }
+
+    for (const [, title] of sortedEntries(card.titles)) {
+      add(title.kind == "role" ? "role" : "title", {}, "text", title.name);
+    }
+
+    for (const [, service] of sortedEntries(card.onlineServices)) {
+      const params = {};
+      if (service.service) {
+        params["x-service-type"] = service.service;
+      }
+      prefParam(params, service.pref);
+      if (service.uri) {
+        add("impp", params, "uri", service.uri);
+      } else if (service.user) {
+        add("x-socialprofile", params, "text", service.user);
+      }
+    }
+
+    for (const [, link] of sortedEntries(card.links)) {
+      const params = {};
+      setTypes(params, contextsToType(link.contexts));
+      prefParam(params, link.pref);
+      add("url", params, "uri", link.uri);
+    }
+
+    for (const [, anniversary] of sortedEntries(card.anniversaries)) {
+      const date = formatDate(anniversary.date);
+      if (!date) {
+        continue;
+      }
+      if (anniversary.kind == "birth") {
+        add("bday", {}, "date-and-or-time", date);
+      } else if (anniversary.kind == "wedding") {
+        add("anniversary", {}, "date-and-or-time", date);
+      }
+    }
+
+    const notes = sortedEntries(card.notes).map(([, note]) => note.note);
+    if (notes.length) {
+      add("note", {}, "text", notes.join("\n\n"));
+    }
+
+    for (const [id, media] of sortedEntries(card.media)) {
+      if (media.kind != "photo") {
+        continue;
+      }
+      const uri = media.uri ?? photos?.get(id);
+      if (uri) {
+        add("photo", {}, "uri", uri);
+        break;
+      }
+    }
+
+    for (const member of Object.keys(card.members ?? {})) {
+      add("member", {}, "uri", member);
+    }
+
+    add("uid", {}, "text", card.uid);
+
+    const vCard = ICAL.stringify(["vcard", props]);
+
+    const extra = {};
+    for (const [key, value] of Object.entries(card)) {
+      if (!KNOWN_PROPERTIES.has(key)) {
+        extra[key] = value;
+      }
+    }
+    // Keep non-photo media and photos we couldn't express.
+    const otherMedia = Object.fromEntries(
+      Object.entries(card.media ?? {}).filter(([, m]) => m.kind != "photo")
+    );
+    if (Object.keys(otherMedia).length) {
+      extra.media = otherMedia;
+    }
+    // Anniversaries without a vCard equivalent.
+    const otherAnniversaries = Object.fromEntries(
+      Object.entries(card.anniversaries ?? {}).filter(
+        ([, a]) => !["birth", "wedding"].includes(a.kind)
+      )
+    );
+    if (Object.keys(otherAnniversaries).length) {
+      extra.anniversaries = otherAnniversaries;
+    }
+    return { vCard, extra };
+  },
+
+  /**
+   * Convert vCard text to a JSContact Card. The result has no JMAP `id` and
+   * no `addressBookIds`; the caller adds those.
+   *
+   * @param {string} vCard
+   * @param {object} [extra] - Properties from {@link toVCard} to merge back.
+   * @returns {object}
+   */
+  fromVCard(vCard, extra = {}) {
+    const [, props] = ICAL.parse(vCard);
+    const card = { "@type": "Card", version: "1.0" };
+    const counters = {};
+    const nextId = prefix => {
+      counters[prefix] = (counters[prefix] ?? 0) + 1;
+      return `${prefix}${counters[prefix]}`;
+    };
+    const put = (key, prefix, value, params) => {
+      const pref = parseInt(params?.pref, 10);
+      if (Number.isInteger(pref) && pref >= 1 && pref <= 100) {
+        value.pref = pref;
+      }
+      card[key] ??= {};
+      card[key][nextId(prefix)] = value;
+    };
+    const asArray = value => [value].flat().map(v => v ?? "");
+
+    let fullName = null;
+    let orgIndex = 0;
+    for (const [rawName, params, , ...values] of props) {
+      const name = rawName.toLowerCase();
+      const value = values.length > 1 ? values : values[0];
+      switch (name) {
+        case "uid":
+          card.uid = String(value);
+          break;
+        case "kind":
+          card.kind = String(value).toLowerCase();
+          break;
+        case "fn":
+          fullName = String(value);
+          break;
+        case "n": {
+          const parts = asArray(value);
+          const components = [];
+          const push = (kind, v) => {
+            for (const piece of asArray(v)) {
+              if (piece) {
+                components.push({ kind, value: piece });
+              }
+            }
+          };
+          push("title", parts[3]);
+          push("given", parts[1]);
+          push("given2", parts[2]);
+          push("surname", parts[0]);
+          push("credential", parts[4]);
+          if (components.length) {
+            card.name = { components, isOrdered: true };
+          }
+          break;
+        }
+        case "nickname":
+          for (const nick of asArray(value)) {
+            if (nick) {
+              put("nicknames", "n", { name: nick }, params);
+            }
+          }
+          break;
+        case "email": {
+          const { contexts } = typeToContexts(params);
+          const email = { address: String(value) };
+          if (contexts) {
+            email.contexts = contexts;
+          }
+          put("emails", "e", email, params);
+          break;
+        }
+        case "tel": {
+          const { types, contexts } = typeToContexts(params);
+          const phone = { number: String(value) };
+          if (contexts) {
+            phone.contexts = contexts;
+          }
+          const features = {};
+          for (const [feature, type] of Object.entries(PHONE_FEATURES)) {
+            if (types.includes(type)) {
+              features[feature] = true;
+            }
+          }
+          if (Object.keys(features).length) {
+            phone.features = features;
+          }
+          put("phones", "p", phone, params);
+          break;
+        }
+        case "adr": {
+          const parts = asArray(value);
+          const kinds = [
+            "postOfficeBox",
+            "apartment",
+            "name",
+            "locality",
+            "region",
+            "postcode",
+            "country",
+          ];
+          const components = [];
+          kinds.forEach((kind, i) => {
+            const piece = asArray(parts[i]).filter(Boolean).join(" ");
+            if (piece) {
+              components.push({ kind, value: piece });
+            }
+          });
+          const { contexts } = typeToContexts(params);
+          const address = { components };
+          if (contexts) {
+            address.contexts = contexts;
+          }
+          if (params.label) {
+            address.full = String(params.label);
+          }
+          if (params.cc) {
+            address.countryCode = String(params.cc);
+          }
+          put("addresses", "a", address, params);
+          break;
+        }
+        case "org": {
+          const parts = asArray(value);
+          const org = { name: parts[0] };
+          if (parts.length > 1) {
+            org.units = parts.slice(1).filter(Boolean).map(u => ({ name: u }));
+          }
+          card.organizations ??= {};
+          card.organizations[`o${++orgIndex}`] = org;
+          break;
+        }
+        case "title":
+        case "role":
+          put("titles", "t", { kind: name, name: String(value) }, params);
+          break;
+        case "impp":
+        case "x-socialprofile": {
+          const service = {};
+          if (name == "impp") {
+            service.uri = String(value);
+          } else {
+            service.user = String(value);
+          }
+          if (params["x-service-type"]) {
+            service.service = String(params["x-service-type"]);
+          }
+          put("onlineServices", "s", service, params);
+          break;
+        }
+        case "url": {
+          const link = { uri: String(value) };
+          const { contexts } = typeToContexts(params);
+          if (contexts) {
+            link.contexts = contexts;
+          }
+          put("links", "l", link, params);
+          break;
+        }
+        case "bday":
+        case "anniversary": {
+          const date = parseDate(value);
+          if (date) {
+            put(
+              "anniversaries",
+              "k",
+              { kind: name == "bday" ? "birth" : "wedding", date },
+              params
+            );
+          }
+          break;
+        }
+        case "note":
+          if (value) {
+            put("notes", "n", { note: String(value) }, params);
+          }
+          break;
+        case "photo":
+          if (value) {
+            put("media", "m", { kind: "photo", uri: String(value) }, params);
+          }
+          break;
+        case "member":
+          card.members ??= {};
+          card.members[String(value)] = true;
+          break;
+      }
+    }
+    if (fullName) {
+      card.name ??= {};
+      card.name.full = fullName;
+    }
+
+    // Merge round-tripped properties. Map-valued ones are merged per key.
+    for (const [key, value] of Object.entries(extra ?? {})) {
+      if (
+        card[key] &&
+        typeof card[key] == "object" &&
+        value &&
+        typeof value == "object"
+      ) {
+        card[key] = { ...value, ...card[key] };
+      } else if (!(key in card)) {
+        card[key] = value;
+      }
+    }
+    return card;
+  },
+};
