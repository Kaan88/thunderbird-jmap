+var { MailServices } = ChromeUtils.importESModule(
+  "resource:///modules/MailServices.sys.mjs"
+);
+
+add_task(function test_jmap_account_registration() {
+  // Folder creation needs a profile-backed local path.
+  do_get_profile();
+
+  const server = MailServices.accounts.createIncomingServer(
+    "user",
+    "jmap.example.com",
+    "jmap"
+  );
+  Assert.equal(server.type, "jmap");
+  Assert.ok(
+    server instanceof Ci.IJmapIncomingServer,
+    "the incoming server implements IJmapIncomingServer"
+  );
+
+  server.jmapSessionUrl = "https://jmap.example.com/.well-known/jmap";
+  Assert.equal(
+    server.jmapSessionUrl,
+    "https://jmap.example.com/.well-known/jmap",
+    "the session URL is stored on the account"
+  );
+
+  const rootFolder = server.rootFolder;
+  Assert.ok(rootFolder, "the account has a root folder");
+  Assert.ok(
+    rootFolder instanceof Ci.IJmapFolder,
+    "the root folder uses the JMAP folder implementation"
+  );
+  Assert.equal(rootFolder.jmapId, "", "the root folder has no mailbox id");
+  Assert.equal(
+    rootFolder.incomingServerType,
+    "jmap",
+    "the folder reports the JMAP server type"
+  );
+
+  registerCleanupFunction(() => {
