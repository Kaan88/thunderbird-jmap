--- /dev/null
+++ b/mailnews/protocols/jmap/test/unit/test_jmap_offline_queue.js
@@ -0,0 +1,75 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+var { JmapOfflineQueue } = ChromeUtils.importESModule(
+  "resource:///modules/jmap/JmapOfflineQueue.sys.mjs"
+);
+
+add_setup(async function () {
+  const dir = PathUtils.join(PathUtils.tempDir, "jmap-offline-test");
+  await IOUtils.remove(dir, { recursive: true, ignoreAbsent: true });
+  JmapOfflineQueue._setDirectory(dir);
+  registerCleanupFunction(() => {
+    Services.io.offline = false;
+  });
+});
+
+add_task(async function test_should_queue() {
+  const error = new JmapNetworkError("down");
+  Services.io.offline = false;
+  Assert.ok(!JmapOfflineQueue.shouldQueue(error));
+  Services.io.offline = true;
+  Assert.ok(JmapOfflineQueue.shouldQueue(error));
+  Assert.ok(!JmapOfflineQueue.shouldQueue(new JmapError("other")));
+});
+
+add_task(async function test_enqueue_and_replay_on_online() {
+  Services.io.offline = true;
+  const replayed = [];
+  JmapOfflineQueue.registerExecutor("srvA", async op => replayed.push(op));
+  await JmapOfflineQueue.enqueue("srvA", {
+    kind: "setRead",
+    args: [["e1"], true],
+  });
+  await JmapOfflineQueue.enqueue("srvA", { kind: "destroy", args: [["e2"]] });
+  Assert.equal((await JmapOfflineQueue.pending("srvA")).length, 2);
+
+  // No replay while offline.
+  Assert.equal(await JmapOfflineQueue.replay("srvA"), 0);
+
+  // Going online fires network:offline-status-changed and replays.
+  Services.io.offline = false;
+  await TestUtils.waitForCondition(() => replayed.length == 2);
+  Assert.deepEqual(
+    replayed.map(op => op.kind),
+    ["setRead", "destroy"]
+  );
+  Assert.deepEqual(replayed[0].args, [["e1"], true]);
+  Assert.equal((await JmapOfflineQueue.pending("srvA")).length, 0);
+  JmapOfflineQueue.unregisterExecutor("srvA");
+});
+
+add_task(async function test_replay_stops_on_network_error() {
+  Services.io.offline = false;
+  let calls = 0;
+  JmapOfflineQueue.registerExecutor("srvB", async op => {
+    calls++;
+    if (op.kind == "bad") {
+      throw new JmapError("gone");
+    }
+    if (op.kind == "net") {
+      throw new JmapNetworkError("down");
+    }
+  });
+  await JmapOfflineQueue.enqueue("srvB", { kind: "bad", args: [] });
+  await JmapOfflineQueue.enqueue("srvB", { kind: "net", args: [] });
+  await JmapOfflineQueue.enqueue("srvB", { kind: "ok", args: [] });
+  Assert.equal(await JmapOfflineQueue.replay("srvB"), 1);
+  Assert.equal(calls, 2);
+  const left = await JmapOfflineQueue.pending("srvB");
+  Assert.deepEqual(
+    left.map(op => op.kind),
+    ["net", "ok"]
+  );
+  JmapOfflineQueue.unregisterExecutor("srvB");
+});
diff --git a/mailnews/protocols/jmap/test/unit/test_jmap_outgoing.js b/mailnews/protocols/jmap/test/unit/test_jmap_outgoing.js
new file mode 100644
index 00000000000..e2def5d73d0
--- /dev/null
+++ b/mailnews/protocols/jmap/test/unit/test_jmap_outgoing.js
@@ -0,0 +1,123 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+var { sendJmapMessage, matchIdentityId, JmapOutgoingServer, JmapSendError } =
+  ChromeUtils.importESModule(
+    "resource:///modules/jmap/JmapOutgoingServer.sys.mjs"
+  );
+
+const IDENTITIES = [
+  { id: "id1", email: "Other@example.com" },
+  { id: "id2", email: "User@Example.com" },
+];
+
+function sendHandler({ submissionFails = false } = {}) {
+  return (url, options) => {
+    if (url.includes("/upload/")) {
+      return { status: 201, headers: new Headers(), body: { blobId: "B1" } };
+    }
+    const { methodCalls } = JSON.parse(options.body);
+    return jmapResponse(
+      methodCalls.map(([name, args, callId]) => {
+        switch (name) {
+          case "Identity/get":
+            return [name, { accountId: "u1", list: IDENTITIES }, callId];
+          case "Mailbox/query":
+            return [name, { accountId: "u1", ids: ["sent1"] }, callId];
+          case "Email/import":
+            return [
+              name,
+              { accountId: "u1", created: { m: { id: "E1" } } },
+              callId,
+            ];
+          case "EmailSubmission/set":
+            return submissionFails
+              ? [name, { notCreated: { s: { type: "forbiddenFrom" } } }, callId]
+              : [name, { created: { s: { id: "S1" } } }, callId];
+          case "Email/set":
+            return [name, { destroyed: args.destroy }, callId];
+        }
+        throw new Error(`unexpected ${name}`);
+      })
+    );
+  };
+}
+
+function apiCalls(transport) {
+  return transport.requests
+    .filter(r => !r.url.includes("/upload/"))
+    .flatMap(r => JSON.parse(r.body).methodCalls);
+}
+
+add_task(function test_match_identity() {
+  Assert.equal(matchIdentityId(IDENTITIES, "user@example.COM"), "id2");
+  Assert.equal(
+    matchIdentityId([{ id: "w", email: "*@example.com" }], "x@example.com"),
+    "w"
+  );
+  Assert.equal(matchIdentityId(IDENTITIES, "nobody@else.org"), null);
+});
+
+add_task(async function test_send() {
+  const { client, transport } = await makeClient(sendHandler());
+  const result = await sendJmapMessage(client, {
+    bytes: new TextEncoder().encode("Subject: hi\r\n\r\nbody\r\n"),
+    fromEmail: "user@example.com",
+    recipients: ["a@example.org", "bcc@example.org"],
+  });
+  Assert.deepEqual(result, { emailId: "E1", submissionId: "S1" });
+
+  const calls = apiCalls(transport);
+  const importCall = calls.find(c => c[0] == "Email/import");
+  Assert.deepEqual(importCall[1].emails.m, {
+    blobId: "B1",
+    mailboxIds: { sent1: true },
+    keywords: { $seen: true },
+  });
+  const submit = calls.find(c => c[0] == "EmailSubmission/set")[1];
+  Assert.equal(submit.create.s.identityId, "id2");
+  Assert.equal(submit.create.s.emailId, "E1");
+  Assert.deepEqual(submit.create.s.envelope, {
+    mailFrom: { email: "user@example.com" },
+    rcptTo: [{ email: "a@example.org" }, { email: "bcc@example.org" }],
+  });
+  Assert.deepEqual(submit.onSuccessUpdateEmail, {
+    "#s": { "keywords/$draft": null },
+  });
+});
+
+add_task(async function test_send_explicit_mailbox_and_failure() {
+  const { client, transport } = await makeClient(
+    sendHandler({ submissionFails: true })
+  );
+  await Assert.rejects(
+    sendJmapMessage(client, {
+      bytes: "x",
+      fromEmail: "user@example.com",
+      recipients: ["a@example.org"],
+      mailboxId: "fcc1",
+    }),
+    e => e instanceof JmapSendError && /forbiddenFrom/.test(e.message)
+  );
+  const calls = apiCalls(transport);
+  Assert.ok(calls.find(c => c[0] == "Email/import")[1].emails.m.mailboxIds.fcc1);
+  // The unsent copy is cleaned up.
+  Assert.deepEqual(calls.find(c => c[0] == "Email/set")[1].destroy, ["E1"]);
+});
+
+add_task(function test_outgoing_server_prefs() {
+  const server = new JmapOutgoingServer();
+  server.initialize("jmapsmtp1");
+  Assert.equal(server.type, "jmap");
+  Assert.equal(server.key, "jmapsmtp1");
+  server.incomingServerKey = "server9";
+  Assert.equal(
+    Services.prefs.getStringPref(
+      "mail.smtpserver.jmapsmtp1.jmap_incoming_server"
+    ),
+    "server9"
+  );
+  Assert.ok(server.wrappedJSObject.handlesFcc);
+  server.clearAllValues();
+  Assert.equal(server.incomingServerKey, "");
+});
