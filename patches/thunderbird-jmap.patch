+++ b/calendar/providers/jmap/test/test_jmapJSCalendar.js
@@ -0,0 +1,298 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Tests for the JSCalendar <-> calIItemBase mapper of the JMAP provider.
+ */
+
+const {
+  JMAP_ID_PROPERTY,
+  applyPatch,
+  fromJSCalendar,
+  recurrenceRuleToRRule,
+  rruleToRecurrenceRule,
+  toJSCalendar,
+  toJSCalendarPatch,
+} = ChromeUtils.importESModule("resource:///modules/JmapJSCalendar.sys.mjs");
+
+const EVENT = {
+  "@type": "Event",
+  id: "jmap-1",
