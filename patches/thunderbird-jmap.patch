+add_task(function test_fromJSCalendar_recurrence() {
+  const item = fromJSCalendar(EVENT);
+  const info = item.recurrenceInfo;
+  Assert.ok(info);
+  const ritems = info.getRecurrenceItems();
+  const rrule = ritems.find(r => hasInterface(r, Ci.calIRecurrenceRule));
+  Assert.equal(rrule.type, "WEEKLY");
+  Assert.equal(rrule.count, 10);
+  Assert.ok(ritems.some(r => hasInterface(r, Ci.calIRecurrenceDate) && r.isNegative));
+
+  const exceptionIds = info.getExceptionIds();
+  Assert.equal(exceptionIds.length, 1);
+  const exception = info.getExceptionFor(exceptionIds[0]);
+  Assert.equal(exception.title, "Team meeting (moved)");
+  Assert.equal(exception.startDate.hour, 14);
+  Assert.equal(exception.endDate.hour, 15);
+  Assert.equal(exception.endDate.minute, 30);
+});
