diff --git a/mailnews/protocols/jmap/test/unit/test_jmap_client.js b/mailnews/protocols/jmap/test/unit/test_jmap_client.js
new file mode 100644
index 00000000000..92894c6df70
--- /dev/null
+++ b/mailnews/protocols/jmap/test/unit/test_jmap_client.js
@@ -0,0 +1,328 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+add_task(async function test_request_envelope() {
+  const { client, transport } = await makeClient(() =>
+    jmapResponse([
+      [
+        "Mailbox/get",
+        { accountId: "u1", state: "s1", list: [], notFound: [] },
+        "c0",
+      ],
+    ])
+  );
+
+  const result = await client.request([
+    { name: "Mailbox/get", args: { accountId: "u1" } },
+  ]);
+
+  const request = transport.requests[0];
+  Assert.equal(request.url, "https://jmap.example.com/api");
+  Assert.equal(request.method, "POST");
+  Assert.equal(request.retry, false, "method calls are never retried blindly");
+  Assert.equal(request.headers["Content-Type"], "application/json");
+
+  const payload = requestBody(transport);
+  Assert.deepEqual(payload.using, [JmapCapability.Core, JmapCapability.Mail]);
+  Assert.deepEqual(payload.methodCalls, [
+    ["Mailbox/get", { accountId: "u1" }, "c0"],
+  ]);
+  Assert.ok(!("createdIds" in payload), "createdIds is omitted when empty");
+
+  Assert.equal(result.responses.length, 1);
+  Assert.deepEqual(result.responses[0].args, {
+    accountId: "u1",
+    state: "s1",
+    list: [],
+    notFound: [],
+  });
+  Assert.deepEqual(result.errors, []);
+  Assert.deepEqual(result.createdIds, {});
+});
+
+add_task(async function test_call_returns_response() {
+  const { client } = await makeClient(() =>
+    jmapResponse([["Thread/get", { list: [{ id: "t1" }] }, "c0"]])
+  );
+
+  const response = await client.call("Thread/get", {
+    accountId: "u1",
+    ids: ["t1"],
+  });
+  Assert.equal(response.method, "Thread/get");
+  Assert.deepEqual(response.args, { list: [{ id: "t1" }] });
+});
+
+add_task(async function test_created_ids_are_merged() {
+  const { client, transport } = await makeClient(() =>
+    jmapResponse([["Mailbox/set", { created: {} }, "c0"]], {
+      createdIds: { newBox: "mb-2" },
+    })
+  );
+
+  const result = await client.request(
+    [
+      {
+        name: "Mailbox/set",
+        args: { accountId: "u1", create: { newBox: { name: "New" } } },
+      },
+    ],
+    { createdIds: { prior: "existing-id" } }
+  );
+
+  Assert.deepEqual(requestBody(transport).createdIds, {
+    prior: "existing-id",
+  });
+  Assert.deepEqual(result.createdIds, {
+    prior: "existing-id",
+    newBox: "mb-2",
+  });
+});
+
+add_task(async function test_method_error_throws() {
+  const { client } = await makeClient(() =>
+    jmapResponse([
+      [
+        "error",
+        { type: JmapMethodErrorType.Forbidden, detail: "not allowed" },
+        "c0",
+      ],
+    ])
+  );
+
+  const error = await expectRejection(
+    client.call("Mailbox/get", { accountId: "u1" }),
+    JmapMethodError,
+    "a method error is surfaced"
+  );
+  Assert.equal(error.type, JmapMethodErrorType.Forbidden);
+  Assert.equal(error.method, "Mailbox/get");
+  Assert.equal(error.callId, "c0");
+  Assert.equal(error.detail, "not allowed");
+  Assert.ok(error.is(JmapMethodErrorType.Forbidden));
+  Assert.ok(
+    isJmapMethodError(error, JmapMethodErrorType.Forbidden),
+    "the helper recognises method errors"
+  );
+});
+
+add_task(async function test_method_error_can_be_allowed() {
+  const { client } = await makeClient(() =>
+    jmapResponse([
+      ["Email/query", { ids: ["e1"] }, "c0"],
+      ["error", { type: JmapMethodErrorType.UnknownMethod }, "c1"],
+    ])
+  );
+
+  const result = await client.request(
+    [
+      { name: "Email/query", args: { accountId: "u1" } },
+      { name: "Bogus/method", args: {}, callId: "c1" },
+    ],
+    { allowErrors: true }
+  );
+
+  Assert.equal(result.responses.length, 2);
+  Assert.equal(result.errors.length, 1);
+  Assert.equal(result.errors[0].type, JmapMethodErrorType.UnknownMethod);
+  Assert.equal(result.errors[0].callId, "c1");
+});
+
+add_task(async function test_missing_capability_is_rejected() {
+  const session = makeSession({
+    capabilities: { [JmapCapability.Core]: coreCapability() },
+  });
+  const { client, transport } = await makeClient(
+    () => jmapResponse([]),
+    session
+  );
+
+  const error = await expectRejection(
+    client.call("Email/get", { accountId: "u1", ids: [] }),
+    JmapCapabilityError,
+    "using a capability that is not advertised fails"
+  );
+  Assert.equal(error.capability, JmapCapability.Mail);
+  Assert.equal(transport.requests.length, 0, "nothing is sent to the server");
+});
+
+add_task(async function test_max_calls_in_request() {
+  const session = makeSession();
+  session.capabilities[JmapCapability.Core] = coreCapability({
+    maxCallsInRequest: 1,
+  });
+  const { client } = await makeClient(() => jmapResponse([]), session);
+
+  await expectRejection(
+    client.request([
+      { name: "Mailbox/get", args: { accountId: "u1" } },
+      { name: "Mailbox/get", args: { accountId: "u1" } },
+    ]),
+    JmapError,
+    "the server call limit is enforced"
+  );
+});
+
+add_task(async function test_max_size_request() {
+  const session = makeSession();
+  session.capabilities[JmapCapability.Core] = coreCapability({
+    maxSizeRequest: 10,
+  });
+  const { client } = await makeClient(() => jmapResponse([]), session);
+
+  const error = await expectRejection(
+    client.request([{ name: "Mailbox/get", args: { accountId: "u1" } }]),
+    JmapRequestError,
+    "the request size limit is enforced"
+  );
+  Assert.equal(error.type, JmapRequestErrorType.Limit);
+  Assert.equal(error.limit, 10);
+});
+
+add_task(async function test_duplicate_call_id() {
+  const { client } = await makeClient(() => jmapResponse([]));
+
+  await expectRejection(
+    client.request([
+      { name: "Mailbox/get", args: { accountId: "u1" }, callId: "same" },
+      { name: "Mailbox/get", args: { accountId: "u1" }, callId: "same" },
+    ]),
+    JmapError,
+    "duplicate call ids are rejected"
+  );
+});
+
+add_task(async function test_malformed_responses() {
+  const missingResponses = await makeClient(() => ({
+    status: 200,
+    headers: new Headers(),
+    body: { nope: true },
+  }));
+  await expectRejection(
+    missingResponses.client.call("Mailbox/get", { accountId: "u1" }),
+    JmapRequestError,
+    "a response without methodResponses is rejected"
+  );
+
+  const malformedEntry = await makeClient(() =>
+    jmapResponse([["Mailbox/get", {}, "c0", "extra"]])
+  );
+  await expectRejection(
+    malformedEntry.client.call("Mailbox/get", { accountId: "u1" }),
+    JmapRequestError,
+    "a malformed method response is rejected"
+  );
+});
+
+add_task(async function test_upload() {
+  const { client, transport } = await makeClient(() => ({
+    status: 200,
+    headers: new Headers({ "content-type": "application/json" }),
+    body: { accountId: "u1", blobId: "blob-1", type: "text/plain", size: 5 },
+  }));
+
+  const result = await client.upload("hello", "text/plain");
+
+  const request = transport.requests[0];
+  Assert.equal(request.url, "https://jmap.example.com/upload/u1/");
+  Assert.equal(request.method, "POST");
+  Assert.equal(request.headers["Content-Type"], "text/plain");
+  Assert.equal(request.body, "hello");
+  Assert.deepEqual(result, {
+    accountId: "u1",
+    blobId: "blob-1",
+    type: "text/plain",
+    size: 5,
+  });
+});
+
+add_task(async function test_upload_size_limit() {
+  const session = makeSession();
+  session.capabilities[JmapCapability.Core] = coreCapability({
+    maxSizeUpload: 2,
+  });
+  const { client } = await makeClient(() => jmapResponse([]), session);
+
+  const error = await expectRejection(
+    client.upload("hello", "text/plain"),
+    JmapRequestError,
+    "the upload size limit is enforced"
+  );
+  Assert.equal(error.type, JmapRequestErrorType.Limit);
+  Assert.equal(error.limit, 2);
+});
+
+add_task(async function test_download() {
+  const blob = new Blob(["hi"], { type: "text/plain" });
+  const { client, transport } = await makeClient(() => ({
+    status: 200,
+    headers: new Headers({ "content-type": "text/plain" }),
+    body: blob,
+  }));
+
+  const result = await client.download("b/1", {
+    type: "text/plain",
+    name: "hello.txt",
+  });
+
+  Assert.equal(
+    transport.requests[0].url,
+    "https://jmap.example.com/download/u1/b%2F1/hello.txt?accept=text%2Fplain"
+  );
+  Assert.equal(transport.requests[0].responseType, "blob");
+  Assert.equal(result.blob, blob);
+  Assert.equal(result.contentType, "text/plain");
+});
+
+add_task(async function test_concurrency_limit() {
+  const session = makeSession();
+  session.capabilities[JmapCapability.Core] = coreCapability({
+    maxConcurrentRequests: 1,
+  });
+
+  const resolvers = [];
+  let active = 0;
+  let maxActive = 0;
+  const { client } = await makeClient(() => {
+    active++;
+    maxActive = Math.max(maxActive, active);
+    return new Promise(resolve => {
+      resolvers.push(() => {
+        active--;
+        resolve(jmapResponse([["Mailbox/get", { list: [] }, "c0"]]));
+      });
+    });
+  }, session);
+
+  const first = client.request([
+    { name: "Mailbox/get", args: { accountId: "u1" } },
+  ]);
+  const second = client.request([
+    { name: "Mailbox/get", args: { accountId: "u1" } },
+  ]);
+
+  await TestUtils.waitForCondition(
+    () => resolvers.length == 1,
+    "the first request should start"
+  );
+  Assert.equal(maxActive, 1, "only one request is in flight");
+
+  resolvers.shift()();
+  await TestUtils.waitForCondition(
+    () => resolvers.length == 1,
+    "the second request should start after the first finishes"
+  );
+  Assert.equal(maxActive, 1, "the concurrency limit is respected");
+
+  resolvers.shift()();
+  await Promise.all([first, second]);
+  Assert.equal(maxActive, 1);
+});
+
+add_task(function test_byte_length() {
+  Assert.equal(byteLength("abc"), 3);
+  Assert.equal(byteLength(new Uint8Array([1, 2, 3, 4])), 4);
+  Assert.equal(byteLength(new ArrayBuffer(7)), 7);
+  Assert.equal(byteLength(new Blob(["hello"])), 5);
+});
