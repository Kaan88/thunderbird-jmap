diff --git a/mailnews/protocols/jmap/test/unit/test_jmap_sync.js b/mailnews/protocols/jmap/test/unit/test_jmap_sync.js
new file mode 100644
index 00000000000..bcbe59c78d7
--- /dev/null
+++ b/mailnews/protocols/jmap/test/unit/test_jmap_sync.js
@@ -0,0 +1,465 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * In-memory `JmapSyncStore` used to test the sync engine without a message
+ * database.
+ */
+class FakeStore {
+  constructor() {
+    this.folders = new Map();
+    this.rows = [];
+    this.state = null;
+    this.flushes = 0;
+  }
+
+  async prepare(mailboxes) {
+    for (const mailbox of mailboxes) {
+      this.folders.set(mailbox.id, { id: mailbox.id });
+    }
+  }
+
+  foldersForMailbox(mailboxId) {
+    return this.folders.has(mailboxId)
+      ? [this.folders.get(mailboxId)]
+      : [];
+  }
+
+  headersForEmail(emailId) {
+    return this.rows
+      .filter(row => row.message.id === emailId)
+      .map(row => ({ folder: row.folder, header: row }));
+  }
+
+  listHeaders(folder) {
+    return this.rows
+      .filter(row => row.folder.id === folder.id)
+      .map(row => ({ jmapId: row.message.id, header: row }));
+  }
+
+  create(folder, message, { isNew = false } = {}) {
+    this.rows.push({
+      folder,
+      isNew,
+      message: {
+        ...message,
+        flags:
+          message.flags | (isNew ? Ci.nsMsgMessageFlags.New : 0),
+      },
+    });
+  }
+
+  update(folder, header, message) {
+    header.isNew = false;
+    header.message = { ...message };
+  }
+
+  remove(folder, header) {
+    this.rows = this.rows.filter(row => row !== header);
+  }
+
+  async getState() {
+    return this.state;
+  }
+
+  async setState(state) {
+    this.state = state;
+  }
+
+  async flush() {
+    this.flushes++;
+  }
+}
+
+/**
+ * Build a JMAP `Email` object.
+ *
+ * @param {string} id
+ * @param {object} [options]
+ * @returns {object}
+ */
+function makeEmail(id, options = {}) {
+  const {
+    mailbox = "inbox",
+    mailboxes = null,
+    keywords = {},
+    subject = `Subject ${id}`,
+    receivedAt = "2026-01-02T03:04:05Z",
+  } = options;
+
+  const mailboxIds = mailboxes
+    ? Object.fromEntries(mailboxes.map(name => [name, true]))
+    : { [mailbox]: true };
+
+  return {
+    id,
+    threadId: `thread-${id}`,
+    mailboxIds,
+    keywords,
+    from: [{ name: "Alice", email: "alice@example.com" }],
+    to: [{ name: "", email: "bob@example.com" }],
+    cc: [],
+    bcc: [],
+    subject,
+    receivedAt,
+    size: 100,
+    preview: `Preview ${id}`,
+    hasAttachment: false,
+    messageId: [`<${id}@example.com>`],
+    references: [],
+  };
+}
+
+/**
+ * Build a fake `JmapMailClient`.
+ *
+ * @param {object} options
+ * @returns {object}
+ */
+function makeFakeMail({ mailboxes, emails, changes = null, pages = null }) {
+  const byId = new Map(emails.map(email => [email.id, email]));
+  const calls = { query: [], get: [], changes: [] };
+
+  return {
+    calls,
+    client: {
+      capabilities: {
+        "urn:ietf:params:jmap:core": { maxObjectsInGet: 2 },
+      },
+    },
+
+    async getMailboxes() {
+      return { list: mailboxes, state: "mailboxes-state" };
+    },
+
+    async queryEmails({ filter, position = 0, limit = 50 }) {
+      calls.query.push({ filter, position, limit });
+      const ids = [...byId.values()]
+        .filter(email => email.mailboxIds?.[filter.inMailbox])
+        .map(email => email.id)
+        .sort();
+      return {
+        ids: ids.slice(position, position + limit),
+        total: ids.length,
+        position,
+        queryState: "query-state",
+      };
+    },
+
+    async getEmails({ ids }) {
+      calls.get.push(ids);
+      if (!ids.length) {
+        return { list: [], state: "email-state" };
+      }
+      return {
+        list: ids.map(id => byId.get(id)).filter(Boolean),
+        state: "email-state",
+      };
+    },
+
+    async getEmailChanges({ sinceState }) {
+      calls.changes.push(sinceState);
+      if (pages) {
+        return pages.get(sinceState);
+      }
+      if (changes) {
+        return changes;
+      }
+      throw new Error("Unexpected Email/changes call");
+    },
+  };
+}
+
+add_task(async function test_full_sync_creates_headers() {
+  const mail = makeFakeMail({
+    mailboxes: [{ id: "inbox", name: "Inbox", role: "inbox" }],
+    emails: [makeEmail("e1"), makeEmail("e2"), makeEmail("e3")],
+  });
+  const store = new FakeStore();
+  const engine = new JmapSyncEngine({ mail, store, batchSize: 2 });
+
+  const stats = await engine.sync();
+
+  Assert.equal(stats.mode, "full");
+  Assert.equal(stats.created, 3);
+  Assert.equal(stats.deleted, 0);
+  Assert.equal(store.rows.length, 3);
+  Assert.equal(store.state, "email-state");
+  Assert.equal(store.flushes, 1);
+  Assert.equal(
+    mail.calls.query.filter(call => call.position === 2).length,
+    1,
+    "the query is paged when there are more ids than the batch size"
+  );
+});
+
+add_task(async function test_full_sync_shares_email_between_mailboxes() {
+  const shared = makeEmail("shared", { mailboxes: ["inbox", "archive"] });
+  const mail = makeFakeMail({
+    mailboxes: [
+      { id: "inbox", name: "Inbox", role: "inbox" },
+      { id: "archive", name: "Archive", role: "archive" },
+    ],
+    emails: [shared],
+  });
+  const store = new FakeStore();
+  const engine = new JmapSyncEngine({ mail, store });
+
+  await engine.sync();
+
+  Assert.equal(store.rows.length, 2, "one header per mailbox membership");
+  Assert.ok(
+    store.rows.some(row => row.folder.id === "inbox"),
+    "the inbox copy exists"
+  );
+  Assert.ok(
+    store.rows.some(row => row.folder.id === "archive"),
+    "the archive copy exists"
+  );
+});
+
+add_task(async function test_full_sync_removes_stale_headers() {
+  const mail = makeFakeMail({
+    mailboxes: [{ id: "inbox", name: "Inbox", role: "inbox" }],
+    emails: [makeEmail("keep")],
+  });
+  const store = new FakeStore();
+
+  // A header which no longer exists on the server.
+  store.rows.push({
+    folder: { id: "inbox" },
+    message: { id: "gone" },
+    isNew: false,
+  });
+
+  const engine = new JmapSyncEngine({ mail, store });
+  const stats = await engine.sync();
+
+  Assert.equal(stats.deleted, 1);
+  Assert.deepEqual(
+    store.rows.map(row => row.message.id),
+    ["keep"]
+  );
+});
+
+add_task(async function test_full_sync_does_not_mark_messages_new() {
+  const mail = makeFakeMail({
+    mailboxes: [{ id: "inbox", name: "Inbox", role: "inbox" }],
+    emails: [makeEmail("unread", { keywords: {} })],
+  });
+  const store = new FakeStore();
+
+  await new JmapSyncEngine({ mail, store }).sync();
+
+  Assert.ok(
+    !(store.rows[0].message.flags & Ci.nsMsgMessageFlags.New),
+    "a full sync must not flag every unread message as new"
+  );
+});
+
+add_task(async function test_incremental_sync_applies_changes() {
+  const archive = { id: "archive", name: "Archive", role: "archive" };
+  const inbox = { id: "inbox", name: "Inbox", role: "inbox" };
+  const mail = makeFakeMail({
+    mailboxes: [inbox, archive],
+    emails: [
+      makeEmail("moved", {
+        mailbox: "archive",
+        keywords: { $seen: true },
+        subject: "Moved",
+      }),
+      makeEmail("new", { mailbox: "inbox", keywords: {} }),
+    ],
+    changes: {
+      created: ["new"],
+      updated: ["moved"],
+      destroyed: ["gone"],
+      newState: "state-2",
+      hasMoreChanges: false,
+    },
+  });
+  const store = new FakeStore();
+  store.state = "state-1";
+  store.rows.push(
+    {
+      folder: { id: "inbox" },
+      message: { id: "moved" },
+      isNew: false,
+    },
+    {
+      folder: { id: "inbox" },
+      message: { id: "gone" },
+      isNew: false,
+    }
+  );
+
+  const stats = await new JmapSyncEngine({ mail, store }).sync();
+
+  Assert.equal(stats.mode, "incremental");
+  Assert.ok(
+    store.rows.some(
+      row => row.message.id === "moved" && row.folder.id === "archive"
+    ),
+    "the updated message is created in its new mailbox"
+  );
+  Assert.ok(
+    !store.rows.some(
+      row => row.message.id === "moved" && row.folder.id === "inbox"
+    ),
+    "the moved message is removed from the old mailbox"
+  );
+  Assert.ok(
+    !store.rows.some(row => row.message.id === "gone"),
+    "the destroyed message is removed"
+  );
+
+  const added = store.rows.find(row => row.message.id === "new");
+  Assert.ok(added.message.flags & Ci.nsMsgMessageFlags.New);
+  Assert.equal(store.state, "state-2");
+});
+
+add_task(async function test_incremental_sync_pages_changes() {
+  const mail = makeFakeMail({
+    mailboxes: [{ id: "inbox", name: "Inbox", role: "inbox" }],
+    emails: [makeEmail("e1"), makeEmail("e2")],
+    pages: new Map([
+      [
+        "state-1",
+        {
+          created: ["e1"],
+          updated: [],
+          destroyed: [],
+          newState: "state-2",
+          hasMoreChanges: true,
+        },
+      ],
+      [
+        "state-2",
+        {
+          created: ["e2"],
+          updated: [],
+          destroyed: [],
+          newState: "state-3",
+          hasMoreChanges: false,
+        },
+      ],
+    ]),
+  });
+  const store = new FakeStore();
+  store.state = "state-1";
+
+  const stats = await new JmapSyncEngine({ mail, store }).sync();
+
+  Assert.deepEqual(mail.calls.changes, ["state-1", "state-2"]);
+  Assert.equal(stats.created, 2);
+  Assert.equal(store.state, "state-3");
+});
+
+add_task(async function test_cannot_calculate_changes_falls_back() {
+  const error = new JmapRequestError("Cannot calculate changes", {
+    type: JmapRequestErrorType.CannotCalculateChanges,
+  });
+  const mail = makeFakeMail({
+    mailboxes: [{ id: "inbox", name: "Inbox", role: "inbox" }],
+    emails: [makeEmail("e1")],
+  });
+  mail.getEmailChanges = async () => {
+    throw error;
+  };
+
+  const store = new FakeStore();
+  store.state = "stale-state";
+  const engine = new JmapSyncEngine({ mail, store });
+
+  Assert.ok(isCannotCalculateChanges(error));
+
+  const stats = await engine.sync();
+
+  Assert.equal(stats.mode, "full");
+  Assert.equal(store.rows.length, 1);
+  Assert.equal(store.state, "email-state");
+});
+
+add_task(async function test_method_level_cannot_calculate_changes() {
+  const error = new JmapMethodError("Cannot calculate changes", {
+    type: JmapMethodErrorType.CannotCalculateChanges,
+  });
+  Assert.ok(isCannotCalculateChanges(error));
+  Assert.ok(!isCannotCalculateChanges(new Error("other")));
+});
+
+add_task(async function test_unknown_mailbox_is_skipped() {
+  const mail = makeFakeMail({
+    mailboxes: [{ id: "inbox", name: "Inbox", role: "inbox" }],
+    emails: [],
+  });
+  const store = new FakeStore();
+
+  const stats = await new JmapSyncEngine({ mail, store }).sync();
+
+  Assert.equal(stats.created, 0);
+  Assert.equal(store.state, "email-state");
+});
+
+add_task(async function test_engine_with_real_mail_client() {
+  const { mail } = await makeMailClient((url, options) => {
+    const body = JSON.parse(options.body);
+    const responses = body.methodCalls.map(([name, callArgs, callId]) => {
+      let args;
+      switch (name) {
+        case "Mailbox/get":
+          args = {
+            accountId: "u1",
+            state: "mailbox-state",
+            list: [{ id: "inbox", name: "Inbox", role: "inbox" }],
+            notFound: [],
+          };
+          break;
+        case "Email/query":
+          args = {
+            accountId: "u1",
+            queryState: "query-state",
+            canCalculateChanges: false,
+            position: 0,
+            total: 1,
+            ids: ["e1"],
+          };
+          break;
+        case "Email/get":
+          args = {
+            accountId: "u1",
+            state: "email-state",
+            list: (callArgs.ids ?? []).map(id => ({
+              id,
+              threadId: "t1",
+              mailboxIds: { inbox: true },
+              keywords: { $seen: true },
+              subject: "Hello",
+              from: [{ name: "Alice", email: "alice@example.com" }],
+              to: [],
+              size: 5,
+              receivedAt: "2026-01-02T03:04:05Z",
+              messageId: [`<${id}@example.com>`],
+            })),
+            notFound: [],
+          };
+          break;
+        default:
+          throw new Error(`Unexpected JMAP method ${name}`);
+      }
+      return [name, args, callId];
+    });
+    return jmapResponse(responses);
+  });
+
+  const store = new FakeStore();
+  const stats = await new JmapSyncEngine({ mail, store }).sync();
+
+  Assert.equal(stats.created, 1);
+  const row = store.rows[0];
+  Assert.equal(row.message.subject, "Hello");
+  Assert.equal(row.message.author, "Alice <alice@example.com>");
+  Assert.ok(row.message.flags & Ci.nsMsgMessageFlags.Read);
+  Assert.equal(store.state, "email-state");
+});
diff --git a/mailnews/protocols/jmap/test/unit/test_jmap_transport.js b/mailnews/protocols/jmap/test/unit/test_jmap_transport.js
new file mode 100644
index 00000000000..dfc902f4c92
--- /dev/null
+++ b/mailnews/protocols/jmap/test/unit/test_jmap_transport.js
@@ -0,0 +1,294 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * @param {*} body
+ * @param {object} [options]
+ * @param {number} [options.status]
+ * @param {object} [options.headers]
+ * @returns {Response}
+ */
+function jsonResponse(body, { status = 200, headers = {} } = {}) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "content-type": "application/json", ...headers },
+  });
+}
+
+add_task(async function test_request_success() {
+  let captured;
+  const fetchImpl = (url, init) => {
+    captured = { url, ...init };
+    return Promise.resolve(jsonResponse({ ok: true }));
+  };
+  const transport = new JmapTransport({
+    fetchImpl,
+    getAuthHeaders: async () => ({ Authorization: "Bearer token" }),
+  });
+
+  const result = await transport.request("https://example.com/api", {
+    headers: { Accept: "application/json" },
+  });
+
+  Assert.equal(result.status, 200);
+  Assert.deepEqual(result.body, { ok: true });
+  Assert.equal(captured.url, "https://example.com/api");
+  Assert.equal(captured.method, "GET");
+  Assert.equal(captured.headers.Authorization, "Bearer token");
+  Assert.equal(captured.headers.Accept, "application/json");
+  Assert.equal(captured.credentials, "omit");
+});
+
+add_task(async function test_json_body_encoding() {
+  let captured;
+  const transport = new JmapTransport({
+    fetchImpl: (url, init) => {
+      captured = init;
+      return Promise.resolve(jsonResponse({ ok: true }));
+    },
+  });
+
+  await transport.request("https://example.com/api", {
+    method: "POST",
+    body: { a: 1 },
+  });
+
+  Assert.equal(captured.body, '{"a":1}');
+  Assert.equal(captured.headers["Content-Type"], "application/json");
+});
+
+add_task(async function test_binary_body_is_passed_through() {
+  let captured;
+  const transport = new JmapTransport({
+    fetchImpl: (url, init) => {
+      captured = init;
+      return Promise.resolve(jsonResponse({ ok: true }));
+    },
+  });
+
+  const blob = new Blob(["hello"], { type: "text/plain" });
+  await transport.request("https://example.com/upload", {
+    method: "POST",
+    headers: { "Content-Type": "text/plain" },
+    body: blob,
+  });
+
+  Assert.equal(captured.body, blob);
+  Assert.equal(captured.headers["Content-Type"], "text/plain");
+});
+
+add_task(async function test_auth_error() {
+  const transport = new JmapTransport({
+    fetchImpl: () =>
+      Promise.resolve(
+        jsonResponse(
+          { type: "urn:example:auth", detail: "bad credentials" },
+          { status: 401 }
+        )
+      ),
+  });
+
+  const error = await expectRejection(
+    transport.request("https://example.com/api"),
+    JmapAuthError,
+    "401 responses become auth errors"
+  );
+  Assert.equal(error.status, 401);
+  Assert.equal(error.detail, "bad credentials");
+  Assert.equal(error.type, "urn:example:auth");
+  Assert.ok(!error.isRetryable);
+});
+
+add_task(async function test_rate_limit_is_retried() {
+  let calls = 0;
+  const transport = new JmapTransport({
+    fetchImpl: () => {
+      calls++;
+      if (calls == 1) {
+        return Promise.resolve(
+          jsonResponse({}, { status: 429, headers: { "retry-after": "1" } })
+        );
+      }
+      return Promise.resolve(jsonResponse({ ok: true }));
+    },
+    retryDelay: error => {
+      Assert.ok(error instanceof JmapRateLimitError);
+      Assert.equal(error.retryAfter, 1000);
+      return 0;
+    },
+  });
+
+  const result = await transport.request("https://example.com/api");
+  Assert.deepEqual(result.body, { ok: true });
+  Assert.equal(calls, 2);
+});
+
+add_task(async function test_post_is_not_retried_by_default() {
+  let calls = 0;
+  const transport = new JmapTransport({
+    fetchImpl: () => {
+      calls++;
+      return Promise.resolve(new Response("", { status: 503 }));
+    },
+    retryDelay: () => 0,
+  });
+
+  const error = await expectRejection(
+    transport.request("https://example.com/api", {
+      method: "POST",
+      body: "{}",
+    }),
+    JmapHttpError,
+    "a failed POST is not retried"
+  );
+  Assert.equal(error.status, 503);
+  Assert.equal(calls, 1);
+});
+
+add_task(async function test_post_can_be_retried_explicitly() {
+  let calls = 0;
+  const transport = new JmapTransport({
+    fetchImpl: () => {
+      calls++;
+      if (calls == 1) {
+        return Promise.resolve(new Response("", { status: 503 }));
+      }
+      return Promise.resolve(jsonResponse({ ok: true }));
+    },
+    maxRetries: 1,
+    retryDelay: () => 0,
+  });
+
+  const result = await transport.request("https://example.com/api", {
+    method: "POST",
+    body: "{}",
+    retry: true,
+  });
+  Assert.deepEqual(result.body, { ok: true });
+  Assert.equal(calls, 2);
+});
+
+add_task(async function test_retries_are_bounded() {
+  let calls = 0;
+  const transport = new JmapTransport({
+    fetchImpl: () => {
+      calls++;
+      return Promise.resolve(new Response("", { status: 503 }));
+    },
+    maxRetries: 2,
+    retryDelay: () => 0,
+  });
+
+  await expectRejection(
+    transport.request("https://example.com/api"),
+    JmapHttpError,
+    "the retry budget is bounded"
+  );
+  Assert.equal(calls, 3);
+});
+
+add_task(async function test_problem_document() {
+  const transport = new JmapTransport({
+    fetchImpl: () =>
+      Promise.resolve(
+        jsonResponse(
+          {
+            type: JmapRequestErrorType.NotRequest,
+            status: 400,
+            detail: "not a request",
+          },
+          { status: 400 }
+        )
+      ),
+  });
+
+  const error = await expectRejection(
+    transport.request("https://example.com/api"),
+    JmapHttpError,
+    "problem documents become HTTP errors"
+  );
+  Assert.equal(error.status, 400);
+  Assert.equal(error.type, JmapRequestErrorType.NotRequest);
+  Assert.equal(error.detail, "not a request");
+});
+
+add_task(async function test_timeout() {
+  const transport = new JmapTransport({
+    fetchImpl: (url, { signal }) =>
+      new Promise((resolve, reject) => {
+        signal.addEventListener("abort", () => reject(signal.reason));
+      }),
+    timeout: 20,
+    maxRetries: 0,
+  });
+
+  const error = await expectRejection(
+    transport.request("https://example.com/api"),
+    JmapNetworkError,
+    "a request that exceeds the timeout fails"
+  );
+  Assert.ok(error.timeout, "the error is marked as a timeout");
+  Assert.ok(!error.aborted);
+});
+
+add_task(async function test_caller_abort() {
+  let calls = 0;
+  const transport = new JmapTransport({
+    fetchImpl: () => {
+      calls++;
+      return Promise.resolve(jsonResponse({ ok: true }));
+    },
+  });
+
+  const controller = new AbortController();
+  controller.abort();
+
+  const error = await expectRejection(
+    transport.request("https://example.com/api", {
+      signal: controller.signal,
+    }),
+    JmapNetworkError,
+    "an already aborted request fails"
+  );
+  Assert.ok(error.aborted);
+  Assert.equal(calls, 0);
+});
+
+add_task(async function test_network_error_is_retried_for_get() {
+  let calls = 0;
+  const transport = new JmapTransport({
+    fetchImpl: () => {
+      calls++;
+      if (calls == 1) {
+        return Promise.reject(new TypeError("connection reset"));
+      }
+      return Promise.resolve(jsonResponse({ ok: true }));
+    },
+    retryDelay: () => 0,
+  });
+
+  const result = await transport.request("https://example.com/api");
+  Assert.deepEqual(result.body, { ok: true });
+  Assert.equal(calls, 2);
+});
+
+add_task(async function test_text_response_type() {
+  const transport = new JmapTransport({
+    fetchImpl: () => Promise.resolve(new Response("hello", { status: 200 })),
+  });
+  const result = await transport.request("https://example.com/api", {
+    responseType: "text",
+  });
+  Assert.equal(result.body, "hello");
+});
+
+add_task(function test_parse_retry_after() {
+  Assert.equal(parseRetryAfter("2"), 2000);
+  Assert.equal(parseRetryAfter(null), null);
+  Assert.equal(parseRetryAfter("not a date"), null);
+
+  const inFiveSeconds = new Date(Date.now() + 5000).toUTCString();
+  const delay = parseRetryAfter(inFiveSeconds);
+  Assert.ok(delay > 0 && delay <= 5000, `unexpected delay: ${delay}`);
+});
