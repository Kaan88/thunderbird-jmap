+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+@import url("chrome://messenger/skin/variables.css");
+@import url("chrome://messenger/skin/widgets.css");
+
+:root {
+  font: message-box;
+  font-size: var(--font-size-base, 1rem);
+}
+
+body.jmap-files {
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  height: 100vh;
+  background-color: var(--layout-background-1, Canvas);
+  color: var(--layout-color-1, CanvasText);
+}
+
+.jmap-files-toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px;
+  padding: 6px 12px;
+  border-block-end: 1px solid var(--layout-border-0, ThreeDShadow);
+  background-color: var(--layout-background-2, Canvas);
+}
+
+#searchBox {
+  margin-inline-start: auto;
+  min-width: 14em;
+}
+
+.jmap-files-breadcrumb ol {
+  display: flex;
+  flex-wrap: wrap;
+  list-style: none;
+  margin: 0;
+  padding: 6px 12px;
+}
+
+.jmap-files-breadcrumb li + li::before {
+  content: "›";
+  padding-inline: 4px;
+  color: var(--layout-color-2, GrayText);
+}
+
+.breadcrumb-item {
+  border: none;
+  background: none;
+  color: inherit;
+  padding: 2px 4px;
+  border-radius: var(--button-border-radius, 3px);
+  cursor: pointer;
+}
+
+.breadcrumb-item:hover,
+.breadcrumb-item:focus-visible {
+  background-color: var(--button-hover-background-color, ButtonFace);
+}
+
+.breadcrumb-item[aria-current] {
+  font-weight: 600;
+}
+
+.jmap-files-main {
+  flex: 1;
+  overflow: auto;
+  padding: 0 12px;
+}
+
+.jmap-files-main.drag-over {
+  outline: 2px dashed var(--selected-item-color, Highlight);
+  outline-offset: -4px;
+}
+
+.jmap-files-list {
+  width: 100%;
+  border-collapse: collapse;
+}
+
+.jmap-files-list:focus-visible {
+  outline: 2px solid var(--focus-outline-color, Highlight);
+}
+
+.jmap-files-list th {
+  text-align: start;
+  font-weight: 600;
+  padding: 4px 6px;
+  border-block-end: 1px solid var(--layout-border-0, ThreeDShadow);
+  position: sticky;
+  top: 0;
+  background-color: var(--layout-background-1, Canvas);
+}
+
+.jmap-files-list td {
+  padding: 4px 6px;
+  white-space: nowrap;
+}
+
+.jmap-files-list tbody tr {
+  cursor: default;
+}
+
+.jmap-files-list tbody tr:hover {
+  background-color: var(--listbox-hover, color-mix(in srgb, Highlight 10%, transparent));
+}
+
+.jmap-files-list tbody tr.selected {
+  background-color: var(--selected-item-color, Highlight);
+  color: var(--selected-item-text-color, HighlightText);
+}
+
+.col-name {
+  width: 100%;
+}
+
+.col-name img {
+  width: 16px;
+  height: 16px;
+  vertical-align: middle;
+  margin-inline-end: 6px;
+  -moz-context-properties: fill, stroke;
+  fill: color-mix(in srgb, currentColor 20%, transparent);
+  stroke: currentColor;
+}
+
+.col-size {
+  text-align: end;
+}
+
+.jmap-files-empty {
+  text-align: center;
+  color: var(--layout-color-2, GrayText);
+  padding: 2em;
+}
+
+.jmap-files-status {
+  min-height: 1.5em;
+  padding: 4px 12px;
+  border-block-start: 1px solid var(--layout-border-0, ThreeDShadow);
+}
+
+.jmap-files-status.error {
+  color: var(--red-60, #d70022);
+}
+
+/* Picker dialog */
+body.jmap-files-picker {
+  height: 100vh;
+}
+
+.jmap-files-picker .jmap-files-main {
+  min-height: 250px;
+}
+
+.jmap-files-picker-buttons {
+  display: flex;
+  justify-content: flex-end;
+  gap: 6px;
+  padding: 8px 12px;
+}
diff --git a/mail/components/jmapfiles/content/jmapFiles.js b/mail/components/jmapfiles/content/jmapFiles.js
new file mode 100644
index 00000000000..3efa5d13949
--- /dev/null
+++ b/mail/components/jmapfiles/content/jmapFiles.js
@@ -0,0 +1,244 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* import-globals-from jmapFilesView.js */
+
+/**
+ * The Files tab (tab type "jmapFiles").
+ */
+
+var view;
+var statusTimer;
+
+function $(id) {
+  return document.getElementById(id);
+}
+
+function setStatus(message, isError = false) {
+  const status = $("status");
+  status.textContent = message;
+  status.classList.toggle("error", isError);
+  clearTimeout(statusTimer);
+  if (message && !isError) {
+    statusTimer = setTimeout(() => (status.textContent = ""), 5000);
+  }
+}
+
+async function l10n(id, args) {
+  return document.l10n.formatValue(id, args);
+}
+
+function onError(e) {
+  setStatus(e.message || String(e), true);
+}
+
+function updateButtons(selection) {
+  const one = selection.length == 1;
+  $("downloadButton").disabled = !selection.some(n => !n.isDirectory);
+  $("renameButton").disabled = !one;
+  $("deleteButton").disabled = selection.length == 0;
+}
+
+async function uploadFiles(files) {
+  const total = files.length;
+  let done = 0;
+  for (const file of files) {
+    try {
+      await view.service.upload(view.parentId, file, {
+        onProgress: (sent, size) =>
+          l10n("jmap-files-uploading", {
+            name: file.name ?? file.leafName,
+            done,
+            total,
+            percent: size ? Math.round((sent / size) * 100) : 0,
+          }).then(m => setStatus(m)),
+      });
+      done++;
+    } catch (e) {
+      onError(e);
+      return;
+    }
+  }
+  view.render();
+  setStatus(await l10n("jmap-files-uploaded", { count: done }));
+}
+
+function pickAndUpload() {
+  const fp = Cc["@mozilla.org/filepicker;1"].createInstance(Ci.nsIFilePicker);
+  l10n("jmap-files-upload-title").then(title => {
+    fp.init(window.browsingContext, title, Ci.nsIFilePicker.modeOpenMultiple);
+    fp.appendFilters(Ci.nsIFilePicker.filterAll);
+    fp.open(rv => {
+      if (rv == Ci.nsIFilePicker.returnOK && fp.files) {
+        uploadFiles([...fp.files]);
+      }
+    });
+  });
+}
+
+async function downloadSelected() {
+  const files = view.selectedNodes.filter(n => !n.isDirectory);
+  if (!files.length) {
+    return;
+  }
+  const fp = Cc["@mozilla.org/filepicker;1"].createInstance(Ci.nsIFilePicker);
+  const title = await l10n("jmap-files-download-title");
+  let dir;
+  if (files.length == 1) {
+    fp.init(window.browsingContext, title, Ci.nsIFilePicker.modeSave);
+    fp.defaultString = files[0].name;
+  } else {
+    fp.init(window.browsingContext, title, Ci.nsIFilePicker.modeGetFolder);
+  }
+  const rv = await new Promise(resolve => fp.open(resolve));
+  if (rv == Ci.nsIFilePicker.returnCancel || !fp.file) {
+    return;
+  }
+  dir = fp.file;
+  const { DownloadPaths } = ChromeUtils.importESModule(
+    "resource://gre/modules/DownloadPaths.sys.mjs"
+  );
+  try {
+    for (const node of files) {
+      let path = dir.path;
+      if (files.length > 1) {
+        // Never replace an existing local file or an earlier one of the batch.
+        const target = dir.clone();
+        target.append(DownloadPaths.sanitize(node.name) || "download");
+        path = DownloadPaths.createNiceUniqueFile(target).path;
+      }
+      setStatus(await l10n("jmap-files-downloading", { name: node.name }));
+      await view.service.downloadToFile(node.id, path);
+    }
+    setStatus(await l10n("jmap-files-downloaded", { count: files.length }));
+  } catch (e) {
+    onError(e);
+  }
+}
+
+async function prompt(titleId, messageId, value = "") {
+  const [title, message] = await Promise.all([l10n(titleId), l10n(messageId)]);
+  const result = { value };
+  const ok = Services.prompt.prompt(window, title, message, result, null, {});
+  return ok ? result.value.trim() : null;
+}
+
+async function newFolder() {
+  const name = await prompt("jmap-files-new-folder-title", "jmap-files-new-folder-prompt");
+  if (!name) {
+    return;
+  }
+  try {
+    const node = await view.service.mkdir(view.parentId, name);
+    view.render();
+    view.selected = new Set([node.id]);
+    view.render();
+  } catch (e) {
+    onError(e);
+  }
+}
+
+async function renameSelected() {
+  const [node] = view.selectedNodes;
+  if (!node) {
+    return;
+  }
+  const name = await prompt("jmap-files-rename-title", "jmap-files-rename-prompt", node.name);
+  if (!name || name == node.name) {
+    return;
+  }
+  try {
+    await view.service.rename(node.id, name);
+    view.render();
+  } catch (e) {
+    onError(e);
+  }
+}
+
+async function deleteSelected() {
+  const nodes = view.selectedNodes;
+  if (!nodes.length) {
+    return;
+  }
+  const [title, message] = await Promise.all([
+    l10n("jmap-files-delete-title"),
+    l10n("jmap-files-delete-confirm", {
+      count: nodes.length,
+      name: nodes[0].name,
+      hasFolders: nodes.some(n => n.isDirectory) ? "true" : "false",
+    }),
+  ]);
+  if (!Services.prompt.confirm(window, title, message)) {
+    return;
+  }
+  try {
+    await view.service.remove(nodes.map(n => n.id));
+    view.render();
+  } catch (e) {
+    onError(e);
+  }
+}
+
+function setUpDropZone() {
+  const zone = $("dropZone");
+  zone.addEventListener("dragover", e => {
+    if (e.dataTransfer.types.includes("Files")) {
+      e.preventDefault();
+      e.dataTransfer.dropEffect = "copy";
+      zone.classList.add("drag-over");
+    }
+  });
+  zone.addEventListener("dragleave", () => zone.classList.remove("drag-over"));
+  zone.addEventListener("drop", e => {
+    zone.classList.remove("drag-over");
+    if (!e.dataTransfer.files.length) {
+      return;
+    }
+    e.preventDefault();
+    uploadFiles([...e.dataTransfer.files]);
+  });
+}
+
+window.addEventListener("load", async () => {
+  view = new JmapFilesView(
+    {
+      accountPicker: $("accountPicker"),
+      breadcrumb: $("breadcrumb"),
+      list: $("fileList"),
+      empty: $("emptyMessage"),
+      noAccount: $("noAccountMessage"),
+    },
+    {
+      onSelect: updateButtons,
+      onActivate: () => downloadSelected(),
+      onError,
+    }
+  );
+  $("uploadButton").addEventListener("click", pickAndUpload);
+  $("newFolderButton").addEventListener("click", newFolder);
+  $("downloadButton").addEventListener("click", downloadSelected);
+  $("renameButton").addEventListener("click", renameSelected);
+  $("deleteButton").addEventListener("click", deleteSelected);
+  $("refreshButton").addEventListener("click", () =>
+    view.service?.refresh().then(() => view.render(), onError)
+  );
+  let searchTimer;
+  $("searchBox").addEventListener("input", e => {
+    clearTimeout(searchTimer);
+    searchTimer = setTimeout(() => view.search(e.target.value.trim()), 300);
+  });
+  $("fileList").addEventListener("keydown", e => {
+    if (e.key == "Delete") {
+      deleteSelected();
+    } else if (e.key == "F2") {
+      renameSelected();
+    }
+  });
+  setUpDropZone();
+  const params = new URLSearchParams(location.search);
+  await view.init(params.get("server"));
+  window.dispatchEvent(new CustomEvent("jmap-files-ready", { bubbles: true }));
+});
+
+window.addEventListener("unload", () => view?.destroy());
