+++ b/mailnews/protocols/jmap/src/JmapIncomingServer.cpp
@@ -0,0 +1,455 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "JmapIncomingServer.h"
+
+#include <utility>
+
+#include "IJmapClient.h"
+#include "JmapFolder.h"
+#include "JmapListeners.h"
+#include "mozilla/Components.h"
+#include "nsIMsgFolderNotificationService.h"
+#include "nsIMsgPluggableStore.h"
+#include "nsMsgSearchCore.h"
+#include "nsMsgUtils.h"
+#include "nsNetUtil.h"
+#include "nsPrintfCString.h"
+#include "nsString.h"
+
+using namespace mozilla;
+
+namespace {
+
+/**
+ * Listener which turns the mailbox list delivered by `IJmapClient` into local
+ * folders.
+ */
+class JmapFolderSyncListener final : public IJmapMailboxListener {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_IJMAPMAILBOXLISTENER
+
+  JmapFolderSyncListener(JmapIncomingServer* server,
+                         nsIUrlListener* listener)
+      : mServer(server), mListener(listener) {}
+
+ private:
+  virtual ~JmapFolderSyncListener() = default;
+
+  RefPtr<JmapIncomingServer> mServer;
+  nsCOMPtr<nsIUrlListener> mListener;
+};
+
+NS_IMPL_ISUPPORTS(JmapFolderSyncListener, IJmapMailboxListener)
+
+NS_IMETHODIMP JmapFolderSyncListener::OnMailbox(IJmapMailbox* mailbox) {
+  NS_ENSURE_ARG_POINTER(mailbox);
+
+  nsAutoCString id;
+  nsresult rv = mailbox->GetId(id);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsAutoCString parentId;
+  rv = mailbox->GetParentId(parentId);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsAutoCString name;
+  rv = mailbox->GetName(name);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  uint32_t flags = 0;
+  rv = mailbox->GetFolderFlags(&flags);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  return mServer->MaybeCreateFolderWithDetails(id, parentId, name, flags);
+}
+
+NS_IMETHODIMP JmapFolderSyncListener::OnComplete(const nsACString& state) {
+  nsresult rv = mServer->SetStringValue("jmapSyncStateToken", state);
+
+  if (mListener) {
+    mListener->OnStopRunningUrl(nullptr, NS_OK);
+  }
+
+  return rv;
+}
+
+NS_IMETHODIMP JmapFolderSyncListener::OnError(nsresult status,
+                                              const nsACString& message) {
+  NS_WARNING(nsPrintfCString("JMAP folder sync failed: 0x%08x %s", status,
+                             PromiseFlatCString(message).get())
+                 .get());
+
+  if (mListener) {
+    mListener->OnStopRunningUrl(nullptr, status);
+  }
+
+  return NS_OK;
+}
+
+}  // namespace
+
+NS_IMPL_ADDREF_INHERITED(JmapIncomingServer, nsMsgIncomingServer)
+NS_IMPL_RELEASE_INHERITED(JmapIncomingServer, nsMsgIncomingServer)
+NS_IMPL_QUERY_HEAD(JmapIncomingServer)
+NS_IMPL_QUERY_BODY(IJmapIncomingServer)
+NS_IMPL_QUERY_TAIL_INHERITING(nsMsgIncomingServer)
+
+JmapIncomingServer::JmapIncomingServer() = default;
+
+JmapIncomingServer::~JmapIncomingServer() = default;
+
+nsresult JmapIncomingServer::MaybeCreateFolderWithDetails(
+    const nsACString& id, const nsACString& parentId, const nsACString& name,
+    uint32_t flags) {
+  // If a folder with this JMAP id already exists, keep it. This is the common
+  // case: the mailbox was created locally and appears in the next sync.
+  nsCOMPtr<nsIMsgFolder> existingFolder;
+  if (NS_SUCCEEDED(FindFolderWithId(id, getter_AddRefs(existingFolder)))) {
+    return NS_OK;
+  }
+
+  nsCOMPtr<nsIMsgFolder> parent;
+  nsresult rv = FindFolderWithId(parentId, getter_AddRefs(parent));
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(parent, NS_MSG_ERROR_FOLDER_MISSING);
+
+  // JMAP allows sibling mailboxes with the same name, but Thunderbird folders
+  // are addressed by name. Disambiguate the local folder name while keeping
+  // the JMAP id as the stable identity.
+  nsAutoCString folderName(name);
+  bool containsChild = false;
+  rv = parent->ContainsChildNamed(folderName, &containsChild);
+  NS_ENSURE_SUCCESS(rv, rv);
+  for (int32_t suffix = 2; containsChild && suffix < 1000; suffix++) {
+    folderName = name;
+    folderName.AppendLiteral(" (");
+    folderName.AppendInt(suffix);
+    folderName.AppendLiteral(")");
+    rv = parent->ContainsChildNamed(folderName, &containsChild);
+    NS_ENSURE_SUCCESS(rv, rv);
+  }
+  if (containsChild) {
+    return NS_MSG_CANT_CREATE_FOLDER;
+  }
+
+  nsCOMPtr<nsIMsgPluggableStore> msgStore;
+  rv = GetMsgStore(getter_AddRefs(msgStore));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<nsIMsgFolder> newFolder;
+  rv = msgStore->CreateFolder(parent, folderName, getter_AddRefs(newFolder));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  rv = newFolder->SetStringProperty("jmapId", id);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  rv = newFolder->SetFlags(flags);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  rv = newFolder->SetName(folderName);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<nsIMsgFolderNotificationService> notifier =
+      components::FolderNotification::Service();
+  if (notifier) {
+    notifier->NotifyFolderAdded(newFolder);
+  }
+
+  rv = parent->NotifyFolderAdded(newFolder);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  return NS_OK;
+}
+
+nsresult JmapIncomingServer::FindFolderWithId(const nsACString& id,
+                                              nsIMsgFolder** _retval) {
+  NS_ENSURE_ARG_POINTER(_retval);
+
+  // Top-level mailboxes have no parent; their parent folder is the account
+  // root folder.
+  if (id.IsEmpty()) {
+    return GetRootFolder(_retval);
+  }
+
+  nsresult failureStatus = NS_MSG_ERROR_FOLDER_MISSING;
+
+  nsCOMPtr<nsIMsgFolder> root;
+  nsresult rv = GetRootFolder(getter_AddRefs(root));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsTArray<RefPtr<nsIMsgFolder>> foldersToScan;
+  foldersToScan.AppendElement(root);
+
+  while (foldersToScan.Length() != 0) {
+    nsTArray<RefPtr<nsIMsgFolder>> nextFoldersToScan;
+
+    for (auto folder : foldersToScan) {
+      nsCString folderId;
+      rv = folder->GetStringProperty("jmapId", folderId);
+      if (NS_SUCCEEDED(rv) && folderId.Equals(id)) {
+        folder.forget(_retval);
+        return NS_OK;
+      }
+      if (NS_FAILED(rv)) {
+        failureStatus = rv;
+      }
+
+      nsTArray<RefPtr<nsIMsgFolder>> subfolders;
+      if (NS_SUCCEEDED(folder->GetSubFolders(subfolders))) {
+        nextFoldersToScan.AppendElements(subfolders);
+      }
+    }
+
+    foldersToScan = std::move(nextFoldersToScan);
+  }
+
+  return failureStatus;
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetProtocolClient(IJmapClient** aClient) {
+  NS_ENSURE_ARG_POINTER(aClient);
+
+  if (!mClient) {
+    nsCString sessionUrl;
+    nsresult rv = GetStringValue("jmap_session_url", sessionUrl);
+    if (NS_FAILED(rv)) {
+      sessionUrl.Truncate();
+    }
+
+    nsCOMPtr<nsISupports> instance =
+        do_CreateInstance("@mozilla.org/messenger/jmap-client;1", &rv);
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    nsCOMPtr<IJmapClient> client = do_QueryInterface(instance, &rv);
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    rv = client->Initialize(this, sessionUrl);
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    mClient = client;
+  }
+
+  NS_IF_ADDREF(*aClient = mClient);
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetProtocolClientRunning(bool* running) {
+  NS_ENSURE_ARG_POINTER(running);
+
+  if (!mClient) {
+    *running = false;
+    return NS_OK;
+  }
+
+  return mClient->GetRunning(running);
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetProtocolClientIdle(bool* idle) {
+  NS_ENSURE_ARG_POINTER(idle);
+
+  if (!mClient) {
+    *idle = false;
+    return NS_OK;
+  }
+
+  return mClient->GetIdle(idle);
+}
+
+NS_IMETHODIMP JmapIncomingServer::SyncFolderHierarchy(
+    nsIUrlListener* aListener, nsIMsgWindow* aMsgWindow) {
+  if (WeAreOffline()) {
+    if (aListener) {
+      aListener->OnStopRunningUrl(nullptr, NS_MSG_ERROR_OFFLINE);
+    }
+    return NS_OK;
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  nsresult rv = GetProtocolClient(getter_AddRefs(client));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<IJmapMailboxListener> listener =
+      new JmapFolderSyncListener(this, aListener);
+  return client->SyncMailboxes(listener);
+}
+
+NS_IMETHODIMP JmapIncomingServer::SyncMessages(nsIUrlListener* aListener) {
+  if (WeAreOffline()) {
+    if (aListener) {
+      aListener->OnStopRunningUrl(nullptr, NS_MSG_ERROR_OFFLINE);
+    }
+    return NS_OK;
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  nsresult rv = GetProtocolClient(getter_AddRefs(client));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  // Refresh the cached account quota after every sync.
+  RefPtr<JmapIncomingServer> self = this;
+  nsCOMPtr<nsIUrlListener> outer = aListener;
+  RefPtr<JmapUrlStopListener> listener =
+      new JmapUrlStopListener([self, outer](nsresult status) {
+        if (NS_SUCCEEDED(status)) {
+          nsCOMPtr<nsIMsgFolder> root;
+          if (NS_SUCCEEDED(self->GetRootFolder(getter_AddRefs(root)))) {
+            nsCOMPtr<IJmapFolder> jmapRoot = do_QueryInterface(root);
+            if (jmapRoot) {
+              static_cast<JmapFolder*>(jmapRoot.get())->RefreshQuota();
+            }
+          }
+        }
+        if (outer) {
+          return outer->OnStopRunningUrl(nullptr, status);
+        }
+        return NS_OK;
+      });
+
+  if (aListener) {
+    aListener->OnStartRunningUrl(nullptr);
+  }
+  return client->SyncAccount(listener);
+}
+
+NS_IMETHODIMP JmapIncomingServer::CreateFolderForMailbox(
+    const nsACString& aId, const nsACString& aParentId,
+    const nsACString& aName, uint32_t aFlags) {
+  return MaybeCreateFolderWithDetails(aId, aParentId, aName, aFlags);
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetJmapSessionUrl(nsACString& value) {
+  return GetStringValue("jmap_session_url", value);
+}
+
+NS_IMETHODIMP JmapIncomingServer::SetJmapSessionUrl(const nsACString& value) {
+  return SetStringValue("jmap_session_url", value);
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetPassword(nsAString& password) {
+  // `nsMsgIncomingServer` does not read the password from the login manager at
+  // startup. Make sure it has been read at least once before the client asks
+  // for it.
+  nsAutoCString value;
+  nsresult rv = mPasswordModule->GetCachedPassword(value);
+  if (NS_SUCCEEDED(rv) && value.IsEmpty()) {
+    rv = GetPasswordWithoutUI();
+    NS_ENSURE_SUCCESS(rv, rv);
+  }
+
+  return nsMsgIncomingServer::GetPassword(password);
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetPort(int32_t* aPort) {
+  NS_ENSURE_ARG_POINTER(aPort);
+
+  nsCString sessionUrl;
+  nsresult rv = GetStringValue("jmap_session_url", sessionUrl);
+  if (NS_FAILED(rv)) {
+    sessionUrl.Truncate();
+  }
+
+  int32_t port = -1;
+  if (!sessionUrl.IsEmpty()) {
+    nsCOMPtr<nsIURI> uri;
+    if (NS_SUCCEEDED(NS_NewURI(getter_AddRefs(uri), sessionUrl))) {
+      uri->GetPort(&port);
+    }
+  }
+
+  if (port < 0) {
+    nsMsgSocketTypeValue socketType;
+    rv = GetSocketType(&socketType);
+    NS_ENSURE_SUCCESS(rv, rv);
+    port = socketType == nsMsgSocketType::SSL ? 443 : 80;
+  }
+
+  *aPort = port;
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetLocalStoreType(
+    nsACString& aLocalStoreType) {
+  aLocalStoreType.AssignLiteral("jmap");
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetLocalDatabaseType(
+    nsACString& aLocalDatabaseType) {
+  aLocalDatabaseType.AssignLiteral("mailbox");
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetCanBeDefaultServer(
+    bool* canBeDefaultServer) {
+  NS_ENSURE_ARG_POINTER(canBeDefaultServer);
+  *canBeDefaultServer = true;
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetOfflineSupportLevel(
+    int32_t* aSupportLevel) {
+  NS_ENSURE_ARG_POINTER(aSupportLevel);
+  // Message bodies are kept in the local store once downloaded, so
+  // reading and searching work offline; mutations fail with
+  // NS_MSG_ERROR_OFFLINE.
+  *aSupportLevel = OFFLINE_SUPPORT_LEVEL_REGULAR;
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetCanSearchMessages(
+    bool* canSearchMessages) {
+  NS_ENSURE_ARG_POINTER(canSearchMessages);
+  *canSearchMessages = true;
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetSearchScope(
+    nsMsgSearchScopeValue* searchScope) {
+  NS_ENSURE_ARG_POINTER(searchScope);
+  // Like IMAP: "search on server" uses Email/query (JmapService::Search)
+  // while online, and the local databases otherwise.
+  *searchScope = WeAreOffline() ? nsMsgSearchScope::offlineMail
+                                : nsMsgSearchScope::onlineMail;
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapIncomingServer::GetNewMessages(
+    nsIMsgFolder* aFolder, nsIMsgWindow* aMsgWindow,
+    nsIUrlListener* aUrlListener) {
+  // A JMAP sync covers the whole account, so every folder triggers the same
+  // account-wide operation.
+  return SyncMessages(aUrlListener);
+}
+
+NS_IMETHODIMP JmapIncomingServer::PerformBiff(nsIMsgWindow* aMsgWindow) {
+  return SyncMessages(nullptr);
+}
+
+NS_IMETHODIMP JmapIncomingServer::PerformExpand(nsIMsgWindow* aMsgWindow) {
+  return SyncFolderHierarchy(nullptr, aMsgWindow);
+}
+
+NS_IMETHODIMP JmapIncomingServer::Shutdown() {
+  if (mClient) {
+    mClient->Shutdown();
+    mClient = nullptr;
+  }
+
+  return nsMsgIncomingServer::Shutdown();
+}
+
+NS_IMETHODIMP JmapIncomingServer::VerifyLogon(nsIUrlListener* aUrlListener,
+                                              nsIMsgWindow* aMsgWindow,
+                                              nsIURI** _retval) {
+  NS_ENSURE_ARG_POINTER(_retval);
+  *_retval = nullptr;
+
+  nsCOMPtr<IJmapClient> client;
+  nsresult rv = GetProtocolClient(getter_AddRefs(client));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  return client->CheckConnectivity(aUrlListener);
+}
