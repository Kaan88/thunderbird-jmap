+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Live tests: VacationResponse, Sieve scripts and push (EventSource).
+ */
+
+var { JmapPush } = ChromeUtils.importESModule(
+  "resource:///modules/jmap/JmapPush.sys.mjs"
+);
+
+let alice, bob;
+
+add_setup(async function () {
+  if (!LIVE_CONFIG) {
+    return;
+  }
+  alice = await createLiveAccount("alice@test.localhost");
+  bob = await createLiveAccount("bob@test.localhost");
+  await ensureServerIdentity(alice);
+});
+
+add_live_task(async function test_vacationResponse() {
+  const subject = `Away ${RUN_ID}`;
+  registerCleanupFunction(() =>
+    callMethod(alice.server, "VacationResponse/set", {
+      update: { singleton: { isEnabled: false } },
+    }).catch(() => {})
+  );
+  let result = await callMethod(alice.server, "VacationResponse/set", {
+    update: {
+      singleton: { isEnabled: true, subject, textBody: "Out of office." },
+    },
+  });
+  Assert.ok(
+    result.updated && "singleton" in result.updated,
+    "vacation response enabled"
+  );
+  result = await callMethod(alice.server, "VacationResponse/get", {
+    ids: ["singleton"],
+  });
+  Assert.equal(result.list[0].isEnabled, true, "vacation is enabled");
+  Assert.equal(result.list[0].subject, subject, "vacation subject stored");
+
+  await callMethod(alice.server, "VacationResponse/set", {
+    update: { singleton: { isEnabled: false } },
+  });
+  result = await callMethod(alice.server, "VacationResponse/get", {
+    ids: ["singleton"],
+  });
+  Assert.equal(result.list[0].isEnabled, false, "vacation disabled");
+});
+
+add_live_task(async function test_sieve() {
+  const client = await jsClient(alice.server);
+  if (!client.supports(JmapCapability.Sieve)) {
+    info("server has no Sieve capability; skipping");
+    return;
+  }
+  const accountId = client.getAccountId(JmapCapability.Sieve);
+  const script = `require ["fileinto"];\r\nif header :contains "subject" "sieve-${RUN_ID}" {\r\n  fileinto "Junk Mail";\r\n}\r\n`;
+  const { blobId } = await client.upload(script, "application/sieve", {
+    accountId,
+  });
+  Assert.ok(blobId, "sieve script uploaded");
+
+  const validation = await callMethod(alice.server, "SieveScript/validate", {
+    blobId,
+  });
+  Assert.ok(!validation.error, "script validates");
+
+  const name = `live-${RUN_ID}`;
+  const created = await callMethod(alice.server, "SieveScript/set", {
+    create: { s: { name, blobId } },
+  });
+  const id = created.created?.s?.id;
+  Assert.ok(id, "sieve script created");
+  registerCleanupFunction(async () => {
+    await callMethod(alice.server, "SieveScript/set", {
+      onSuccessDeactivateScript: true,
+    }).catch(() => {});
+    await callMethod(alice.server, "SieveScript/set", { destroy: [id] }).catch(
+      () => {}
+    );
+  });
+
+  await callMethod(alice.server, "SieveScript/set", {
+    onSuccessActivateScript: id,
+  });
+  let got = await callMethod(alice.server, "SieveScript/get", { ids: [id] });
+  Assert.equal(got.list[0].isActive, true, "script active");
+
+  await callMethod(alice.server, "SieveScript/set", {
+    onSuccessDeactivateScript: true,
+  });
+  got = await callMethod(alice.server, "SieveScript/get", { ids: [id] });
+  Assert.equal(got.list[0].isActive, false, "script inactive");
+
+  const destroyed = await callMethod(alice.server, "SieveScript/set", {
+    destroy: [id],
+  });
+  Assert.ok(destroyed.destroyed?.includes(id), "script destroyed");
+  got = await callMethod(alice.server, "SieveScript/get", { ids: [id] });
+  Assert.equal(got.list.length, 0, "script gone");
+});
+
+add_live_task(async function test_push() {
+  const subject = `Live push ${RUN_ID}`;
+  registerCleanupFunction(async () => {
+    await destroyBySubject(alice.server, subject);
+    await destroyBySubject(bob.server, subject);
+  });
+  const bobClient = await jsClient(bob.server);
+  const { promise, resolve } = Promise.withResolvers();
+  const unsubscribe = JmapPush.addListener(bob.server.key, null, changed => {
+    if (changed && Object.keys(changed).length) {
+      resolve(changed);
+    }
+  });
+  registerCleanupFunction(() => {
+    unsubscribe();
+    JmapPush.stop(bob.server.key);
+  });
+  JmapPush.start(bob.server, bobClient);
+  await pollUntil(
+    () => JmapPush.isConnected(bob.server.key),
+    "push stream connected"
+  );
+  // Let the server register the subscription before the change happens.
+  await PromiseTestUtils.promiseDelay(2000);
+
+  const file = await writeMessageFile({
+    from: alice.email,
+    to: bob.email,
+    subject,
+  });
+  await sendThroughOutgoing(alice, file, [bob.email]);
+
+  let timer;
+  const timeout = new Promise((_, reject) => {
+    timer = setTimeout(
+      () => reject(new Error("no StateChange within 30s")),
+      POLL_TIMEOUT_MS
+    );
+  });
+  const changed = await Promise.race([promise, timeout]);
+  clearTimeout(timer);
+  const types = Object.values(changed).flatMap(s => Object.keys(s));
+  info(`push changed types: ${types.join(", ")}`);
+  Assert.ok(
+    types.some(t => ["Email", "Mailbox", "Thread", "EmailDelivery"].includes(t)),
+    "StateChange reports a mail type"
+  );
+});
