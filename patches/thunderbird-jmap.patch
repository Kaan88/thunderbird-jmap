+}
+
+NS_IMETHODIMP JmapFolder::CreateSubfolderWithListener(
+    const nsACString& aFolderName, nsIUrlListener* aListener) {
+  nsCOMPtr<nsIUrlListener> urlListener = aListener;
+  auto fail = [urlListener](nsresult status) {
+    if (urlListener) {
+      urlListener->OnStopRunningUrl(nullptr, status);
+      return NS_OK;
+    }
+    return status;
+  };
+
+  if (aFolderName.IsEmpty()) {
+    return fail(NS_MSG_ERROR_INVALID_FOLDER_NAME);
+  }
+
+  bool canCreate = false;
+  GetCanCreateSubfolders(&canCreate);
+  if (!canCreate) {
+    return fail(NS_MSG_CANT_CREATE_FOLDER);
+  }
+
+  if (WeAreOffline()) {
+    return fail(NS_MSG_ERROR_OFFLINE);
+  }
+
+  nsAutoCString parentId;
+  nsresult rv = GetParentIdForChildren(parentId);
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  rv = GetClientForMutation(client);
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+
+  nsCOMPtr<nsIMsgIncomingServer> server;
+  rv = GetServer(getter_AddRefs(server));
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+  nsCOMPtr<IJmapIncomingServer> jmapServer = do_QueryInterface(server, &rv);
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+
+  const nsCString folderName(aFolderName);
+  const nsCString parent(parentId);
+
+  // The local folder is created once the server has assigned the id, so it
+  // is never orphaned when the server refuses the mailbox.
+  RefPtr<JmapOperationListener> listener = new JmapOperationListener(
+      [jmapServer, folderName, parent, urlListener](const nsACString& id) {
+        nsresult rv =
+            jmapServer->CreateFolderForMailbox(id, parent, folderName, 0);
+        if (urlListener) {
+          urlListener->OnStopRunningUrl(nullptr, rv);
+        }
+        return NS_OK;
+      },
+      [urlListener](nsresult status, const nsACString&) {
+        if (urlListener) {
+          urlListener->OnStopRunningUrl(nullptr, status);
+        }
+        return NS_OK;
+      });
+
+  rv = client->CreateMailbox(folderName, parent, listener);
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapFolder::Rename(const nsACString& aNewName,
+                                 nsIMsgWindow* msgWindow) {
+  // Virtual folders are just a local operation.
+  if (mFlags & nsMsgFolderFlags::Virtual) {
+    return nsMsgDBFolder::Rename(aNewName, msgWindow);
+  }
+
+  nsAutoCString currentName;
+  nsresult rv = GetName(currentName);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (aNewName.Equals(currentName)) {
+    return NS_OK;
+  }
+  if (aNewName.IsEmpty()) {
+    return NS_MSG_ERROR_INVALID_FOLDER_NAME;
+  }
+
+  bool canRename = false;
+  rv = GetCanRename(&canRename);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (!canRename) {
+    return NS_ERROR_UNEXPECTED;
+  }
+
+  if (WeAreOffline()) {
+    return NS_MSG_ERROR_OFFLINE;
+  }
+
+  nsAutoCString mailboxId;
+  rv = GetJmapId(mailboxId);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(!mailboxId.IsEmpty(), NS_ERROR_UNEXPECTED);
+
+  nsCOMPtr<IJmapClient> client;
+  rv = GetClientForMutation(client);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  const nsCString newName(aNewName);
+  const nsCOMPtr<nsIMsgWindow> window = msgWindow;
+  RefPtr<JmapFolder> self = this;
+
+  RefPtr<JmapOperationListener> listener = new JmapOperationListener(
+      [self, newName, window](const nsACString&) {
+        nsCOMPtr<nsIMsgFolder> parent;
+        nsresult rv = self->GetParent(getter_AddRefs(parent));
+        NS_ENSURE_SUCCESS(rv, rv);
+        return LocalRenameOrReparentFolder(self, parent, newName, window);
+      },
+      nullptr);
+
+  // "-" keeps the current parent.
+  return client->UpdateMailbox(mailboxId, newName, "-"_ns, listener);
+}
+
+bool JmapFolder::IsInTrash() {
+  nsCOMPtr<nsIMsgFolder> folder = this;
+  while (folder) {
+    bool isTrash = false;
+    folder->GetFlag(nsMsgFolderFlags::Trash, &isTrash);
+    if (isTrash) {
+      return true;
+    }
+    nsCOMPtr<nsIMsgFolder> parent;
+    folder->GetParent(getter_AddRefs(parent));
+    folder = parent;
+  }
+  return false;
+}
+
+nsresult JmapFolder::GetTrashFolder(nsIMsgFolder** trashFolder) {
+  NS_ENSURE_ARG_POINTER(trashFolder);
+  *trashFolder = nullptr;
+
+  nsCOMPtr<nsIMsgFolder> rootFolder;
+  nsresult rv = GetRootFolder(getter_AddRefs(rootFolder));
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (rootFolder) {
+    rootFolder->GetFolderWithFlags(nsMsgFolderFlags::Trash, trashFolder);
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapFolder::DeleteSelf(nsIMsgWindow* aWindow) {
+  if (mFlags & nsMsgFolderFlags::Virtual) {
+    return nsMsgDBFolder::DeleteSelf(aWindow);
+  }
+
+  bool deletable = false;
+  nsresult rv = GetDeletable(&deletable);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (!deletable) {
+    return NS_ERROR_UNEXPECTED;
+  }
+
+  if (WeAreOffline()) {
+    return NS_MSG_ERROR_OFFLINE;
+  }
+
+  nsAutoCString mailboxId;
+  rv = GetJmapId(mailboxId);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(!mailboxId.IsEmpty(), NS_ERROR_UNEXPECTED);
+
+  nsCOMPtr<IJmapClient> client;
+  rv = GetClientForMutation(client);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  RefPtr<JmapFolder> self = this;
+  const nsCOMPtr<nsIMsgWindow> window = aWindow;
+
+  nsCOMPtr<nsIMsgFolder> trashFolder;
+  GetTrashFolder(getter_AddRefs(trashFolder));
+  nsAutoCString trashId;
+  if (trashFolder) {
+    trashFolder->GetStringProperty("jmapId", trashId);
+  }
+
+  if (IsInTrash() || !trashFolder || trashId.IsEmpty()) {
+    // Permanent delete: destroy the subtree, deepest mailboxes first, then
+    // remove the local folders.
+    nsTArray<nsCString> ids;
+    rv = JmapMailboxIdsDeepestFirst(this, true, ids);
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    JmapDestroyMailboxChain(
+        RefPtr<IJmapClient>(client.get()), CopyableTArray<nsCString>(ids), 0,
+        [self, window](nsresult status) {
+          if (NS_FAILED(status)) {
+            // Some children may be gone already; the next folder sync
+            // reconciles the hierarchy.
+            JmapSyncAccountForFolder(self, nullptr);
+            return status;
+          }
+          return self->nsMsgDBFolder::DeleteSelf(window);
+        });
+    return NS_OK;
+  }
+
+  // Move the mailbox below Trash.
+  nsCOMPtr<nsIMsgFolder> trash = trashFolder;
+  RefPtr<JmapOperationListener> listener = new JmapOperationListener(
+      [self, trash, window](const nsACString&) {
+        nsAutoCString name;
+        nsresult rv = self->GetName(name);
+        NS_ENSURE_SUCCESS(rv, rv);
+        return LocalRenameOrReparentFolder(self, trash, name, window);
+      },
+      nullptr);
+  return client->UpdateMailbox(mailboxId, ""_ns, trashId, listener);
+}
+
+NS_IMETHODIMP JmapFolder::EmptyTrash(nsIUrlListener* aListener) {
+  nsCOMPtr<nsIUrlListener> urlListener = aListener;
+
+  if (WeAreOffline()) {
+    if (urlListener) {
+      urlListener->OnStopRunningUrl(nullptr, NS_MSG_ERROR_OFFLINE);
+    }
+    return NS_MSG_ERROR_OFFLINE;
+  }
+
+  nsCOMPtr<nsIMsgFolder> trashFolder;
+  nsresult rv = GetTrashFolder(getter_AddRefs(trashFolder));
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(trashFolder, NS_MSG_ERROR_FOLDER_MISSING);
+
+  nsAutoCString trashId;
+  rv = trashFolder->GetStringProperty("jmapId", trashId);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(!trashId.IsEmpty(), NS_ERROR_UNEXPECTED);
+
+  nsCOMPtr<IJmapClient> client;
+  rv = GetClientForMutation(client);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<nsIURI> trashUri;
+  FolderUri(trashFolder, getter_AddRefs(trashUri));
+
+  // Subfolders of Trash are destroyed together with their emails.
+  nsTArray<nsCString> subfolderIds;
+  rv = JmapMailboxIdsDeepestFirst(trashFolder, false, subfolderIds);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  auto finish = [trashFolder, trashUri, urlListener](nsresult status) {
+    if (NS_SUCCEEDED(status)) {
+      nsTArray<RefPtr<nsIMsgFolder>> subFolders;
+      if (NS_SUCCEEDED(trashFolder->GetSubFolders(subFolders))) {
+        for (const auto& folder : subFolders) {
+          trashFolder->PropagateDelete(folder, true);
+        }
+      }
+
+      nsCOMPtr<nsIMsgDatabase> db;
+      if (NS_SUCCEEDED(trashFolder->GetMsgDatabase(getter_AddRefs(db))) &&
+          db) {
+        nsTArray<nsMsgKey> keys;
+        nsTArray<RefPtr<nsIMsgDBHdr>> headers;
+        if (NS_SUCCEEDED(db->ListAllKeys(keys)) &&
+            NS_SUCCEEDED(MsgGetHeadersFromKeys(db, keys, headers))) {
+          LocalDeleteMessages(trashFolder, headers);
+        }
+      }
+    }
+    if (urlListener) {
+      urlListener->OnStopRunningUrl(trashUri, status);
+    }
+    return NS_OK;
+  };
+
+  RefPtr<IJmapClient> clientRef(client.get());
+  RefPtr<JmapOperationListener> listener = new JmapOperationListener(
+      [clientRef, subfolderIds = CopyableTArray<nsCString>(subfolderIds),
+       finish](const nsACString&) {
+        JmapDestroyMailboxChain(clientRef, subfolderIds, 0, finish);
+        return NS_OK;
+      },
+      [finish](nsresult status, const nsACString&) { return finish(status); });
+
+  if (urlListener) {
+    urlListener->OnStartRunningUrl(trashUri);
+  }
+  return client->EmptyMailbox(trashId, listener);
+}
+
+NS_IMETHODIMP JmapFolder::CopyFolder(nsIMsgFolder* aSrcFolder,
+                                     bool aIsMoveFolder,
+                                     nsIMsgWindow* aMsgWindow,
+                                     nsIMsgCopyServiceListener* aListener) {
+  NS_ENSURE_ARG_POINTER(aSrcFolder);
+
+  uint32_t srcFlags = 0;
+  aSrcFolder->GetFlags(&srcFlags);
+  if (srcFlags & nsMsgFolderFlags::Virtual) {
+    return LocalCopyVirtualFolder(aSrcFolder, this, aIsMoveFolder);
+  }
+
+  nsCOMPtr<nsIMsgFolder> srcFolder = aSrcFolder;
+  nsCOMPtr<nsIMsgCopyServiceListener> copyListener = aListener;
+  RefPtr<JmapFolder> self = this;
+
+  auto complete = [srcFolder, self](nsresult status) {
+    if (NS_FAILED(status)) {
+      srcFolder->NotifyFolderEvent(kDeleteOrMoveMsgFailed);
+    }
+    nsCOMPtr<nsIMsgCopyService> copyService =
+        mozilla::components::Copy::Service();
+    copyService->NotifyCompletion(srcFolder, self, status);
+    return NS_OK;
+  };
+
+  bool sameServer = false;
+  nsresult rv = FoldersOnSameServer(aSrcFolder, this, &sameServer);
+  if (NS_FAILED(rv)) {
+    complete(rv);
+    return rv;
+  }
+
+  // Only moving a mailbox within the account is a server operation. Copying
+  // a folder (or moving one between accounts) would need every message to
+  // be imported, which is not implemented.
+  if (!sameServer || !aIsMoveFolder) {
+    complete(NS_ERROR_NOT_IMPLEMENTED);
+    return NS_ERROR_NOT_IMPLEMENTED;
+  }
+
+  if (WeAreOffline()) {
+    complete(NS_MSG_ERROR_OFFLINE);
+    return NS_MSG_ERROR_OFFLINE;
+  }
+
+  nsAutoCString srcId;
+  aSrcFolder->GetStringProperty("jmapId", srcId);
+  nsAutoCString newParentId;
+  rv = GetParentIdForChildren(newParentId);
+  if (NS_SUCCEEDED(rv) && srcId.IsEmpty()) {
+    rv = NS_ERROR_UNEXPECTED;
+  }
+  nsCOMPtr<IJmapClient> client;
+  if (NS_SUCCEEDED(rv)) {
+    rv = GetClientForMutation(client);
+  }
+  if (NS_FAILED(rv)) {
+    complete(rv);
+    return rv;
+  }
+
+  const nsCOMPtr<nsIMsgWindow> window = aMsgWindow;
+  RefPtr<JmapOperationListener> listener = new JmapOperationListener(
+      [srcFolder, self, window, complete](const nsACString&) {
+        nsAutoCString name;
+        nsresult rv = srcFolder->GetName(name);
+        if (NS_SUCCEEDED(rv)) {
+          rv = LocalRenameOrReparentFolder(srcFolder, self, name, window);
+        }
+        return complete(rv);
+      },
+      [complete](nsresult status, const nsACString&) {
+        return complete(status);
+      });
+
+  rv = client->UpdateMailbox(srcId, ""_ns, newParentId, listener);
+  if (NS_FAILED(rv)) {
+    complete(rv);
+  }
+  return rv;
+}
+
+NS_IMETHODIMP JmapFolder::CopyFileMessage(
+    nsIFile* aFile, nsIMsgDBHdr* msgToReplace, bool isDraftOrTemplate,
+    uint32_t newMsgFlags, const nsACString& aNewMsgKeywords,
+    nsIMsgWindow* msgWindow, nsIMsgCopyServiceListener* copyListener) {
+  NS_ENSURE_ARG_POINTER(aFile);
+  NS_ENSURE_ARG_POINTER(copyListener);
+
+  nsCOMPtr<nsIMsgCopyService> copyService =
+      mozilla::components::Copy::Service();
+  auto fail = [&](nsresult status) {
+    nsCOMPtr<nsISupports> src = do_QueryInterface(aFile);
+    copyService->NotifyCompletion(src, this, status);
+    return status;
+  };
+
+  if (WeAreOffline()) {
+    return fail(NS_MSG_ERROR_OFFLINE);
+  }
+
+  nsAutoCString mailboxId;
+  nsresult rv = GetJmapId(mailboxId);
+  if (NS_SUCCEEDED(rv) && mailboxId.IsEmpty()) {
+    rv = NS_ERROR_UNEXPECTED;
+  }
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  rv = GetClientForMutation(client);
+  if (NS_FAILED(rv)) {
+    return fail(rv);
+  }
+
+  // Sent messages are read; drafts and templates carry $draft. Callers pass
+  // the Read flag in newMsgFlags for saved sent copies.
+  nsTArray<nsCString> keywords;
+  if (!isDraftOrTemplate || (newMsgFlags & nsMsgMessageFlags::Read)) {
+    keywords.AppendElement("$seen"_ns);
+  }
+  if (isDraftOrTemplate) {
+    keywords.AppendElement("$draft"_ns);
+  }
+  if (newMsgFlags & nsMsgMessageFlags::Marked) {
+    keywords.AppendElement("$flagged"_ns);
+  }
+  for (const auto& keyword : aNewMsgKeywords.Split(' ')) {
+    if (!keyword.IsEmpty() && !keywords.Contains(keyword)) {
+      keywords.AppendElement(keyword);
+    }
+  }
+
+  RefPtr<JmapMessageCopyHandler> handler = new JmapMessageCopyHandler(
+      aFile, this, keywords, msgWindow, mailboxId, client, copyListener);
+  rv = handler->StartCopyingNextMessage();
+  if (NS_FAILED(rv)) {
+    handler->OnCopyCompleted(rv);
+  }
+  return rv;
+}
+
+NS_IMETHODIMP JmapFolder::GetSubFolders(
+    nsTArray<RefPtr<nsIMsgFolder>>& aSubFolders) {
+  if (!mHasLoadedSubfolders) {
+    nsresult rv = CreateChildrenFromStore();
+    NS_ENSURE_SUCCESS(rv, rv);
+  }
+
+  return nsMsgDBFolder::GetSubFolders(aSubFolders);
+}
+
+nsresult JmapFolder::CreateChildrenFromStore() {
+  MOZ_ASSERT(!mHasLoadedSubfolders);
+
+  nsCOMPtr<nsIMsgPluggableStore> msgStore;
+  nsresult rv = GetMsgStore(getter_AddRefs(msgStore));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsTArray<nsCString> childNames;
+  rv = msgStore->DiscoverChildFolders(this, childNames);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  // Set this before creating children: folder creation through the folder
+  // lookup service calls GetSubFolders() to look for existing folders.
+  mHasLoadedSubfolders = true;
+
+  for (auto& childName : childNames) {
+    nsCOMPtr<nsIMsgFolder> child;
+    rv = nsMsgDBFolder::AddSubfolder(childName, getter_AddRefs(child));
+    NS_ENSURE_SUCCESS(rv, rv);
+  }
+
+  for (nsIMsgFolder* child : mSubFolders) {
+    rv = static_cast<JmapFolder*>(child)->CreateChildrenFromStore();
+    NS_ENSURE_SUCCESS(rv, rv);
+  }
+
+  return NS_OK;
+}
