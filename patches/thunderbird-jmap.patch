+/**
+ * A folder in a JMAP account.
+ *
+ * The folder tree mirrors the server's mailbox hierarchy. Every mutation is
+ * sent to the server first; the local state follows either directly (folder
+ * operations) or through the next account sync (message operations).
+ */
+class JmapFolder : public nsMsgDBFolder, public IJmapFolder {
+ public:
+  NS_DECL_ISUPPORTS_INHERITED
+  NS_DECL_IJMAPFOLDER
+
+  JmapFolder();
+
+  // nsIMsgFolder
+  NS_IMETHOD GetIncomingServerType(nsACString& aServerType) override;
+  NS_IMETHOD GetSupportsOffline(bool* supportsOffline) override;
+  NS_IMETHOD GetDeletable(bool* deletable) override;
+  NS_IMETHOD GetCanCreateSubfolders(bool* canCreateSubfolders) override;
+  NS_IMETHOD CreateSubfolder(const nsACString& folderName,
+                             nsIMsgWindow* msgWindow) override;
+  NS_IMETHOD CreateSubfolderWithListener(const nsACString& folderName,
+                                         nsIUrlListener* listener) override;
+  NS_IMETHOD Rename(const nsACString& aNewName,
+                    nsIMsgWindow* msgWindow) override;
+  NS_IMETHOD DeleteSelf(nsIMsgWindow* msgWindow) override;
+  NS_IMETHOD EmptyTrash(nsIUrlListener* aListener) override;
+  NS_IMETHOD CopyFolder(nsIMsgFolder* srcFolder, bool isMoveFolder,
+                        nsIMsgWindow* msgWindow,
+                        nsIMsgCopyServiceListener* listener) override;
+  NS_IMETHOD CopyFileMessage(nsIFile* aFile, nsIMsgDBHdr* msgToReplace,
+                             bool isDraftOrTemplate, uint32_t newMsgFlags,
+                             const nsACString& aNewMsgKeywords,
+                             nsIMsgWindow* msgWindow,
+                             nsIMsgCopyServiceListener* listener) override;
+  NS_IMETHOD GetSubFolders(
+      nsTArray<RefPtr<nsIMsgFolder>>& aSubFolders) override;
+  NS_IMETHOD GetNewMessages(nsIMsgWindow* aWindow,
+                            nsIUrlListener* aListener) override;
+  NS_IMETHOD UpdateFolder(nsIMsgWindow* aWindow) override;
+  NS_IMETHOD GetDBFolderInfoAndDB(nsIDBFolderInfo** folderInfo,
+                                  nsIMsgDatabase** database) override;
+  NS_IMETHOD MarkMessagesRead(
+      const nsTArray<RefPtr<nsIMsgDBHdr>>& messages,
+      bool markRead) override;
+  NS_IMETHOD MarkMessagesFlagged(
+      const nsTArray<RefPtr<nsIMsgDBHdr>>& messages,
+      bool markFlagged) override;
+  NS_IMETHOD MarkAllMessagesRead(nsIMsgWindow* aMsgWindow) override;
+  NS_IMETHOD AddKeywordsToMessages(
+      const nsTArray<RefPtr<nsIMsgDBHdr>>& aMessages,
+      const nsACString& aKeywords) override;
+  NS_IMETHOD RemoveKeywordsFromMessages(
+      const nsTArray<RefPtr<nsIMsgDBHdr>>& aMessages,
+      const nsACString& aKeywords) override;
+  NS_IMETHOD DeleteMessages(
+      const nsTArray<RefPtr<nsIMsgDBHdr>>& messages, nsIMsgWindow* msgWindow,
+      bool deleteStorage, bool isMove, nsIMsgCopyServiceListener* listener,
+      bool allowUndo) override;
+  NS_IMETHOD CopyMessages(nsIMsgFolder* srcFolder,
+                          const nsTArray<RefPtr<nsIMsgDBHdr>>& messages,
+                          bool isMove, nsIMsgWindow* msgWindow,
+                          nsIMsgCopyServiceListener* listener, bool isFolder,
+                          bool allowUndo) override;
+  NS_IMETHOD SetJunkScoreForMessages(
+      const nsTArray<RefPtr<nsIMsgDBHdr>>& messages,
+      nsMsgJunkScore junkScore, const nsACString& junkScoreOrigin,
+      int32_t junkPercent) override;
+
+  // nsIJunkMailClassificationListener
+  NS_IMETHOD OnMessageClassified(const nsACString& aMsgURI,
+                                 nsMsgJunkStatus aClassification,
+                                 uint32_t aJunkPercent) override;
+
+  /**
+   * Fetch the account quota from the server and cache it. Only meaningful
+   * on the root folder, which holds the cache for the account.
+   */
+  void RefreshQuota();
+
+ protected:
+  virtual ~JmapFolder();
+
+  virtual nsresult CreateBaseMessageURI(const nsACString& aURI) override;
+  virtual nsresult GetDatabase() override;
+
+ private:
+  /**
+   * Recursively create child folder objects from the local message store.
+   * This gives the folder pane something to show before the first server
+   * synchronization completes.
+   */
+  nsresult CreateChildrenFromStore();
+
+  /** Ask the incoming server to synchronize message metadata. */
+  nsresult SyncMessages(nsIUrlListener* aListener);
+
+  /**
+   * Collect the JMAP email ids of the given headers, skipping headers which
+   * are not backed by a server message.
+   */
+  nsresult CollectJmapIds(const nsTArray<RefPtr<nsIMsgDBHdr>>& messages,
+                          nsTArray<nsCString>& ids);
+
+  /** Return the protocol client, or an error when the account is unavailable. */
+  nsresult GetClientForMutation(nsCOMPtr<IJmapClient>& client);
+
+  /** Send a read/unread change to the server, logging failures. */
+  nsresult SendReadMutation(const nsTArray<RefPtr<nsIMsgDBHdr>>& messages,
+                            bool read);
+
+  /** Send a flagged/unflagged change to the server, logging failures. */
+  nsresult SendFlaggedMutation(const nsTArray<RefPtr<nsIMsgDBHdr>>& messages,
+                               bool flagged);
+
+  /** Send a keyword (tag) change to the server, logging failures. */
+  nsresult SendKeywordMutation(const nsTArray<RefPtr<nsIMsgDBHdr>>& messages,
+                               const nsACString& keywords, bool add);
+
+  /** The account's Trash folder, or null. */
+  nsresult GetTrashFolder(nsIMsgFolder** trashFolder);
+
+  /** Whether this folder is the Trash folder or inside it. */
+  bool IsInTrash();
+
+  /**
+   * The JMAP id to use as the parent when creating a mailbox below this
+   * folder: empty for the root folder.
+   */
+  nsresult GetParentIdForChildren(nsACString& parentId);
+
+  /**
+   * Run incoming filters and junk classification on as many queued new
+   * messages as possible. Mirrors ExchangeFolder::PerformFiltering.
+   */
+  nsresult PerformFiltering();
+
+  /** Whether children have been discovered from the local store. */
+  bool mHasLoadedSubfolders;
+
+  /** New messages waiting for incoming filters. */
+  nsTArray<nsMsgKey> mFilterQueue;
+
+  /** Junk messages to move at the end of a classification batch. */
+  nsTArray<nsMsgKey> mSpamKeysToMove;
+
+  /** Cached quota JSON from IJmapClient.getQuota (root folder only). */
+  nsCString mQuotaJSON;
+
+  /** Whether a quota request has been made (root folder only). */
+  bool mQuotaRequested;
+};
+
+#endif  // COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPFOLDER_H_
