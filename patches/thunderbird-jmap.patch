diff --git a/mail/components/accountcreation/test/xpcshell/test_jmapDiscovery.js b/mail/components/accountcreation/test/xpcshell/test_jmapDiscovery.js
new file mode 100644
index 00000000000..bb0674445b7
--- /dev/null
+++ b/mail/components/accountcreation/test/xpcshell/test_jmapDiscovery.js
@@ -0,0 +1,258 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Tests JMAP discovery (JmapDiscovery.sys.mjs) with a mocked fetch, the
+ * AccountConfig JMAP preference ordering and autoconfig XML parsing of
+ * <incomingServer type="jmap">.
+ */
+
+const { JmapDiscovery, JmapDiscoveryInternal } = ChromeUtils.importESModule(
+  "resource:///modules/accountcreation/JmapDiscovery.sys.mjs"
+);
+const { AccountConfig } = ChromeUtils.importESModule(
+  "resource:///modules/accountcreation/AccountConfig.sys.mjs"
+);
+const { readFromXML } = ChromeUtils.importESModule(
+  "resource:///modules/accountcreation/readFromXML.sys.mjs"
+);
+const { JXON } = ChromeUtils.importESModule("resource:///modules/JXON.sys.mjs");
+
+const originalFetch = JmapDiscoveryInternal.fetch;
+
+/**
+ * Install a fake fetch. `routes` maps a URL to {status, url, json}.
+ *
+ * @param {object} routes
+ * @returns {string[]} The list of requested URLs (filled as requests happen).
+ */
+function mockFetch(routes) {
+  const requested = [];
+  JmapDiscoveryInternal.fetch = async (url, options) => {
+    requested.push({ url, options });
+    const route = routes[url];
+    if (!route) {
+      throw new TypeError("NetworkError when attempting to fetch resource.");
+    }
+    return {
+      status: route.status,
+      ok: route.status >= 200 && route.status < 300,
+      url: route.url ?? url,
+      json: async () => {
+        if (route.json === undefined) {
+          throw new SyntaxError("not json");
+        }
+        return route.json;
+      },
+    };
+  };
+  return requested;
+}
+
+registerCleanupFunction(() => {
+  JmapDiscoveryInternal.fetch = originalFetch;
+  Services.prefs.clearUserPref("mail.jmap.enabled");
+});
+
+add_task(function test_candidateHosts() {
+  Assert.deepEqual(
+    JmapDiscovery.candidateHosts("Example.com", [
+      "mail.example.com",
+      "MAIL.example.com.",
+      "%EMAILDOMAIN%",
+      null,
+      "example.com",
+    ]),
+    ["example.com", "mail.example.com", "jmap.example.com"],
+    "hosts are normalized, de-duplicated and placeholders dropped"
+  );
+});
+
+add_task(async function test_probe401AfterRedirect() {
+  // Stalwart-like: the email domain doesn't answer, the IMAP host redirects
+  // /.well-known/jmap (307) to /jmap/session which requires auth.
+  const requested = mockFetch({
+    "https://mail.example.com/.well-known/jmap": {
+      status: 401,
+      url: "https://mail.example.com/jmap/session",
+    },
+  });
+  const found = await JmapDiscovery.probeHosts(
+    JmapDiscovery.candidateHosts("example.com", ["mail.example.com"])
+  );
+  Assert.ok(found, "JMAP found");
+  Assert.equal(found.host, "mail.example.com");
+  Assert.equal(found.sessionUrl, "https://mail.example.com/jmap/session");
+  Assert.ok(found.needsAuth);
+  Assert.ok(
+    requested.some(r => r.url == "https://example.com/.well-known/jmap"),
+    "email domain was probed too"
+  );
+  Assert.equal(requested[0].options.credentials, "omit");
+  Assert.equal(requested[0].options.redirect, "follow");
+});
+
+add_task(async function test_probeOpenSession() {
+  mockFetch({
+    "https://example.org/.well-known/jmap": {
+      status: 200,
+      url: "https://example.org/jmap/session",
+      json: {
+        apiUrl: "https://example.org/jmap/api",
+        capabilities: {
+          "urn:ietf:params:jmap:core": {},
+          "urn:ietf:params:jmap:mail": {},
+        },
+      },
+    },
+  });
+  const found = await JmapDiscovery.probeHost("example.org");
+  Assert.equal(found.sessionUrl, "https://example.org/jmap/session");
+  Assert.ok(!found.needsAuth);
+});
+
+add_task(async function test_probeNotJmap() {
+  mockFetch({
+    "https://web.example.net/.well-known/jmap": { status: 404 },
+    "https://html.example.net/.well-known/jmap": { status: 200 },
+  });
+  Assert.equal(await JmapDiscovery.probeHost("web.example.net"), null);
+  Assert.equal(
+    await JmapDiscovery.probeHost("html.example.net"),
+    null,
+    "200 without a JSON session is not JMAP"
+  );
+  Assert.equal(await JmapDiscovery.probeHost("down.example.net"), null);
+});
+
+add_task(async function test_probeSiteWideAuthNotJmap() {
+  // A 401/403 without WWW-Authenticate, JSON or a redirect to a JMAP path
+  // (site-wide auth, WAF) is not taken as JMAP.
+  mockFetch({
+    "https://waf.example.net/.well-known/jmap": { status: 403 },
+  });
+  Assert.equal(await JmapDiscovery.probeHost("waf.example.net"), null);
+});
+
+add_task(async function test_addJmapToConfigPrefersJmap() {
+  const config = new AccountConfig();
+  config.incoming.type = "imap";
+  config.incoming.hostname = "mail.example.com";
+  const pop = config.createNewIncoming();
+  pop.type = "pop3";
+  config.incomingAlternatives.push(pop);
+  config.outgoing.type = "smtp";
+  config.outgoing.hostname = "mail.example.com";
+
+  JmapDiscovery.addJmapToConfig(config, {
+    host: "mail.example.com",
+    sessionUrl: "https://mail.example.com/jmap/session",
+    needsAuth: true,
+  });
+
+  Assert.equal(config.incoming.type, "jmap", "JMAP is preselected");
+  Assert.equal(
+    config.incoming.sessionUrl,
+    "https://mail.example.com/jmap/session"
+  );
+  Assert.equal(config.incoming.port, 443);
+  Assert.equal(config.incoming.socketType, Ci.nsMsgSocketType.SSL);
+  Assert.equal(config.incoming.username, "%EMAILADDRESS%");
+  Assert.deepEqual(
+    config.incomingAlternatives.map(i => i.type),
+    ["imap", "pop3"],
+    "IMAP/POP3 remain as alternatives"
+  );
+
+  // Capabilities unknown and SMTP found: send via SMTP until verified.
+  Assert.ok(!config.usesJmapSubmission());
+  config.incoming.jmapCapabilities = [
+    "urn:ietf:params:jmap:core",
+    "urn:ietf:params:jmap:mail",
+    "urn:ietf:params:jmap:submission",
+  ];
+  Assert.ok(config.usesJmapSubmission(), "submission advertised");
+  Assert.ok(config.configureOutgoingFromIncoming());
+  config.incoming.jmapCapabilities = ["urn:ietf:params:jmap:mail"];
+  Assert.ok(!config.configureOutgoingFromIncoming(), "falls back to SMTP");
+});
+
+add_task(async function test_fetchSession() {
+  const requested = mockFetch({
+    "https://mail.example.com/jmap/session": {
+      status: 200,
+      json: {
+        apiUrl: "https://mail.example.com/jmap/",
+        capabilities: {
+          "urn:ietf:params:jmap:core": {},
+          "urn:ietf:params:jmap:mail": {},
+          "urn:ietf:params:jmap:submission": {},
+          "urn:ietf:params:jmap:contacts": {},
+        },
+      },
+    },
+  });
+  const session = await JmapDiscovery.fetchSession(
+    "https://mail.example.com/jmap/session",
+    "user@example.com",
+    "pässword"
+  );
+  Assert.ok(
+    requested[0].options.headers.Authorization.startsWith("Basic "),
+    "basic auth sent"
+  );
+  const summary = JmapDiscovery.summarizeCapabilities(session);
+  Assert.ok(summary.mail && summary.submission && summary.contacts);
+  Assert.ok(!summary.calendars && !summary.files);
+
+  mockFetch({
+    "https://mail.example.com/jmap/session": { status: 401 },
+  });
+  await Assert.rejects(
+    JmapDiscovery.fetchSession(
+      "https://mail.example.com/jmap/session",
+      "user@example.com",
+      "wrong"
+    ),
+    e => e.status == 401
+  );
+});
+
+add_task(function test_autoconfigJmapIncoming() {
+  Services.prefs.setBoolPref("mail.jmap.enabled", true);
+  const xml = `<?xml version="1.0"?>
+<clientConfig version="1.1">
+  <emailProvider id="example.com">
+    <domain>example.com</domain>
+    <incomingServer type="jmap">
+      <url>https://mail.example.com/jmap/session</url>
+      <username>%EMAILADDRESS%</username>
+      <authentication>password-cleartext</authentication>
+    </incomingServer>
+    <incomingServer type="imap">
+      <hostname>mail.example.com</hostname>
+      <port>993</port>
+      <socketType>SSL</socketType>
+      <username>%EMAILADDRESS%</username>
+      <authentication>password-cleartext</authentication>
+    </incomingServer>
+    <outgoingServer type="smtp">
+      <hostname>mail.example.com</hostname>
+      <port>465</port>
+      <socketType>SSL</socketType>
+      <username>%EMAILADDRESS%</username>
+      <authentication>password-cleartext</authentication>
+    </outgoingServer>
+  </emailProvider>
+</clientConfig>`;
+  const doc = new DOMParser().parseFromString(xml, "text/xml");
+  const config = readFromXML(JXON.build(doc), "test");
+  const all = [config.incoming, ...config.incomingAlternatives];
+  const jmap = all.find(i => i.type == "jmap");
+  Assert.ok(jmap, "jmap incoming parsed");
+  Assert.equal(jmap.sessionUrl, "https://mail.example.com/jmap/session");
+  Assert.equal(jmap.hostname, "mail.example.com");
+  config.preferJmap();
+  Assert.equal(config.incoming.type, "jmap");
+});
