+   *   `{ isEnabled: true, subject: "Away" }`.
+   * @param {object} [options]
+   * @param {string} [options.accountId]
+   * @returns {Promise<object>}
+   */
+  async setVacationResponse(values, { accountId } = {}) {
+    return this.#call("VacationResponse/set", {
+      accountId: this.mailAccountId(accountId),
+      update: { singleton: values },
+    });
+  }
+
+  /**
+   * Convenience wrapper around `client.call` that returns the method args.
+   *
+   * @param {string} name
+   * @param {object} args
+   * @param {object} [options]
+   * @returns {Promise<object>}
+   */
+  async #call(name, args, options) {
+    const { args: responseArgs } = await this.#client.call(name, args, options);
+    return responseArgs;
+  }
+}
diff --git a/mailnews/protocols/jmap/modules/JmapMailboxSync.sys.mjs b/mailnews/protocols/jmap/modules/JmapMailboxSync.sys.mjs
new file mode 100644
index 00000000000..9a2ec38e841
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapMailboxSync.sys.mjs
@@ -0,0 +1,187 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import {
+  JmapAuthError,
+  JmapNetworkError,
+  JmapSessionError,
+} from "resource:///modules/jmap/JmapErrors.sys.mjs";
+
+/**
+ * Compute Thunderbird folder flags from a JMAP mailbox role.
+ *
+ * RFC 8621 defines a fixed set of roles. Roles which have no Thunderbird
+ * equivalent (such as `flagged` or `important`) are represented as normal
+ * folders for now.
+ *
+ * @param {?string} role
+ * @returns {number} A combination of `nsMsgFolderFlags` values.
+ */
+export function folderFlagsForRole(role) {
+  switch (role) {
+    case "inbox":
+      return Ci.nsMsgFolderFlags.Inbox;
+    case "archive":
+      return Ci.nsMsgFolderFlags.Archive;
+    case "drafts":
+      return Ci.nsMsgFolderFlags.Drafts;
+    case "sent":
+      return Ci.nsMsgFolderFlags.SentMail;
+    case "trash":
+      return Ci.nsMsgFolderFlags.Trash;
+    case "junk":
+      return Ci.nsMsgFolderFlags.Junk;
+    case "all":
+      return Ci.nsMsgFolderFlags.AllMail;
+    default:
+      return 0;
+  }
+}
+
+/**
+ * A JMAP mailbox exposed over XPCOM.
+ */
+export class JmapMailbox {
+  #mailbox;
+
+  /**
+   * @param {object} mailbox - A `Mailbox` object from `Mailbox/get`.
+   */
+  constructor(mailbox) {
+    this.#mailbox = mailbox ?? {};
+  }
+
+  get id() {
+    return this.#mailbox.id ?? "";
+  }
+
+  get parentId() {
+    return this.#mailbox.parentId ?? "";
+  }
+
+  get name() {
+    return this.#mailbox.name ?? "";
+  }
+
+  get role() {
+    return this.#mailbox.role ?? "";
+  }
+
+  get sortOrder() {
+    return Number(this.#mailbox.sortOrder) || 0;
+  }
+
+  get folderFlags() {
+    return folderFlagsForRole(this.#mailbox.role);
+  }
+
+  get totalEmails() {
+    return Number(this.#mailbox.totalEmails) || 0;
+  }
+
+  get unreadEmails() {
+    return Number(this.#mailbox.unreadEmails) || 0;
+  }
+
+  get totalThreads() {
+    return Number(this.#mailbox.totalThreads) || 0;
+  }
+
+  get unreadThreads() {
+    return Number(this.#mailbox.unreadThreads) || 0;
+  }
+
+  QueryInterface = ChromeUtils.generateQI(["IJmapMailbox"]);
+}
+
+/**
+ * Sort mailboxes so that every parent appears before its children.
+ *
+ * JMAP does not require `Mailbox/get` to return mailboxes in tree order, but
+ * the account integration creates folders as the list is delivered and needs
+ * the parent to exist first.
+ *
+ * The sort is stable for mailboxes at the same depth and tolerates cycles and
+ * references to missing parents.
+ *
+ * @param {object[]} mailboxes
+ * @returns {object[]}
+ */
+export function sortMailboxesByDepth(mailboxes) {
+  const byId = new Map();
+  for (const mailbox of mailboxes) {
+    if (mailbox?.id) {
+      byId.set(mailbox.id, mailbox);
+    }
+  }
+
+  const cache = new Map();
+
+  function depth(mailbox, visiting) {
+    if (cache.has(mailbox.id)) {
+      return cache.get(mailbox.id);
+    }
+    const parent = mailbox.parentId ? byId.get(mailbox.parentId) : null;
+    if (!parent || visiting.has(mailbox.id)) {
+      cache.set(mailbox.id, 0);
+      return 0;
+    }
+    visiting.add(mailbox.id);
+    const result = 1 + depth(parent, visiting);
+    visiting.delete(mailbox.id);
+    cache.set(mailbox.id, result);
+    return result;
+  }
+
+  return [...mailboxes].sort((a, b) => {
+    const aDepth = a?.id ? depth(a, new Set()) : 0;
+    const bDepth = b?.id ? depth(b, new Set()) : 0;
+    return aDepth - bDepth;
+  });
+}
+
+/**
+ * Deliver every mailbox of an account to a listener, followed by the mailbox
+ * list state token.
+ *
+ * This is kept separate from the XPCOM component so it can be tested without
+ * a running HTTP server.
+ *
+ * @param {{getMailboxes: Function}} mail - A `JmapMailClient`, or an object
+ *   with a compatible `getMailboxes` method.
+ * @param {IJmapMailboxListener} listener
+ * @returns {Promise<{count: number, state: string}>}
+ */
+export async function syncMailboxes(mail, listener) {
+  const { list = [], state = "" } = await mail.getMailboxes();
+
+  let count = 0;
+  for (const mailbox of sortMailboxesByDepth(list)) {
+    listener.onMailbox(new JmapMailbox(mailbox));
+    count++;
+  }
+  listener.onComplete(state ?? "");
+
+  return { count, state: state ?? "" };
+}
+
+/**
+ * Translate a JMAP client error into an XPCOM error code.
+ *
+ * @param {*} error
+ * @returns {number}
+ */
+export function toNsresult(error) {
+  if (error instanceof JmapAuthError) {
+    // The account needs new credentials; callers can prompt the user.
+    return Cr.NS_ERROR_FAILURE;
+  }
+  if (error instanceof JmapNetworkError) {
+    return Cr.NS_ERROR_NOT_AVAILABLE;
+  }
+  if (error instanceof JmapSessionError) {
+    return Cr.NS_ERROR_UNEXPECTED;
+  }
+  return Cr.NS_ERROR_FAILURE;
+}
diff --git a/mailnews/protocols/jmap/modules/JmapMessage.sys.mjs b/mailnews/protocols/jmap/modules/JmapMessage.sys.mjs
new file mode 100644
index 00000000000..703c46ae040
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapMessage.sys.mjs
@@ -0,0 +1,304 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Conversion of JMAP `Email` objects into the fields of a local
+ * `nsIMsgDBHdr`.
+ *
+ * Everything here is pure: no database or folder access happens in this
+ * module, which keeps it testable outside a running Thunderbird.
+ */
+
+/**
+ * JMAP keyword which corresponds to a Thunderbird message flag.
+ */
+const KEYWORD_FLAGS = new Map([
+  ["$seen", Ci.nsMsgMessageFlags.Read],
+  ["$flagged", Ci.nsMsgMessageFlags.Marked],
+  ["$answered", Ci.nsMsgMessageFlags.Replied],
+  ["$forwarded", Ci.nsMsgMessageFlags.Forwarded],
+]);
+
+/**
+ * Prefixes used for reply and forward subjects.
+ */
+const REPLY_PREFIX = /^\s*(?:re|fwd?|aw|sv)\s*:/i;
+
+/**
+ * Property name under which the JMAP email id is stored on a local header.
+ */
+export const JMAP_ID_PROPERTY = "jmapId";
+
+/**
+ * Property name under which the JMAP mailbox ids are stored on a header.
+ */
+export const JMAP_MAILBOX_IDS_PROPERTY = "jmapMailboxIds";
+
+/**
+ * Property name under which the JMAP keywords are stored on a header.
+ */
+export const JMAP_KEYWORDS_PROPERTY = "jmapKeywords";
+
+/**
+ * Property name under which the JMAP thread id is stored on a header.
+ */
+export const JMAP_THREAD_ID_PROPERTY = "jmapThreadId";
+
+/**
+ * Thunderbird header property holding the space-separated tag keywords.
+ */
+export const TB_KEYWORDS_PROPERTY = "keywords";
+
+/**
+ * JMAP system keywords which map onto flags or junk state rather than tags.
+ */
+const SYSTEM_KEYWORDS = new Set([
+  "$seen",
+  "$flagged",
+  "$answered",
+  "$forwarded",
+  "$draft",
+  "$junk",
+  "$notjunk",
+  "$phishing",
+]);
+
+/**
+ * The Thunderbird tag keywords contained in a JMAP keyword map: every
+ * keyword except the system keywords which Thunderbird represents as flags.
+ * JMAP keywords are case-insensitive, Thunderbird tag keys are lower case.
+ *
+ * @param {?object|string[]} keywords
+ * @returns {string[]}
+ */
+export function tagKeywords(keywords) {
+  const tags = new Set();
+  for (const keyword of keywordList(keywords)) {
+    const lower = keyword.toLowerCase();
+    if (!SYSTEM_KEYWORDS.has(lower)) {
+      tags.add(lower);
+    }
+  }
+  return [...tags].sort();
+}
+
+/**
+ * Strip the angle brackets from a Message-ID.
+ *
+ * `nsIMsgDatabase.getMsgHdrForMessageID` and the `messageId` attribute on
+ * `nsIMsgDBHdr` expect the value without angle brackets.
+ *
+ * @param {?string} value
+ * @returns {string}
+ */
+export function stripMessageId(value) {
+  if (!value) {
+    return "";
+  }
+  return String(value).trim().replace(/^</, "").replace(/>$/, "");
+}
+
+/**
+ * Format one JMAP `EmailAddress` the way Thunderbird stores addresses.
+ *
+ * @param {{name?: ?string, email?: ?string}} address
+ * @returns {string}
+ */
+export function formatAddress(address) {
+  const email = address?.email?.trim() ?? "";
+  const name = address?.name?.trim() ?? "";
+  if (!email) {
+    return "";
+  }
+  return name ? `${name} <${email}>` : email;
+}
+
+/**
+ * Format a list of JMAP `EmailAddress` objects as a comma-separated string.
+ *
+ * @param {?object[]} addresses
+ * @returns {string}
+ */
+export function formatAddressList(addresses) {
+  return (addresses ?? []).map(formatAddress).filter(Boolean).join(", ");
+}
+
+/**
+ * Convert a JMAP `UTCDate` into the microsecond `PRTime` used by
+ * `nsIMsgDBHdr.date`.
+ *
+ * @param {?string} value
+ * @returns {number}
+ */
+export function toPrTime(value) {
+  if (!value) {
+    return 0;
+  }
+  const milliseconds = Date.parse(value);
+  if (!Number.isFinite(milliseconds) || milliseconds <= 0) {
+    return 0;
+  }
+  return Math.floor(milliseconds * 1000);
+}
+
+/**
+ * Convert a JMAP keyword map into the set of Thunderbird flags it implies.
+ *
+ * @param {?object|string[]} keywords
+ * @returns {number}
+ */
+export function keywordFlags(keywords) {
+  let flags = 0;
+  for (const [keyword, flag] of KEYWORD_FLAGS) {
+    if (hasKeyword(keywords, keyword)) {
+      flags |= flag;
+    }
+  }
+  return flags;
+}
+
+/**
+ * Test whether a JMAP keyword map contains a keyword.
+ *
+ * @param {?object|string[]} keywords
+ * @param {string} keyword
+ * @returns {boolean}
+ */
+export function hasKeyword(keywords, keyword) {
+  if (!keywords) {
+    return false;
+  }
+  if (Array.isArray(keywords)) {
+    return keywords.includes(keyword);
+  }
+  return keywords[keyword] === true;
+}
+
+/**
+ * Convert a JMAP keyword map into a sorted array of keywords.
+ *
+ * @param {?object|string[]} keywords
+ * @returns {string[]}
+ */
+export function keywordList(keywords) {
+  if (!keywords) {
+    return [];
+  }
+  if (Array.isArray(keywords)) {
+    return [...keywords].sort();
+  }
+  return Object.keys(keywords)
+    .filter(keyword => keywords[keyword] === true)
+    .sort();
+}
+
+/**
+ * The junk score implied by the JMAP `$junk`/`$notjunk` keywords.
+ *
+ * @param {?object|string[]} keywords
+ * @returns {?number} 100 for junk, 0 for explicitly not junk, or null.
+ */
+export function junkScore(keywords) {
+  if (hasKeyword(keywords, "$junk")) {
+    return 100;
+  }
+  if (hasKeyword(keywords, "$notjunk")) {
+    return 0;
+  }
+  return null;
+}
+
+/**
+ * Whether a subject should get the `HasRe` flag.
+ *
+ * @param {?string} subject
+ * @returns {boolean}
+ */
+export function subjectHasReplyPrefix(subject) {
+  return REPLY_PREFIX.test(subject ?? "");
+}
+
+/**
+ * Normalize a JMAP `Email` object into local header fields.
+ *
+ * @param {object} email - An `Email` from `Email/get`.
+ * @param {object} [options]
+ * @param {boolean} [options.isNew=false] - Mark unread messages as new so
+ *   biff and the new-mail notification fire. Only used for messages which
+ *   arrived in an incremental sync.
+ * @returns {object}
+ */
+export function normalizeEmail(email, { isNew = false } = {}) {
+  const keywords = email?.keywords;
+  const subject = email?.subject ?? "";
+  const from = email?.from?.length ? email.from : email?.sender;
+  const receivedAt = email?.receivedAt ?? email?.sentAt;
+
+  let flags = keywordFlags(keywords);
+  if (email?.hasAttachment) {
+    flags |= Ci.nsMsgMessageFlags.Attachment;
+  }
+  if (subjectHasReplyPrefix(subject)) {
+    flags |= Ci.nsMsgMessageFlags.HasRe;
+  }
+  if (isNew && !hasKeyword(keywords, "$seen")) {
+    flags |= Ci.nsMsgMessageFlags.New;
+  }
+
+  const references = (email?.references ?? [])
+    .map(stripMessageId)
+    .filter(Boolean)
+    .map(id => `<${id}>`)
+    .join(" ");
+
+  const size = Number(email?.size);
+
+  return {
+    id: email?.id ?? "",
+    threadId: email?.threadId ?? "",
+    mailboxIds: Object.keys(email?.mailboxIds ?? {}),
+    subject,
+    author: formatAddress(from?.[0]),
+    recipients: formatAddressList(email?.to),
+    ccList: formatAddressList(email?.cc),
+    bccList: formatAddressList(email?.bcc),
+    messageId: stripMessageId(email?.messageId?.[0]),
+    references,
+    date: toPrTime(receivedAt),
+    size:
+      Number.isFinite(size) && size > 0
+        ? Math.min(size, 0xffffffff)
+        : 0,
+    flags,
+    keywords: keywordList(keywords),
+    tags: tagKeywords(keywords).join(" "),
+    preview: email?.preview ?? "",
+    junkScore: junkScore(keywords),
+    hasAttachment: Boolean(email?.hasAttachment),
+    isRead: hasKeyword(keywords, "$seen"),
+    isFlagged: hasKeyword(keywords, "$flagged"),
+    isReplied: hasKeyword(keywords, "$answered"),
+    isForwarded: hasKeyword(keywords, "$forwarded"),
+  };
+}
+
+/**
+ * Build the string stored in the `jmapMailboxIds` header property.
+ *
+ * @param {string[]} mailboxIds
+ * @returns {string}
+ */
+export function mailboxIdsToString(mailboxIds) {
+  return [...mailboxIds].sort().join(" ");
+}
+
+/**
+ * Parse the `jmapMailboxIds` header property.
+ *
+ * @param {?string} value
+ * @returns {string[]}
+ */
+export function parseMailboxIds(value) {
+  return (value ?? "").split(/\s+/).filter(Boolean);
+}
diff --git a/mailnews/protocols/jmap/modules/JmapMessageBuilder.sys.mjs b/mailnews/protocols/jmap/modules/JmapMessageBuilder.sys.mjs
new file mode 100644
index 00000000000..c0411b012d0
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapMessageBuilder.sys.mjs
@@ -0,0 +1,669 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import {
+  chooseTransferEncoding,
+  encodeAddress,
+  encodeAddressList,
+  encodeBase64,
+  encodeHeaderValue,
+  encodeParameter,
+  encodeQuotedPrintable,
+  foldHeader,
+  formatRfc5322Date,
+  isAscii,
+  normalizeNewlines,
+  sanitizeHeaderValue,
+  utf8,
+} from "resource:///modules/jmap/JmapMimeEncoder.sys.mjs";
+import { stripMessageId } from "resource:///modules/jmap/JmapMessage.sys.mjs";
+
+/**
+ * Error raised when a message cannot be reconstructed.
+ */
+export class MessageBuildError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = "MessageBuildError";
+  }
+}
+
+/**
+ * Normalize a MIME type by dropping its parameters.
+ *
+ * @param {?string} type
+ * @returns {string}
+ */
+function baseType(type) {
+  return (type ?? "").split(";")[0].trim().toLowerCase() || "text/plain";
+}
+
+/**
+ * Stable key for a part, used to deduplicate the body lists.
+ *
+ * @param {object} part
+ * @param {number} index
+ * @returns {string}
+ */
+function partKey(part, index) {
+  return part?.partId ?? part?.blobId ?? `#${index}`;
+}
+
+/**
+ * @param {object[]} parts
+ * @returns {object[]}
+ */
+function uniqueParts(parts) {
+  const seen = new Set();
+  const result = [];
+  parts.forEach((part, index) => {
+    const key = partKey(part, index);
+    if (seen.has(key)) {
+      return;
+    }
+    seen.add(key);
+    result.push(part);
+  });
+  return result;
+}
+
+/**
+ * Whether HTML references a cid.
+ *
+ * @param {string} html
+ * @param {string} cid
+ * @returns {boolean}
+ */
+function referencesCid(html, cid) {
+  if (!html || !cid) {
+    return false;
+  }
+  const clean = cid.replace(/^<|>$/g, "");
+  return html.includes(`cid:${clean}`) || html.includes(`cid:${encodeURIComponent(clean)}`);
+}
+
+/**
+ * Walk a `bodyStructure` and split its leaves into text, html and attachments.
+ *
+ * Used when the server did not return `textBody`/`htmlBody`/`attachments`.
+ *
+ * @param {?object} structure
+ * @returns {{text: object[], html: object[], attachments: object[]}}
+ */
+export function decomposeBodyStructure(structure) {
+  const text = [];
+  const html = [];
+  const attachments = [];
+
+  const visit = part => {
+    if (!part) {
+      return;
+    }
+    const type = baseType(part.type);
+    if (type.startsWith("multipart/")) {
+      for (const child of part.subParts ?? []) {
+        visit(child);
+      }
+      return;
+    }
+    if (type === "text/plain") {
+      text.push(part);
+    } else if (type === "text/html") {
+      html.push(part);
+    } else {
+      attachments.push(part);
+    }
+  };
+
+  visit(structure);
+  return { text, html, attachments };
+}
+
+/**
+ * Split the body of an email into the lists needed by the builder.
+ *
+ * @param {object} email
+ * @returns {{plain: object[], html: object[], inline: object[],
+ *   attachments: object[]}}
+ */
+export function collectBodyParts(email) {
+  let plain = uniqueParts(
+    (email.textBody ?? []).filter(part => baseType(part.type) === "text/plain")
+  );
+  let html = uniqueParts(
+    (email.htmlBody ?? []).filter(part => baseType(part.type) === "text/html")
+  );
+  let attachments = uniqueParts(email.attachments ?? []);
+
+  if (!plain.length && !html.length && email.bodyStructure) {
+    const decomposed = decomposeBodyStructure(email.bodyStructure);
+    plain = uniqueParts(
+      decomposed.text.filter(part => baseType(part.type) === "text/plain")
+    );
+    html = uniqueParts(
+      decomposed.html.filter(part => baseType(part.type) === "text/html")
+    );
+    attachments = uniqueParts(decomposed.attachments);
+  }
+
+  const plainKeys = new Set(plain.map((part, index) => partKey(part, index)));
+  html = html.filter((part, index) => !plainKeys.has(partKey(part, index)));
+
+  const usedKeys = new Set([
+    ...plainKeys,
+    ...html.map((part, index) => partKey(part, index)),
+  ]);
+  attachments = attachments.filter(
+    (part, index) => !usedKeys.has(partKey(part, index))
+  );
+
+  const htmlText = html
+    .map(part => email.bodyValues?.[part.partId]?.value ?? "")
+    .join("\r\n");
+
+  const inline = [];
+  const remaining = [];
+  for (const part of attachments) {
+    if (part.cid && referencesCid(htmlText, part.cid)) {
+      inline.push(part);
+    } else {
+      remaining.push(part);
+    }
+  }
+
+  return { plain, html, inline, attachments: remaining };
+}
+
+/**
+ * Build the top-level RFC 5322 header block.
+ *
+ * The `Content-Type` header is generated separately, together with the MIME
+ * body tree.
+ *
+ * @param {object} email
+ * @param {object} [options]
+ * @returns {Array<[string, string]>}
+ */
+export function buildMessageHeaders(email, options = {}) {
+  const headers = [];
+  const now = options.now ? options.now() : Date.now();
+
+  headers.push(["MIME-Version", "1.0"]);
+  headers.push([
+    "Date",
+    formatRfc5322Date(
+      email.sentAt ?? email.receivedAt,
+      Math.max(0, now) * 1000
+    ),
+  ]);
+
+  const from = encodeAddressList(email.from);
+  if (from) {
+    headers.push(["From", from]);
+  }
+  const sender = encodeAddress(email.sender);
+  if (sender && sender !== from) {
+    headers.push(["Sender", sender]);
+  }
+  const replyTo = encodeAddressList(email.replyTo);
+  if (replyTo) {
+    headers.push(["Reply-To", replyTo]);
+  }
+
+  for (const [field, value] of [
+    ["To", email.to],
+    ["Cc", email.cc],
+    ["Bcc", email.bcc],
+  ]) {
+    const encoded = encodeAddressList(value);
+    if (encoded) {
+      headers.push([field, encoded]);
+    }
+  }
+
+  headers.push(["Subject", encodeHeaderValue(email.subject ?? "")]);
+
+  const domain =
+    (email.from?.[0]?.email ?? "").split("@")[1] || "jmap.invalid";
+  const firstId = stripMessageId(email.messageId?.[0]);
+  const localPart = sanitizeHeaderValue(email.id).replace(
+    /[^A-Za-z0-9._-]/g,
+    ""
+  );
+  const messageId =
+    firstId || `jmap.${localPart || "message"}@${domain}`;
+  headers.push(["Message-ID", `<${messageId}>`]);
+
+  const inReplyTo = (email.inReplyTo ?? [])
+    .map(stripMessageId)
+    .filter(Boolean)
+    .map(id => `<${id}>`)
+    .join(" ");
+  if (inReplyTo) {
+    headers.push(["In-Reply-To", inReplyTo]);
+  }
+
+  const references = (email.references ?? [])
+    .map(stripMessageId)
+    .filter(Boolean)
+    .map(id => `<${id}>`)
+    .join(" ");
+  if (references) {
+    headers.push(["References", references]);
+  }
+
+  return headers;
+}
+
+/**
+ * Builder state, shared by the recursive serialization functions.
+ */
+class BuildContext {
+  constructor(email, options) {
+    this.email = email;
+    this.options = options;
+    this.bodyValues = options.bodyValues ?? email.bodyValues ?? {};
+    this.partMap = new Map();
+    this.boundaryPrefix = options.boundaryPrefix ?? "----=_JMAP_";
+    this.boundaryCounter = 0;
+    this.totalBytes = 0;
+    this.maxTotalBytes = options.maxTotalBytes ?? 64 * 1024 * 1024;
+  }
+
+  newBoundary() {
+    this.boundaryCounter++;
+    return `${this.boundaryPrefix}${this.boundaryCounter}@jmap.invalid`;
+  }
+
+  /**
+   * @param {string} blobId
+   * @returns {Promise<Uint8Array>}
+   */
+  async fetchBlob(blobId) {
+    if (!this.options.getBlob) {
+      throw new MessageBuildError(
+        `No blob loader is available for part ${blobId}`
+      );
+    }
+    const data = await this.options.getBlob(blobId);
+    if (data instanceof Uint8Array) {
+      return data;
+    }
+    if (data instanceof ArrayBuffer) {
+      return new Uint8Array(data);
+    }
+    if (ArrayBuffer.isView(data)) {
+      return new Uint8Array(data.buffer, data.byteOffset, data.byteLength);
+    }
+    throw new MessageBuildError(`Blob ${blobId} is not binary data`);
+  }
+
+  /**
+   * Whether the bytes of an attachment should be embedded.
+   *
+   * @param {"body"|"inline"|"attachment"} role
+   * @returns {boolean}
+   */
+  includesData(role) {
+    const mode = this.options.includeAttachmentData ?? "none";
+    if (role === "body") {
+      return true;
+    }
+    if (mode === "all") {
+      return true;
+    }
+    return mode === "inline" && role === "inline";
+  }
+
+  addBytes(count) {
+    this.totalBytes += count;
+    if (this.totalBytes > this.maxTotalBytes) {
+      throw new MessageBuildError("Reconstructed message exceeds size limit");
+    }
+  }
+}
+
+/**
+ * Build a leaf entity (a single MIME part).
+ *
+ * @param {BuildContext} context
+ * @param {object} part
+ * @param {"body"|"inline"|"attachment"} role
+ * @returns {Promise<object>}
+ */
+async function makeLeaf(context, part, role) {
+  const type = baseType(part.type);
+  let charset = part.charset || "utf-8";
+  let bytes = new Uint8Array(0);
+  let fromValues = false;
+  let truncated = false;
+  let encodingProblem = false;
+
+  const bodyValue = part.partId
+    ? context.bodyValues?.[part.partId]
+    : undefined;
+
+  if (bodyValue && typeof bodyValue.value === "string") {
+    bytes = utf8(normalizeNewlines(bodyValue.value));
+    charset = "utf-8";
+    fromValues = true;
+    truncated = Boolean(bodyValue.isTruncated);
+    encodingProblem = Boolean(bodyValue.isEncodingProblem);
+
+    // Prefer the untruncated blob when the server says the value was cut.
+    if (truncated && part.blobId && context.options.getBlob) {
+      bytes = await context.fetchBlob(part.blobId);
+      charset = part.charset || charset;
+      fromValues = false;
+      truncated = false;
+    }
+  } else if (part.blobId && context.includesData(role)) {
+    bytes = await context.fetchBlob(part.blobId);
+    charset = part.charset || charset;
+  }
+
+  let transferEncoding;
+  if (fromValues && type.startsWith("text/")) {
+    transferEncoding = chooseTransferEncoding(type, bytes);
+  } else if (type.startsWith("text/") && isAscii(bytesToString(bytes))) {
+    transferEncoding = "7bit";
+  } else if (!bytes.length) {
+    transferEncoding = type.startsWith("text/") ? "7bit" : "base64";
+  } else {
+    transferEncoding = "base64";
+  }
+
+  let encodedBody;
+  if (transferEncoding === "quoted-printable") {
+    encodedBody = encodeQuotedPrintable(bytesToString(bytes));
+  } else if (transferEncoding === "base64") {
+    encodedBody = encodeBase64(bytes);
+  } else {
+    encodedBody = bytes;
+  }
+
+  const headers = [];
+  headers.push([
+    "Content-Type",
+    `${type}; charset=${sanitizeCharset(charset)}`,
+  ]);
+  headers.push(["Content-Transfer-Encoding", transferEncoding]);
+
+  if (part.cid) {
+    headers.push(["Content-ID", `<${sanitizeCid(part.cid)}>`]);
+  }
+
+  const disposition = role === "attachment" ? "attachment" : "inline";
+  const filename = encodeParameter("filename", part.name);
+  if (role === "attachment" || part.name) {
+    headers.push([
+      "Content-Disposition",
+      filename ? `${disposition}; ${filename}` : disposition,
+    ]);
+  }
+
+  if (truncated) {
+    headers.push(["X-JMAP-Body-Truncated", "1"]);
+  }
+  if (encodingProblem) {
+    headers.push(["X-JMAP-Encoding-Problem", "1"]);
+  }
+
+  return {
+    kind: "leaf",
+    headers,
+    body: encodedBody,
+    type,
+    part,
+    charset,
+    role,
+  };
+}
+
+/**
+ * @param {Uint8Array} bytes
+ * @returns {string}
+ */
+function bytesToString(bytes) {
+  return new TextDecoder("utf-8").decode(bytes);
+}
+
+/**
+ * @param {?string} charset
+ * @returns {string}
+ */
+function sanitizeCharset(charset) {
+  const clean = sanitizeHeaderValue(charset).toLowerCase();
+  return /^[a-z0-9._:-]{1,64}$/.test(clean) ? clean : "utf-8";
+}
+
+/**
+ * @param {?string} cid
+ * @returns {string}
+ */
+function sanitizeCid(cid) {
+  const clean = sanitizeHeaderValue(cid).replace(/^<|>$/g, "");
+  return /^[^\s<>"'@]+@[^\s<>"']+$/.test(clean)
+    ? clean
+    : `jmap-${Math.random().toString(36).slice(2)}@jmap.invalid`;
+}
+
+/**
+ * Create a multipart entity.
+ *
+ * @param {string} subtype
+ * @param {object[]} children
+ * @param {object} [params]
+ * @returns {object}
+ */
+function multipart(subtype, children, params = {}) {
+  return { kind: "multipart", subtype, children, params };
+}
+
+/**
+ * Create the body tree for an email.
+ *
+ * @param {BuildContext} context
+ * @param {{plain: object[], html: object[], inline: object[],
+ *   attachments: object[]}} parts
+ * @returns {Promise<object>}
+ */
+async function makeBodyTree(context, parts) {
+  const plainLeaves = [];
+  for (const part of parts.plain) {
+    plainLeaves.push(await makeLeaf(context, part, "body"));
+  }
+
+  const htmlLeaves = [];
+  for (const part of parts.html) {
+    htmlLeaves.push(await makeLeaf(context, part, "body"));
+  }
+
+  const plainEntity =
+    plainLeaves.length === 1
+      ? plainLeaves[0]
+      : multipart("mixed", plainLeaves);
+
+  let htmlEntity =
+    htmlLeaves.length === 1
+      ? htmlLeaves[0]
+      : multipart("mixed", htmlLeaves);
+
+  if (parts.inline.length) {
+    const inlineLeaves = [];
+    for (const part of parts.inline) {
+      inlineLeaves.push(await makeLeaf(context, part, "inline"));
+    }
+    htmlEntity = multipart("related", [htmlEntity, ...inlineLeaves], {
+      type: "text/html",
+    });
+  }
+
+  let body;
+  if (plainLeaves.length && htmlLeaves.length) {
+    body = multipart("alternative", [plainEntity, htmlEntity]);
+  } else if (htmlLeaves.length) {
+    body = htmlEntity;
+  } else if (plainLeaves.length) {
+    body = plainEntity;
+  } else {
+    body = {
+      kind: "leaf",
+      headers: [
+        ["Content-Type", "text/plain; charset=utf-8"],
+        ["Content-Transfer-Encoding", "7bit"],
+      ],
+      body: new Uint8Array(0),
+      type: "text/plain",
+      part: {},
+      charset: "utf-8",
+      role: "body",
+    };
+  }
+
+  if (parts.attachments.length) {
+    const attachmentLeaves = [];
+    for (const part of parts.attachments) {
+      attachmentLeaves.push(await makeLeaf(context, part, "attachment"));
+    }
+    body = multipart("mixed", [body, ...attachmentLeaves]);
+  }
+
+  return body;
+}
+
+/**
+ * Serialize a MIME entity, including its headers and a trailing blank line.
+ *
+ * @param {BuildContext} context
+ * @param {object} entity
+ * @param {string} number - MIME part number, empty for the root.
+ * @returns {Promise<Uint8Array>}
+ */
+async function serializeEntity(context, entity, number) {
+  if (entity.kind === "leaf") {
+    const partNumber = number || "1";
+    context.partMap.set(partNumber, {
+      partId: entity.part.partId ?? null,
+      blobId: entity.part.blobId ?? null,
+      type: entity.type,
+      charset: entity.charset,
+      name: entity.part.name ?? null,
+      cid: entity.part.cid ?? null,
+      disposition:
+        entity.part.disposition ??
+        (entity.role === "attachment" ? "attachment" : "inline"),
+      size: entity.part.size ?? null,
+    });
+
+    const headerBytes = utf8(renderHeaders(entity.headers) + "\r\n\r\n");
+    context.addBytes(entity.body.length);
+    return concat([
+      headerBytes,
+      entity.body,
+      endsWithCrlf(entity.body) ? new Uint8Array(0) : utf8("\r\n"),
+    ]);
+  }
+
+  const boundary = context.newBoundary();
+  let contentType = `multipart/${entity.subtype}; boundary="${boundary}"`;
+  if (entity.subtype === "related") {
+    if (entity.params.type) {
+      contentType += `; type="${entity.params.type}"`;
+    }
+    if (entity.params.start) {
+      contentType += `; start="${entity.params.start}"`;
+    }
+  }
+
+  const chunks = [
+    utf8(renderHeaders([["Content-Type", contentType]]) + "\r\n\r\n"),
+  ];
+
+  let index = 0;
+  for (const child of entity.children) {
+    index++;
+    const childNumber = number ? `${number}.${index}` : `${index}`;
+    chunks.push(utf8(`--${boundary}\r\n`));
+    chunks.push(await serializeEntity(context, child, childNumber));
+  }
+  chunks.push(utf8(`--${boundary}--\r\n`));
+
+  return concat(chunks);
+}
+
+/**
+ * @param {Array<[string, string]>} headers
+ * @returns {string}
+ */
+function renderHeaders(headers) {
+  return headers
+    .map(([name, value]) => foldHeader(name, value))
+    .join("\r\n");
+}
+
+/**
+ * @param {Uint8Array} bytes
+ * @returns {boolean}
+ */
+function endsWithCrlf(bytes) {
+  return (
+    bytes.length >= 2 &&
+    bytes[bytes.length - 2] === 0x0d &&
+    bytes[bytes.length - 1] === 0x0a
+  );
+}
+
+/**
+ * @param {Uint8Array[]} chunks
+ * @returns {Uint8Array}
+ */
+function concat(chunks) {
+  const length = chunks.reduce((sum, chunk) => sum + chunk.length, 0);
+  const result = new Uint8Array(length);
+  let offset = 0;
+  for (const chunk of chunks) {
+    result.set(chunk, offset);
+    offset += chunk.length;
+  }
+  return result;
+}
+
+/**
+ * Reconstruct an RFC 5322 message from a JMAP `Email` object.
+ *
+ * @param {object} email - An `Email` with the body properties requested by
+ *   `EMAIL_DISPLAY_PROPERTIES`.
+ * @param {object} [options]
+ * @param {object} [options.bodyValues] - Override `email.bodyValues`.
+ * @param {(blobId: string) => Promise<Uint8Array>} [options.getBlob]
+ * @param {"none"|"inline"|"all"} [options.includeAttachmentData="none"]
+ * @param {number} [options.maxTotalBytes]
+ * @param {() => number} [options.now]
+ * @param {string} [options.boundaryPrefix]
+ * @returns {Promise<{bytes: Uint8Array, headers: Array<[string, string]>,
+ *   partMap: Map<string, object>, rootType: string}>}
+ */
+export async function buildMessage(email, options = {}) {
+  if (!email || typeof email != "object") {
+    throw new MessageBuildError("A JMAP Email object is required");
+  }
+
+  const context = new BuildContext(email, options);
+  const parts = collectBodyParts(email);
+  const root = await makeBodyTree(context, parts);
+  const topHeaders = buildMessageHeaders(email, options);
+  const bodyBytes = await serializeEntity(context, root, "");
+
+  const bytes = concat([utf8(renderHeaders(topHeaders) + "\r\n"), bodyBytes]);
+  return {
+    bytes,
+    headers: topHeaders,
+    partMap: context.partMap,
+    rootType:
+      root.kind === "multipart"
+        ? `multipart/${root.subtype}`
+        : root.type,
+  };
+}
