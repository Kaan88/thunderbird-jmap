+add_task(function test_fromJSCalendar_basic() {
+  const item = fromJSCalendar(EVENT);
+  Assert.ok(item.isEvent());
+  Assert.equal(item.id, EVENT.uid);
+  Assert.equal(item.getProperty(JMAP_ID_PROPERTY), "jmap-1");
+  Assert.equal(item.title, "Team meeting");
+  Assert.equal(item.getProperty("DESCRIPTION"), "Weekly sync");
+  Assert.equal(item.startDate.timezone.tzid, "Europe/Berlin");
+  Assert.equal(item.startDate.hour, 10);
+  Assert.equal(item.endDate.hour, 11);
+  Assert.equal(item.endDate.minute, 30);
+  Assert.equal(item.status, "CONFIRMED");
+  Assert.equal(item.getProperty("TRANSP"), "OPAQUE");
+  Assert.equal(item.privacy, "PRIVATE");
+  Assert.equal(item.getProperty("SEQUENCE"), 3);
+  Assert.equal(item.priority, 1);
+  Assert.deepEqual(item.getCategories().sort(), ["weekly", "work"]);
+  Assert.equal(item.getProperty("LOCATION"), "Room 101");
+
+  Assert.equal(item.organizer.id, "mailto:boss@example.com");
+  Assert.equal(item.organizer.commonName, "Boss");
+  const attendees = item.getAttendees();
+  Assert.equal(attendees.length, 2);
+  const alice = attendees.find(a => a.id == "mailto:alice@example.com");
+  Assert.equal(alice.role, "OPT-PARTICIPANT");
+  Assert.equal(alice.participationStatus, "TENTATIVE");
+  Assert.equal(alice.rsvp, "TRUE");
+  const boss = attendees.find(a => a.id == "mailto:boss@example.com");
+  Assert.equal(boss.role, "CHAIR");
+  Assert.equal(boss.participationStatus, "ACCEPTED");
+
+  const alarms = item.getAlarms();
+  Assert.equal(alarms.length, 2);
+  const relative = alarms.find(a => a.related == Ci.calIAlarm.ALARM_RELATED_START);
+  Assert.equal(relative.offset.icalString, "-PT15M");
+  Assert.equal(relative.action, "DISPLAY");
+  const absolute = alarms.find(a => a.related == Ci.calIAlarm.ALARM_RELATED_ABSOLUTE);
+  Assert.equal(absolute.action, "EMAIL");
+  Assert.equal(absolute.alarmDate.hour, 7);
+
+  const attachments = item.getAttachments();
+  Assert.equal(attachments.length, 1);
+  Assert.equal(attachments[0].uri.spec, "https://example.com/agenda.pdf");
+  Assert.equal(attachments[0].formatType, "application/pdf");
+});
