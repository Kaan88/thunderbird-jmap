+/**
+ * Wraps parallelAutoDiscoveryInner() and adds JMAP discovery: we probe
+ * `/.well-known/jmap` on the email domain right away (in parallel with the
+ * other mechanisms), and on all hostnames found by autoconfig/MX/Exchange once
+ * those are known. If JMAP is found, it is added as the preferred (first,
+ * preselected) incoming protocol.
+ *
+ * Same signature and semantics as parallelAutoDiscoveryInner().
+ */
+async function* parallelAutoDiscovery(
+  domain,
+  emailAddress,
+  abortSignal,
+  password,
+  exchangeUsername
+) {
+  const jmapEnabled = lazy.JmapDiscovery.isEnabled();
+  const domainProbe = jmapEnabled
+    ? lazy.JmapDiscovery.probeHosts(
+        lazy.JmapDiscovery.candidateHosts(domain),
+        abortSignal
+      ).catch(() => null)
+    : Promise.resolve(null);
+
+  const inner = parallelAutoDiscoveryInner(
+    domain,
+    emailAddress,
+    abortSignal,
+    password,
+    exchangeUsername
