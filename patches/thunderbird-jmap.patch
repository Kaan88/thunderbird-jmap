@@ -0,0 +1,106 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+const { JmapJSContact } = ChromeUtils.importESModule(
+  "resource:///modules/JmapJSContact.sys.mjs"
+);
+const { VCardProperties } = ChromeUtils.importESModule(
+  "resource:///modules/VCardUtils.sys.mjs"
+);
+
+const CARD = {
+  "@type": "Card",
+  version: "1.0",
+  id: "c1",
+  addressBookIds: { b1: true },
+  uid: "urn:uuid:1234",
+  name: {
+    components: [
+      { kind: "given", value: "Ada" },
+      { kind: "surname", value: "Lovelace" },
+    ],
+    full: "Ada Lovelace",
+  },
+  nicknames: { n1: { name: "Countess" } },
+  emails: {
+    e1: { address: "ada@example.com", contexts: { work: true }, pref: 1 },
+    e2: { address: "ada@home.example" },
+  },
+  phones: { p1: { number: "+1 555 0100", features: { mobile: true } } },
+  addresses: {
+    a1: {
+      components: [
+        { kind: "number", value: "12" },
+        { kind: "name", value: "St James's Square" },
+        { kind: "locality", value: "London" },
+        { kind: "country", value: "UK" },
+      ],
+    },
+  },
+  organizations: { o1: { name: "Analytical Engines", units: [{ name: "R&D" }] } },
+  titles: { t1: { kind: "title", name: "Mathematician" } },
+  links: { l1: { uri: "https://example.com/ada" } },
+  anniversaries: {
+    k1: { kind: "birth", date: { "@type": "PartialDate", year: 1815, month: 12, day: 10 } },
+    k2: { kind: "death", date: { "@type": "PartialDate", year: 1852 } },
+  },
+  notes: { n1: { note: "First programmer" } },
+  "example.com:custom": { keep: "me" },
+};
+
+add_task(function test_toVCard() {
+  const { vCard, extra } = JmapJSContact.toVCard(CARD);
+  const props = VCardProperties.fromVCard(vCard);
+  Assert.equal(props.getFirstValue("fn"), "Ada Lovelace");
+  Assert.deepEqual(props.getFirstValue("n"), ["Lovelace", "Ada", "", "", ""]);
+  Assert.deepEqual(props.getAllValues("email"), [
+    "ada@example.com",
+    "ada@home.example",
+  ]);
+  Assert.equal(props.getFirstValue("tel"), "+1 555 0100");
+  Assert.equal(props.getFirstEntry("tel").params.type, "cell");
+  Assert.equal(props.getFirstValue("adr")[3], "London");
+  Assert.equal(props.getFirstValue("title"), "Mathematician");
+  Assert.equal(props.getFirstValue("url"), "https://example.com/ada");
+  Assert.equal(props.getFirstValue("note"), "First programmer");
+  Assert.equal(props.getFirstValue("uid"), "urn:uuid:1234");
+  Assert.ok(props.getFirstValue("bday"));
+  Assert.deepEqual(extra["example.com:custom"], { keep: "me" });
+  Assert.equal(extra.anniversaries.k2.kind, "death");
+  Assert.ok(!("id" in extra));
+});
+
+add_task(function test_roundTrip() {
+  const { vCard, extra } = JmapJSContact.toVCard(CARD);
+  const card = JmapJSContact.fromVCard(vCard, extra);
+  Assert.equal(card.uid, "urn:uuid:1234");
+  Assert.equal(card.name.full, "Ada Lovelace");
+  Assert.deepEqual(
+    Object.values(card.emails).map(e => e.address),
+    ["ada@example.com", "ada@home.example"]
+  );
+  Assert.ok(Object.values(card.emails)[0].contexts.work);
+  Assert.ok(Object.values(card.phones)[0].features.mobile);
+  Assert.equal(Object.values(card.organizations)[0].name, "Analytical Engines");
+  const birth = Object.values(card.anniversaries).find(a => a.kind == "birth");
+  Assert.deepEqual(
+    [birth.date.year, birth.date.month, birth.date.day],
+    [1815, 12, 10]
+  );
+  Assert.ok(Object.values(card.anniversaries).some(a => a.kind == "death"));
+  Assert.deepEqual(card["example.com:custom"], { keep: "me" });
+  Assert.equal(Object.values(card.notes)[0].note, "First programmer");
+});
+
+add_task(function test_photoBlob() {
+  const { vCard } = JmapJSContact.toVCard(
+    { uid: "x", media: { m1: { kind: "photo", blobId: "B1" } } },
+    { photos: new Map([["m1", "data:image/png;base64,AAAA"]]) }
+  );
+  // ICAL.js escapes the comma, exactly like Thunderbird's own vCards.
+  Assert.stringContains(vCard, "PHOTO:data:image/png;base64\\,AAAA");
+});
+
+add_task(function test_directoryType() {
+  Assert.equal(Ci.nsIAbManager.JMAP_DIRECTORY_TYPE, 104);
+});
