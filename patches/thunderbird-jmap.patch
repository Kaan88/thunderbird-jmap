+JmapMessageChannel::JmapMessageChannel(nsIURI* uri, bool convert)
+    : mConvert(convert),
+      mURI(uri),
+      mContentDisposition(nsIChannel::DISPOSITION_INLINE),
+      mContentLength(-1),
+      mLoadFlags(nsIRequest::LOAD_NORMAL),
+      mPending(true),
+      mStatus(NS_OK) {
+  mContentType.AssignLiteral(MESSAGE_RFC822);
+}
