+/** Extract `"key":"value"` from a flat JSON object. */
+nsAutoCString JmapJsonStringField(const nsACString& object, const char* key) {
+  nsAutoCString needle("\"");
+  needle.Append(key);
+  needle.AppendLiteral("\":\"");
+  nsAutoCString result;
+  int32_t start = object.Find(needle);
+  if (start < 0) {
+    return result;
+  }
+  start += needle.Length();
+  int32_t end = object.FindChar('"', start);
+  if (end > start) {
+    result = Substring(object, start, end - start);
+  }
+  return result;
+}
+
+/** Extract `"key":<number>` from a flat JSON object. */
+uint64_t JmapJsonNumberField(const nsACString& object, const char* key) {
+  nsAutoCString needle("\"");
+  needle.Append(key);
+  needle.AppendLiteral("\":");
+  int32_t start = object.Find(needle);
+  if (start < 0) {
+    return 0;
+  }
+  uint64_t value = 0;
+  const char* cursor = object.BeginReading() + start + needle.Length();
+  const char* end = object.EndReading();
+  for (; cursor < end && *cursor >= '0' && *cursor <= '9'; ++cursor) {
+    value = value * 10 + uint64_t(*cursor - '0');
+  }
+  return value;
+}
