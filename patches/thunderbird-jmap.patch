+  const participants = Object.values(js.participants);
+  Assert.equal(participants.length, 2);
+  const owner = participants.find(p => p.roles.owner);
+  Assert.equal(owner.sendTo.imip, "mailto:boss@example.com");
+  Assert.ok(owner.roles.chair);
+  const alice = participants.find(p => p.email == "alice@example.com");
+  Assert.ok(alice.roles.optional);
