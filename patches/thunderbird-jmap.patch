+
+  Assert.ok(protocolInfo.requiresUsername);
+  Assert.ok(protocolInfo.canGetIncomingMessages);
+  Assert.ok(protocolInfo.canDelete);
+  Assert.ok(protocolInfo.foldersCreatedAsync);
+  Assert.equal(protocolInfo.getDefaultServerPort(true), 443);
+  Assert.equal(protocolInfo.getDefaultServerPort(false), 80);
+});
