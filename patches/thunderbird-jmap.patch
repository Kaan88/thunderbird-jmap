@@ -0,0 +1,380 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Shared helpers for the LIVE JMAP tests. These tests talk to a real JMAP
+ * server (Stalwart) on 127.0.0.1:8080. Account data is read at runtime from
+ * the JSON file named by $JMAP_LIVE_ACCOUNTS (default
+ * E:\tb-build\stalwart\test-accounts.json). If the file is missing, every
+ * task registered with `add_live_task` is skipped, so the suite passes on
+ * machines without a server.
+ *
+ * Passwords are never logged.
+ */
+
+var { MailServices } = ChromeUtils.importESModule(
+  "resource:///modules/MailServices.sys.mjs"
+);
+var { setTimeout, clearTimeout } = ChromeUtils.importESModule(
+  "resource://gre/modules/Timer.sys.mjs"
+);
+var { PromiseTestUtils } = ChromeUtils.importESModule(
+  "resource://testing-common/mailnews/PromiseTestUtils.sys.mjs"
+);
+var { TestUtils } = ChromeUtils.importESModule(
+  "resource://testing-common/TestUtils.sys.mjs"
+);
+var { NetUtil } = ChromeUtils.importESModule(
+  "resource://gre/modules/NetUtil.sys.mjs"
+);
+
+var { JmapAccountRegistry } = ChromeUtils.importESModule(
+  "resource:///modules/jmap/JmapAccountRegistry.sys.mjs"
+);
+var { JmapCapability } = ChromeUtils.importESModule(
+  "resource:///modules/jmap/JmapConstants.sys.mjs"
+);
+
+const DEFAULT_ACCOUNTS_FILE = "E:\\tb-build\\stalwart\\test-accounts.json";
+const LIVE_HOST = "127.0.0.1";
+const LIVE_PORT = 8080;
+const POLL_TIMEOUT_MS = 30000;
+
+/** Unique marker for subjects/names created by this run. */
+const RUN_ID = `${Date.now().toString(36)}${Math.floor(Math.random() * 1e6).toString(36)}`;
+
+do_get_profile();
+
+/**
+ * Read the live account configuration synchronously, or null if absent.
+ *
+ * @returns {?{accounts: object[], sessionUrl: string}}
+ */
+// Verbose JMAP logging helps diagnose live failures.
+Services.prefs.setStringPref("mail.jmap.loglevel", "All");
+
+function readLiveConfig() {
+  try {
+    const path =
+      Services.env.get("JMAP_LIVE_ACCOUNTS") || DEFAULT_ACCOUNTS_FILE;
+    const file = Cc["@mozilla.org/file/local;1"].createInstance(Ci.nsIFile);
+    file.initWithPath(path);
+    if (!file.exists()) {
+      info(`JMAP live: ${path} not found, skipping live tests`);
+      return null;
+    }
+    const stream = Cc[
+      "@mozilla.org/network/file-input-stream;1"
+    ].createInstance(Ci.nsIFileInputStream);
+    stream.init(file, -1, 0, 0);
+    const text = NetUtil.readInputStreamToString(stream, stream.available(), {
+      charset: "UTF-8",
+    });
+    stream.close();
+    const config = JSON.parse(text);
+    if (!Array.isArray(config.accounts) || !config.sessionUrl) {
+      info("JMAP live: account file is malformed, skipping live tests");
+      return null;
+    }
+    return config;
+  } catch (e) {
+    info(`JMAP live: cannot read account file (${e.name}), skipping`);
+    return null;
+  }
+}
+
+const LIVE_CONFIG = readLiveConfig();
+
+/** Register a task that only runs when a live server is configured. */
+function add_live_task(fn) {
+  return add_task({ skip_if: () => !LIVE_CONFIG }, fn);
+}
+
+function liveAccount(email) {
+  const account = LIVE_CONFIG.accounts.find(a => a.email == email);
+  Assert.ok(!!account, `live account ${email} is configured`);
+  return account;
+}
+
+/**
+ * Store a password in the login manager for a JMAP server, the way the
+ * account wizard does (origin = "jmap://<host>").
+ */
+async function storeLogin(username, password) {
+  const origin = `jmap://${LIVE_HOST}`;
+  const existing = await Services.logins.searchLoginsAsync({ origin });
+  for (const login of existing) {
+    if (login.username == username) {
+      Services.logins.removeLogin(login);
+    }
+  }
+  const loginInfo = Cc[
+    "@mozilla.org/login-manager/loginInfo;1"
+  ].createInstance(Ci.nsILoginInfo);
+  loginInfo.init(origin, null, origin, username, password, "", "");
+  await Services.logins.addLoginAsync(loginInfo);
+}
+
+/**
+ * Create a JMAP account (incoming + outgoing server + identity) for one of
+ * the live users. Basic auth uses the full email as username.
+ *
+ * @param {string} email
+ * @returns {Promise<{account, server, outgoing, identity, email}>}
+ */
+async function createLiveAccount(email) {
+  const cfg = liveAccount(email);
+  const username = cfg.email;
+  await storeLogin(username, cfg.password);
+
+  const server = MailServices.accounts.createIncomingServer(
+    username,
+    LIVE_HOST,
+    "jmap"
+  );
+  server.port = LIVE_PORT;
+  server.socketType = Ci.nsMsgSocketType.plain;
+  server.authMethod = Ci.nsMsgAuthMethod.passwordCleartext;
+  server.QueryInterface(Ci.IJmapIncomingServer).jmapSessionUrl =
+    LIVE_CONFIG.sessionUrl;
+  // Push is started explicitly by the push test.
+  Services.prefs.setBoolPref("mail.jmap.push.enabled", !Services.env.exists("JMAP_LIVE_NOPUSH"));
+
+  const outgoing = MailServices.outgoingServer.createServer("jmap");
+  outgoing.wrappedJSObject.incomingServerKey = server.key;
+
+  const identity = MailServices.accounts.createIdentity();
+  identity.email = email;
+  identity.fullName = email.split("@")[0];
+  identity.smtpServerKey = outgoing.key;
+
+  const account = MailServices.accounts.createAccount();
+  account.incomingServer = server;
+  account.addIdentity(identity);
+  account.defaultIdentity = identity;
+
+  const result = { account, server, outgoing, identity, email };
+  registerCleanupFunction(async () => {
+    try {
+      JmapAccountRegistry.forget(server.key);
+      MailServices.accounts.removeAccount(account, true);
+    } catch (e) {}
+  });
+  return result;
+}
+
+/** Shared JS session client for a server. */
+async function jsClient(server) {
+  return JmapAccountRegistry.getClient(server);
+}
+
+/** Run a single JMAP method directly on the server (bypassing Thunderbird). */
+async function jmapCall(server, method, args, capability = JmapCapability.Mail) {
+  const client = await jsClient(server);
+  if (!("accountId" in args)) {
+    args = { accountId: client.getAccountId(capability), ...args };
+  }
+  const response = await client.call(method, args);
+  return response.args;
+}
+
+/** An nsIUrlListener resolving on OnStopRunningUrl. */
+function urlListener() {
+  return new PromiseTestUtils.PromiseUrlListener();
+}
+
+/** An IJmapOperationListener resolving with the result string. */
+function operationListener() {
+  const { promise, resolve, reject } = Promise.withResolvers();
+  return {
+    QueryInterface: ChromeUtils.generateQI(["IJmapOperationListener"]),
+    onSuccess(result) {
+      resolve(result);
+    },
+    onFailure(status, message) {
+      reject(new Error(`0x${(status >>> 0).toString(16)}: ${message}`));
+    },
+    promise,
+  };
+}
+
+function protocolClient(server) {
+  return server.QueryInterface(Ci.IJmapIncomingServer).getProtocolClient();
+}
+
+/** IJmapClient.callMethod as a promise returning parsed JSON. */
+async function callMethod(server, method, args) {
+  const listener = operationListener();
+  protocolClient(server).callMethod(method, JSON.stringify(args), listener);
+  return JSON.parse(await listener.promise);
+}
+
+async function syncFolders(server) {
+  const listener = urlListener();
+  server
+    .QueryInterface(Ci.IJmapIncomingServer)
+    .syncFolderHierarchy(listener, null);
+  await listener.promise;
+}
+
+async function syncMessages(server) {
+  const listener = urlListener();
+  server.QueryInterface(Ci.IJmapIncomingServer).syncMessages(listener);
+  await listener.promise;
+}
+
+async function syncAll(server) {
+  await syncFolders(server);
+  await syncMessages(server);
+}
+
+function folderNamed(server, name) {
+  return server.rootFolder.getChildNamed(name);
+}
+
+function folderWithFlag(server, flag) {
+  return server.rootFolder.getFolderWithFlags(flag);
+}
+
+function headers(folder) {
+  return [...folder.msgDatabase.enumerateMessages()];
+}
+
+function findHeader(folder, subject) {
+  return headers(folder).find(h => h.mime2DecodedSubject == subject) ?? null;
+}
+
+/**
+ * Sync repeatedly until a header with `subject` exists in `folder`.
+ *
+ * @returns {Promise<nsIMsgDBHdr>}
+ */
+async function waitForHeader(server, folderGetter, subject, timeout = POLL_TIMEOUT_MS) {
+  const deadline = Date.now() + timeout;
+  for (;;) {
+    await syncAll(server);
+    const folder = folderGetter();
+    const hdr = folder && findHeader(folder, subject);
+    if (hdr) {
+      return hdr;
+    }
+    if (Date.now() > deadline) {
+      throw new Error(`Timed out waiting for "${subject}"`);
+    }
+    await PromiseTestUtils.promiseDelay(1000);
+  }
+}
+
+/** Poll an async predicate until truthy; returns its value. */
+async function pollUntil(fn, message, timeout = POLL_TIMEOUT_MS) {
+  const deadline = Date.now() + timeout;
+  for (;;) {
+    const value = await fn();
+    if (value) {
+      return value;
+    }
+    if (Date.now() > deadline) {
+      throw new Error(`Timed out: ${message}`);
+    }
+    await PromiseTestUtils.promiseDelay(500);
+  }
+}
+
+/** Server-side Email/get for one id. */
+async function getEmail(server, id, properties = ["keywords", "mailboxIds", "subject"]) {
+  const { list } = await jmapCall(server, "Email/get", { ids: [id], properties });
+  return list[0] ?? null;
+}
+
+/** Server-side Email/query by exact subject; returns ids. */
+async function queryBySubject(server, subject) {
+  const { ids } = await jmapCall(server, "Email/query", {
+    filter: { subject },
+  });
+  return ids ?? [];
+}
+
+/** Destroy emails by subject on the server (cleanup). */
+async function destroyBySubject(server, subject) {
+  try {
+    const ids = await queryBySubject(server, subject);
+    if (ids.length) {
+      await jmapCall(server, "Email/set", { destroy: ids });
+    }
+  } catch (e) {
+    info(`cleanup of "${subject}" failed: ${e}`);
+  }
+}
+
+/** Write a raw RFC 5322 message into a temp file. */
+async function writeMessageFile({ from, to, subject, body, inReplyTo }) {
+  const lines = [
+    `From: ${from}`,
+    `To: ${to}`,
+    `Subject: ${subject}`,
+    `Date: ${new Date().toUTCString().replace("GMT", "+0000")}`,
+    `Message-ID: <${RUN_ID}.${Math.random().toString(36).slice(2)}@test.localhost>`,
+  ];
+  if (inReplyTo) {
+    lines.push(`In-Reply-To: ${inReplyTo}`, `References: ${inReplyTo}`);
+  }
+  lines.push(
+    "MIME-Version: 1.0",
+    "Content-Type: text/plain; charset=UTF-8",
+    "Content-Transfer-Encoding: 8bit",
+    "",
+    body ?? "Live JMAP test body.",
+    ""
+  );
+  const file = Services.dirsvc.get("TmpD", Ci.nsIFile);
+  file.append(`jmaplive-${RUN_ID}.eml`);
+  file.createUnique(Ci.nsIFile.NORMAL_FILE_TYPE, 0o600);
+  await IOUtils.writeUTF8(file.path, lines.join("\r\n"));
+  registerCleanupFunction(() => IOUtils.remove(file.path).catch(() => {}));
+  return file;
+}
+
+/** Make sure the server has an Identity for the account's email. */
+async function ensureServerIdentity(live) {
+  const { list } = await jmapCall(
+    live.server,
+    "Identity/get",
+    { ids: null },
+    JmapCapability.Submission
+  );
+  if (list.some(i => i.email?.toLowerCase() == live.email.toLowerCase())) {
+    return;
+  }
+  const result = await jmapCall(
+    live.server,
+    "Identity/set",
+    { create: { i: { email: live.email, name: live.identity.fullName } } },
+    JmapCapability.Submission
+  );
+  const id = result.created?.i?.id;
+  Assert.ok(id, `created server identity for ${live.email}`);
+  registerCleanupFunction(() =>
+    jmapCall(live.server, "Identity/set", { destroy: [id] }, JmapCapability.Submission).catch(
+      () => {}
+    )
+  );
+}
+
+/** Send a message file through the JMAP outgoing server. */
+async function sendThroughOutgoing(live, file, recipients) {
+  const listener = new PromiseTestUtils.PromiseMsgOutgoingListener();
+  live.outgoing.sendMailMessage(
+    file,
+    recipients.map(email => ({ email, displayName: "" })),
+    [],
+    live.identity,
+    live.email,
+    "",
+    null,
+    false,
+    `<${RUN_ID}@test.localhost>`,
+    listener
+  );
+  await listener.promise;
+}
diff --git a/mailnews/protocols/jmap/test/live/test_live_contacts_calendar.js b/mailnews/protocols/jmap/test/live/test_live_contacts_calendar.js
new file mode 100644
index 00000000000..fe42dd28268
