+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Entry points used by the mail UI: "Save to Files…" for received
+ * attachments, "Attach from Files…" in compose, and opening the Files tab.
+ */
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  JmapFiles: "resource:///modules/jmapfiles/JmapFiles.sys.mjs",
+});
+ChromeUtils.defineLazyGetter(
+  lazy,
+  "l10n",
+  () => new Localization(["messenger/jmapFiles.ftl"], true)
+);
+
+const PICKER_URL = "chrome://messenger/content/jmapfiles/jmapFilesPicker.xhtml";
+
+function alert(win, error) {
+  const title = lazy.l10n.formatValueSync("jmap-files-error-title");
+  Services.prompt.alert(win, title, error?.message ?? String(error));
+}
+
+export const JmapFilesUI = {
+  /** Whether any JMAP server is configured (cheap, synchronous). */
+  get hasServers() {
+    return lazy.JmapFiles.servers.length > 0;
+  },
+
+  /**
+   * Show the picker dialog (modal).
+   *
+   * @param {Window} win
+   * @param {"folder"|"files"} mode
+   * @returns {?object} The picker result or null when cancelled.
+   */
+  pick(win, mode) {
+    const args = { mode, result: null };
+    win.openDialog(
+      PICKER_URL,
+      "",
+      "chrome,modal,centerscreen,resizable,dialog=no",
+      args
+    );
+    return args.result;
+  },
+
+  /**
+   * Save received attachments (AttachmentInfo objects) into JMAP files.
+   *
+   * @param {Window} win
+   * @param {AttachmentInfo[]} attachments
+   */
+  async saveAttachments(win, attachments) {
+    const target = this.pick(win, "folder");
+    if (!target) {
+      return;
+    }
+    try {
+      const service = await lazy.JmapFiles.forServer(target.serverKey);
+      for (const attachment of attachments) {
+        const buffer = await attachment.fetchAttachment();
+        const blob = new Blob([buffer], {
+          type: attachment.contentType || "application/octet-stream",
+        });
+        await service.upload(target.folderId ?? null, blob, {
+          name: attachment.name || "attachment",
+          mediaType: attachment.contentType,
+          onExists: "rename",
+        });
+      }
+    } catch (e) {
+      console.error(e);
+      alert(win, e);
+    }
+  },
+
+  /**
+   * Pick files and download them to a temporary directory.
+   *
+   * @param {Window} win
+   * @returns {Promise<nsIFile[]>}
+   */
+  async pickFilesToTemp(win) {
+    const picked = this.pick(win, "files");
+    if (!picked) {
+      return [];
+    }
+    const files = [];
+    try {
+      const service = await lazy.JmapFiles.forServer(picked.serverKey);
+      const dir = await IOUtils.createUniqueDirectory(
+        PathUtils.tempDir,
+        "jmap-files",
+        0o700
+      );
+      for (const id of picked.nodeIds) {
+        const node = service.getNode(id);
+        // A subdirectory per node keeps same-named files apart.
+        const subdir = await IOUtils.createUniqueDirectory(dir, "f", 0o700);
+        const name = (node?.name || id).replace(/[\\/:*?"<>|]/g, "_");
+        const path = PathUtils.join(
+          subdir,
+          name == "." || name == ".." ? "_" : name
+        );
+        await service.downloadToFile(id, path);
+        const file = Cc["@mozilla.org/file/local;1"].createInstance(
+          Ci.nsIFile
+        );
+        file.initWithPath(path);
+        files.push(file);
+      }
+    } catch (e) {
+      console.error(e);
+      alert(win, e);
+    }
+    return files;
+  },
+
+  /**
+   * Open (or switch to) the Files tab in a 3-pane window.
+   *
+   * @param {Window} win - A messenger window.
+   * @param {object} [args]
+   */
+  openTab(win, args = {}) {
+    const tabmail = win.document.getElementById("tabmail");
+    if (tabmail) {
+      tabmail.openTab("jmapFiles", args);
+    }
+  },
+};
