index 00000000000..75cb81b3d95
--- /dev/null
+++ b/mailnews/protocols/jmap/test/unit/test_jmap_keywords_and_store.js
@@ -0,0 +1,133 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Tests for Thunderbird tags mapped from JMAP keywords, and for the new-mail
+ * bookkeeping JmapFolderStore does for incoming filters.
+ */
+
+var { TB_KEYWORDS_PROPERTY, tagKeywords } = ChromeUtils.importESModule(
+  "resource:///modules/jmap/JmapMessage.sys.mjs"
+);
+var { JmapFolderStore } = ChromeUtils.importESModule(
+  "resource:///modules/jmap/JmapFolderStore.sys.mjs"
+);
+var { localAccountUtils } = ChromeUtils.importESModule(
+  "resource://testing-common/mailnews/LocalAccountUtils.sys.mjs"
+);
+
+const EMAIL = {
+  id: "e1",
+  threadId: "t1",
+  mailboxIds: { inbox: true },
+  keywords: {
+    $seen: true,
+    $flagged: true,
+    $answered: true,
+    $forwarded: true,
+    $draft: true,
+    $junk: true,
+    $NotJunk: true,
+    $phishing: true,
+    $label1: true,
+    Work: true,
+    todo: true,
+    ignored: false,
+  },
+  from: [{ name: "Alice", email: "alice@example.com" }],
+  to: [{ name: "", email: "bob@example.com" }],
+  subject: "Tagged",
+  receivedAt: "2026-01-02T03:04:05Z",
+  size: 100,
+  messageId: ["<tagged@example.com>"],
+};
+
+add_task(function test_tag_keywords() {
+  Assert.deepEqual(tagKeywords(EMAIL.keywords), ["$label1", "todo", "work"]);
+  Assert.deepEqual(tagKeywords(["$seen", "Later"]), ["later"]);
+  Assert.deepEqual(tagKeywords(null), []);
+  Assert.deepEqual(tagKeywords({ $seen: true }), []);
+  Assert.equal(TB_KEYWORDS_PROPERTY, "keywords");
+});
+
+add_task(function test_normalize_email_tags() {
+  const message = normalizeEmail(EMAIL);
+  Assert.equal(message.tags, "$label1 todo work");
+  // The raw keyword list is still available for the jmapKeywords property.
+  Assert.ok(message.keywords.includes("$seen"));
+  Assert.equal(normalizeEmail({ id: "x" }).tags, "");
+});
+
+/**
+ * A store whose server creates nothing; the tests use the local Inbox, which
+ * has a real message database, and give it a mailbox id.
+ */
+function makeStore(rootFolder) {
+  return new JmapFolderStore({
+    server: { createFolderForMailbox() {} },
+    rootFolder,
+  });
+}
+
+add_task(async function test_store_writes_tags_and_tracks_new_keys() {
+  do_get_profile();
+  localAccountUtils.loadLocalMailAccount();
+  const inbox = localAccountUtils.inboxFolder;
+  const root = localAccountUtils.rootFolder;
+  inbox.setFlag(Ci.nsMsgFolderFlags.Inbox);
+  inbox.setStringProperty("jmapId", "inbox");
+
+  const store = makeStore(root);
+  await store.prepare([]);
+  Assert.deepEqual(store.foldersForMailbox("inbox"), [inbox]);
+
+  const message = normalizeEmail(EMAIL, { isNew: true });
+  store.create(inbox, message, { isNew: true });
+
+  const [entry] = store.headersForEmail("e1");
+  Assert.ok(entry, "header indexed");
+  Assert.equal(
+    entry.header.getStringProperty(TB_KEYWORDS_PROPERTY),
+    "$label1 todo work"
+  );
+
+  // New messages in the Inbox are queued for the folder's filters.
+  const pending = store.pendingNewKeys.get(inbox);
+  Assert.deepEqual(pending, [entry.header.messageKey]);
+
+  // An initial (non-new) message is not queued.
+  store.create(inbox, normalizeEmail({ ...EMAIL, id: "e2" }), {
+    isNew: false,
+  });
+  Assert.equal(store.pendingNewKeys.get(inbox).length, 1);
+
+  // Updating replaces the tags.
+  store.update(
+    inbox,
+    entry.header,
+    normalizeEmail({ ...EMAIL, keywords: { $seen: true, later: true } })
+  );
+  Assert.equal(entry.header.getStringProperty(TB_KEYWORDS_PROPERTY), "later");
+
+  // A local folder is not an IJmapFolder: flush must not throw and must
+  // clear the queue.
+  await store.flush();
+  Assert.equal(store.pendingNewKeys.size, 0);
+});
+
+add_task(async function test_store_ignores_new_mail_outside_inbox() {
+  const root = localAccountUtils.rootFolder;
+  const other = root.createLocalSubfolder("Other");
+  other.setStringProperty("jmapId", "other");
+
+  const store = makeStore(root);
+  await store.prepare([]);
+  store.create(
+    other,
+    normalizeEmail({ ...EMAIL, id: "e3", mailboxIds: { other: true } }),
+    { isNew: true }
+  );
+  Assert.ok(!store.pendingNewKeys.has(other));
+  await store.flush();
+});
