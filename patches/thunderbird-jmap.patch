+  sanitizeHeaderValue,
+} = ChromeUtils.importESModule(
+  "resource:///modules/jmap/JmapMimeEncoder.sys.mjs"
+);
+
+var { TestUtils } = ChromeUtils.importESModule(
+  "resource://testing-common/TestUtils.sys.mjs"
+);
+
+/**
+ * A transport that delegates to a caller-provided handler and records the
+ * requests it saw.
+ */
+class MockTransport {
+  /**
+   * @param {Function} handler - `(url, options) => {status, headers, body}`.
+   */
+  constructor(handler) {
+    this.handler = handler;
+    this.requests = [];
+  }
+
+  async request(url, options = {}) {
+    // Honour the client's concurrency slot hooks like JmapTransport does.
+    await options.slot?.acquire(options.signal);
+    try {
+      this.requests.push({ url, ...options });
+      return await this.handler(url, options);
+    } finally {
+      options.slot?.release();
+    }
+  }
+}
+
+/**
+ * Build a valid JMAP core capability object.
+ *
+ * @param {object} [overrides]
+ * @returns {object}
+ */
+function coreCapability(overrides = {}) {
+  return {
+    maxSizeUpload: 50000000,
+    maxConcurrentUpload: 4,
+    maxSizeRequest: 10000000,
+    maxConcurrentRequests: 4,
+    maxCallsInRequest: 64,
+    maxObjectsInGet: 1000,
+    maxObjectsInSet: 500,
+    collationAlgorithms: ["i;ascii-casemap"],
+    versions: ["1.0"],
+    ...overrides,
+  };
+}
+
+/**
+ * Build a session document for tests.
+ *
+ * @param {object} [overrides] - Shallow overrides applied to the session.
+ * @returns {object}
+ */
+function makeSession(overrides = {}) {
+  return {
+    username: "user@example.com",
+    apiUrl: "https://jmap.example.com/api",
+    downloadUrl:
+      "https://jmap.example.com/download/{accountId}/{blobId}/{name}?accept={type}",
+    uploadUrl: "https://jmap.example.com/upload/{accountId}/",
+    eventSourceUrl:
+      "https://jmap.example.com/eventsource/?types={types}&closeafter={closeafter}&ping={ping}",
+    state: "session-state-1",
+    capabilities: {
+      [JmapCapability.Core]: coreCapability(),
+      [JmapCapability.Mail]: {},
+      [JmapCapability.Submission]: {},
+      [JmapCapability.VacationResponse]: {},
+    },
+    accounts: {
+      u1: {
+        name: "user@example.com",
+        isPersonal: true,
+        isReadOnly: false,
+        accountCapabilities: {
+          [JmapCapability.Mail]: {},
+          [JmapCapability.Submission]: {
+            maxDelayedSend: 0,
+            submissionExtensions: {},
+          },
+          [JmapCapability.VacationResponse]: {},
+        },
+      },
+    },
+    primaryAccounts: {
+      [JmapCapability.Mail]: "u1",
+      [JmapCapability.Submission]: "u1",
+      [JmapCapability.VacationResponse]: "u1",
+    },
+    ...overrides,
+  };
+}
+
+/**
+ * Build a transport response that contains JMAP method responses.
+ *
+ * @param {Array} methodResponses
+ * @param {object} [options]
+ * @param {string} [options.sessionState]
+ * @param {object} [options.createdIds]
+ * @returns {{status: number, headers: Headers, body: object}}
+ */
+function jmapResponse(
+  methodResponses,
+  { sessionState = "session-state-1", createdIds } = {}
+) {
+  const body = { methodResponses, sessionState };
+  if (createdIds) {
+    body.createdIds = createdIds;
+  }
+  return {
+    status: 200,
+    headers: new Headers({ "content-type": "application/json" }),
+    body,
+  };
+}
+
+/**
+ * Create a JmapClient backed by a mock transport.
+ *
+ * @param {Function} handler
+ * @param {object} [session]
+ * @returns {Promise<{client: JmapClient, transport: MockTransport}>}
+ */
+async function makeClient(handler, session = makeSession()) {
+  const transport = new MockTransport(handler);
+  const client = await JmapClient.connect({ transport, session });
+  return { client, transport };
+}
+
+/**
+ * Create a JmapMailClient backed by a mock transport.
+ *
+ * @param {Function} handler
+ * @param {object} [session]
+ * @returns {Promise<{client: JmapClient, mail: JmapMailClient, transport: MockTransport}>}
+ */
+async function makeMailClient(handler, session = makeSession()) {
+  const { client, transport } = await makeClient(handler, session);
+  return { client, mail: new JmapMailClient(client), transport };
+}
+
+/**
+ * Parse the JSON request body captured by a mock transport.
+ *
+ * @param {MockTransport} transport
+ * @param {number} [index]
+ * @returns {object}
+ */
+function requestBody(transport, index = -1) {
+  const request = index < 0
+    ? transport.requests.at(index)
+    : transport.requests[index];
+  return JSON.parse(request.body);
+}
+
+/**
+ * Await a promise that is expected to reject with an instance of a given
+ * error class. Returns the caught error so tests can inspect it.
+ *
+ * @param {Promise} promise
+ * @param {Function} ErrorClass
+ * @param {string} message
+ * @returns {Promise<Error>}
+ */
+async function expectRejection(promise, ErrorClass, message) {
+  try {
+    await promise;
+  } catch (error) {
+    Assert.ok(
+      error instanceof ErrorClass,
+      `${message}: expected ${ErrorClass.name}, got ${error?.name}: ${error}`
+    );
+    return error;
+  }
+  Assert.ok(false, `${message}: expected the promise to reject`);
+  return null;
+}
+
