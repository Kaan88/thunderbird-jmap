+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPLISTENERS_H_
+#define COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPLISTENERS_H_
+
+#include <functional>
+
+#include "IJmapClient.h"
+#include "nsIUrlListener.h"
+#include "nsString.h"
+
+/**
+ * `IJmapOperationListener` which forwards to callables, so callers can use
+ * lambdas instead of declaring a listener class per operation.
+ */
+class JmapOperationListener final : public IJmapOperationListener {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_IJMAPOPERATIONLISTENER
+
+  using SuccessFn = std::function<nsresult(const nsACString&)>;
+  using FailureFn = std::function<nsresult(nsresult, const nsACString&)>;
+
+  JmapOperationListener(SuccessFn onSuccess, FailureFn onFailure)
+      : mOnSuccess(std::move(onSuccess)), mOnFailure(std::move(onFailure)) {}
+
+ private:
+  ~JmapOperationListener() = default;
+
+  SuccessFn mOnSuccess;
+  FailureFn mOnFailure;
+};
+
+/**
+ * `nsIUrlListener` which forwards `OnStopRunningUrl` to a callable.
+ */
+class JmapUrlStopListener final : public nsIUrlListener {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIURLLISTENER
+
+  using StopFn = std::function<nsresult(nsresult)>;
+
+  explicit JmapUrlStopListener(StopFn onStop) : mOnStop(std::move(onStop)) {}
+
+ private:
+  ~JmapUrlStopListener() = default;
+
+  StopFn mOnStop;
+};
+
+/**
+ * Parse a JSON array of strings as produced by `JSON.stringify` for an array
+ * of JMAP ids. Ids never contain quotes or escapes, so this is a small
+ * scanner rather than a full JSON parser.
+ */
+void JmapParseIdArray(const nsACString& json, nsTArray<nsCString>& ids);
+
+/** Append `value` to `out` as a JSON string literal, with quotes. */
+void JmapAppendJSONString(nsACString& out, const nsACString& value);
+
+/**
+ * Build `Email/set` arguments which add every email in `ids` to, or remove
+ * it from, `mailboxId` without touching other memberships. This is how a
+ * copy within one account is expressed in JMAP: `Email/copy` only works
+ * between different accounts.
+ */
+void JmapBuildMailboxMembershipArgs(const nsTArray<nsCString>& ids,
+                                    const nsACString& mailboxId, bool add,
+                                    nsACString& argsJSON);
+
+class nsIMsgFolder;
+
+/** Get the protocol client of the JMAP account `folder` belongs to. */
+nsresult JmapClientForFolder(nsIMsgFolder* folder, IJmapClient** client);
+
+/** Start an account-wide message sync for the account of `folder`. */
+nsresult JmapSyncAccountForFolder(nsIMsgFolder* folder,
+                                  nsIUrlListener* listener);
+
+class nsIMsgDBHdr;
+
+/**
+ * Find the header in `folder` whose `jmapId` property is `emailId`.
+ * `*header` is null if there is none.
+ */
+nsresult JmapFindHeaderByEmailId(nsIMsgFolder* folder,
+                                 const nsACString& emailId,
+                                 nsIMsgDBHdr** header);
+
+/**
+ * The JMAP keywords representing the state of a local header: `$seen`,
+ * `$flagged`, `$answered`, `$forwarded` from the flags, plus its tags.
+ */
+void JmapKeywordsForHeader(nsIMsgDBHdr* header, nsTArray<nsCString>& keywords);
+
+#endif  // COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPLISTENERS_H_
