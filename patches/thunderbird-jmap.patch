+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// mail/base/content/specialTabs.js
+/* globals contentTabBaseType, DOMLinkHandler */
+
+/* exported jmapFilesTabType, openJmapFilesTab */
+
+/**
+ * The "Files" tab, showing JMAP File Storage (tab type "jmapFiles").
+ */
+var jmapFilesTabType = {
+  __proto__: contentTabBaseType,
+  name: "jmapFiles",
+  perTabPanel: "vbox",
+  lastBrowserId: 0,
+  tab: null,
+
+  modes: {
+    jmapFiles: {
+      type: "jmapFiles",
+    },
+  },
+
+  shouldSwitchTo() {
+    return this.tab
+      ? document.getElementById("tabmail").tabInfo.indexOf(this.tab)
+      : -1;
+  },
+
+  closeTab() {
+    this.tab = null;
+  },
+
+  openTab(aTab, aArgs) {
+    aTab.tabNode.setIcon("chrome://messenger/skin/icons/new/compact/folder.svg");
+
+    const clone = document
+      .getElementById("preferencesTab")
+      .firstElementChild.cloneNode(true);
+    clone.setAttribute("id", "jmapFilesTab" + this.lastBrowserId);
+    clone.setAttribute("tabtoolbar", "false");
+    aTab.panel.setAttribute("id", "jmapFilesTabWrapper" + this.lastBrowserId);
+    aTab.panel.appendChild(clone);
+
+    aTab.browser = aTab.panel.querySelector("browser");
+    aTab.browser.setAttribute("id", "jmapFilesTabBrowser" + this.lastBrowserId);
+    aTab.browser.addEventListener("DOMLinkAdded", DOMLinkHandler);
+    aTab.reloadEnabled = false;
+
+    let url = "chrome://messenger/content/jmapfiles/jmapFiles.xhtml";
+    if (aArgs.serverKey) {
+      url += "?server=" + encodeURIComponent(aArgs.serverKey);
+    }
+    aTab.url = url;
+
+    this._setUpTitleListener(aTab);
+    this._setUpCloseWindowListener(aTab);
+
+    aTab.title = document
+      .getElementById("bundle_messenger")
+      .getString("loadingTab");
+
+    aTab.browser.loadURI(Services.io.newURI(url), {
+      triggeringPrincipal: Services.scriptSecurityManager.getSystemPrincipal(),
+    });
+
+    this.tab = aTab;
+    this.lastBrowserId++;
+  },
+
+  persistTab() {
+    return {};
+  },
+
+  restoreTab(aTabmail) {
+    aTabmail.openTab("jmapFiles", { background: true });
+  },
+
+  supportsCommand() {
+    return false;
+  },
+  isCommandEnabled() {
+    return false;
+  },
+  doCommand() {},
+};
+
+/** Open or switch to the Files tab. */
+function openJmapFilesTab(args = {}) {
+  document.getElementById("tabmail").openTab("jmapFiles", args);
+}
diff --git a/mail/components/jmapfiles/content/jmapFilesView.js b/mail/components/jmapfiles/content/jmapFilesView.js
new file mode 100644
index 00000000000..b220c9fd486
--- /dev/null
+++ b/mail/components/jmapfiles/content/jmapFilesView.js
@@ -0,0 +1,363 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* exported JmapFilesView */
+
+/**
+ * Shared list/breadcrumb rendering for the Files tab and the picker dialog.
+ */
+
+var { JmapFiles, formatSize } = ChromeUtils.importESModule(
+  "resource:///modules/jmapfiles/JmapFiles.sys.mjs"
+);
+
+class JmapFilesView {
+  /**
+   * @param {object} elements
+   * @param {HTMLSelectElement} elements.accountPicker
+   * @param {HTMLElement} elements.breadcrumb - Contains an <ol>.
+   * @param {HTMLTableElement} elements.list
+   * @param {HTMLElement} [elements.empty]
+   * @param {HTMLElement} [elements.noAccount]
+   * @param {object} [options]
+   * @param {function(object):boolean} [options.filter] - Nodes to show.
+   * @param {Function} [options.onSelect]
+   * @param {Function} [options.onActivate] - Called with a file node.
+   * @param {Function} [options.onError]
+   */
+  constructor(elements, options = {}) {
+    this.el = elements;
+    this.options = options;
+    this.service = null;
+    this.parentId = null;
+    this.searchText = "";
+    this.nodes = [];
+    this.selected = new Set();
+    this.anchorIndex = -1;
+    this._listener = () => this.render();
+    this.dateFormat = new Intl.DateTimeFormat(undefined, {
+      dateStyle: "medium",
+      timeStyle: "short",
+    });
+
+    this.el.accountPicker.addEventListener("change", () =>
+      this.setServer(this.el.accountPicker.value)
+    );
+    this.el.list.addEventListener("click", e => this._onClick(e));
+    this.el.list.addEventListener("dblclick", e => this._onDblClick(e));
+    this.el.list.addEventListener("keydown", e => this._onKeyDown(e));
+    this.el.breadcrumb.addEventListener("click", e => {
+      const button = e.target.closest("button[data-id]");
+      if (button) {
+        this.navigate(button.dataset.id || null);
+      }
+    });
+  }
+
+  async init(preferredServerKey) {
+    const servers = await JmapFiles.availableServers();
+    this.el.accountPicker.replaceChildren(
+      ...servers.map(server => {
+        const option = document.createElement("option");
+        option.value = server.key;
+        option.textContent = server.prettyName;
+        return option;
+      })
+    );
+    const hasAccount = servers.length > 0;
+    this.el.noAccount && (this.el.noAccount.hidden = hasAccount);
+    this.el.list.hidden = !hasAccount;
+    if (!hasAccount) {
+      return;
+    }
+    const key = servers.some(s => s.key == preferredServerKey)
+      ? preferredServerKey
+      : servers[0].key;
+    this.el.accountPicker.value = key;
+    await this.setServer(key);
+  }
+
+  async setServer(serverKey) {
+    this.service?.removeListener(this._listener);
+    try {
+      this.service = await JmapFiles.forServer(serverKey);
+      this.service.addListener(this._listener);
+      await this.service.ensureLoaded();
+      await this.service.refresh();
+    } catch (e) {
+      this._error(e);
+    }
+    this.parentId = null;
+    this.render();
+  }
+
+  destroy() {
+    this.service?.removeListener(this._listener);
+  }
+
+  async navigate(parentId) {
+    this.parentId = parentId;
+    this.searchText = "";
+    this.selected.clear();
+    this.render();
+  }
+
+  async search(text) {
+    this.searchText = text;
+    this.selected.clear();
+    if (!text) {
+      this.render();
+      return;
+    }
+    try {
+      this._searchResults = await this.service.search(text);
+    } catch (e) {
+      this._error(e);
+      this._searchResults = [];
+    }
+    this.render();
+  }
+
+  get selectedNodes() {
+    return this.nodes.filter(n => this.selected.has(n.id));
+  }
+
+  render() {
+    if (!this.service) {
+      return;
+    }
+    if (this.parentId && !this.service.getNode(this.parentId)) {
+      this.parentId = null;
+    }
+    let nodes = this.searchText
+      ? this._searchResults ?? []
+      : this.service.childrenSync(this.parentId);
+    if (this.options.filter) {
+      nodes = nodes.filter(this.options.filter);
+    }
+    this.nodes = nodes;
+    for (const id of [...this.selected]) {
+      if (!nodes.some(n => n.id == id)) {
+        this.selected.delete(id);
+      }
+    }
+    this._renderBreadcrumb();
+    const tbody = this.el.list.tBodies[0];
+    tbody.replaceChildren(...nodes.map((n, i) => this._row(n, i)));
+    if (this.el.empty) {
+      this.el.empty.hidden = nodes.length > 0;
+    }
+    this.options.onSelect?.(this.selectedNodes);
+  }
+
+  _renderBreadcrumb() {
+    const ol = this.el.breadcrumb.querySelector("ol");
+    const crumbs = [{ id: "", name: this.el.accountPicker.selectedOptions[0]?.textContent ?? "/" }];
+    for (const node of this.service.pathTo(this.parentId)) {
+      crumbs.push({ id: node.id, name: node.name });
+    }
+    ol.replaceChildren(
+      ...crumbs.map((crumb, i) => {
+        const li = document.createElement("li");
+        const button = document.createElement("button");
+        button.type = "button";
+        button.dataset.id = crumb.id;
+        button.textContent = crumb.name;
+        button.classList.add("breadcrumb-item");
+        if (i == crumbs.length - 1) {
+          button.setAttribute("aria-current", "location");
+        }
+        if (crumb.id || i == 0) {
+          button.addEventListener("dragover", e => this._onDragOver(e, crumb.id));
+          button.addEventListener("drop", e => this._onDropNode(e, crumb.id || null));
+        }
+        li.appendChild(button);
+        return li;
+      })
+    );
+  }
+
+  _row(node, index) {
+    const tr = document.createElement("tr");
+    tr.dataset.id = node.id;
+    tr.dataset.index = index;
+    tr.setAttribute("role", "row");
+    tr.setAttribute("aria-selected", this.selected.has(node.id));
+    tr.classList.toggle("selected", this.selected.has(node.id));
+    tr.classList.add(node.isDirectory ? "directory" : "file");
+    tr.draggable = true;
+    tr.addEventListener("dragstart", e => {
+      if (!this.selected.has(node.id)) {
+        this._select(index, false, false);
+      }
+      e.dataTransfer.setData(
+        "application/x-jmap-filenodes",
+        JSON.stringify([...this.selected])
+      );
+      e.dataTransfer.effectAllowed = "move";
+    });
+    if (node.isDirectory) {
+      tr.addEventListener("dragover", e => this._onDragOver(e, node.id));
+      tr.addEventListener("drop", e => this._onDropNode(e, node.id));
+    }
+
+    const name = document.createElement("td");
+    name.classList.add("col-name");
+    const icon = document.createElement("img");
+    icon.alt = "";
+    icon.src = node.isDirectory
+      ? "chrome://messenger/skin/icons/new/compact/folder.svg"
+      : `moz-icon://.${encodeURIComponent(
+          node.name.includes(".") ? node.name.split(".").pop() : "bin"
+        )}?size=16`;
+    const label = document.createElement("span");
+    label.textContent = node.name;
+    name.append(icon, label);
+
+    const size = document.createElement("td");
+    size.classList.add("col-size");
+    size.textContent = node.isDirectory ? "" : formatSize(node.size);
+
+    const modified = document.createElement("td");
+    modified.classList.add("col-modified");
+    const date = node.modified ? new Date(node.modified) : null;
+    modified.textContent =
+      date && !isNaN(date) ? this.dateFormat.format(date) : "";
+
+    for (const td of [name, size, modified]) {
+      td.setAttribute("role", "gridcell");
+    }
+    tr.append(name, size, modified);
+    return tr;
+  }
+
+  _select(index, toggle, range) {
+    if (index < 0 || index >= this.nodes.length) {
+      return;
+    }
+    if (range && this.anchorIndex >= 0) {
+      this.selected.clear();
+      const [a, b] = [this.anchorIndex, index].sort((x, y) => x - y);
+      for (let i = a; i <= b; i++) {
+        this.selected.add(this.nodes[i].id);
+      }
+    } else if (toggle) {
+      const id = this.nodes[index].id;
+      this.selected.has(id) ? this.selected.delete(id) : this.selected.add(id);
+      this.anchorIndex = index;
+    } else {
+      this.selected = new Set([this.nodes[index].id]);
+      this.anchorIndex = index;
+    }
+    this.focusIndex = index;
+    this._updateSelection();
+    this.el.list.tBodies[0].rows[index]?.scrollIntoView({ block: "nearest" });
+  }
+
+  /**
+   * Reflect `this.selected` on the existing rows. Rows are not rebuilt: a
+   * double-click only fires when both clicks hit the same element.
+   */
+  _updateSelection() {
+    for (const tr of this.el.list.tBodies[0].rows) {
+      const isSelected = this.selected.has(tr.dataset.id);
+      tr.classList.toggle("selected", isSelected);
+      tr.setAttribute("aria-selected", isSelected);
+    }
+    this.options.onSelect?.(this.selectedNodes);
+  }
+
+  _onClick(e) {
+    const tr = e.target.closest("tbody tr");
+    if (tr) {
+      this._select(Number(tr.dataset.index), e.ctrlKey || e.metaKey, e.shiftKey);
+    }
+  }
+
+  _activate(node) {
+    if (node.isDirectory) {
+      this.navigate(node.id);
+    } else {
+      this.options.onActivate?.(node);
+    }
+  }
+
+  _onDblClick(e) {
+    const tr = e.target.closest("tbody tr");
+    if (tr) {
+      this._activate(this.nodes[Number(tr.dataset.index)]);
+    }
+  }
+
+  _onKeyDown(e) {
+    const current = this.focusIndex ?? -1;
+    switch (e.key) {
+      case "ArrowDown":
+        this._select(Math.min(current + 1, this.nodes.length - 1), false, e.shiftKey);
+        break;
+      case "ArrowUp":
+        this._select(Math.max(current - 1, 0), false, e.shiftKey);
+        break;
+      case "Home":
+        this._select(0, false, e.shiftKey);
+        break;
+      case "End":
+        this._select(this.nodes.length - 1, false, e.shiftKey);
+        break;
+      case "Enter":
+        if (this.nodes[current]) {
+          this._activate(this.nodes[current]);
+        }
+        break;
+      case "Backspace": {
+        const parent = this.parentId && this.service.getNode(this.parentId);
+        if (parent) {
+          this.navigate(parent.parentId);
+        }
+        break;
+      }
+      case "a":
+        if (e.ctrlKey || e.metaKey) {
+          this.selected = new Set(this.nodes.map(n => n.id));
+          this.render();
+          break;
+        }
+        return;
+      default:
+        return;
+    }
+    e.preventDefault();
+  }
+
+  _onDragOver(e, targetId) {
+    if (e.dataTransfer.types.includes("application/x-jmap-filenodes")) {
+      e.preventDefault();
+      e.dataTransfer.dropEffect = "move";
+    }
+  }
+
+  async _onDropNode(e, targetId) {
+    const data = e.dataTransfer.getData("application/x-jmap-filenodes");
+    if (!data) {
+      return;
+    }
+    e.preventDefault();
+    e.stopPropagation();
+    const ids = JSON.parse(data).filter(id => id != targetId);
+    if (!ids.length) {
+      return;
+    }
+    try {
+      await this.service.move(ids, targetId);
+    } catch (err) {
+      this._error(err);
+    }
+    this.render();
+  }
+
+  _error(e) {
+    console.error(e);
+    this.options.onError?.(e);
+  }
+}
