+  if (isAscii(name)) {
+    if (/[()<>@,;:\\".[\]]/.test(name)) {
+      return `"${name.replace(/(["\\])/g, "\\$1")}" <${email}>`;
+    }
+    return `${name} <${email}>`;
+  }
+
+  return `${encodeWord(name)} <${email}>`;
+}
+
+/**
+ * Encode a list of addresses.
+ *
+ * @param {?object[]} addresses
+ * @returns {string}
+ */
+export function encodeAddressList(addresses) {
+  return (addresses ?? [])
+    .map(encodeAddress)
+    .filter(Boolean)
+    .join(", ");
+}
+
+/**
+ * Encode a MIME parameter, using RFC 2231 for non-ASCII values.
+ *
+ * @param {string} name
+ * @param {*} value
+ * @returns {string} An empty string when there is no value.
+ */
+export function encodeParameter(name, value) {
+  const clean = sanitizeHeaderValue(value);
+  if (!clean) {
+    return "";
+  }
+
+  if (isAscii(clean)) {
+    return `${name}="${clean.replace(/(["\\])/g, "\\$1")}"`;
+  }
+
+  return `${name}*=UTF-8''${encodeURIComponent(clean)}`;
+}
+
+/**
+ * Format a microsecond PRTime value as an RFC 5322 date (UTC).
+ *
+ * @param {number} microseconds
+ * @returns {string}
+ */
+function formatPrTime(microseconds) {
+  const date = new Date(Math.floor(microseconds / 1000));
+  const pad = value => String(value).padStart(2, "0");
+  return (
+    `${DAYS[date.getUTCDay()]}, ${pad(date.getUTCDate())} ` +
+    `${MONTHS[date.getUTCMonth()]} ${date.getUTCFullYear()} ` +
+    `${pad(date.getUTCHours())}:${pad(date.getUTCMinutes())}:` +
+    `${pad(date.getUTCSeconds())} +0000`
+  );
+}
+
+/**
+ * Format a JMAP `UTCDate` as an RFC 5322 date, preserving the offset.
+ *
+ * @param {?string} value
+ * @param {number} [fallbackMicroseconds] - Used when the value is invalid.
+ * @returns {string}
+ */
+export function formatRfc5322Date(value, fallbackMicroseconds = 0) {
+  const milliseconds = Date.parse(value ?? "");
+  if (!Number.isFinite(milliseconds)) {
+    return formatPrTime(fallbackMicroseconds);
+  }
+
+  const match = /([+-])(\d{2}):?(\d{2})$/.exec(value ?? "");
+  if (!match) {
+    return formatPrTime(milliseconds * 1000);
+  }
+
+  const sign = match[1] === "-" ? -1 : 1;
+  const offset = sign * (Number(match[2]) * 60 + Number(match[3]));
+  const date = new Date(milliseconds + offset * 60000);
+  const pad = number => String(number).padStart(2, "0");
+  const absOffset = Math.abs(offset);
+
+  return (
+    `${DAYS[date.getUTCDay()]}, ${pad(date.getUTCDate())} ` +
+    `${MONTHS[date.getUTCMonth()]} ${date.getUTCFullYear()} ` +
+    `${pad(date.getUTCHours())}:${pad(date.getUTCMinutes())}:` +
+    `${pad(date.getUTCSeconds())} ${offset < 0 ? "-" : "+"}` +
+    `${pad(Math.floor(absOffset / 60))}${pad(absOffset % 60)}`
+  );
+}
+
+/**
+ * Pick a transfer encoding for a leaf part.
+ *
+ * @param {string} type - MIME type of the part.
+ * @param {Uint8Array} bytes
+ * @returns {"7bit"|"quoted-printable"|"base64"}
+ */
+export function chooseTransferEncoding(type, bytes) {
+  if (!/^text\//i.test(type)) {
+    return "base64";
+  }
+
+  let lineLength = 0;
+  for (const byte of bytes) {
+    if (byte === 0x0d) {
+      continue;
+    }
+    if (byte === 0x0a) {
+      lineLength = 0;
+      continue;
+    }
+    if (byte > 0x7e || (byte < 0x20 && byte !== 0x09)) {
+      return "quoted-printable";
+    }
+    lineLength++;
+    if (lineLength > 900) {
+      return "quoted-printable";
+    }
+  }
+
+  return "7bit";
+}
+
+/**
+ * Generate a MIME boundary.
+ *
+ * @param {string} prefix
+ * @returns {string}
+ */
+export function newBoundary(prefix) {
+  const random = new Uint32Array(2);
+  crypto.getRandomValues(random);
+  return (
+    prefix +
+    random[0].toString(36) +
+    random[1].toString(36) +
+    "@jmap.invalid"
+  );
+}
+
+/**
+ * Encode text to UTF-8 bytes.
+ *
+ * @param {string} value
+ * @returns {Uint8Array}
+ */
+export function utf8(value) {
+  return encoder.encode(value);
+}
diff --git a/mailnews/protocols/jmap/modules/JmapMutations.sys.mjs b/mailnews/protocols/jmap/modules/JmapMutations.sys.mjs
new file mode 100644
index 00000000000..335a9f2242f
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapMutations.sys.mjs
@@ -0,0 +1,541 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import {
+  JmapCapability,
+  JmapMethodErrorType,
+} from "resource:///modules/jmap/JmapConstants.sys.mjs";
+import { JmapMethodError } from "resource:///modules/jmap/JmapErrors.sys.mjs";
+
+/**
+ * Standard JMAP keywords used for Thunderbird message flags.
+ */
+export const JmapKeyword = Object.freeze({
+  Seen: "$seen",
+  Flagged: "$flagged",
+  Answered: "$answered",
+  Forwarded: "$forwarded",
+  Draft: "$draft",
+  Junk: "$junk",
+  NotJunk: "$notjunk",
+});
+
+/**
+ * Default `maxObjectsInSet` when the server does not advertise one.
+ */
+const DEFAULT_SET_LIMIT = 500;
+
+/**
+ * @param {string} keyword
+ * @returns {string} JSON pointer for a keyword in an `Email/set` patch.
+ */
+export function keywordPath(keyword) {
+  return `keywords/${keyword}`;
+}
+
+/**
+ * @param {string} mailboxId
+ * @returns {string} JSON pointer for a mailbox membership patch.
+ */
+export function mailboxPath(mailboxId) {
+  return `mailboxIds/${mailboxId}`;
+}
+
+/**
+ * @param {Array} values
+ * @param {number} size
+ * @returns {Array[]}
+ */
+function chunk(values, size) {
+  const chunks = [];
+  for (let index = 0; index < values.length; index += size) {
+    chunks.push(values.slice(index, index + size));
+  }
+  return chunks;
+}
+
+/**
+ * @returns {object} An empty aggregated `Email/set` result.
+ */
+function emptyResult() {
+  return {
+    created: null,
+    notCreated: null,
+    updated: null,
+    notUpdated: null,
+    destroyed: null,
+    notDestroyed: null,
+  };
+}
+
+/**
+ * Merge one `Email/set` response into an aggregated result.
+ *
+ * @param {object} target
+ * @param {object} result
+ */
+function mergeResult(target, result) {
+  if (!result) {
+    return;
+  }
+  if (result.created) {
+    target.created ??= {};
+    Object.assign(target.created, result.created);
+  }
+  if (result.notCreated) {
+    target.notCreated ??= {};
+    Object.assign(target.notCreated, result.notCreated);
+  }
+  if (result.updated) {
+    target.updated ??= {};
+    Object.assign(target.updated, result.updated);
+  }
+  if (result.notUpdated) {
+    target.notUpdated ??= {};
+    Object.assign(target.notUpdated, result.notUpdated);
+  }
+  if (result.destroyed?.length) {
+    target.destroyed ??= [];
+    target.destroyed.push(...result.destroyed);
+  }
+  if (result.notDestroyed) {
+    target.notDestroyed ??= {};
+    Object.assign(target.notDestroyed, result.notDestroyed);
+  }
+}
+
+/**
+ * Whether an error means the account state used by `ifInState` is stale.
+ *
+ * @param {*} error
+ * @returns {boolean}
+ */
+export function isStateMismatch(error) {
+  return (
+    error instanceof JmapMethodError &&
+    error.type === JmapMethodErrorType.StateMismatch
+  );
+}
+
+/**
+ * Translate Thunderbird mutations into JMAP `Email/set` calls.
+ *
+ * All operations are batched to the server's `maxObjectsInSet` limit and
+ * retried once without `ifInState` when the state token is stale.
+ */
+export class JmapMutator {
+  #mail;
+  #logger;
+
+  /**
+   * @param {object} options
+   * @param {object} options.mail - A `JmapMailClient` or compatible object.
+   * @param {?object} [options.logger]
+   */
+  constructor({ mail, logger = null } = {}) {
+    if (!mail) {
+      throw new TypeError("JmapMutator requires a mail client");
+    }
+    this.#mail = mail;
+    this.#logger = logger;
+  }
+
+  /**
+   * @returns {number}
+   */
+  #batchSize() {
+    const core =
+      this.#mail.client?.capabilities?.[JmapCapability.Core];
+    const limit = Number(core?.maxObjectsInSet);
+    if (Number.isFinite(limit) && limit > 0) {
+      return Math.max(1, Math.floor(limit));
+    }
+    return DEFAULT_SET_LIMIT;
+  }
+
+  /**
+   * Run an `Email/set` operation, retrying once without `ifInState` when the
+   * server reports a state mismatch.
+   *
+   * @param {(ifInState: ?string) => Promise<object>} operation
+   * @param {?string} ifInState
+   * @returns {Promise<object>}
+   */
+  async #withStateRetry(operation, ifInState) {
+    if (!ifInState) {
+      return operation(undefined);
+    }
+
+    try {
+      return await operation(ifInState);
+    } catch (error) {
+      if (!isStateMismatch(error)) {
+        throw error;
+      }
+      this.#logger?.warn?.(
+        "JMAP mutation state is stale, retrying without ifInState"
+      );
+      return operation(undefined);
+    }
+  }
+
+  /**
+   * Update several emails with the same patch.
+   *
+   * @param {string[]} ids
+   * @param {() => object} patchFactory
+   * @param {?string} ifInState
+   * @returns {Promise<object>}
+   */
+  #updateAll(ids, patchFactory, ifInState) {
+    const update = {};
+    for (const id of new Set(ids.filter(Boolean))) {
+      update[id] = patchFactory();
+    }
+    return this.update(update, { ifInState });
+  }
+
+  /**
+   * Apply per-id patches.
+   *
+   * @param {object} update - `id -> patch` map.
+   * @param {object} [options]
+   * @param {?string} [options.ifInState]
+   * @returns {Promise<object>}
+   */
+  async update(update, { ifInState } = {}) {
+    const ids = Object.keys(update ?? {});
+    const result = emptyResult();
+    if (!ids.length) {
+      return result;
+    }
+
+    for (const chunkIds of chunk(ids, this.#batchSize())) {
+      const chunkUpdate = {};
+      for (const id of chunkIds) {
+        chunkUpdate[id] = update[id];
+      }
+      const response = await this.#withStateRetry(state => {
+        const args = { update: chunkUpdate };
+        if (state) {
+          args.ifInState = state;
+        }
+        return this.#mail.setEmails(args);
+      }, ifInState);
+      mergeResult(result, response);
+    }
+    return result;
+  }
+
+  /**
+   * Permanently destroy emails.
+   *
+   * @param {string[]} ids
+   * @param {object} [options]
+   * @param {?string} [options.ifInState]
+   * @returns {Promise<object>}
+   */
+  async destroy(ids, { ifInState } = {}) {
+    const unique = [...new Set((ids ?? []).filter(Boolean))];
+    const result = emptyResult();
+    if (!unique.length) {
+      return result;
+    }
+
+    for (const chunkIds of chunk(unique, this.#batchSize())) {
+      const response = await this.#withStateRetry(state => {
+        const args = { destroy: chunkIds };
+        if (state) {
+          args.ifInState = state;
+        }
+        return this.#mail.setEmails(args);
+      }, ifInState);
+      mergeResult(result, response);
+    }
+    return result;
+  }
+
+  /**
+   * Create emails from `Email/set` create objects.
+   *
+   * @param {object} create - `creationId -> email` map.
+   * @param {object} [options]
+   * @param {?string} [options.ifInState]
+   * @returns {Promise<object>}
+   */
+  async create(create, { ifInState } = {}) {
+    const ids = Object.keys(create ?? {});
+    const result = emptyResult();
+    if (!ids.length) {
+      return result;
+    }
+
+    for (const chunkIds of chunk(ids, this.#batchSize())) {
+      const chunkCreate = {};
+      for (const id of chunkIds) {
+        chunkCreate[id] = create[id];
+      }
+      const response = await this.#withStateRetry(state => {
+        const args = { create: chunkCreate };
+        if (state) {
+          args.ifInState = state;
+        }
+        return this.#mail.setEmails(args);
+      }, ifInState);
+      mergeResult(result, response);
+    }
+    return result;
+  }
+
+  /**
+   * Mark messages read or unread.
+   *
+   * @param {string[]} ids
+   * @param {boolean} read
+   * @param {object} [options]
+   * @returns {Promise<object>}
+   */
+  setRead(ids, read, { ifInState } = {}) {
+    return this.#updateAll(
+      ids,
+      () => ({
+        [keywordPath(JmapKeyword.Seen)]: read ? true : null,
+      }),
+      ifInState
+    );
+  }
+
+  /**
+   * Flag or unflag messages.
+   *
+   * @param {string[]} ids
+   * @param {boolean} flagged
+   * @param {object} [options]
+   * @returns {Promise<object>}
+   */
+  setFlagged(ids, flagged, { ifInState } = {}) {
+    return this.#updateAll(
+      ids,
+      () => ({
+        [keywordPath(JmapKeyword.Flagged)]: flagged ? true : null,
+      }),
+      ifInState
+    );
+  }
+
+  /**
+   * Mark messages as answered (replied) or not.
+   *
+   * @param {string[]} ids
+   * @param {boolean} answered
+   * @param {object} [options]
+   * @returns {Promise<object>}
+   */
+  setAnswered(ids, answered, { ifInState } = {}) {
+    return this.#updateAll(
+      ids,
+      () => ({
+        [keywordPath(JmapKeyword.Answered)]: answered ? true : null,
+      }),
+      ifInState
+    );
+  }
+
+  /**
+   * Mark messages as forwarded or not.
+   *
+   * @param {string[]} ids
+   * @param {boolean} forwarded
+   * @param {object} [options]
+   * @returns {Promise<object>}
+   */
+  setForwarded(ids, forwarded, { ifInState } = {}) {
+    return this.#updateAll(
+      ids,
+      () => ({
+        [keywordPath(JmapKeyword.Forwarded)]: forwarded ? true : null,
+      }),
+      ifInState
+    );
+  }
+
+  /**
+   * Mark messages as junk or not junk.
+   *
+   * JMAP uses two keywords: `$junk` and `$notjunk`. `false` is not a valid
+   * patch value, so the opposite keyword is cleared with `null`.
+   *
+   * @param {string[]} ids
+   * @param {boolean} junk
+   * @param {object} [options]
+   * @returns {Promise<object>}
+   */
+  setJunk(ids, junk, { ifInState } = {}) {
+    return this.#updateAll(
+      ids,
+      () =>
+        junk
+          ? {
+              [keywordPath(JmapKeyword.Junk)]: true,
+              [keywordPath(JmapKeyword.NotJunk)]: null,
+            }
+          : {
+              [keywordPath(JmapKeyword.Junk)]: null,
+              [keywordPath(JmapKeyword.NotJunk)]: true,
+            },
+      ifInState
+    );
+  }
+
+  /**
+   * Add keywords (tags) to messages.
+   *
+   * @param {string[]} ids
+   * @param {string[]} keywords
+   * @param {object} [options]
+   * @returns {Promise<object>}
+   */
+  addKeywords(ids, keywords, { ifInState } = {}) {
+    const patch = {};
+    for (const keyword of keywords ?? []) {
+      patch[keywordPath(keyword)] = true;
+    }
+    return this.#updateAll(ids, () => ({ ...patch }), ifInState);
+  }
+
+  /**
+   * Remove keywords (tags) from messages.
+   *
+   * @param {string[]} ids
+   * @param {string[]} keywords
+   * @param {object} [options]
+   * @returns {Promise<object>}
+   */
+  removeKeywords(ids, keywords, { ifInState } = {}) {
+    const patch = {};
+    for (const keyword of keywords ?? []) {
+      patch[keywordPath(keyword)] = null;
+    }
+    return this.#updateAll(ids, () => ({ ...patch }), ifInState);
+  }
+
+  /**
+   * Move messages between mailboxes.
+   *
+   * @param {string[]} ids
+   * @param {string} fromMailboxId
+   * @param {string} toMailboxId - An empty id removes the messages from
+   *   `fromMailboxId` only, see {@link deleteFromMailbox}.
+   * @param {object} [options]
+   * @returns {Promise<object>}
+   */
+  move(ids, fromMailboxId, toMailboxId, { ifInState } = {}) {
+    if (!toMailboxId) {
+      return this.deleteFromMailbox(ids, fromMailboxId);
+    }
+    return this.#updateAll(
+      ids,
+      () => ({
+        [mailboxPath(fromMailboxId)]: null,
+        [mailboxPath(toMailboxId)]: true,
+      }),
+      ifInState
+    );
+  }
+
+  /**
+   * Add messages to a mailbox without removing other memberships.
+   *
+   * @param {string[]} ids
+   * @param {string} mailboxId
+   * @param {object} [options]
+   * @returns {Promise<object>}
+   */
+  addToMailbox(ids, mailboxId, { ifInState } = {}) {
+    return this.#updateAll(
+      ids,
+      () => ({ [mailboxPath(mailboxId)]: true }),
+      ifInState
+    );
+  }
+
+  /**
+   * Remove messages from a mailbox without deleting them.
+   *
+   * @param {string[]} ids
+   * @param {string} mailboxId
+   * @param {object} [options]
+   * @returns {Promise<object>}
+   */
+  removeFromMailbox(ids, mailboxId, { ifInState } = {}) {
+    return this.#updateAll(
+      ids,
+      () => ({ [mailboxPath(mailboxId)]: null }),
+      ifInState
+    );
+  }
+
+  /**
+   * Permanently delete messages from one mailbox. Emails that are also in
+   * other mailboxes only lose their membership of `mailboxId`; emails that
+   * are in no other mailbox are destroyed.
+   *
+   * @param {string[]} ids
+   * @param {string} mailboxId
+   * @returns {Promise<object>}
+   */
+  async deleteFromMailbox(ids, mailboxId) {
+    const unique = [...new Set((ids ?? []).filter(Boolean))];
+    const result = emptyResult();
+    if (!unique.length) {
+      return result;
+    }
+
+    const destroy = [];
+    const keep = [];
+    for (const chunkIds of chunk(unique, this.#batchSize())) {
+      // Emails the server reports as not found are already gone.
+      const { list = [] } = await this.#mail.getEmails({
+        ids: chunkIds,
+        properties: ["id", "mailboxIds"],
+      });
+      for (const email of list) {
+        const others = Object.keys(email.mailboxIds ?? {}).filter(
+          id => id != mailboxId && email.mailboxIds[id]
+        );
+        (others.length ? keep : destroy).push(email.id);
+      }
+    }
+
+    mergeResult(result, await this.destroy(destroy));
+    mergeResult(result, await this.removeFromMailbox(keep, mailboxId));
+    return result;
+  }
+
+  /**
+   * Copy messages into a mailbox (possibly in another account).
+   *
+   * @param {string[]} ids
+   * @param {object} options
+   * @param {string} options.fromAccountId
+   * @param {string} options.toMailboxId
+   * @param {?string} [options.toAccountId]
+   * @param {object} [options.keywords]
+   * @returns {Promise<object>}
+   */
+  copy(ids, {
+    fromAccountId,
+    toMailboxId,
+    toAccountId = null,
+    keywords,
+  } = {}) {
+    return this.#mail.copyEmails({
+      fromAccountId,
+      ids: (ids ?? []).filter(Boolean),
+      toAccountId,
+      mailboxIds: { [toMailboxId]: true },
+      keywords,
+    });
+  }
+}
diff --git a/mailnews/protocols/jmap/modules/JmapOfflineQueue.sys.mjs b/mailnews/protocols/jmap/modules/JmapOfflineQueue.sys.mjs
new file mode 100644
index 00000000000..60515c8d6e7
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapOfflineQueue.sys.mjs
@@ -0,0 +1,160 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Persistent queue of JMAP mutations made while offline.
+ *
+ * Operations are plain JSON (`{kind, args}`) stored per server in
+ * `<profile>/jmap-offline/<serverKey>.json` and replayed, in order, through an
+ * executor registered by the server's `JmapXPCOMClient` when Thunderbird goes
+ * back online.
+ */
+
+const log = console.createInstance({
+  prefix: "mail.jmap.offline",
+  maxLogLevel: "Warn",
+  maxLogLevelPref: "mail.jmap.loglevel",
+});
+
+/** @type {Map<string, (op: object) => Promise<void>>} */
+const executors = new Map();
+/** @type {Map<string, Promise>} serialises file access per server */
+const locks = new Map();
+let observing = false;
+let directoryOverride = null;
+
+function queueDir() {
+  return directoryOverride ?? PathUtils.join(PathUtils.profileDir, "jmap-offline");
+}
+
+function queuePath(serverKey) {
+  return PathUtils.join(queueDir(), `${serverKey.replace(/[^\w.-]/g, "_")}.json`);
+}
+
+function withLock(serverKey, task) {
+  const previous = locks.get(serverKey) ?? Promise.resolve();
+  const next = previous.catch(() => {}).then(task);
+  locks.set(serverKey, next);
+  return next;
+}
+
+async function readQueue(serverKey) {
+  try {
+    const ops = await IOUtils.readJSON(queuePath(serverKey));
+    return Array.isArray(ops) ? ops : [];
+  } catch (e) {
+    if (e.name == "NotFoundError") {
+      return [];
+    }
+    // Do not treat an unreadable queue as empty: the caller would overwrite
+    // it and lose the queued ops.
+    log.error(`Reading JMAP offline queue for ${serverKey} failed`, e);
+    throw e;
+  }
+}
+
+async function writeQueue(serverKey, ops) {
+  const path = queuePath(serverKey);
+  if (!ops.length) {
+    await IOUtils.remove(path, { ignoreAbsent: true });
+    return;
+  }
+  await IOUtils.makeDirectory(queueDir(), { ignoreExisting: true });
+  await IOUtils.writeJSON(path, ops, { tmpPath: `${path}.tmp` });
+}
+
+const observer = {
+  observe(subject, topic, data) {
+    if (topic == "network:offline-status-changed" && data == "online") {
+      for (const serverKey of executors.keys()) {
+        JmapOfflineQueue.replay(serverKey).catch(e =>
+          log.error(`Replaying JMAP offline queue for ${serverKey} failed`, e)
+        );
+      }
+    }
+  },
+};
+
+export const JmapOfflineQueue = {
+  /**
+   * Whether a failure should be queued rather than reported.
+   *
+   * @param {Error} error
+   * @returns {boolean}
+   */
+  shouldQueue(error) {
+    return Services.io.offline && error?.name == "JmapNetworkError";
+  },
+
+  /**
+   * Register the function that replays queued ops for a server.
+   *
+   * @param {string} serverKey
+   * @param {(op: {kind: string, args: Array}) => Promise<void>} executor
+   */
+  registerExecutor(serverKey, executor) {
+    executors.set(serverKey, executor);
+    if (!observing) {
+      Services.obs.addObserver(observer, "network:offline-status-changed");
+      observing = true;
+    }
+  },
+
+  unregisterExecutor(serverKey) {
+    executors.delete(serverKey);
+  },
+
+  /** Append an op to a server's queue. */
+  enqueue(serverKey, op) {
+    return withLock(serverKey, async () => {
+      const ops = await readQueue(serverKey);
+      ops.push({ ...op, queuedAt: Date.now() });
+      await writeQueue(serverKey, ops);
+    });
+  },
+
+  /** The pending ops for a server. */
+  pending(serverKey) {
+    return withLock(serverKey, () => readQueue(serverKey));
+  },
+
+  /**
+   * Replay queued ops in order. Stops at the first network failure (keeping
+   * that op and the rest); other failures drop the op since retrying would
+   * not help (e.g. the message no longer exists).
+   *
+   * @param {string} serverKey
+   * @returns {Promise<number>} Number of ops replayed.
+   */
+  replay(serverKey) {
+    return withLock(serverKey, async () => {
+      const executor = executors.get(serverKey);
+      if (!executor || Services.io.offline) {
+        return 0;
+      }
+      const ops = await readQueue(serverKey);
+      let done = 0;
+      while (ops.length) {
+        try {
+          await executor(ops[0]);
+        } catch (error) {
+          if (error?.name == "JmapNetworkError") {
+            break;
+          }
+          log.warn(`Dropping queued JMAP op ${ops[0].kind}`, error);
+        }
+        ops.shift();
+        done++;
+        // Save progress after each op so a crash does not replay it.
+        await writeQueue(serverKey, ops);
+      }
+      return done;
+    });
+  },
+
+  /** Tests only: store queues in another directory. */
+  _setDirectory(path) {
+    directoryOverride = path;
+  },
+};
diff --git a/mailnews/protocols/jmap/modules/JmapOutgoingServer.sys.mjs b/mailnews/protocols/jmap/modules/JmapOutgoingServer.sys.mjs
new file mode 100644
index 00000000000..24fe575437c
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapOutgoingServer.sys.mjs
@@ -0,0 +1,429 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * nsIMsgOutgoingServer for JMAP accounts (contract
+ * `@mozilla.org/messenger/outgoing/server;1?type=jmap`).
+ *
+ * Sending is: upload the message blob, `Email/import` it into the Sent
+ * mailbox (or the identity's FCC folder when it is a folder of the same JMAP
+ * account) with `$seen`, then `EmailSubmission/set`. Because the server keeps
+ * the sent copy, MessageSend skips its own FCC copy for JMAP servers (see
+ * `JmapOutgoingServer.handlesFcc` and MessageSend.sys.mjs `_doFcc`).
+ */
+
+import { JmapError, JmapAuthError } from "resource:///modules/jmap/JmapErrors.sys.mjs";
+import { JmapCapability } from "resource:///modules/jmap/JmapConstants.sys.mjs";
+import { toNsresult } from "resource:///modules/jmap/JmapMailboxSync.sys.mjs";
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  JmapAccountRegistry: "resource:///modules/jmap/JmapAccountRegistry.sys.mjs",
+  MailServices: "resource:///modules/MailServices.sys.mjs",
+  MailUtils: "resource:///modules/MailUtils.sys.mjs",
+});
+
+const log = console.createInstance({
+  prefix: "mail.jmap.send",
+  maxLogLevel: "Warn",
+  maxLogLevelPref: "mail.jmap.loglevel",
+});
+
+/** Error raised when sending fails for a protocol (non-transport) reason. */
+export class JmapSendError extends JmapError {}
+
+/**
+ * Find the identity id to submit with, matching by email case-insensitively.
+ * Falls back to a wildcard identity (`*@domain`) and then the first one.
+ *
+ * @param {object[]} identities - Identity/get list.
+ * @param {string} email
+ * @returns {?string}
+ */
+export function matchIdentityId(identities, email) {
+  const wanted = (email ?? "").toLowerCase();
+  const exact = identities.find(i => (i.email ?? "").toLowerCase() == wanted);
+  if (exact) {
+    return exact.id;
+  }
+  const domain = wanted.split("@")[1];
+  const wildcard = identities.find(
+    i => (i.email ?? "").toLowerCase() == `*@${domain}`
+  );
+  return wildcard?.id ?? null;
+}
+
+/**
+ * Send a message through a JMAP session.
+ *
+ * @param {JmapClient} client
+ * @param {object} options
+ * @param {Uint8Array} options.bytes - RFC 5322 message.
+ * @param {string} options.fromEmail - Envelope sender / identity email.
+ * @param {string[]} options.recipients - Envelope recipients (incl. Bcc).
+ * @param {?string} [options.mailboxId] - Mailbox for the sent copy; defaults
+ *   to the mailbox with role "sent".
+ * @param {boolean} [options.keepCopy=true] - Whether the server keeps the
+ *   sent copy. Submission needs an Email object, so without a copy the
+ *   message is imported and destroyed once the submission is created.
+ * @param {AbortSignal} [options.signal]
+ * @returns {Promise<{emailId: string, submissionId: string}>}
+ */
+export async function sendJmapMessage(
+  client,
+  { bytes, fromEmail, recipients, mailboxId = null, keepCopy = true, signal }
+) {
+  if (!client.supports(JmapCapability.Submission)) {
+    throw new JmapSendError("Server does not support JMAP submission");
+  }
+  const accountId = client.getAccountId(JmapCapability.Mail);
+  const submissionAccountId = client.getAccountId(JmapCapability.Submission);
+
+  // Identities and the Sent mailbox in one round trip.
+  const { responses } = await client.request(
+    [
+      {
+        name: "Identity/get",
+        args: { accountId: submissionAccountId, ids: null },
+      },
+      { name: "Mailbox/query", args: { accountId, filter: { role: "sent" } } },
+    ],
+    { signal }
+  );
+  const identities = responses[0].args.list ?? [];
+  const identityId = matchIdentityId(identities, fromEmail);
+  if (!identityId) {
+    throw new JmapSendError(`No JMAP identity matches ${fromEmail}`);
+  }
+  if (!mailboxId) {
+    mailboxId =
+      responses[1].args.ids?.[0] ?? null;
+  }
+  if (!mailboxId) {
+    throw new JmapSendError("No Sent mailbox to store the message in");
+  }
+
+  const { blobId } = await client.upload(bytes, "message/rfc822", {
+    accountId,
+    signal,
+  });
+
+  const imported = await client.call(
+    "Email/import",
+    {
+      accountId,
+      emails: {
+        m: {
+          blobId,
+          mailboxIds: { [mailboxId]: true },
+          keywords: { $seen: true },
+        },
+      },
+    },
+    { signal }
+  );
+  const emailId = imported.args.created?.m?.id;
+  if (!emailId) {
+    const failure = imported.args.notCreated?.m;
+    throw new JmapSendError(
+      `Email/import failed: ${failure?.type ?? "unknown"} ${failure?.description ?? ""}`
+    );
+  }
+
+  const submitted = await client.call(
+    "EmailSubmission/set",
+    {
+      accountId: submissionAccountId,
+      create: {
+        s: {
+          identityId,
+          emailId,
+          envelope: {
+            mailFrom: { email: fromEmail },
+            rcptTo: recipients.map(email => ({ email })),
+          },
+        },
+      },
+      ...(keepCopy
+        ? { onSuccessUpdateEmail: { "#s": { "keywords/$draft": null } } }
+        : { onSuccessDestroyEmail: ["#s"] }),
+    },
+    { signal }
+  );
+  const submission = submitted.args.created?.s;
+  if (!submission) {
+    const failure = submitted.args.notCreated?.s;
+    // Don't leave an unsent message in Sent.
+    try {
+      await client.call("Email/set", { accountId, destroy: [emailId] });
+    } catch (e) {
+      log.warn("Failed to remove unsent message", e);
+    }
+    const error = new JmapSendError(
+      `EmailSubmission/set failed: ${failure?.type ?? "unknown"} ${failure?.description ?? ""}`
+    );
+    error.setError = failure;
+    throw error;
+  }
+  return { emailId, submissionId: submission.id };
+}
+
+/** Map a send failure to an nsresult for nsIMsgOutgoingListener. */
+export function sendErrorToNsresult(error) {
+  if (error instanceof JmapAuthError) {
+    // NS_ERROR_SMTP_AUTH_FAILURE: shows the authentication failure prompt.
+    return 0x805530dd;
+  }
+  return toNsresult(error);
+}
+
+export class JmapOutgoingServer {
+  QueryInterface = ChromeUtils.generateQI(["nsIMsgOutgoingServer"]);
+
+  _key = "";
+  _prefs = null;
+
+  get type() {
+    return "jmap";
+  }
+
+  /** MessageSend checks this to skip its own FCC copy. */
+  get handlesFcc() {
+    return true;
+  }
+
+  get wrappedJSObject() {
+    return this;
+  }
+
+  get key() {
+    return this._key;
+  }
+
+  initialize(key) {
+    if (this._key) {
+      throw new Components.Exception(
+        `Server already initialized for key ${key}`,
+        Cr.NS_ERROR_ALREADY_INITIALIZED
+      );
+    }
+    this._key = key;
+    this._prefs = Services.prefs.getBranch(`mail.smtpserver.${key}.`);
+  }
+
+  #getString(name) {
+    return this._prefs?.getStringPref(name, "") ?? "";
+  }
+
+  #setString(name, value) {
+    this._prefs.setStringPref(name, value ?? "");
+  }
+
+  /** The key of the JMAP incoming server this server sends through. */
+  get incomingServerKey() {
+    return this.#getString("jmap_incoming_server");
+  }
+
+  set incomingServerKey(value) {
+    this.#setString("jmap_incoming_server", value);
+  }
+
+  get incomingServer() {
+    const key = this.incomingServerKey;
+    return key ? lazy.MailServices.accounts.getIncomingServer(key) : null;
+  }
+
+  get UID() {
+    const uid = this.#getString("uid");
+    if (uid) {
+      return uid;
+    }
+    const generated = Services.uuid.generateUUID().toString().substring(1, 37);
+    this.#setString("uid", generated);
+    return generated;
+  }
+
+  set UID(uid) {
+    if (this._prefs.prefHasUserValue("uid")) {
+      throw new Components.Exception("uid is already set", Cr.NS_ERROR_ABORT);
+    }
+    this.#setString("uid", uid);
+  }
+
+  get description() {
+    return this.#getString("description");
+  }
+
+  set description(value) {
+    this.#setString("description", value);
+  }
+
+  get username() {
+    return this.incomingServer?.username ?? "";
+  }
+
+  set username(value) {}
+
+  get password() {
+    return this.incomingServer?.password ?? "";
+  }
+
+  set password(value) {}
+
+  get displayname() {
+    const incoming = this.incomingServer;
+    return incoming ? `JMAP (${incoming.prettyName})` : "JMAP";
+  }
+
+  get authMethod() {
+    return this.incomingServer?.authMethod ?? Ci.nsMsgAuthMethod.passwordCleartext;
+  }
+
+  set authMethod(value) {}
+
+  get socketType() {
+    return Ci.nsMsgSocketType.SSL;
+  }
+
+  set socketType(value) {}
+
+  get serverURI() {
+    const incoming = this.incomingServer;
+    return Services.io.newURI(
+      `jmap://${incoming?.hostName || "localhost"}/${this._key}`
+    );
+  }
+
+  get maximumConnectionsNumber() {
+    return 1;
+  }
+
+  set maximumConnectionsNumber(value) {}
+
+  sendMailMessage(
+    filePath,
+    visibleRecipients,
+    bccRecipients,
+    identity,
+    sender,
+    password,
+    statusListener,
+    requestDSN,
+    messageId,
+    listener
+  ) {
+    const controller = new AbortController();
+    const request = {
+      QueryInterface: ChromeUtils.generateQI(["nsIRequest"]),
+      name: `jmap-send:${messageId}`,
+      status: Cr.NS_OK,
+      isPending: () => !controller.signal.aborted,
+      cancel(status) {
+        this.status = status;
+        controller.abort();
+      },
+      suspend() {},
+      resume() {},
+      loadFlags: 0,
+      loadGroup: null,
+    };
+    try {
+      listener.onSendStart(request);
+    } catch (e) {
+      log.error("onSendStart failed", e);
+    }
+
+    (async () => {
+      let status = Cr.NS_OK;
+      let errorMsg = "";
+      try {
+        const incoming = this.incomingServer;
+        if (!incoming) {
+          throw new JmapSendError(
+            `Outgoing server ${this._key} has no JMAP incoming server`
+          );
+        }
+        const client = await lazy.JmapAccountRegistry.getClient(incoming, {
+          signal: controller.signal,
+        });
+        const bytes = await IOUtils.read(filePath.path);
+        const recipients = [...visibleRecipients, ...bccRecipients]
+          .map(r => r.email)
+          .filter(Boolean);
+        // The server keeps the sent copy only when it is the identity's FCC
+        // folder on this account; MessageSend files every other copy itself
+        // (see _outgoingServerHandlesFcc).
+        const mailboxId = this.#fccMailboxId(identity, incoming);
+        await sendJmapMessage(client, {
+          bytes,
+          fromEmail: identity?.email || sender,
+          recipients,
+          mailboxId,
+          keepCopy: !!mailboxId,
+          signal: controller.signal,
+        });
+      } catch (error) {
+        log.error("JMAP send failed", error);
+        status = controller.signal.aborted
+          ? Cr.NS_ERROR_ABORT
+          : sendErrorToNsresult(error);
+        errorMsg = String(error?.message ?? error);
+      }
+      try {
+        listener.onSendStop(this.serverURI, status, null, errorMsg);
+      } catch (e) {
+        log.error("onSendStop failed", e);
+      }
+    })();
+  }
+
+  /**
+   * The JMAP mailbox id of the identity's FCC folder, if that folder lives
+   * on the same JMAP account.
+   */
+  #fccMailboxId(identity, incoming) {
+    try {
+      if (!identity?.doFcc || !identity.fccFolderURI) {
+        return null;
+      }
+      const folder = lazy.MailUtils.getExistingFolder(identity.fccFolderURI);
+      if (folder?.server?.key != incoming.key) {
+        return null;
+      }
+      return folder.QueryInterface(Ci.IJmapFolder).jmapId || null;
+    } catch (e) {
+      return null;
+    }
+  }
+
+  closeCachedConnections() {}
+
+  getPasswordWithUI(promptString, promptTitle) {
+    return this.incomingServer.getPasswordWithUI(promptString, promptTitle);
+  }
+
+  forgetPassword() {
+    this.incomingServer?.forgetPassword();
+  }
+
+  forgetSessionPassword() {
+    this.incomingServer?.forgetSessionPassword(false);
+  }
+
+  verifyLogon(urlListener, msgWindow) {
+    const uri = this.serverURI;
+    urlListener?.OnStartRunningUrl(uri);
+    lazy.JmapAccountRegistry.getClient(this.incomingServer).then(
+      () => urlListener?.OnStopRunningUrl(uri, Cr.NS_OK),
+      error => urlListener?.OnStopRunningUrl(uri, sendErrorToNsresult(error))
+    );
+    return uri;
+  }
+
+  clearAllValues() {
+    for (const prefName of this._prefs.getChildList("")) {
+      this._prefs.clearUserPref(prefName);
+    }
+  }
+}
diff --git a/mailnews/protocols/jmap/modules/JmapPush.sys.mjs b/mailnews/protocols/jmap/modules/JmapPush.sys.mjs
new file mode 100644
index 00000000000..9b1e5a86c9f
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapPush.sys.mjs
@@ -0,0 +1,361 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * JMAP push (RFC 8620 section 7.3) over the session's eventSourceUrl.
+ *
+ * `EventSource` cannot send an Authorization header from a system module, so
+ * this reads the text/event-stream with a streaming `fetch`. `state` events
+ * carry a StateChange object; listeners registered with `addListener` get the
+ * changed types per account. Email/Mailbox/Thread changes trigger
+ * `IJmapIncomingServer.syncMessages`. When the server has no event source or
+ * the stream keeps failing, we fall back to polling.
+ */
+
+import { expandUrlTemplate } from "resource:///modules/jmap/JmapClient.sys.mjs";
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  getAuthHeaders: "resource:///modules/jmap/JmapAuth.sys.mjs",
+  MailServices: "resource:///modules/MailServices.sys.mjs",
+  clearTimeout: "resource://gre/modules/Timer.sys.mjs",
+  setTimeout: "resource://gre/modules/Timer.sys.mjs",
+});
+
+const log = console.createInstance({
+  prefix: "mail.jmap.push",
+  maxLogLevel: "Warn",
+  maxLogLevelPref: "mail.jmap.loglevel",
+});
+
+const MAIL_TYPES = new Set(["Email", "Mailbox", "Thread", "EmailDelivery"]);
+const PING_SECONDS = 60;
+const MAX_BACKOFF_MS = 5 * 60 * 1000;
+const FAILURES_BEFORE_POLLING = 5;
+
+/**
+ * Incremental text/event-stream parser.
+ */
+export class EventStreamParser {
+  #buffer = "";
+  #event = "";
+  #data = [];
+  #onEvent;
+
+  /** @param {(type: string, data: string, id: ?string) => void} onEvent */
+  constructor(onEvent) {
+    this.#onEvent = onEvent;
+  }
+
+  /** @param {string} chunk */
+  feed(chunk) {
+    this.#buffer += chunk;
+    let index;
+    while ((index = this.#buffer.search(/\r\n|\r|\n/)) != -1) {
+      const line = this.#buffer.slice(0, index);
+      const sepLength = this.#buffer.startsWith("\r\n", index) ? 2 : 1;
+      // A lone trailing \r may be the start of \r\n: wait for more data.
+      if (this.#buffer[index] == "\r" && index + 1 == this.#buffer.length) {
+        break;
+      }
+      this.#buffer = this.#buffer.slice(index + sepLength);
+      this.#line(line);
+    }
+  }
+
+  #line(line) {
+    if (line == "") {
+      if (this.#data.length) {
+        this.#onEvent(this.#event || "message", this.#data.join("\n"));
+      }
+      this.#event = "";
+      this.#data = [];
+      return;
+    }
+    if (line.startsWith(":")) {
+      return;
+    }
+    const colon = line.indexOf(":");
+    const field = colon == -1 ? line : line.slice(0, colon);
+    let value = colon == -1 ? "" : line.slice(colon + 1);
+    if (value.startsWith(" ")) {
+      value = value.slice(1);
+    }
+    if (field == "event") {
+      this.#event = value;
+    } else if (field == "data") {
+      this.#data.push(value);
+    }
+  }
+}
+
+/** Compute the reconnect delay for the n-th consecutive failure. */
+export function backoffDelay(failures) {
+  return Math.min(MAX_BACKOFF_MS, 1000 * 2 ** Math.max(0, failures - 1));
+}
+
+class PushConnection {
+  constructor(serverKey, client, options) {
+    this.serverKey = serverKey;
+    this.client = client;
+    this.fetch = options.fetch ?? globalThis.fetch;
+    this.getAuthHeaders = options.getAuthHeaders;
+    this.onStateChange = options.onStateChange;
+    this.onPoll = options.onPoll;
+    this.controller = null;
+    this.failures = 0;
+    this.timer = null;
+    this.stopped = false;
+    this.connected = false;
+  }
+
+  start() {
+    if (!this.client.eventSourceUrl) {
+      this.#schedulePoll();
+      return;
+    }
+    this.#connect();
+  }
+
+  stop() {
+    this.stopped = true;
+    this.controller?.abort();
+    if (this.timer) {
+      lazy.clearTimeout(this.timer);
+      this.timer = null;
+    }
+  }
+
+  async #connect() {
+    if (this.stopped) {
+      return;
+    }
+    this.controller = new AbortController();
+    try {
+      const url = expandUrlTemplate(this.client.eventSourceUrl, {
+        types: "*",
+        closeafter: "no",
+        ping: String(PING_SECONDS),
+      });
+      const headers = {
+        Accept: "text/event-stream",
+        "Cache-Control": "no-cache",
+        ...(await this.getAuthHeaders()),
+      };
+      log.debug(`JMAP push connecting ${this.serverKey}`);
+      // Gecko may only resolve fetch() once the first body bytes arrive, and
+      // an idle event stream sends nothing until a change or ping. Treat the
+      // stream as open while the request is pending; failures reset this.
+      this.connected = true;
+      // "no-store": an open stream holds its HTTP cache entry, which would
+      // block a second stream to the same URL (another account on the host).
+      const response = await this.fetch(url, {
+        headers,
+        cache: "no-store",
+        credentials: "omit",
+        signal: this.controller.signal,
+      });
+      if (!response.ok) {
+        throw new Error(`Event source returned HTTP ${response.status}`);
+      }
+      log.debug(`JMAP push response ${this.serverKey} ${response.status}`);
+      this.connected = true;
+      this.failures = 0;
+      const parser = new EventStreamParser((type, data) =>
+        this.#onEvent(type, data)
+      );
+      const decoder = new TextDecoder();
+      const reader = response.body.getReader();
+      for (;;) {
+        const { value, done } = await reader.read();
+        if (done) {
+          break;
+        }
+        parser.feed(decoder.decode(value, { stream: true }));
+      }
+      throw new Error("Event stream closed");
+    } catch (error) {
+      this.connected = false;
+      if (this.stopped) {
+        return;
+      }
+      this.failures++;
+      log.warn(`JMAP push stream failed (${this.failures})`, error);
+      if (this.failures >= FAILURES_BEFORE_POLLING) {
+        // Poll for a while, then try the stream again.
+        this.#schedulePoll(() => this.#connect());
+        return;
+      }
+      this.timer = lazy.setTimeout(
+        () => this.#connect(),
+        backoffDelay(this.failures)
+      );
+    }
+  }
+
+  #schedulePoll(then = null) {
+    if (this.stopped) {
+      return;
+    }
+    const minutes = Services.prefs.getIntPref(
+      "mail.jmap.push.poll_minutes",
+      5
+    );
+    this.timer = lazy.setTimeout(() => {
+      this.timer = null;
+      try {
+        this.onPoll();
+      } catch (e) {
+        log.error("JMAP poll failed", e);
+      }
+      if (then) {
+        this.failures = 0;
+        then();
+      } else {
+        this.#schedulePoll();
+      }
+    }, minutes * 60 * 1000);
+  }
+
+  #onEvent(type, data) {
+    if (type != "state") {
+      return;
+    }
+    let change;
+    try {
+      change = JSON.parse(data);
+    } catch (e) {
+      log.warn("Malformed JMAP StateChange", data);
+      return;
+    }
+    if (change?.["@type"] != "StateChange" || !change.changed) {
+      return;
+    }
+    this.onStateChange(change.changed);
+  }
+}
+
+/** @type {Map<string, PushConnection>} */
+const connections = new Map();
+/** @type {Map<string, Set<{types: ?Set<string>, callback: Function}>>} */
+const listeners = new Map();
+
+export const JmapPush = {
+  /**
+   * Start push for a server if not already running.
+   *
+   * @param {nsIMsgIncomingServer|string} serverOrKey
+   * @param {JmapClient} client
+   * @param {object} [options] - Test hooks: fetch, getAuthHeaders,
+   *   onMailChange.
+   */
+  start(serverOrKey, client, options = {}) {
+    const serverKey =
+      typeof serverOrKey == "string" ? serverOrKey : serverOrKey.key;
+    if (connections.has(serverKey)) {
+      return;
+    }
+    if (!Services.prefs.getBoolPref("mail.jmap.push.enabled", true)) {
+      return;
+    }
+    const getServer = () =>
+      typeof serverOrKey == "string"
+        ? lazy.MailServices.accounts.getIncomingServer(serverKey)
+        : serverOrKey;
+    // Per-account switch from the account settings pane.
+    try {
+      if (getServer()?.getBoolValue("jmap_push_enabled") === false &&
+          getServer().getStringValue("jmap_push_enabled") !== "") {
+        return;
+      }
+    } catch (e) {}
+    const syncMail =
+      options.onMailChange ??
+      (() =>
+        getServer().QueryInterface(Ci.IJmapIncomingServer).syncMessages(null));
+    const connection = new PushConnection(serverKey, client, {
+      fetch: options.fetch,
+      getAuthHeaders:
+        options.getAuthHeaders ?? (() => lazy.getAuthHeaders(getServer())),
+      onPoll: () => {
+        syncMail();
+        this._dispatch(serverKey, null);
+      },
+      onStateChange: changed => {
+        let mail = false;
+        for (const types of Object.values(changed)) {
+          if (Object.keys(types).some(t => MAIL_TYPES.has(t))) {
+            mail = true;
+          }
+        }
+        if (mail) {
+          try {
+            syncMail();
+          } catch (e) {
+            log.error("Failed to start JMAP sync from push", e);
+          }
+        }
+        this._dispatch(serverKey, changed);
+      },
+    });
+    connections.set(serverKey, connection);
+    connection.start();
+  },
+
+  /** Stop push for a server. */
+  stop(serverKey) {
+    connections.get(serverKey)?.stop();
+    connections.delete(serverKey);
+  },
+
+  /** Whether a push stream is currently connected for a server. */
+  isConnected(serverKey) {
+    return connections.get(serverKey)?.connected ?? false;
+  },
+
+  /**
+   * Subscribe to state changes.
+   *
+   * @param {string} serverKey
+   * @param {?string[]} types - JMAP type names (e.g. "ContactCard",
+   *   "CalendarEvent"), or null for all.
+   * @param {(changed: ?object) => void} callback - Called with
+   *   `{accountId: {Type: state}}` restricted to `types`, or with null when a
+   *   poll tick happened (the caller should check for changes itself).
+   * @returns {Function} Unsubscribe function.
+   */
+  addListener(serverKey, types, callback) {
+    let set = listeners.get(serverKey);
+    if (!set) {
+      set = new Set();
+      listeners.set(serverKey, set);
+    }
+    const entry = { types: types ? new Set(types) : null, callback };
+    set.add(entry);
+    return () => set.delete(entry);
+  },
+
+  _dispatch(serverKey, changed) {
+    for (const { types, callback } of listeners.get(serverKey) ?? []) {
+      let filtered = changed;
+      if (changed && types) {
+        filtered = {};
+        for (const [accountId, states] of Object.entries(changed)) {
+          const matching = Object.entries(states).filter(([t]) => types.has(t));
+          if (matching.length) {
+            filtered[accountId] = Object.fromEntries(matching);
+          }
+        }
+        if (!Object.keys(filtered).length) {
+          continue;
+        }
+      }
+      try {
+        callback(filtered);
+      } catch (e) {
+        log.error("JMAP push listener failed", e);
+      }
+    }
+  },
+};
diff --git a/mailnews/protocols/jmap/modules/JmapSync.sys.mjs b/mailnews/protocols/jmap/modules/JmapSync.sys.mjs
new file mode 100644
index 00000000000..6341db2776b
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapSync.sys.mjs
@@ -0,0 +1,382 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import {
+  JmapCapability,
+  JmapMethodErrorType,
+  JmapRequestErrorType,
+} from "resource:///modules/jmap/JmapConstants.sys.mjs";
+import {
+  JmapMethodError,
+  JmapRequestError,
+} from "resource:///modules/jmap/JmapErrors.sys.mjs";
+import { normalizeEmail } from "resource:///modules/jmap/JmapMessage.sys.mjs";
+
+/**
+ * The local side of a JMAP metadata sync.
+ *
+ * The engine never touches `nsIMsgDatabase` directly; `JmapFolderStore`
+ * implements this contract on top of Thunderbird's folder and message
+ * database objects, and tests use an in-memory implementation.
+ *
+ * @typedef {object} JmapSyncStore
+ * @property {(mailboxes: object[]) => Promise<void>} prepare - Create any
+ *   missing local folders and build the lookup structures used below.
+ * @property {(mailboxId: string) => object[]} foldersForMailbox - Local
+ *   folders mirroring a JMAP mailbox. Normally exactly one.
+ * @property {(emailId: string) => {folder: object, header: object}[]}
+ *   headersForEmail - Local headers currently storing a JMAP email.
+ * @property {(folder: object) => {jmapId: string, header: object}[]}
+ *   listHeaders - Every JMAP-backed header in a folder.
+ * @property {(folder: object, message: object, options: object) => void}
+ *   create - Add a header for a normalized message. `options.isNew` asks for
+ *   the message to be flagged as new.
+ * @property {(folder: object, header: object, message: object) => void}
+ *   update - Apply a normalized message to an existing header.
+ * @property {(folder: object, header: object) => void} remove - Delete a
+ *   header.
+ * @property {() => Promise<?string>} getState - The account-wide
+ *   `Email/changes` state token, or null when a full sync is needed.
+ * @property {(state: string) => Promise<void>} setState - Persist the state
+ *   token after a successful sync.
+ * @property {() => Promise<void>} flush - Commit database changes and
+ *   refresh folder counts.
+ */
+
+/**
+ * Whether an error means the server cannot calculate changes from our state
+ * token, in which case a full resync is required.
+ *
+ * RFC 8620 defines this as a request-level problem type, but some servers
+ * report it as a method-level error instead.
+ *
+ * @param {*} error
+ * @returns {boolean}
+ */
+export function isCannotCalculateChanges(error) {
+  if (error instanceof JmapRequestError) {
+    return error.type === JmapRequestErrorType.CannotCalculateChanges;
+  }
+  if (error instanceof JmapMethodError) {
+    return error.type === JmapMethodErrorType.CannotCalculateChanges;
+  }
+  return false;
+}
+
+/**
+ * Synchronize JMAP email metadata into local folders.
+ *
+ * The first sync for an account lists every message of every mailbox. Later
+ * syncs use `Email/changes` with the state token kept by the store, and fall
+ * back to a full sync when the server cannot calculate changes.
+ */
+export class JmapSyncEngine {
+  #mail;
+  #store;
+  #logger;
+  #batchSize;
+
+  /**
+   * @param {object} options
+   * @param {object} options.mail - A `JmapMailClient` (or a compatible
+   *   object with the methods used below).
+   * @param {JmapSyncStore} options.store
+   * @param {?object} [options.logger] - Object with `debug`/`warn` methods.
+   * @param {number} [options.batchSize=100] - Maximum number of emails per
+   *   `Email/get` request, capped by the server's `maxObjectsInGet`.
+   */
+  constructor({ mail, store, logger = null, batchSize = 100 } = {}) {
+    if (!mail) {
+      throw new TypeError("JmapSyncEngine requires a mail client");
+    }
+    if (!store) {
+      throw new TypeError("JmapSyncEngine requires a store");
+    }
+
+    this.#mail = mail;
+    this.#store = store;
+    this.#logger = logger;
+    this.#batchSize = Math.max(1, Number(batchSize) || 100);
+  }
+
+  /**
+   * Run one synchronization.
+   *
+   * @returns {Promise<{mode: "full"|"incremental", created: number,
+   *   updated: number, deleted: number}>}
+   */
+  async sync() {
+    const { list = [] } = await this.#mail.getMailboxes();
+    const mailboxes = list.filter(mailbox => mailbox?.id);
+
+    await this.#store.prepare(mailboxes);
+
+    const state = await this.#store.getState();
+    let stats;
+    if (!state) {
+      stats = await this.#fullSync(mailboxes);
+    } else {
+      try {
+        stats = await this.#incrementalSync(state);
+      } catch (error) {
+        if (!isCannotCalculateChanges(error)) {
+          throw error;
+        }
+        this.#logger?.warn?.(
+          "JMAP sync: cannot calculate changes, performing a full resync"
+        );
+        stats = await this.#fullSync(mailboxes);
+      }
+    }
+
+    await this.#store.flush();
+    return stats;
+  }
+
+  /**
+   * Fetch every message of every mailbox and reconcile the local folders
+   * with the server.
+   *
+   * @param {object[]} mailboxes
+   * @returns {Promise<object>}
+   */
+  async #fullSync(mailboxes) {
+    const stats = {
+      mode: "full",
+      created: 0,
+      updated: 0,
+      deleted: 0,
+    };
+
+    // Read the state before querying so changes made during the sync are
+    // reported again by the next Email/changes; replaying them is harmless.
+    const { state = "" } = await this.#mail.getEmails({ ids: [] });
+
+    for (const mailbox of mailboxes) {
+      const folders = this.#store.foldersForMailbox(mailbox.id);
+      if (!folders.length) {
+        continue;
+      }
+
+      const ids = await this.#queryAllIds(mailbox.id);
+      const seen = new Set();
+
+      for await (const emails of this.#fetchEmails(ids)) {
+        for (const email of emails) {
+          if (!email?.id) {
+            continue;
+          }
+          seen.add(email.id);
+
+          const message = normalizeEmail(email);
+          const existing = this.#store
+            .headersForEmail(email.id)
+            .filter(entry => folders.includes(entry.folder));
+
+          if (existing.length) {
+            for (const { folder, header } of existing) {
+              this.#store.update(folder, header, message);
+              stats.updated++;
+            }
+            continue;
+          }
+
+          for (const folder of folders) {
+            // A full sync is not "new mail": avoid flagging every unread
+            // message as new and notifying about the whole account.
+            this.#store.create(folder, message, { isNew: false });
+            stats.created++;
+          }
+        }
+      }
+
+      // Remove local headers which no longer exist on the server.
+      for (const folder of folders) {
+        for (const { jmapId, header } of this.#store.listHeaders(folder)) {
+          if (!seen.has(jmapId)) {
+            this.#store.remove(folder, header);
+            stats.deleted++;
+          }
+        }
+      }
+    }
+
+    await this.#store.setState(state ?? "");
+    return stats;
+  }
+
+  /**
+   * Apply `Email/changes` to the local folders.
+   *
+   * @param {string} state
+   * @returns {Promise<object>}
+   */
+  async #incrementalSync(state) {
+    const changes = await this.#collectChanges(state);
+    const createdIds = new Set(changes.created);
+    const fetchIds = [...new Set([...changes.created, ...changes.updated])];
+
+    const stats = {
+      mode: "incremental",
+      created: 0,
+      updated: 0,
+      deleted: 0,
+    };
+
+    for await (const emails of this.#fetchEmails(fetchIds)) {
+      for (const email of emails) {
+        if (!email?.id) {
+          continue;
+        }
+
+        const message = normalizeEmail(email);
+        const folders = message.mailboxIds.flatMap(mailboxId =>
+          this.#store.foldersForMailbox(mailboxId)
+        );
+        const wantedFolders = new Set(folders);
+        const existingFolders = new Set();
+
+        for (const { folder, header } of this.#store.headersForEmail(
+          email.id
+        )) {
+          if (wantedFolders.has(folder)) {
+            this.#store.update(folder, header, message);
+            existingFolders.add(folder);
+            stats.updated++;
+          } else {
+            // The message was moved out of, or removed from, this folder.
+            this.#store.remove(folder, header);
+            stats.deleted++;
+          }
+        }
+
+        for (const folder of folders) {
+          if (existingFolders.has(folder)) {
+            continue;
+          }
+          this.#store.create(folder, message, {
+            isNew: createdIds.has(email.id),
+          });
+          stats.created++;
+        }
+      }
+    }
+
+    for (const emailId of changes.destroyed) {
+      for (const { folder, header } of this.#store.headersForEmail(emailId)) {
+        this.#store.remove(folder, header);
+        stats.deleted++;
+      }
+    }
+
+    await this.#store.setState(changes.newState);
+    return stats;
+  }
+
+  /**
+   * Follow `hasMoreChanges` until the server has reported every change.
+   *
+   * @param {string} state
+   * @returns {Promise<{created: string[], updated: string[],
+   *   destroyed: string[], newState: string}>}
+   */
+  async #collectChanges(state) {
+    const created = [];
+    const updated = [];
+    const destroyed = [];
+    let sinceState = state;
+    let newState = state;
+
+    for (;;) {
+      const page = await this.#mail.getEmailChanges({
+        sinceState,
+        maxChanges: this.#batchSizeForRequest(),
+      });
+      created.push(...(page.created ?? []));
+      updated.push(...(page.updated ?? []));
+      destroyed.push(...(page.destroyed ?? []));
+
+      newState = page.newState ?? sinceState;
+      if (!page.hasMoreChanges || newState === sinceState) {
+        break;
+      }
+      sinceState = newState;
+    }
+
+    return { created, updated, destroyed, newState };
+  }
+
+  /**
+   * List every email id in a mailbox, handling server paging.
+   *
+   * @param {string} mailboxId
+   * @returns {Promise<string[]>}
+   */
+  async #queryAllIds(mailboxId) {
+    const limit = this.#batchSizeForRequest();
+    const ids = [];
+    let position = 0;
+
+    for (;;) {
+      const result = await this.#mail.queryEmails({
+        filter: { inMailbox: mailboxId },
+        position,
+        limit,
+        calculateTotal: true,
+        collapseThreads: false,
+      });
+
+      const page = result.ids ?? [];
+      ids.push(...page);
+
+      if (!page.length) {
+        break;
+      }
+
+      const total = Number(result.total);
+      if (Number.isFinite(total)) {
+        // `total` is authoritative even if the server capped the page below
+        // the requested limit.
+        if (ids.length >= total) {
+          break;
+        }
+      } else if (page.length < limit) {
+        break;
+      }
+      position += page.length;
+    }
+
+    return ids;
+  }
+
+  /**
+   * Fetch emails in batches, yielding each `Email/get` result list.
+   *
+   * @param {string[]} ids
+   * @returns {AsyncGenerator<object[]>}
+   */
+  async *#fetchEmails(ids) {
+    const limit = this.#batchSizeForRequest();
+    for (let index = 0; index < ids.length; index += limit) {
+      const chunk = ids.slice(index, index + limit);
+      const { list = [] } = await this.#mail.getEmails({ ids: chunk });
+      yield list;
+    }
+  }
+
+  /**
+   * `Email/get` batch size: the configured value, capped by the server's
+   * advertised `maxObjectsInGet`.
+   *
+   * @returns {number}
+   */
+  #batchSizeForRequest() {
+    const core = this.#mail.client?.capabilities?.[JmapCapability.Core];
+    const limit = Number(core?.maxObjectsInGet);
+    if (Number.isFinite(limit) && limit > 0) {
+      return Math.max(1, Math.min(this.#batchSize, limit));
+    }
+    return this.#batchSize;
+  }
+}
diff --git a/mailnews/protocols/jmap/modules/JmapTransport.sys.mjs b/mailnews/protocols/jmap/modules/JmapTransport.sys.mjs
new file mode 100644
index 00000000000..f5bc81b9a0b
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapTransport.sys.mjs
@@ -0,0 +1,622 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import {
+  JmapAuthError,
+  JmapError,
+  JmapHttpError,
+  JmapNetworkError,
+  JmapRateLimitError,
+} from "resource:///modules/jmap/JmapErrors.sys.mjs";
+import { clearTimeout, setTimeout } from "resource://gre/modules/Timer.sys.mjs";
+
+/** Default client-side request rate, in requests per second (0 = no limit). */
+const DEFAULT_REQUESTS_PER_SECOND = 10;
+
+/** Requests that may be sent back to back before pacing starts. */
+const DEFAULT_BURST = 20;
+
+/** Longest pause after a 429, whatever the server asks for. */
+const RATE_LIMIT_MAX_PAUSE_MS = 60000;
+
+/** How often a rate-limited (429) request is retried. */
+const DEFAULT_RATE_LIMIT_RETRIES = 6;
+
+/**
+ * Per-origin pacing state, shared by every transport talking to the same
+ * server: mail, contacts, calendars and files each have their own client, but
+ * the server counts all of their requests against one account limit.
+ *
+ * @type {Map<string, {pausedUntil: number, tat: number}>}
+ */
+const originGates = new Map();
+
+function gateFor(url) {
+  let origin;
+  try {
+    origin = new URL(url).origin;
+  } catch {
+    origin = String(url);
+  }
+  let gate = originGates.get(origin);
+  if (!gate) {
+    gate = { pausedUntil: 0, tat: 0 };
+    originGates.set(origin, gate);
+  }
+  return gate;
+}
+
+function defaultRequestsPerSecond() {
+  try {
+    return Services.prefs.getIntPref(
+      "mail.jmap.max_requests_per_second",
+      DEFAULT_REQUESTS_PER_SECOND
+    );
+  } catch {
+    return DEFAULT_REQUESTS_PER_SECOND;
+  }
+}
+
+/** Maximum delay we are willing to honour from a `Retry-After` header. */
+const MAX_RETRY_AFTER_MS = 120000;
+
+/**
+ * HTTP transport used by the JMAP client.
+ *
+ * The transport is deliberately small: it knows how to attach credentials,
+ * apply a timeout, retry transient failures and turn HTTP error responses
+ * into typed errors. It does not know anything about JMAP itself, which makes
+ * it easy to replace with a mock in tests and with a Rust implementation
+ * later.
+ */
+export class JmapTransport {
+  /**
+   * @param {object} [options]
+   * @param {Function} [options.fetchImpl] - `fetch`-compatible function. May
+   *   be swapped out in tests.
+   * @param {Function} [options.getAuthHeaders] - Async function returning an
+   *   object of headers to add to every request (for example
+   *   `{ Authorization: "Bearer ..." }`). Called once per attempt so OAuth2
+   *   tokens can be refreshed. Returning a falsy value adds no headers.
+   * @param {number} [options.timeout] - Request timeout in milliseconds. Set
+   *   to 0 to disable the timeout.
+   * @param {number} [options.maxRetries] - Number of retries for requests
+   *   that are considered retryable.
+   * @param {Function} [options.retryDelay] - Function
+   *   `(error, attempt) => milliseconds` used between retries. Intended for
+   *   deterministic tests.
+   * @param {Console} [options.logger] - Optional logger.
+   */
+  constructor({
+    fetchImpl = globalThis.fetch,
+    getAuthHeaders = null,
+    timeout = 30000,
+    maxRetries = 2,
+    rateLimitRetries = DEFAULT_RATE_LIMIT_RETRIES,
+    requestsPerSecond = defaultRequestsPerSecond(),
+    burst = DEFAULT_BURST,
+    retryDelay = null,
+    logger = null,
+  } = {}) {
+    if (typeof fetchImpl !== "function") {
+      throw new TypeError("JmapTransport requires a fetch implementation");
+    }
+    if (getAuthHeaders !== null && typeof getAuthHeaders !== "function") {
+      throw new TypeError("getAuthHeaders must be a function");
+    }
+
+    this.fetchImpl = fetchImpl;
+    this.getAuthHeaders = getAuthHeaders;
+    this.timeout = timeout;
+    this.maxRetries = maxRetries;
+    this.rateLimitRetries = rateLimitRetries;
+    this.requestsPerSecond = requestsPerSecond;
+    this.burst = Math.max(1, burst);
+    this.retryDelay = retryDelay ?? defaultRetryDelay;
+    this.logger = logger;
+  }
+
+  /**
+   * Perform an HTTP request.
+   *
+   * @param {string} url
+   * @param {object} [options]
+   * @param {string} [options.method] - HTTP method, defaults to `GET`.
+   * @param {object} [options.headers] - Additional request headers.
+   * @param {*} [options.body] - Request body. Plain objects are serialised
+   *   as JSON; strings, blobs, buffers and form data are sent as-is.
+   * @param {AbortSignal} [options.signal] - Caller cancellation signal.
+   * @param {"json"|"text"|"blob"|"arrayBuffer"} [options.responseType] - How
+   *   to read the response body. Defaults to `json`.
+   * @param {boolean} [options.retry] - Override the retry policy. By default
+   *   only idempotent requests (GET/HEAD) are retried.
+   * @param {number} [options.timeout] - Per-request timeout in milliseconds,
+   *   overriding the transport default.
+   * @returns {Promise<{status: number, headers: Headers, body: *}>}
+   * @throws {JmapNetworkError} On transport failures and timeouts.
+   * @throws {JmapAuthError} On 401/403 responses.
+   * @throws {JmapRateLimitError} On 429 responses.
+   * @throws {JmapHttpError} On any other non-success status.
+   */
+  async request(
+    url,
+    {
+      method = "GET",
+      headers = {},
+      body,
+      signal,
+      responseType = "json",
+      retry,
+      rateLimitRetry = true,
+      slot = null,
+      timeout,
+    } = {}
+  ) {
+    if (signal?.aborted) {
+      throw new JmapNetworkError("JMAP request was aborted", { aborted: true });
+    }
+
+    const canRetry =
+      typeof retry == "boolean"
+        ? retry
+        : method === "GET" || method === "HEAD";
+    // A ReadableStream body cannot be replayed, so retrying is unsafe.
+    const replayable = !isStreamBody(body);
+    const attempts = canRetry && replayable ? Math.max(0, this.maxRetries) + 1 : 1;
+    // A 429 means the server did not process the request, so even a POST
+    // sent with `retry: false` can be sent again. Rate limits last longer
+    // than other transient errors, so they get their own budget; callers opt
+    // out with `rateLimitRetry: false`.
+    const rateLimitAttempts =
+      replayable && rateLimitRetry ? Math.max(0, this.rateLimitRetries) + 1 : 1;
+    const gate = gateFor(url);
+
+    let rateLimited = 0;
+    let other = 0;
+    for (;;) {
+      await this.#waitForTurn(gate, signal);
+      // Take the caller's concurrency slot only once the request may go out,
+      // and give it back before any retry wait, so that a paused request does
+      // not block other requests to the server.
+      await slot?.acquire(signal);
+      // Waiting for the slot takes time: re-check the abort signal, any
+      // rate-limit pause and the request rate, and only then use up a token.
+      if (signal?.aborted || !this.#takeToken(gate)) {
+        slot?.release();
+        throwIfAborted(signal);
+        continue;
+      }
+      let result;
+      let failure = null;
+      try {
+        result = await this.#requestOnce(url, {
+          method,
+          headers,
+          body,
+          signal,
+          responseType,
+          timeout: timeout ?? this.timeout,
+        });
+      } catch (error) {
+        failure = error;
+      } finally {
+        slot?.release();
+      }
+      if (!failure) {
+        return result;
+      }
+
+      const error = failure;
+      const isRateLimit = error instanceof JmapRateLimitError;
+      const attempt = isRateLimit ? rateLimited++ : other++;
+      const isLastAttempt =
+        attempt + 1 >= (isRateLimit ? rateLimitAttempts : attempts);
+      if (
+        isLastAttempt ||
+        !(error instanceof JmapError) ||
+        !this.#shouldRetry(error)
+      ) {
+        throw error;
+      }
+
+      const delay = this.retryDelay(error, attempt);
+      if (isRateLimit) {
+        // Hold back every request to this server, not just this one.
+        gate.pausedUntil = Math.max(gate.pausedUntil, Date.now() + delay);
+        this.logger?.warn?.(
+          `JMAP server ${new URL(url).host} is rate limiting requests; pausing for ${delay}ms`
+        );
+      } else {
+        this.logger?.debug?.(
+          `Retrying JMAP request to ${url} in ${delay}ms (attempt ${
+            attempt + 2
+          }/${attempts})`
+        );
+        await sleep(delay, signal);
+      }
+    }
+  }
+
+  /**
+   * Wait until this server may probably be sent another request: after any
+   * pause caused by a 429, and within the client-side request rate. Nothing is
+   * reserved here; {@link #takeToken} does that right before sending.
+   *
+   * @param {{pausedUntil: number, tat: number}} gate
+   * @param {AbortSignal} [signal]
+   */
+  async #waitForTurn(gate, signal) {
+    for (;;) {
+      throwIfAborted(signal);
+      const wait = this.#delayFor(gate);
+      if (wait <= 0) {
+        return;
+      }
+      await sleep(wait, signal);
+    }
+  }
+
+  /**
+   * How long a request to this server has to wait right now.
+   *
+   * @param {{pausedUntil: number, tat: number}} gate
+   * @returns {number} Milliseconds; 0 or less means it may go now.
+   */
+  #delayFor(gate) {
+    const now = Date.now();
+    const pause = gate.pausedUntil - now;
+    if (pause > 0) {
+      return pause;
+    }
+    if (!(this.requestsPerSecond > 0)) {
+      return 0;
+    }
+    // Generic cell rate algorithm: `tat` is the theoretical arrival time of
+    // the next request; up to `burst` requests may go out back to back.
+    const interval = 1000 / this.requestsPerSecond;
+    return Math.max(gate.tat, now - (this.burst - 1) * interval) - now;
+  }
+
+  /**
+   * Reserve a request token if the request may go out now.
+   *
+   * @param {{pausedUntil: number, tat: number}} gate
+   * @returns {boolean} False when the request has to wait again.
+   */
+  #takeToken(gate) {
+    if (this.#delayFor(gate) > 0) {
+      return false;
+    }
+    if (this.requestsPerSecond > 0) {
+      const now = Date.now();
+      const interval = 1000 / this.requestsPerSecond;
+      gate.tat = Math.max(gate.tat, now - (this.burst - 1) * interval) + interval;
+    }
+    return true;
+  }
+
+  /**
+   * Perform a single HTTP request, without retries.
+   *
+   * @param {string} url
+   * @param {object} options
+   * @returns {Promise<{status: number, headers: Headers, body: *}>}
+   */
+  async #requestOnce(
+    url,
+    { method, headers, body, signal, responseType, timeout }
+  ) {
+    const requestHeaders = { ...headers };
+    let requestBody = body;
+
+    if (this.getAuthHeaders) {
+      const authHeaders = await this.getAuthHeaders();
+      if (authHeaders) {
+        Object.assign(requestHeaders, authHeaders);
+      }
+    }
+
+    if (body !== undefined && body !== null && !isPassthroughBody(body)) {
+      requestBody = JSON.stringify(body);
+      requestHeaders["Content-Type"] ??= "application/json";
+    }
+
+    // AbortSignal.timeout() needs a window, which system modules don't have,
+    // so the timeout and the caller's signal are combined by hand.
+    const controller = new AbortController();
+    let timer = null;
+    const onCallerAbort = () => controller.abort(signal.reason);
+    if (signal?.aborted) {
+      onCallerAbort();
+    } else {
+      signal?.addEventListener("abort", onCallerAbort, { once: true });
+    }
+    if (timeout > 0) {
+      timer = setTimeout(
+        () =>
+          controller.abort(
+            new DOMException("JMAP request timed out", "TimeoutError")
+          ),
+        timeout
+      );
+    }
+    const combinedSignal = controller.signal;
+
+    try {
+      return await this.#send(url, {
+        method,
+        requestHeaders,
+        requestBody,
+        combinedSignal,
+        signal,
+        responseType,
+      });
+    } finally {
+      clearTimeout(timer);
+      signal?.removeEventListener("abort", onCallerAbort);
+    }
+  }
+
+  /**
+   * Perform the fetch and read the response. The body is read before the
+   * timeout is cleared, so a stalled body read also times out.
+   */
+  async #send(
+    url,
+    { method, requestHeaders, requestBody, combinedSignal, signal, responseType }
+  ) {
+    let response;
+    try {
+      this.logger?.debug?.(`JMAP ${method} ${url}`);
+      response = await this.fetchImpl(url, {
+        method,
+        headers: requestHeaders,
+        body: requestBody,
+        signal: combinedSignal,
+        credentials: "omit",
+      });
+    } catch (cause) {
+      this.logger?.debug?.(`JMAP ${method} ${url} failed: ${cause}`);
+      throw toNetworkError(cause, signal);
+    }
+    this.logger?.debug?.(`JMAP ${method} ${url} -> ${response.status}`);
+
+    if (!response.ok) {
+      // Error bodies are always read as text/JSON, even for blob requests.
+      const errorData = await parseBody(response, "json");
+      throw toHttpError(response, errorData, url);
+    }
+
+    const data = await parseBody(response, responseType);
+    return { status: response.status, headers: response.headers, body: data };
+  }
+
+  /**
+   * Whether a failed request may be retried.
+   *
+   * @param {JmapError} error
+   * @returns {boolean}
+   */
+  #shouldRetry(error) {
+    if (error instanceof JmapAuthError) {
+      return false;
+    }
+    if (error instanceof JmapHttpError) {
+      return error.isRetryable;
+    }
+    if (error instanceof JmapNetworkError) {
+      return !error.aborted;
+    }
+    return false;
+  }
+}
+
+/**
+ * Default retry delay: honour the server's `Retry-After` if present, and
+ * otherwise use exponential backoff with a small amount of jitter.
+ *
+ * @param {JmapHttpError} error
+ * @param {number} attempt - Zero-based attempt number.
+ * @returns {number} Delay in milliseconds.
+ */
+function defaultRetryDelay(error, attempt) {
+  if (error instanceof JmapRateLimitError) {
+    // Rate limit windows are usually a minute long. Back off at least
+    // exponentially, even when the server asks for less (`Retry-After: 0`),
+    // and never pause longer than a minute so that a request (and the
+    // message display waiting on it) does not hang for many minutes.
+    const backoff = Math.min(2 ** attempt * 2000, RATE_LIMIT_MAX_PAUSE_MS);
+    const requested = Math.min(error.retryAfter ?? 0, RATE_LIMIT_MAX_PAUSE_MS);
+    return Math.max(backoff, requested) + Math.floor(Math.random() * 1000);
+  }
+  if (error.retryAfter != null) {
+    return Math.min(error.retryAfter, MAX_RETRY_AFTER_MS);
+  }
+  const base = Math.min(2 ** attempt * 500, 10000);
+  return base + Math.floor(Math.random() * 250);
+}
+
+/**
+ * Read and, when requested, parse a response body.
+ *
+ * @param {Response} response
+ * @param {"json"|"text"|"blob"|"arrayBuffer"} responseType
+ * @returns {Promise<*>}
+ */
+async function parseBody(response, responseType) {
+  switch (responseType) {
+    case "blob":
+      return response.blob();
+    case "arrayBuffer":
+      return response.arrayBuffer();
+    case "text":
+      return response.text();
+    case "json": {
+      const text = await response.text();
+      if (!text) {
+        return null;
+      }
+      try {
+        return JSON.parse(text);
+      } catch {
+        // A non-JSON error page is still useful to the caller as text.
+        return text;
+      }
+    }
+    default:
+      throw new TypeError(`Unsupported responseType: ${responseType}`);
+  }
+}
+
+/**
+ * Convert a fetch rejection into a typed network error.
+ *
+ * @param {*} cause
+ * @param {AbortSignal} [signal]
+ * @returns {JmapNetworkError}
+ */
+function toNetworkError(cause, signal) {
+  if (signal?.aborted) {
+    return new JmapNetworkError("JMAP request was aborted", {
+      aborted: true,
+      cause,
+    });
+  }
+  if (cause?.name === "TimeoutError") {
+    return new JmapNetworkError("JMAP request timed out", {
+      timeout: true,
+      cause,
+    });
+  }
+  return new JmapNetworkError(
+    `JMAP request failed: ${cause?.message ?? String(cause)}`,
+    { cause }
+  );
+}
+
+/**
+ * Build the appropriate typed error for a non-success HTTP response.
+ *
+ * @param {Response} response
+ * @param {*} data - Parsed response body.
+ * @param {string} url
+ * @returns {JmapHttpError}
+ */
+function toHttpError(response, data, url) {
+  const isProblem =
+    typeof data == "object" &&
+    data !== null &&
+    !Array.isArray(data) &&
+    typeof data.type == "string";
+
+  const type = isProblem ? data.type : null;
+  const detail =
+    isProblem && typeof data.detail == "string" ? data.detail : null;
+  const message =
+    detail ??
+    (isProblem ? `JMAP error ${type}` : `HTTP ${response.status} from ${url}`);
+  const options = {
+    status: response.status,
+    type,
+    detail,
+    retryAfter: parseRetryAfter(response.headers.get("retry-after")),
+    body: data,
+    url,
+  };
+
+  if (response.status === 401 || response.status === 403) {
+    return new JmapAuthError(message, options);
+  }
+  if (response.status === 429) {
+    return new JmapRateLimitError(message, options);
+  }
+  return new JmapHttpError(message, options);
+}
+
+/**
+ * Parse a `Retry-After` header, which is either a number of seconds or an
+ * HTTP date.
+ *
+ * @param {?string} value
+ * @returns {?number} Delay in milliseconds, or null.
+ */
+export function parseRetryAfter(value) {
+  if (!value) {
+    return null;
+  }
+  const seconds = Number(value);
+  if (Number.isFinite(seconds)) {
+    return Math.max(0, seconds * 1000);
+  }
+  const date = Date.parse(value);
+  if (Number.isFinite(date)) {
+    return Math.max(0, date - Date.now());
+  }
+  return null;
+}
+
+/**
+ * Bodies that `fetch` accepts directly and that must not be JSON encoded.
+ *
+ * @param {*} body
+ * @returns {boolean}
+ */
+function isPassthroughBody(body) {
+  if (typeof body == "string") {
+    return true;
+  }
+  // Duck-typed: Blobs and buffers may come from another global.
+  if (typeof body?.byteLength == "number" || typeof body?.arrayBuffer == "function") {
+    return true;
+  }
+  for (const type of ["FormData", "URLSearchParams", "ReadableStream"]) {
+    if (
+      typeof globalThis[type] == "function" &&
+      body instanceof globalThis[type]
+    ) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/**
+ * @param {*} body
+ * @returns {boolean}
+ */
+function isStreamBody(body) {
+  return typeof ReadableStream == "function" && body instanceof ReadableStream;
+}
+
+/**
+ * @param {number} ms
+ * @returns {Promise<void>}
+ */
+function sleep(ms, signal) {
+  return new Promise((resolve, reject) => {
+    if (signal?.aborted) {
+      reject(new JmapNetworkError("JMAP request was aborted", { aborted: true }));
+      return;
+    }
+    const onAbort = () => {
+      clearTimeout(timer);
+      reject(new JmapNetworkError("JMAP request was aborted", { aborted: true }));
+    };
+    const timer = setTimeout(() => {
+      signal?.removeEventListener("abort", onAbort);
+      resolve();
+    }, ms);
+    signal?.addEventListener("abort", onAbort, { once: true });
+  });
+}
+
+/**
+ * @param {AbortSignal} [signal]
+ * @throws {JmapNetworkError} If the signal has been aborted.
+ */
+function throwIfAborted(signal) {
+  if (signal?.aborted) {
+    throw new JmapNetworkError("JMAP request was aborted", { aborted: true });
+  }
+}
diff --git a/mailnews/protocols/jmap/modules/JmapTypeClient.sys.mjs b/mailnews/protocols/jmap/modules/JmapTypeClient.sys.mjs
new file mode 100644
index 00000000000..8eca2df451e
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapTypeClient.sys.mjs
@@ -0,0 +1,260 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Generic access to one JMAP data type (RFC 8620 section 5).
+ *
+ * Every JMAP type follows the same `/get`, `/changes`, `/set`, `/query`,
+ * `/queryChanges` and `/copy` shape, so the contacts, calendar, file, quota,
+ * Sieve and identity code share this class instead of each wrapping the
+ * standard methods again.
+ */
+
+import { JmapMethodError } from "resource:///modules/jmap/JmapErrors.sys.mjs";
+import { JmapMethodErrorType } from "resource:///modules/jmap/JmapConstants.sys.mjs";
+
+const DEFAULT_MAX_OBJECTS = 500;
+
+export class JmapTypeClient {
+  /**
+   * @param {JmapClient} client - Connected session.
+   * @param {string} type - JMAP data type, for example "FileNode".
+   * @param {string} capability - Capability whose account should be used.
+   * @param {string} [accountId] - Overrides the primary account.
+   */
+  constructor(client, type, capability, accountId) {
+    this.client = client;
+    this.type = type;
+    this.capability = capability;
+    this.accountId = accountId ?? client.getAccountId(capability);
+  }
+
+  get #maxObjectsInGet() {
+    const core = this.client.getCapability("urn:ietf:params:jmap:core");
+    return core?.maxObjectsInGet ?? DEFAULT_MAX_OBJECTS;
+  }
+
+  get #maxObjectsInSet() {
+    const core = this.client.getCapability("urn:ietf:params:jmap:core");
+    return core?.maxObjectsInSet ?? DEFAULT_MAX_OBJECTS;
+  }
+
+  /** The account-level capability object for this type's capability. */
+  get accountCapability() {
+    return (
+      this.client.accounts?.[this.accountId]?.accountCapabilities?.[
+        this.capability
+      ] ?? {}
+    );
+  }
+
+  async #call(verb, args, options) {
+    const response = await this.client.call(
+      `${this.type}/${verb}`,
+      { accountId: this.accountId, ...args },
+      options
+    );
+    return response.args;
+  }
+
+  /**
+   * `<Type>/get`. With `ids` given, requests are split to respect
+   * `maxObjectsInGet` and the results are merged.
+   *
+   * @param {?string[]} ids - Null fetches all objects.
+   * @param {object} [extra] - Extra arguments (properties, fetchParents...).
+   * @returns {Promise<{state: string, list: object[], notFound: string[]}>}
+   */
+  async get(ids = null, extra = {}, options = {}) {
+    if (!ids || ids.length <= this.#maxObjectsInGet) {
+      const result = await this.#call("get", { ids, ...extra }, options);
+      return {
+        state: result.state,
+        list: result.list ?? [],
+        notFound: result.notFound ?? [],
+      };
+    }
+    const merged = { state: null, list: [], notFound: [] };
+    for (let i = 0; i < ids.length; i += this.#maxObjectsInGet) {
+      const part = await this.get(
+        ids.slice(i, i + this.#maxObjectsInGet),
+        extra,
+        options
+      );
+      merged.state = part.state;
+      merged.list.push(...part.list);
+      merged.notFound.push(...part.notFound);
+    }
+    return merged;
+  }
+
+  /**
+   * Follow `<Type>/changes` until `hasMoreChanges` is false.
+   *
+   * @returns {Promise<?{oldState, newState, created, updated, destroyed}>}
+   *   Null when the server cannot calculate changes: the caller must resync.
+   */
+  async changesSince(sinceState, options = {}) {
+    const all = {
+      oldState: sinceState,
+      newState: sinceState,
+      created: [],
+      updated: [],
+      destroyed: [],
+    };
+    let state = sinceState;
+    for (;;) {
+      let result;
+      try {
+        result = await this.#call(
+          "changes",
+          { sinceState: state, maxChanges: this.#maxObjectsInGet },
+          options
+        );
+      } catch (error) {
+        if (
+          error instanceof JmapMethodError &&
+          error.type == JmapMethodErrorType.CannotCalculateChanges
+        ) {
+          return null;
+        }
+        throw error;
+      }
+      all.created.push(...(result.created ?? []));
+      all.updated.push(...(result.updated ?? []));
+      all.destroyed.push(...(result.destroyed ?? []));
+      all.newState = result.newState;
+      if (!result.hasMoreChanges || result.newState == state) {
+        break;
+      }
+      state = result.newState;
+    }
+    // An id may move between lists across pages; destroyed wins.
+    const destroyed = new Set(all.destroyed);
+    all.created = [...new Set(all.created)].filter(id => !destroyed.has(id));
+    all.updated = [...new Set(all.updated)].filter(
+      id => !destroyed.has(id) && !all.created.includes(id)
+    );
+    return all;
+  }
+
+  /**
+   * `<Type>/set`. Throws a `JmapMethodError` describing the first
+   * notCreated/notUpdated/notDestroyed entry, unless `allowPartial`.
+   *
+   * @param {object} args - {create, update, destroy, ifInState, ...extra}.
+   * @param {object} [opts]
+   * @param {boolean} [opts.allowPartial]
+   */
+  async set(args, { allowPartial = false, ...options } = {}) {
+    const result = await this.#call("set", args, options);
+    if (!allowPartial) {
+      for (const key of ["notCreated", "notUpdated", "notDestroyed"]) {
+        const failures = result[key];
+        if (failures && Object.keys(failures).length) {
+          const [id, setError] = Object.entries(failures)[0];
+          throw new JmapMethodError(
+            setError.description ??
+              `${this.type}/set ${key} ${id}: ${setError.type}`,
+            {
+              method: `${this.type}/set`,
+              type: setError.type,
+              detail: setError.description ?? null,
+              args: { id, ...setError },
+            }
+          );
+        }
+      }
+    }
+    return result;
+  }
+
+  /** Create one object and return the server's view of it (with `id`). */
+  async create(object, extra = {}, options = {}) {
+    const result = await this.set(
+      { create: { new: object }, ...extra },
+      options
+    );
+    return { ...object, ...result.created.new };
+  }
+
+  async update(id, patch, extra = {}, options = {}) {
+    return this.set({ update: { [id]: patch }, ...extra }, options);
+  }
+
+  async destroy(ids, extra = {}, options = {}) {
+    const list = [...ids];
+    const results = [];
+    for (let i = 0; i < list.length; i += this.#maxObjectsInSet) {
+      results.push(
+        await this.set(
+          { destroy: list.slice(i, i + this.#maxObjectsInSet), ...extra },
+          options
+        )
+      );
+    }
+    return results;
+  }
+
+  /** `<Type>/query`, following pages until all ids are collected. */
+  async queryAll(filter = null, sort = null, extra = {}, options = {}) {
+    const ids = [];
+    let position = 0;
+    let queryState = null;
+    for (;;) {
+      const result = await this.#call(
+        "query",
+        { filter, sort, position, limit: this.#maxObjectsInGet, ...extra },
+        options
+      );
+      queryState = result.queryState;
+      ids.push(...(result.ids ?? []));
+      if (
+        !result.ids?.length ||
+        (Number.isFinite(result.total) && ids.length >= result.total)
+      ) {
+        break;
+      }
+      position = ids.length;
+    }
+    return { ids, queryState };
+  }
+
+  /** `<Type>/query` + `<Type>/get` by back-reference, in one request. */
+  async queryAndGet(filter = null, sort = null, extra = {}, options = {}) {
+    const { responses } = await this.client.request(
+      [
+        {
+          name: `${this.type}/query`,
+          args: { accountId: this.accountId, filter, sort, ...extra },
+          callId: "q",
+        },
+        {
+          name: `${this.type}/get`,
+          args: {
+            accountId: this.accountId,
+            "#ids": { resultOf: "q", name: `${this.type}/query`, path: "/ids" },
+          },
+          callId: "g",
+        },
+      ],
+      options
+    );
+    return {
+      ids: responses[0].args.ids ?? [],
+      list: responses[1].args.list ?? [],
+      state: responses[1].args.state,
+    };
+  }
+
+  /** `<Type>/copy` from another account. */
+  async copy(fromAccountId, create, extra = {}, options = {}) {
+    return this.#call("copy", { fromAccountId, create, ...extra }, options);
+  }
+
+  /** Call any other method of this type, e.g. "parse" or "validate". */
+  async invoke(verb, args = {}, options = {}) {
+    return this.#call(verb, args, options);
+  }
+}
