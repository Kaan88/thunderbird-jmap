+add_task(async function test_create_chunking() {
+  const mail = makeMail({ maxObjectsInSet: 1 });
+  const result = await new JmapMutator({ mail }).create({
+    draft1: { mailboxIds: { drafts: true } },
+    draft2: { mailboxIds: { drafts: true } },
