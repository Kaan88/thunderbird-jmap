diff --git a/mail/components/jmapfiles/content/jmapFilesPicker.js b/mail/components/jmapfiles/content/jmapFilesPicker.js
new file mode 100644
index 00000000000..c840bc170cf
--- /dev/null
+++ b/mail/components/jmapfiles/content/jmapFilesPicker.js
@@ -0,0 +1,107 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* import-globals-from jmapFilesView.js */
+
+/**
+ * Folder/file picker dialog. Opened with window.openDialog and one argument:
+ *   { mode: "folder" | "files", serverKey?: string, result: null }
+ * On accept, `result` is set to
+ *   { serverKey, folderId } for "folder" mode, or
+ *   { serverKey, nodeIds: string[] } for "files" mode.
+ */
+
+var args = window.arguments?.[0] ?? { mode: "files" };
+var view;
+
+function $(id) {
+  return document.getElementById(id);
+}
+
+function updateAccept(selection) {
+  if (args.mode == "folder") {
+    $("acceptButton").disabled = !view.service;
+  } else {
+    $("acceptButton").disabled = !selection.some(n => !n.isDirectory);
+  }
+}
+
+function accept() {
+  if (!view.service) {
+    return;
+  }
+  if (args.mode == "folder") {
+    const [selected] = view.selectedNodes;
+    args.result = {
+      serverKey: view.service.serverKey,
+      folderId: selected?.isDirectory ? selected.id : view.parentId,
+    };
+  } else {
+    const ids = view.selectedNodes.filter(n => !n.isDirectory).map(n => n.id);
+    if (!ids.length) {
+      return;
+    }
+    args.result = { serverKey: view.service.serverKey, nodeIds: ids };
+  }
+  window.close();
+}
+
+async function newFolder() {
+  const [title, message] = await document.l10n.formatValues([
+    "jmap-files-new-folder-title",
+    "jmap-files-new-folder-prompt",
+  ]);
+  const result = { value: "" };
+  if (!Services.prompt.prompt(window, title, message, result, null, {})) {
+    return;
+  }
+  try {
+    const node = await view.service.mkdir(view.parentId, result.value.trim());
+    view.navigate(node.id);
+  } catch (e) {
+    $("status").textContent = e.message;
+  }
+}
+
+window.addEventListener("load", async () => {
+  const isFolder = args.mode == "folder";
+  document.l10n.setAttributes(
+    $("pickerTitle"),
+    isFolder ? "jmap-files-picker-title-folder" : "jmap-files-picker-title-files"
+  );
+  document.l10n.setAttributes(
+    $("acceptButton"),
+    isFolder ? "jmap-files-picker-accept-folder" : "jmap-files-picker-accept-files"
+  );
+  $("newFolderButton").hidden = !isFolder;
+
+  view = new JmapFilesView(
+    {
+      accountPicker: $("accountPicker"),
+      breadcrumb: $("breadcrumb"),
+      list: $("fileList"),
+      empty: $("emptyMessage"),
+      noAccount: $("noAccountMessage"),
+    },
+    {
+      filter: isFolder ? node => node.isDirectory : null,
+      onSelect: updateAccept,
+      onActivate: () => accept(),
+      onError: e => ($("status").textContent = e.message),
+    }
+  );
+  $("acceptButton").addEventListener("click", accept);
+  $("cancelButton").addEventListener("click", () => window.close());
+  $("newFolderButton").addEventListener("click", newFolder);
+  window.addEventListener("keydown", e => {
+    if (e.key == "Escape") {
+      window.close();
+    }
+  });
+  await view.init(args.serverKey);
+  updateAccept([]);
+  $("fileList").focus();
+});
+
+window.addEventListener("unload", () => view?.destroy());
