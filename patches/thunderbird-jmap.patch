+nsresult JmapFolder::SyncMessages(nsIUrlListener* aListener) {
+  if (WeAreOffline()) {
+    if (aListener) {
+      aListener->OnStopRunningUrl(nullptr, NS_MSG_ERROR_OFFLINE);
+    }
+    NotifyFolderEvent(kFolderLoaded);
+    return NS_OK;
+  }
+
+  // The server refreshes the quota once the sync is done.
+  return JmapSyncAccountForFolder(this, aListener);
+}
