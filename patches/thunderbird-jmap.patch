diff --git a/mail/components/jmapfiles/test/unit/head.js b/mail/components/jmapfiles/test/unit/head.js
new file mode 100644
index 00000000000..4f0466aff80
--- /dev/null
+++ b/mail/components/jmapfiles/test/unit/head.js
@@ -0,0 +1,258 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* exported FakeFileNodeClient */
+
+var { JmapMethodError } = ChromeUtils.importESModule(
+  "resource:///modules/jmap/JmapErrors.sys.mjs"
+);
+
+const FILENODE = "urn:ietf:params:jmap:filenode";
+
+/**
+ * In-memory stand-in for a JmapClient serving FileNode methods.
+ */
+class FakeFileNodeClient {
+  constructor({ accountCapability = {}, webUrlTemplate } = {}) {
+    this.nodes = new Map();
+    this.blobs = new Map();
+    this.nextId = 1;
+    this.state = 0;
+    this.log = [];
+    this.changes = []; // [{state, created, updated, destroyed}]
+    this.spuriousChanges = false;
+    this.quotaLeft = Infinity;
+    this.downloadUrl =
+      "https://jmap.example/download/{accountId}/{blobId}/{name}?type={type}";
+    this.accounts = {
+      a1: {
+        accountCapabilities: {
+          [FILENODE]: { ...accountCapability, webUrlTemplate },
+        },
+      },
+    };
+  }
+
+  getCapability(cap) {
+    return cap == "urn:ietf:params:jmap:core" ? { maxSizeUpload: 50e6 } : {};
+  }
+  supports() {
+    return true;
+  }
+  getAccountId() {
+    return "a1";
+  }
+
+  add(node) {
+    const id = node.id ?? `n${this.nextId++}`;
+    this.nodes.set(id, { parentId: null, ...node, id });
+    this.#bump({ created: [id] });
+    return id;
+  }
+
+  #bump(change) {
+    this.state++;
+    this.changes.push({
+      state: String(this.state),
+      created: [],
+      updated: [],
+      destroyed: [],
+      ...change,
+    });
+  }
+
+  #error(type, description) {
+    return { type, description };
+  }
+
+  async call(name, args) {
+    this.log.push({ name, args });
+    const [, verb] = name.split("/");
+    switch (verb) {
+      case "get": {
+        const ids = args.ids ?? [...this.nodes.keys()];
+        const list = ids.filter(id => this.nodes.has(id)).map(id => ({
+          ...this.nodes.get(id),
+        }));
+        const notFound = ids.filter(id => !this.nodes.has(id));
+        return { args: { state: String(this.state), list, notFound } };
+      }
+      case "changes": {
+        const since = Number(args.sinceState);
+        if (since > this.state) {
+          throw new JmapMethodError("cannot", {
+            type: "cannotCalculateChanges",
+          });
+        }
+        const out = { created: [], updated: [], destroyed: [] };
+        for (const c of this.changes.filter(c => Number(c.state) > since)) {
+          out.created.push(...c.created);
+          out.updated.push(...c.updated);
+          out.destroyed.push(...c.destroyed);
+        }
+        if (this.spuriousChanges) {
+          // Stalwart: reports existing nodes as changed right after a get.
+          out.updated.push(...this.nodes.keys());
+        }
+        return {
+          args: {
+            oldState: args.sinceState,
+            newState: String(this.state),
+            hasMoreChanges: false,
+            ...out,
+          },
+        };
+      }
+      case "set":
+        return { args: this.#set(args) };
+      case "query": {
+        const text = args.filter?.text?.toLowerCase() ?? "";
+        const ids = [...this.nodes.values()]
+          .filter(n => n.name.toLowerCase().includes(text))
+          .map(n => n.id);
+        return { args: { ids, total: ids.length, queryState: "q" } };
+      }
+    }
+    throw new JmapMethodError("unknownMethod", { type: "unknownMethod" });
+  }
+
+  async request(calls) {
+    const query = await this.call(calls[0].name, calls[0].args);
+    const get = await this.call(calls[1].name, {
+      ...calls[1].args,
+      ids: query.args.ids,
+    });
+    return { responses: [query, get] };
+  }
+
+  #sibling(parentId, name, exceptId, ci) {
+    for (const n of this.nodes.values()) {
+      if (
+        n.id != exceptId &&
+        n.parentId == parentId &&
+        (ci ? n.name.toLowerCase() == name.toLowerCase() : n.name == name)
+      ) {
+        return n;
+      }
+    }
+    return null;
+  }
+
+  #uniqueName(parentId, name, ci) {
+    let candidate = name;
+    for (let i = 1; this.#sibling(parentId, candidate, null, ci); i++) {
+      const dot = name.lastIndexOf(".");
+      candidate =
+        dot > 0
+          ? `${name.slice(0, dot)} (${i})${name.slice(dot)}`
+          : `${name} (${i})`;
+    }
+    return candidate;
+  }
+
+  #set(args) {
+    const result = {
+      newState: null,
+      created: {},
+      updated: {},
+      destroyed: [],
+      notCreated: {},
+      notUpdated: {},
+      notDestroyed: {},
+    };
+    const ci = args.compareCaseInsensitively;
+    const change = { created: [], updated: [], destroyed: [] };
+    for (const [key, obj] of Object.entries(args.create ?? {})) {
+      let name = obj.name;
+      if (this.#sibling(obj.parentId ?? null, name, null, ci)) {
+        if (args.onExists == "rename") {
+          name = this.#uniqueName(obj.parentId ?? null, name, ci);
+        } else {
+          result.notCreated[key] = this.#error("alreadyExists");
+          continue;
+        }
+      }
+      const size = obj.blobId ? this.blobs.get(obj.blobId)?.size ?? 0 : 0;
+      if (size > this.quotaLeft) {
+        result.notCreated[key] = this.#error("overQuota");
+        continue;
+      }
+      const id = `n${this.nextId++}`;
+      const node = {
+        "@type": obj["@type"],
+        parentId: obj.parentId ?? null,
+        name,
+        blobId: obj.blobId ?? null,
+        mediaType: obj.mediaType ?? null,
+        size,
+        id,
+      };
+      this.nodes.set(id, node);
+      change.created.push(id);
+      result.created[key] = { id, name, size };
+    }
+    for (const [id, patch] of Object.entries(args.update ?? {})) {
+      const node = this.nodes.get(id);
+      if (!node) {
+        result.notUpdated[id] = this.#error("notFound");
+        continue;
+      }
+      const next = { ...node, ...patch };
+      if (this.#sibling(next.parentId, next.name, id, ci)) {
+        if (args.onExists == "rename") {
+          next.name = this.#uniqueName(next.parentId, next.name, ci);
+        } else {
+          result.notUpdated[id] = this.#error("alreadyExists");
+          continue;
+        }
+      }
+      this.nodes.set(id, next);
+      change.updated.push(id);
+      result.updated[id] = null;
+    }
+    for (const id of args.destroy ?? []) {
+      if (!this.nodes.has(id)) {
+        result.notDestroyed[id] = this.#error("notFound");
+        continue;
+      }
+      const children = [...this.nodes.values()].filter(n => n.parentId == id);
+      if (children.length && !args.onDestroyRemoveChildren) {
+        result.notDestroyed[id] = this.#error("nodeHasChildren");
+        continue;
+      }
+      const remove = nodeId => {
+        for (const c of [...this.nodes.values()].filter(
+          n => n.parentId == nodeId
+        )) {
+          remove(c.id);
+        }
+        this.nodes.delete(nodeId);
+        change.destroyed.push(nodeId);
+      };
+      remove(id);
+      result.destroyed.push(id);
+    }
+    this.#bump(change);
+    result.newState = String(this.state);
+    return result;
+  }
+
+  async upload(data, type) {
+    const bytes =
+      data instanceof Blob
+        ? new Uint8Array(await data.arrayBuffer())
+        : new Uint8Array(data);
+    const blobId = `b${this.nextId++}`;
+    this.blobs.set(blobId, { bytes, type, size: bytes.length });
+    return { accountId: "a1", blobId, type, size: bytes.length };
+  }
+
+  async download(blobId, { type } = {}) {
+    const blob = this.blobs.get(blobId);
+    if (!blob) {
+      throw new JmapMethodError("notFound", { type: "notFound" });
+    }
+    return { blob: new Blob([blob.bytes], { type }), contentType: type };
+  }
+}
diff --git a/mail/components/jmapfiles/test/unit/test_jmapFiles.js b/mail/components/jmapfiles/test/unit/test_jmapFiles.js
new file mode 100644
index 00000000000..36b05e2c7e9
--- /dev/null
+++ b/mail/components/jmapfiles/test/unit/test_jmapFiles.js
@@ -0,0 +1,251 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* import-globals-from head.js */
+
+const { JmapFileService, JmapFilesError, nodeType, formatSize } =
+  ChromeUtils.importESModule(
+    "resource:///modules/jmapfiles/JmapFiles.sys.mjs"
+  );
+
+function bytes(text) {
+  return new TextEncoder().encode(text);
+}
+
+function makeService(options) {
+  const client = new FakeFileNodeClient(options);
+  const service = new JmapFileService(client, { serverKey: "server1" });
+  return { client, service };
+}
+
+add_task(function test_nodeType() {
+  Assert.equal(nodeType({ "@type": "File" }), "File");
+  Assert.equal(nodeType({ "@type": "directory" }), "Directory");
+  Assert.equal(nodeType({ "@type": "symlink" }), "SymLink");
+  Assert.equal(nodeType({ blobId: "b1" }), "File");
+  Assert.equal(nodeType({}), "Directory");
+  Assert.equal(formatSize(2048), "2.0 KiB");
+});
+
+add_task(async function test_tree_and_listing() {
+  const { client, service } = makeService();
+  const docs = client.add({ "@type": "directory", name: "Docs" });
+  client.add({ "@type": "file", name: "b.txt", parentId: docs, blobId: "x" });
+  client.add({ "@type": "File", name: "A.txt", parentId: docs, blobId: "y" });
+  client.add({ "@type": "Directory", name: "Sub", parentId: docs });
+
+  const top = await service.listChildren(null);
+  Assert.deepEqual(
+    top.map(n => n.name),
+    ["Docs"]
+  );
+  const children = await service.listChildren(docs);
+  Assert.deepEqual(
+    children.map(n => n.name),
+    ["Sub", "A.txt", "b.txt"],
+    "directories first, then case-insensitive names"
+  );
+  Assert.deepEqual(
+    service.pathTo(children[0].id).map(n => n.name),
+    ["Docs", "Sub"]
+  );
+});
+
+add_task(async function test_mkdir_upload_download() {
+  const { client, service } = makeService();
+  const dir = await service.mkdir(null, "Projects");
+  Assert.ok(dir.isDirectory);
+  const progress = [];
+  const file = await service.upload(dir.id, bytes("hello"), {
+    name: "hello.txt",
+    mediaType: "text/plain",
+    onProgress: (sent, total) => progress.push([sent, total]),
+  });
+  Assert.equal(file.name, "hello.txt");
+  Assert.equal(file.parentId, dir.id);
+  Assert.equal(file.size, 5);
+  Assert.deepEqual(progress, [
+    [0, 5],
+    [5, 5],
+  ]);
+  const set = client.log.filter(l => l.name == "FileNode/set").pop();
+  Assert.equal(set.args.create.file.blobId, file.blobId);
+  Assert.equal(set.args.onExists, "rename");
+
+  const blob = await service.download(file.id);
+  Assert.equal(await blob.text(), "hello");
+
+  // A second upload with the same name is renamed by the server.
+  const again = await service.upload(dir.id, bytes("again"), {
+    name: "HELLO.txt",
+  });
+  Assert.equal(again.name, "HELLO (1).txt");
+
+  const path = PathUtils.join(PathUtils.tempDir, "jmapfiles-test.txt");
+  await service.downloadToFile(file.id, path);
+  Assert.equal(await IOUtils.readUTF8(path), "hello");
+  await IOUtils.remove(path);
+});
+
+add_task(async function test_mkdir_exists_error() {
+  const { service } = makeService();
+  await service.mkdir(null, "Dup");
+  await Assert.rejects(
+    service.mkdir(null, "dup"),
+    e => e instanceof JmapFilesError && e.code == "alreadyExists"
+  );
+});
+
+add_task(async function test_ensureDirectory() {
+  const { client, service } = makeService();
+  const a = await service.ensureDirectory(["Thunderbird Attachments"]);
+  const b = await service.ensureDirectory(["Thunderbird Attachments"]);
+  Assert.equal(a.id, b.id);
+  Assert.equal(
+    [...client.nodes.values()].filter(n => n.name == "Thunderbird Attachments")
+      .length,
+    1
+  );
+});
+
+add_task(async function test_rename_move_copy_delete() {
+  const { client, service } = makeService();
+  const src = await service.mkdir(null, "src");
+  const dst = await service.mkdir(null, "dst");
+  const f = await service.upload(src.id, bytes("x"), { name: "f.bin" });
+
+  await service.rename(f.id, "g.bin");
+  Assert.equal(service.getNode(f.id).name, "g.bin");
+  Assert.equal(client.nodes.get(f.id).name, "g.bin");
+
+  await service.move([f.id], dst.id);
+  Assert.equal(service.getNode(f.id).parentId, dst.id);
+  Assert.equal((await service.listChildren(src.id)).length, 0);
+
+  await Assert.rejects(
+    service.move([dst.id], dst.id),
+    e => e instanceof JmapFilesError,
+    "cannot move a folder into itself"
+  );
+
+  const copy = await service.copy(dst.id, src.id);
+  Assert.ok(copy.isDirectory);
+  Assert.equal(service.childrenSync(copy.id)[0].name, "g.bin");
+
+  await service.remove([dst.id]);
+  Assert.equal(service.getNode(dst.id), null);
+  Assert.equal(service.getNode(f.id), null, "children are dropped too");
+  Assert.ok(!client.nodes.has(f.id), "server removed children");
+  const destroy = client.log.filter(l => l.name == "FileNode/set").pop();
+  Assert.equal(destroy.args.onDestroyRemoveChildren, true);
+});
+
+add_task(async function test_refresh_and_spurious_changes() {
+  const { client, service } = makeService();
+  await service.ensureLoaded();
+  const events = [];
+  service.addListener(topic => events.push(topic));
+
+  const id = client.add({ "@type": "File", name: "remote.txt", blobId: "z" });
+  await service.refresh();
+  Assert.equal(service.getNode(id).name, "remote.txt");
+
+  // Stalwart may report unchanged nodes as updated just after a get.
+  client.spuriousChanges = true;
+  await service.refresh();
+  await service.refresh();
+  Assert.equal(service.childrenSync(null).length, 1);
+  client.spuriousChanges = false;
+
+  client.nodes.delete(id);
+  client.changes.push({
+    state: String(++client.state),
+    created: [],
+    updated: [],
+    destroyed: [id],
+  });
+  await service.refresh();
+  Assert.equal(service.getNode(id), null);
+  Assert.ok(events.includes("changed"));
+});
+
+add_task(async function test_limits_and_names() {
+  const { client, service } = makeService({
+    accountCapability: {
+      forbiddenNameChars: ":*",
+      maxSizeFileNodeName: 10,
+      maxFileNodeDepth: 2,
+      mayCreateTopLevelFileNode: true,
+      maxSize: 4,
+    },
+  });
+  await Assert.rejects(
+    service.mkdir(null, "a:b"),
+    e => e.code == "invalidName"
+  );
+  await Assert.rejects(
+    service.mkdir(null, "a-very-long-name"),
+    e => e.code == "invalidName"
+  );
+  const one = await service.mkdir(null, "one");
+  const two = await service.mkdir(one.id, "two");
+  await Assert.rejects(service.mkdir(two.id, "three"), e => e.code == "depth");
+
+  Assert.equal(service.maxFileSize, 4);
+  await Assert.rejects(
+    service.upload(one.id, bytes("too big"), { name: "big" }),
+    e => e.code == "tooLarge"
+  );
+
+  client.accounts.a1.accountCapabilities[FILENODE].maxSize = 100;
+  client.quotaLeft = 1;
+  await Assert.rejects(
+    service.upload(one.id, bytes("abc"), { name: "q" }),
+    e => e.code == "overQuota"
+  );
+});
+
+add_task(async function test_top_level_forbidden() {
+  const { service } = makeService({
+    accountCapability: { mayCreateTopLevelFileNode: false },
+  });
+  await Assert.rejects(service.mkdir(null, "x"), e => e.code == "forbidden");
+});
+
+add_task(async function test_search() {
+  const { service } = makeService();
+  const d = await service.mkdir(null, "Reports");
+  await service.upload(d.id, bytes("1"), { name: "report-2025.pdf" });
+  await service.upload(d.id, bytes("2"), { name: "notes.txt" });
+  const results = await service.search("report");
+  Assert.deepEqual(results.map(n => n.name).sort(), [
+    "Reports",
+    "report-2025.pdf",
+  ]);
+  const scoped = await service.search("report", d.id);
+  Assert.deepEqual(
+    scoped.map(n => n.name),
+    ["report-2025.pdf"]
+  );
+});
+
+add_task(async function test_links() {
+  let { service } = makeService();
+  const f = await service.upload(null, bytes("x"), {
+    name: "a b.txt",
+    mediaType: "text/plain",
+  });
+  let link = service.linkFor(f.id);
+  Assert.ok(link.requiresLogin);
+  Assert.ok(link.url.startsWith("https://jmap.example/download/a1/"));
+  Assert.ok(link.url.includes("a%20b.txt"));
+
+  ({ service } = makeService({
+    webUrlTemplate: "https://files.example/s/{accountId}/{id}",
+  }));
+  const g = await service.upload(null, bytes("x"), { name: "g" });
+  link = service.linkFor(g.id);
+  Assert.ok(!link.requiresLogin);
+  Assert.equal(link.url, `https://files.example/s/a1/${g.id}`);
+});
