+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Live mail tests: mailbox sync, drafts, send/receive, flags, folder and
+ * message operations, search and quota.
+ */
+
+let alice, bob;
+const SUBJECT_SEND = `Live send ${RUN_ID}`;
+const SUBJECT_REPLY = `Re: Live send ${RUN_ID}`;
+
+add_setup(async function () {
+  if (!LIVE_CONFIG) {
+    return;
+  }
+  alice = await createLiveAccount("alice@test.localhost");
+  bob = await createLiveAccount("bob@test.localhost");
+  await ensureServerIdentity(alice);
+  await ensureServerIdentity(bob);
+  registerCleanupFunction(async () => {
+    for (const live of [alice, bob]) {
+      await destroyBySubject(live.server, SUBJECT_SEND);
+      await destroyBySubject(live.server, SUBJECT_REPLY);
+    }
+  });
+});
+
+add_live_task(async function test_mailboxSync() {
+  await syncAll(alice.server);
+  const expected = [
+    ["Inbox", Ci.nsMsgFolderFlags.Inbox],
+    ["Drafts", Ci.nsMsgFolderFlags.Drafts],
+    ["Sent Items", Ci.nsMsgFolderFlags.SentMail],
+    ["Deleted Items", Ci.nsMsgFolderFlags.Trash],
+    ["Junk Mail", Ci.nsMsgFolderFlags.Junk],
+  ];
+  for (const [name, flag] of expected) {
+    const folder = folderNamed(alice.server, name);
+    Assert.ok(folder, `folder ${name} exists locally`);
+    Assert.ok(folder.getFlag(flag), `folder ${name} has flag 0x${flag.toString(16)}`);
+    Assert.ok(
+      folder.QueryInterface(Ci.IJmapFolder).jmapId,
+      `folder ${name} has a JMAP id`
+    );
+  }
+});
+
+add_live_task(async function test_saveDraft() {
+  const subject = `Live draft ${RUN_ID}`;
+  registerCleanupFunction(() => destroyBySubject(alice.server, subject));
+  const drafts = folderWithFlag(alice.server, Ci.nsMsgFolderFlags.Drafts);
+  const file = await writeMessageFile({
+    from: alice.email,
+    to: bob.email,
+    subject,
+  });
+  const copyListener = new PromiseTestUtils.PromiseCopyListener();
+  MailServices.copy.copyFileMessage(
+    file,
+    drafts,
+    null,
+    true,
+    0,
+    "",
+    copyListener,
+    null
+  );
+  await copyListener.promise;
+
+  const hdr = await waitForHeader(
+    alice.server,
+    () => folderWithFlag(alice.server, Ci.nsMsgFolderFlags.Drafts),
+    subject
+  );
+  const id = hdr.getStringProperty("jmapId");
+  Assert.ok(id, "draft header has a JMAP id");
+  const email = await getEmail(alice.server, id);
+  Assert.ok(email?.keywords?.$draft, "draft has $draft keyword on server");
+  Assert.ok(
+    email.mailboxIds[drafts.QueryInterface(Ci.IJmapFolder).jmapId],
+    "draft is in the Drafts mailbox on server"
+  );
+});
+
+add_live_task(async function test_sendAliceToBob() {
+  const file = await writeMessageFile({
+    from: alice.email,
+    to: bob.email,
+    subject: SUBJECT_SEND,
+  });
+  const sent = folderWithFlag(alice.server, Ci.nsMsgFolderFlags.SentMail);
+  alice.identity.doFcc = true;
+  alice.identity.fccFolderURI = sent.URI;
+  await sendThroughOutgoing(alice, file, [bob.email]);
+
+  const sentHdr = await waitForHeader(
+    alice.server,
+    () => folderWithFlag(alice.server, Ci.nsMsgFolderFlags.SentMail),
+    SUBJECT_SEND
+  );
+  Assert.ok(sentHdr, "copy is in alice's Sent Items");
+
+  const bobHdr = await waitForHeader(
+    bob.server,
+    () => folderWithFlag(bob.server, Ci.nsMsgFolderFlags.Inbox),
+    SUBJECT_SEND
+  );
+  Assert.ok(bobHdr, "bob received the message");
+  Assert.ok(
+    bobHdr.author.includes(alice.email),
+    `author is alice (${bobHdr.author})`
+  );
+});
+
+add_live_task(async function test_sendWithoutCopy() {
+  const subject = `Live nocopy ${RUN_ID}`;
+  registerCleanupFunction(async () => {
+    await destroyBySubject(alice.server, subject);
+    await destroyBySubject(bob.server, subject);
+  });
+  const file = await writeMessageFile({
+    from: alice.email,
+    to: bob.email,
+    subject,
+  });
+  const { doFcc, fccFolderURI } = alice.identity;
+  alice.identity.doFcc = false;
+  try {
+    await sendThroughOutgoing(alice, file, [bob.email]);
+  } finally {
+    alice.identity.doFcc = doFcc;
+    alice.identity.fccFolderURI = fccFolderURI;
+  }
+  const bobHdr = await waitForHeader(
+    bob.server,
+    () => folderWithFlag(bob.server, Ci.nsMsgFolderFlags.Inbox),
+    subject
+  );
+  Assert.ok(bobHdr, "bob received the message sent without a copy");
+  Assert.deepEqual(
+    await queryBySubject(alice.server, subject),
+    [],
+    "no sent copy is left on alice's server"
+  );
+});
+
+add_live_task(async function test_replyAndFlags() {
+  const bobInbox = folderWithFlag(bob.server, Ci.nsMsgFolderFlags.Inbox);
+  const original = findHeader(bobInbox, SUBJECT_SEND);
+  Assert.ok(original, "bob has the original message");
+  const file = await writeMessageFile({
+    from: bob.email,
+    to: alice.email,
+    subject: SUBJECT_REPLY,
+    inReplyTo: `<${original.messageId}>`,
+  });
+  await sendThroughOutgoing(bob, file, [alice.email]);
+
+  let hdr = await waitForHeader(
+    alice.server,
+    () => folderWithFlag(alice.server, Ci.nsMsgFolderFlags.Inbox),
+    SUBJECT_REPLY
+  );
+  const inbox = folderWithFlag(alice.server, Ci.nsMsgFolderFlags.Inbox);
+  const id = hdr.getStringProperty("jmapId");
+  Assert.ok(id, "reply header has a JMAP id");
+
+  inbox.markMessagesRead([hdr], true);
+  inbox.markMessagesFlagged([hdr], true);
+  inbox.addKeywordsToMessages([hdr], "$label1");
+
+  const email = await pollUntil(async () => {
+    const e = await getEmail(alice.server, id);
+    return e?.keywords?.$seen && e.keywords.$flagged && e.keywords.$label1
+      ? e
+      : null;
+  }, "keywords $seen/$flagged/$label1 on server");
+  Assert.ok(email.keywords.$seen, "$seen set on server");
+  Assert.ok(email.keywords.$flagged, "$flagged set on server");
+  Assert.ok(email.keywords.$label1, "$label1 set on server");
+
+  inbox.markMessagesRead([hdr], false);
+  inbox.markMessagesFlagged([hdr], false);
+  inbox.removeKeywordsFromMessages([hdr], "$label1");
+  await pollUntil(async () => {
+    const e = await getEmail(alice.server, id);
+    return e && !e.keywords?.$seen && !e.keywords?.$flagged && !e.keywords?.$label1;
+  }, "keywords cleared on server");
+});
+
+add_live_task(async function test_folderAndMessageOperations() {
+  const name = `LiveFolder ${RUN_ID}`;
+  const renamed = `LiveRenamed ${RUN_ID}`;
+  const server = alice.server;
+  const createdIds = [];
+  registerCleanupFunction(async () => {
+    for (const mboxId of createdIds) {
+      await jmapCall(server, "Mailbox/set", {
+        destroy: [mboxId],
+        onDestroyRemoveEmails: true,
+      }).catch(() => {});
+    }
+  });
+
+  // Create.
+  const createListener = urlListener();
+  server.rootFolder.createSubfolderWithListener(name, createListener);
+  await createListener.promise;
+  let folder = folderNamed(server, name);
+  Assert.ok(folder, "new folder exists locally");
+  const mailboxId = folder.QueryInterface(Ci.IJmapFolder).jmapId;
+  Assert.ok(mailboxId, "new folder has a mailbox id");
+  createdIds.push(mailboxId);
+  let { list } = await jmapCall(server, "Mailbox/get", { ids: [mailboxId] });
+  Assert.equal(list[0]?.name, name, "mailbox exists on server");
+
+  // Rename.
+  folder.rename(renamed, null);
+  folder = await TestUtils.waitForCondition(
+    () => folderNamed(server, renamed),
+    "renamed folder appears locally"
+  );
+  ({ list } = await jmapCall(server, "Mailbox/get", { ids: [mailboxId] }));
+  Assert.equal(list[0]?.name, renamed, "mailbox renamed on server");
+
+  // Copy and move the reply from Inbox into the new folder.
+  const inbox = folderWithFlag(server, Ci.nsMsgFolderFlags.Inbox);
+  const hdr = findHeader(inbox, SUBJECT_REPLY);
+  Assert.ok(hdr, "reply is in Inbox");
+  const emailId = hdr.getStringProperty("jmapId");
+
+  let copyListener = new PromiseTestUtils.PromiseCopyListener();
+  MailServices.copy.copyMessages(inbox, [hdr], folder, false, copyListener, null, false);
+  await copyListener.promise;
+  await pollUntil(async () => {
+    const ids = await queryBySubject(server, SUBJECT_REPLY);
+    for (const id of ids) {
+      const e = await getEmail(server, id);
+      if (e?.mailboxIds?.[mailboxId]) {
+        return true;
+      }
+    }
+    return false;
+  }, "copy appears in new mailbox");
+
+  const sent = folderWithFlag(server, Ci.nsMsgFolderFlags.SentMail);
+  const sentHdr = findHeader(sent, SUBJECT_SEND);
+  Assert.ok(sentHdr, "sent copy exists for move");
+  const sentId = sentHdr.getStringProperty("jmapId");
+  copyListener = new PromiseTestUtils.PromiseCopyListener();
+  MailServices.copy.copyMessages(sent, [sentHdr], folder, true, copyListener, null, false);
+  await copyListener.promise;
+  await pollUntil(async () => {
+    const e = await getEmail(server, sentId);
+    return e?.mailboxIds?.[mailboxId] && !e.mailboxIds[sent.QueryInterface(Ci.IJmapFolder).jmapId];
+  }, "moved message is only in new mailbox");
+
+  // Delete to trash.
+  await syncAll(server);
+  const trash = folderWithFlag(server, Ci.nsMsgFolderFlags.Trash);
+  const trashId = trash.QueryInterface(Ci.IJmapFolder).jmapId;
+  const movedHdr = await pollUntil(async () => {
+    await syncAll(server);
+    return findHeader(folderNamed(server, renamed), SUBJECT_SEND);
+  }, "moved header appears locally");
+  copyListener = new PromiseTestUtils.PromiseCopyListener();
+  folderNamed(server, renamed).deleteMessages(
+    [movedHdr],
+    null,
+    false,
+    false,
+    copyListener,
+    false
+  );
+  await copyListener.promise;
+  await pollUntil(async () => {
+    const e = await getEmail(server, sentId);
+    return e?.mailboxIds?.[trashId];
+  }, "deleted message is in trash on server");
+
+  // Empty trash.
+  await syncAll(server);
+  const emptyListener = urlListener();
+  folderWithFlag(server, Ci.nsMsgFolderFlags.Trash).emptyTrash(emptyListener);
+  await emptyListener.promise;
+  await pollUntil(async () => !(await getEmail(server, sentId)), "trash emptied");
+  const { ids: trashIds } = await jmapCall(server, "Email/query", {
+    filter: { inMailbox: trashId },
+  });
+  Assert.equal(trashIds.length, 0, "trash is empty on server");
+
+  // Delete the folder (its contents go with it).
+  folder = folderNamed(server, renamed);
+  folder.deleteSelf(null);
+  await pollUntil(async () => {
+    const r = await jmapCall(server, "Mailbox/get", { ids: [mailboxId] });
+    // Either destroyed, or moved below Trash.
+    return !r.list.length || r.list[0].parentId == trashId;
+  }, "folder deleted on server");
+});
+
+add_live_task(async function test_serverSearch() {
+  const listener = operationListener();
+  protocolClient(alice.server).queryEmails(
+    JSON.stringify({ subject: SUBJECT_REPLY }),
+    10,
+    listener
+  );
+  const ids = JSON.parse(await listener.promise);
+  Assert.ok(Array.isArray(ids), "queryEmails returns an array");
+  Assert.greater(ids.length, 0, "search finds the reply by subject");
+  const email = await getEmail(alice.server, ids[0]);
+  Assert.equal(email.subject, SUBJECT_REPLY, "found email has the subject");
+});
+
+add_live_task(async function test_quota() {
+  const listener = operationListener();
+  protocolClient(alice.server).getQuota(listener);
+  const quotas = JSON.parse(await listener.promise);
+  Assert.ok(Array.isArray(quotas), "getQuota returns a JSON array");
+  for (const q of quotas) {
+    Assert.equal(typeof q.used, "number", `quota ${q.name} has numeric used`);
+  }
+});
diff --git a/mailnews/protocols/jmap/test/live/test_live_settings_push.js b/mailnews/protocols/jmap/test/live/test_live_settings_push.js
