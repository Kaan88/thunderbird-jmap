+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Shared constants for the JMAP implementation.
+ *
+ * @see RFC 8620: The JSON Meta Application Protocol (JMAP)
+ * @see RFC 8621: The JSON Meta Application Protocol (JMAP) for Mail
+ */
+
+/**
+ * Capability URIs used by this implementation.
+ */
+export const JmapCapability = Object.freeze({
+  Core: "urn:ietf:params:jmap:core",
+  Mail: "urn:ietf:params:jmap:mail",
+  Submission: "urn:ietf:params:jmap:submission",
+  VacationResponse: "urn:ietf:params:jmap:vacationresponse",
+  MailShare: "urn:ietf:params:jmap:mail:share",
+  Mdn: "urn:ietf:params:jmap:mdn",
+  Quota: "urn:ietf:params:jmap:quota",
+  Sieve: "urn:ietf:params:jmap:sieve",
+  Blob: "urn:ietf:params:jmap:blob",
+  Contacts: "urn:ietf:params:jmap:contacts",
+  ContactsParse: "urn:ietf:params:jmap:contacts:parse",
+  Calendars: "urn:ietf:params:jmap:calendars",
+  CalendarsParse: "urn:ietf:params:jmap:calendars:parse",
+  Principals: "urn:ietf:params:jmap:principals",
+  PrincipalsAvailability: "urn:ietf:params:jmap:principals:availability",
+  FileNode: "urn:ietf:params:jmap:filenode",
+  WebSocket: "urn:ietf:params:jmap:websocket",
+});
+
+/**
+ * The JMAP data types that Thunderbird knows about, mapped to the capability
+ * that must be advertised by a server before the type may be used.
+ *
+ * Unknown types are treated as extension methods: they are sent without
+ * adding an implicit capability, so an account that negotiated an extension
+ * out of band can still use it.
+ */
+const DATA_TYPE_CAPABILITIES = Object.freeze({
+  Mailbox: JmapCapability.Mail,
+  Thread: JmapCapability.Mail,
+  Email: JmapCapability.Mail,
+  SearchSnippet: JmapCapability.Mail,
+  Identity: JmapCapability.Submission,
+  EmailSubmission: JmapCapability.Submission,
+  VacationResponse: JmapCapability.VacationResponse,
+  MDN: JmapCapability.Mdn,
+  Quota: JmapCapability.Quota,
+  SieveScript: JmapCapability.Sieve,
+  Blob: JmapCapability.Blob,
+  AddressBook: JmapCapability.Contacts,
+  ContactCard: JmapCapability.Contacts,
+  Calendar: JmapCapability.Calendars,
+  CalendarEvent: JmapCapability.Calendars,
+  CalendarEventNotification: JmapCapability.Calendars,
+  ParticipantIdentity: JmapCapability.Calendars,
+  Principal: JmapCapability.Principals,
+  ShareNotification: JmapCapability.Principals,
+  FileNode: JmapCapability.FileNode,
+});
+
+/**
+ * Capability needed by `<Type>/parse` methods, which differ from the type's
+ * own capability.
+ */
+const PARSE_CAPABILITIES = Object.freeze({
+  ContactCard: JmapCapability.ContactsParse,
+  CalendarEvent: JmapCapability.CalendarsParse,
+});
+
+/**
+ * Find the capability required by a JMAP method name.
+ *
+ * @param {string} method - A JMAP method name, for example `Email/get`.
+ * @returns {?string} The capability URI, or null if the method is not one of
+ *   the mail methods known to Thunderbird.
+ */
+export function capabilityForMethod(method) {
+  if (typeof method != "string") {
+    return null;
+  }
+  const [dataType, verb] = method.split("/", 2);
+  if (verb == "parse" && PARSE_CAPABILITIES[dataType]) {
+    return PARSE_CAPABILITIES[dataType];
+  }
+  return DATA_TYPE_CAPABILITIES[dataType] ?? null;
+}
+
+/**
+ * Request-level error types, defined by RFC 8620 section 3.6.1. A request
+ * error is returned as an HTTP problem document instead of a method response.
+ */
+export const JmapRequestErrorType = Object.freeze({
+  NotJSON: "urn:ietf:params:jmap:error:notJSON",
+  NotRequest: "urn:ietf:params:jmap:error:notRequest",
+  Limit: "urn:ietf:params:jmap:error:limit",
+  UnknownCapability: "urn:ietf:params:jmap:error:unknownCapability",
+  CannotCalculateChanges:
+    "urn:ietf:params:jmap:error:cannotCalculateChanges",
+});
+
+/**
+ * Method-level error types, defined by RFC 8620 section 3.6.2. These are
+ * returned as an `error` method response for the call that failed.
+ */
+export const JmapMethodErrorType = Object.freeze({
+  ServerUnavailable: "serverUnavailable",
+  ServerFail: "serverFail",
+  ServerPartialFail: "serverPartialFail",
+  UnknownMethod: "unknownMethod",
+  InvalidArguments: "invalidArguments",
+  InvalidResultReference: "invalidResultReference",
+  Forbidden: "forbidden",
+  AccountNotFound: "accountNotFound",
+  AccountNotSupportedByMethod: "accountNotSupportedByMethod",
+  AccountReadOnly: "accountReadOnly",
+  RequestTooLarge: "requestTooLarge",
+  CannotCalculateChanges: "cannotCalculateChanges",
+  StateMismatch: "stateMismatch",
+  RateLimit: "rateLimit",
+});
diff --git a/mailnews/protocols/jmap/modules/JmapErrors.sys.mjs b/mailnews/protocols/jmap/modules/JmapErrors.sys.mjs
new file mode 100644
index 00000000000..217419298a2
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapErrors.sys.mjs
@@ -0,0 +1,214 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Error types used by the JMAP client.
+ *
+ * The class hierarchy makes it possible for callers to distinguish between
+ * failures that are safe to retry, failures that need new credentials, and
+ * failures caused by the server rejecting a particular method call.
+ */
+
+/**
+ * Base class for all errors raised by the JMAP client.
+ */
+export class JmapError extends Error {
+  constructor(message, { cause } = {}) {
+    super(message, cause === undefined ? undefined : { cause });
+    this.name = new.target.name;
+  }
+}
+
+/**
+ * A transport-level failure: DNS, connection reset, TLS problem, timeout or
+ * an aborted request.
+ */
+export class JmapNetworkError extends JmapError {
+  /**
+   * @param {string} message
+   * @param {object} [options]
+   * @param {boolean} [options.timeout] - Whether the failure was caused by the
+   *   configured request timeout.
+   * @param {boolean} [options.aborted] - Whether the caller aborted the
+   *   request.
+   * @param {Error} [options.cause]
+   */
+  constructor(message, { timeout = false, aborted = false, cause } = {}) {
+    super(message, { cause });
+    this.timeout = timeout;
+    this.aborted = aborted;
+  }
+}
+
+/**
+ * An HTTP response with a non-success status code.
+ */
+export class JmapHttpError extends JmapError {
+  /**
+   * @param {string} message
+   * @param {object} [options]
+   * @param {number} [options.status] - HTTP status code.
+   * @param {?string} [options.type] - Problem document type, if the server
+   *   returned one.
+   * @param {?string} [options.detail] - Problem document detail, if any.
+   * @param {?number} [options.retryAfter] - Delay in milliseconds requested by
+   *   the server through the `Retry-After` header.
+   * @param {*} [options.body] - Parsed response body.
+   * @param {?string} [options.url] - Request URL.
+   * @param {Error} [options.cause]
+   */
+  constructor(
+    message,
+    {
+      status,
+      type = null,
+      detail = null,
+      retryAfter = null,
+      body,
+      url,
+      cause,
+    } = {}
+  ) {
+    super(message, { cause });
+    this.status = status;
+    this.type = type;
+    this.detail = detail;
+    this.retryAfter = retryAfter;
+    this.body = body;
+    this.url = url;
+  }
+
+  /**
+   * Whether retrying the request may succeed.
+   *
+   * @returns {boolean}
+   */
+  get isRetryable() {
+    return (
+      this.status === 429 ||
+      this.status === 502 ||
+      this.status === 503 ||
+      this.status === 504
+    );
+  }
+}
+
+/**
+ * The server rejected the credentials, or the authenticated user is not
+ * allowed to perform the request.
+ *
+ * Callers should refresh OAuth2 tokens (when possible) or prompt for a new
+ * password before retrying.
+ */
+export class JmapAuthError extends JmapHttpError {}
+
+/**
+ * The server asked the client to slow down (HTTP 429).
+ */
+export class JmapRateLimitError extends JmapHttpError {}
+
+/**
+ * The session document is missing, malformed, or lacks a capability that the
+ * client requires.
+ */
+export class JmapSessionError extends JmapError {}
+
+/**
+ * A method was used without the capability required to call it, or the
+ * session does not advertise that capability.
+ */
+export class JmapCapabilityError extends JmapError {
+  /**
+   * @param {string} message
+   * @param {object} [options]
+   * @param {?string} [options.capability] - The capability URI that was
+   *   missing or unsupported.
+   */
+  constructor(message, { capability = null } = {}) {
+    super(message);
+    this.capability = capability;
+  }
+}
+
+/**
+ * The request as a whole was rejected (RFC 8620 section 3.6.1). The body of
+ * the HTTP response is a problem document with a `type` URI.
+ */
+export class JmapRequestError extends JmapError {
+  /**
+   * @param {string} message
+   * @param {object} [options]
+   * @param {?string} [options.type] - Problem document type URI.
+   * @param {?number} [options.status] - HTTP status code.
+   * @param {?string} [options.detail] - Human readable detail.
+   * @param {?number} [options.limit] - Limit that was exceeded, for
+   *   `urn:ietf:params:jmap:error:limit`.
+   */
+  constructor(
+    message,
+    { type = null, status = null, detail = null, limit = null } = {}
+  ) {
+    super(message);
+    this.type = type;
+    this.status = status;
+    this.detail = detail;
+    this.limit = limit;
+  }
+}
+
+/**
+ * A single method call failed while the rest of the request succeeded
+ * (RFC 8620 section 3.6.2).
+ */
+export class JmapMethodError extends JmapError {
+  /**
+   * @param {string} message
+   * @param {object} [options]
+   * @param {?string} [options.method] - Method that failed, for example
+   *   `Email/set`.
+   * @param {?string} [options.callId] - Call id of the failed invocation.
+   * @param {?string} [options.type] - Method error type, for example
+   *   `notFound`.
+   * @param {?string} [options.detail] - Human readable detail.
+   * @param {*} [options.args] - Raw error arguments from the server.
+   */
+  constructor(
+    message,
+    {
+      method = null,
+      callId = null,
+      type = null,
+      detail = null,
+      args = null,
+    } = {}
+  ) {
+    super(message);
+    this.method = method;
+    this.callId = callId;
+    this.type = type;
+    this.detail = detail;
+    this.args = args;
+  }
+
+  /**
+   * Check the method error type.
+   *
+   * @param {string} type - One of the values in `JmapMethodErrorType`.
+   * @returns {boolean}
+   */
+  is(type) {
+    return this.type === type;
+  }
+}
+
+/**
+ * Check whether an error is a method error of the given type.
+ *
+ * @param {*} error
+ * @param {string} type
+ * @returns {boolean}
+ */
+export function isJmapMethodError(error, type) {
+  return error instanceof JmapMethodError && error.is(type);
+}
diff --git a/mailnews/protocols/jmap/modules/JmapFolderStore.sys.mjs b/mailnews/protocols/jmap/modules/JmapFolderStore.sys.mjs
new file mode 100644
index 00000000000..aec80dd0ca9
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapFolderStore.sys.mjs
@@ -0,0 +1,400 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { MailServices } from "resource:///modules/MailServices.sys.mjs";
+import {
+  folderFlagsForRole,
+  sortMailboxesByDepth,
+} from "resource:///modules/jmap/JmapMailboxSync.sys.mjs";
+import {
+  JMAP_ID_PROPERTY,
+  JMAP_KEYWORDS_PROPERTY,
+  JMAP_MAILBOX_IDS_PROPERTY,
+  JMAP_THREAD_ID_PROPERTY,
+  TB_KEYWORDS_PROPERTY,
+  mailboxIdsToString,
+} from "resource:///modules/jmap/JmapMessage.sys.mjs";
+
+/**
+ * Folder property holding the account-wide `Email/changes` state token.
+ */
+const EMAIL_STATE_PROPERTY = "jmapEmailState";
+
+/**
+ * Folder property holding the JMAP mailbox id of a folder.
+ */
+const MAILBOX_ID_PROPERTY = "jmapId";
+
+/**
+ * `JmapSyncStore` implementation backed by Thunderbird folders and message
+ * databases.
+ *
+ * The store keeps an index of JMAP email id -> local headers, rebuilt at the
+ * start of every sync. This makes the engine's lookups cheap at the cost of
+ * enumerating the account's headers once per sync; large accounts can be
+ * optimized later with an incremental index.
+ */
+export class JmapFolderStore {
+  #server;
+  #rootFolder;
+  #logger;
+  #folders = new Map();
+  #headers = new Map();
+  #touched = new Set();
+  #newKeys = new Map();
+
+  /**
+   * @param {object} options
+   * @param {IJmapIncomingServer} options.server - The JMAP incoming server.
+   * @param {nsIMsgFolder} options.rootFolder - The server's root folder.
+   * @param {?object} [options.logger]
+   */
+  constructor({ server, rootFolder, logger = null }) {
+    this.#server = server;
+    this.#rootFolder = rootFolder;
+    this.#logger = logger;
+  }
+
+  /**
+   * Create local folders for every mailbox and rebuild the indexes.
+   *
+   * @param {object[]} mailboxes
+   */
+  async prepare(mailboxes) {
+    for (const mailbox of sortMailboxesByDepth(mailboxes)) {
+      try {
+        this.#server.createFolderForMailbox(
+          mailbox.id,
+          mailbox.parentId ?? "",
+          mailbox.name ?? "",
+          folderFlagsForRole(mailbox.role)
+        );
+      } catch (error) {
+        this.#logger?.warn?.(
+          `JMAP sync: could not create folder for mailbox ${mailbox.id}: ` +
+            error
+        );
+      }
+    }
+
+    this.#rebuildIndex();
+  }
+
+  /**
+   * @param {string} mailboxId
+   * @returns {nsIMsgFolder[]}
+   */
+  foldersForMailbox(mailboxId) {
+    return this.#folders.get(mailboxId) ?? [];
+  }
+
+  /**
+   * @param {string} emailId
+   * @returns {{folder: nsIMsgFolder, header: nsIMsgDBHdr}[]}
+   */
+  headersForEmail(emailId) {
+    return this.#headers.get(emailId) ?? [];
+  }
+
+  /**
+   * @param {nsIMsgFolder} folder
+   * @returns {{jmapId: string, header: nsIMsgDBHdr}[]}
+   */
+  listHeaders(folder) {
+    const result = [];
+    for (const [emailId, entries] of this.#headers) {
+      for (const entry of entries) {
+        if (entry.folder == folder) {
+          result.push({ jmapId: emailId, header: entry.header });
+        }
+      }
+    }
+    return result;
+  }
+
+  /**
+   * @param {nsIMsgFolder} folder
+   * @param {object} message - A normalized message.
+   * @param {{isNew: boolean}} options
+   */
+  create(folder, message, { isNew } = {}) {
+    const db = this.#databaseFor(folder);
+    if (!db) {
+      return;
+    }
+
+    const header = db.createNewHdr();
+    this.#applyFields(header, message, isNew);
+    const live = db.attachHdr(header, true);
+
+    this.#touched.add(folder);
+    this.#indexHeader(folder, live, message.id);
+    if (isNew && folder.getFlag(Ci.nsMsgFolderFlags.Inbox)) {
+      if (!this.#newKeys.has(folder)) {
+        this.#newKeys.set(folder, []);
+      }
+      this.#newKeys.get(folder).push(live.messageKey);
+    }
+    MailServices.mfn.notifyMsgAdded(live);
+  }
+
+  /**
+   * @param {nsIMsgFolder} folder
+   * @param {nsIMsgDBHdr} header
+   * @param {object} message - A normalized message.
+   */
+  update(folder, header, message) {
+    const db = this.#databaseFor(folder);
+    if (!db) {
+      return;
+    }
+
+    this.#applyFields(header, message, false);
+    this.#applyFlags(db, header, message);
+
+    this.#touched.add(folder);
+    MailServices.mfn.notifyMsgPropertyChanged(
+      header,
+      "subject",
+      "",
+      message.subject
+    );
+  }
+
+  /**
+   * @param {nsIMsgFolder} folder
+   * @param {nsIMsgDBHdr} header
+   */
+  remove(folder, header) {
+    const db = this.#databaseFor(folder);
+    if (!db) {
+      return;
+    }
+
+    let key = 0;
+    try {
+      key = header.messageKey;
+      db.deleteMessages([key], null);
+    } catch (error) {
+      this.#logger?.warn?.(`JMAP sync: could not delete message: ${error}`);
+      return;
+    }
+
+    this.#touched.add(folder);
+    this.#unindexHeader(folder, header);
+    MailServices.mfn.notifyMsgsDeleted([header]);
+  }
+
+  /**
+   * @returns {Promise<?string>}
+   */
+  async getState() {
+    return this.#rootFolder.getStringProperty(EMAIL_STATE_PROPERTY) || null;
+  }
+
+  /**
+   * @param {string} state
+   */
+  async setState(state) {
+    this.#rootFolder.setStringProperty(EMAIL_STATE_PROPERTY, state ?? "");
+  }
+
+  /**
+   * Commit touched databases and refresh folder counts.
+   */
+  async flush() {
+    for (const folder of this.#touched) {
+      try {
+        const db = this.#databaseFor(folder);
+        db?.commit(Ci.nsMsgDBCommitType.kLargeCommit);
+        folder.updateSummaryTotals(true);
+      } catch (error) {
+        this.#logger?.warn?.(`JMAP sync: could not commit folder: ${error}`);
+      }
+    }
+    this.#touched.clear();
+
+    // Hand new Inbox messages to the folder, which runs incoming filters
+    // and junk classification on them.
+    const newKeys = this.#newKeys;
+    this.#newKeys = new Map();
+    for (const [folder, keys] of newKeys) {
+      try {
+        folder.QueryInterface(Ci.IJmapFolder).onNewMessages(keys);
+      } catch (error) {
+        this.#logger?.warn?.(
+          `JMAP sync: could not filter new messages: ${error}`
+        );
+      }
+    }
+  }
+
+  /**
+   * Message keys created as new in each folder since the last flush. For
+   * tests.
+   *
+   * @returns {Map<nsIMsgFolder, number[]>}
+   */
+  get pendingNewKeys() {
+    return this.#newKeys;
+  }
+
+  /**
+   * Walk the folder tree and index mailboxes and JMAP-backed headers.
+   */
+  #rebuildIndex() {
+    this.#folders.clear();
+    this.#headers.clear();
+
+    const folders = [this.#rootFolder];
+    try {
+      folders.push(...(this.#rootFolder.descendants ?? []));
+    } catch (error) {
+      this.#logger?.warn?.(`JMAP sync: could not list folders: ${error}`);
+    }
+
+    for (const folder of folders) {
+      let mailboxId = "";
+      try {
+        mailboxId = folder.getStringProperty(MAILBOX_ID_PROPERTY);
+      } catch (error) {
+        continue;
+      }
+      if (!mailboxId) {
+        continue;
+      }
+
+      if (!this.#folders.has(mailboxId)) {
+        this.#folders.set(mailboxId, []);
+      }
+      this.#folders.get(mailboxId).push(folder);
+
+      const db = this.#databaseFor(folder);
+      if (!db) {
+        continue;
+      }
+
+      try {
+        for (const header of db.enumerateMessages()) {
+          const emailId = header.getStringProperty(JMAP_ID_PROPERTY);
+          if (emailId) {
+            this.#indexHeader(folder, header, emailId);
+          }
+        }
+      } catch (error) {
+        this.#logger?.warn?.(
+          `JMAP sync: could not read folder ${folder.URI}: ${error}`
+        );
+      }
+    }
+  }
+
+  /**
+   * @param {nsIMsgFolder} folder
+   * @returns {?nsIMsgDatabase}
+   */
+  #databaseFor(folder) {
+    try {
+      return folder.msgDatabase ?? null;
+    } catch (error) {
+      this.#logger?.warn?.(
+        `JMAP sync: could not open database for ${folder.URI}: ${error}`
+      );
+      return null;
+    }
+  }
+
+  /**
+   * @param {nsIMsgFolder} folder
+   * @param {nsIMsgDBHdr} header
+   * @param {string} emailId
+   */
+  #indexHeader(folder, header, emailId) {
+    if (!this.#headers.has(emailId)) {
+      this.#headers.set(emailId, []);
+    }
+    this.#headers.get(emailId).push({ folder, header });
+  }
+
+  /**
+   * @param {nsIMsgFolder} folder
+   * @param {nsIMsgDBHdr} header
+   */
+  #unindexHeader(folder, header) {
+    for (const [emailId, entries] of this.#headers) {
+      const remaining = entries.filter(
+        entry => entry.folder != folder || entry.header != header
+      );
+      if (remaining.length) {
+        this.#headers.set(emailId, remaining);
+      } else {
+        this.#headers.delete(emailId);
+      }
+    }
+  }
+
+  /**
+   * Copy the normalized message into header fields.
+   *
+   * @param {nsIMsgDBHdr} header
+   * @param {object} message
+   * @param {boolean} isNew
+   */
+  #applyFields(header, message, isNew) {
+    header.date = message.date;
+    header.messageSize = message.size;
+    header.messageId = message.messageId;
+    header.author = message.author;
+    header.subject = message.subject;
+    header.recipients = message.recipients;
+    header.ccList = message.ccList;
+    header.bccList = message.bccList;
+    header.setReferences(message.references);
+
+    header.setStringProperty(JMAP_ID_PROPERTY, message.id);
+    header.setStringProperty(
+      JMAP_MAILBOX_IDS_PROPERTY,
+      mailboxIdsToString(message.mailboxIds)
+    );
+    header.setStringProperty(
+      JMAP_KEYWORDS_PROPERTY,
+      message.keywords.join(" ")
+    );
+    header.setStringProperty(JMAP_THREAD_ID_PROPERTY, message.threadId);
+    header.setStringProperty(TB_KEYWORDS_PROPERTY, message.tags ?? "");
+
+    if (message.preview) {
+      header.setStringProperty("preview", message.preview);
+    }
+    if (message.junkScore != null) {
+      header.setStringProperty("junkscore", String(message.junkScore));
+      header.setStringProperty("junkscoreorigin", "jmap");
+    }
+
+    header.flags =
+      message.flags |
+      (isNew ? Ci.nsMsgMessageFlags.New : 0);
+  }
+
+  /**
+   * Apply flag changes through the database so listeners and views update.
+   *
+   * @param {nsIMsgDatabase} db
+   * @param {nsIMsgDBHdr} header
+   * @param {object} message
+   */
+  #applyFlags(db, header, message) {
+    const key = header.messageKey;
+    db.markRead(key, message.isRead, null);
+    db.markMarked(key, message.isFlagged, null);
+    db.markReplied(key, message.isReplied, null);
+    db.markForwarded(key, message.isForwarded, null);
+    db.markHasAttachments(key, message.hasAttachment, null);
+
+    const flags = header.flags;
+    header.flags =
+      (flags & ~Ci.nsMsgMessageFlags.HasRe) |
+      (message.flags & Ci.nsMsgMessageFlags.HasRe);
+  }
+}
diff --git a/mailnews/protocols/jmap/modules/JmapIdentities.sys.mjs b/mailnews/protocols/jmap/modules/JmapIdentities.sys.mjs
new file mode 100644
index 00000000000..3bf8d46adbe
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapIdentities.sys.mjs
@@ -0,0 +1,144 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Keep Thunderbird identities of a JMAP account in step with the server's
+ * `Identity` objects (RFC 8621 section 6).
+ */
+
+import { JmapCapability } from "resource:///modules/jmap/JmapConstants.sys.mjs";
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  MailServices: "resource:///modules/MailServices.sys.mjs",
+});
+
+/** Format a JMAP EmailAddress[] as a header-style string. */
+export function formatAddresses(addresses) {
+  return (addresses ?? [])
+    .map(a =>
+      lazy.MailServices.headerParser.makeMimeAddress(a.name ?? "", a.email ?? "")
+    )
+    .join(", ");
+}
+
+/** Parse a header-style string into a JMAP EmailAddress[] (or null). */
+export function parseAddresses(value) {
+  if (!value) {
+    return null;
+  }
+  const parsed = lazy.MailServices.headerParser.parseEncodedHeaderW(value);
+  return parsed.map(a => ({ name: a.name || null, email: a.email }));
+}
+
+/**
+ * Apply one JMAP identity to a Thunderbird identity.
+ *
+ * @param {object} jmapIdentity
+ * @param {nsIMsgIdentity} identity
+ * @returns {boolean} Whether anything changed.
+ */
+export function applyIdentity(jmapIdentity, identity) {
+  let changed = false;
+  const set = (prop, value) => {
+    if (value != null && identity[prop] != value) {
+      identity[prop] = value;
+      changed = true;
+    }
+  };
+  if (jmapIdentity.name) {
+    set("fullName", jmapIdentity.name);
+  }
+  if (jmapIdentity.replyTo?.length) {
+    set("replyTo", formatAddresses(jmapIdentity.replyTo));
+  }
+  if (jmapIdentity.bcc?.length) {
+    set("bccList", formatAddresses(jmapIdentity.bcc));
+    set("doBcc", true);
+  }
+  // Never overwrite a signature the user configured locally.
+  if (!identity.htmlSigText) {
+    if (jmapIdentity.htmlSignature) {
+      set("htmlSigFormat", true);
+      set("htmlSigText", jmapIdentity.htmlSignature);
+    } else if (jmapIdentity.textSignature) {
+      set("htmlSigFormat", false);
+      set("htmlSigText", jmapIdentity.textSignature);
+    }
+  }
+  try {
+    identity.setUnicharAttribute("jmap_identity_id", jmapIdentity.id);
+  } catch (e) {}
+  return changed;
+}
+
+/**
+ * Pull `Identity/get` into the account's identities, matched by email.
+ *
+ * @param {nsIMsgIncomingServer} server
+ * @param {JmapClient} client
+ * @returns {Promise<number>} Number of identities updated.
+ */
+export async function syncIdentities(server, client) {
+  if (!client.supports(JmapCapability.Submission)) {
+    return 0;
+  }
+  const { args } = await client.call("Identity/get", {
+    accountId: client.getAccountId(JmapCapability.Submission),
+    ids: null,
+  });
+  const list = args.list ?? [];
+  let updated = 0;
+  for (const identity of lazy.MailServices.accounts.getIdentitiesForServer(
+    server
+  )) {
+    const email = (identity.email ?? "").toLowerCase();
+    const match = list.find(i => (i.email ?? "").toLowerCase() == email);
+    if (match && applyIdentity(match, identity)) {
+      updated++;
+    }
+  }
+  return updated;
+}
+
+/**
+ * Push a Thunderbird identity's editable fields back with `Identity/set`.
+ *
+ * @param {JmapClient} client
+ * @param {nsIMsgIdentity} identity
+ * @returns {Promise<void>}
+ */
+export async function pushIdentity(client, identity) {
+  const accountId = client.getAccountId(JmapCapability.Submission);
+  let id = "";
+  try {
+    id = identity.getUnicharAttribute("jmap_identity_id");
+  } catch (e) {}
+  if (!id) {
+    const { args } = await client.call("Identity/get", { accountId, ids: null });
+    const email = (identity.email ?? "").toLowerCase();
+    id = args.list?.find(i => (i.email ?? "").toLowerCase() == email)?.id;
+  }
+  if (!id) {
+    throw new Error(`No JMAP identity for ${identity.email}`);
+  }
+  const patch = {
+    name: identity.fullName ?? "",
+    replyTo: parseAddresses(identity.replyTo),
+    bcc: identity.doBcc ? parseAddresses(identity.bccList) : null,
+  };
+  if (identity.htmlSigFormat) {
+    patch.htmlSignature = identity.htmlSigText ?? "";
+  } else {
+    patch.textSignature = identity.htmlSigText ?? "";
+  }
+  const { args } = await client.call("Identity/set", {
+    accountId,
+    update: { [id]: patch },
+  });
+  if (args.notUpdated?.[id]) {
+    const failure = args.notUpdated[id];
+    throw new Error(`Identity/set failed: ${failure.type} ${failure.description ?? ""}`);
+  }
+}
diff --git a/mailnews/protocols/jmap/modules/JmapMailClient.sys.mjs b/mailnews/protocols/jmap/modules/JmapMailClient.sys.mjs
new file mode 100644
index 00000000000..131f6a76055
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapMailClient.sys.mjs
@@ -0,0 +1,1028 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { JmapCapability } from "resource:///modules/jmap/JmapConstants.sys.mjs";
+import { JmapCapabilityError } from "resource:///modules/jmap/JmapErrors.sys.mjs";
+
+/**
+ * Mailbox properties that Thunderbird's folder model needs.
+ */
+export const MAILBOX_PROPERTIES = Object.freeze([
+  "id",
+  "name",
+  "parentId",
+  "role",
+  "sortOrder",
+  "totalEmails",
+  "unreadEmails",
+  "totalThreads",
+  "unreadThreads",
+  "myRights",
+  "isSubscribed",
+]);
+
+/**
+ * Email properties needed to populate the message database and message list.
+ */
+export const EMAIL_METADATA_PROPERTIES = Object.freeze([
+  "id",
+  "blobId",
+  "threadId",
+  "mailboxIds",
+  "keywords",
+  "from",
+  "to",
+  "cc",
+  "bcc",
+  "replyTo",
+  "sender",
+  "subject",
+  "sentAt",
+  "receivedAt",
+  "size",
+  "preview",
+  "hasAttachment",
+  "messageId",
+  "inReplyTo",
+  "references",
+]);
+
+/**
+ * Email properties needed to display a message and its attachments.
+ */
+export const EMAIL_BODY_PROPERTIES = Object.freeze([
+  ...EMAIL_METADATA_PROPERTIES,
+  "bodyValues",
+  "textBody",
+  "htmlBody",
+  "attachments",
+]);
+
+/**
+ * Email properties needed to reconstruct an RFC 5322 message.
+ *
+ * `bodyStructure` is not in the RFC default property list and has to be
+ * requested explicitly.
+ */
+export const EMAIL_DISPLAY_PROPERTIES = Object.freeze([
+  ...EMAIL_METADATA_PROPERTIES,
+  "bodyStructure",
+  "bodyValues",
+  "textBody",
+  "htmlBody",
+  "attachments",
+]);
+
+/**
+ * Properties requested for each `EmailBodyPart`.
+ */
+export const EMAIL_BODY_PART_PROPERTIES = Object.freeze([
+  "partId",
+  "blobId",
+  "size",
+  "name",
+  "type",
+  "charset",
+  "disposition",
+  "cid",
+  "language",
+  "location",
+]);
+
+/**
+ * Thread properties.
+ */
+export const THREAD_PROPERTIES = Object.freeze(["id", "emailIds"]);
+
+/**
+ * Default identity properties.
+ */
+export const IDENTITY_PROPERTIES = Object.freeze([
+  "id",
+  "name",
+  "email",
+  "replyTo",
+  "bcc",
+  "textSignature",
+  "htmlSignature",
+  "mayDelete",
+]);
+
+/**
+ * Remove keys with an `undefined` or `null` value, so optional JMAP arguments
+ * are only sent when the caller actually provided a value. (`null` is
+ * meaningful inside patch objects, which are passed as nested values, but at
+ * the top level it only ever means "not set". Some servers reject it.)
+ *
+ * @param {object} args
+ * @returns {object}
+ */
+function defined(args) {
+  return Object.fromEntries(
+    Object.entries(args).filter(
+      ([, value]) => value !== undefined && value !== null
+    )
+  );
+}
+
+/**
+ * Client for the JMAP mail data model (RFC 8621).
+ *
+ * This class is a thin, typed wrapper around {@link JmapClient}. Every method
+ * returns the `args` part of the corresponding method response, and throws
+ * `JmapMethodError` when the server rejects the call.
+ */
+/** Upper bound on remembered email blob ids (see `cachedBlobId`). */
+const MAX_CACHED_BLOB_IDS = 200000;
+
+export class JmapMailClient {
+  #client;
+  #blobIds = new Map();
+
+  /**
+   * @param {import("resource:///modules/jmap/JmapClient.sys.mjs").JmapClient} client
+   */
+  constructor(client) {
+    if (!client || typeof client.request != "function") {
+      throw new TypeError("JmapMailClient requires a JmapClient");
+    }
+    if (!client.supports(JmapCapability.Mail)) {
+      throw new JmapCapabilityError(
+        "Server does not advertise the JMAP mail capability",
+        { capability: JmapCapability.Mail }
+      );
+    }
+    this.#client = client;
+  }
+
+  /** @returns {import("resource:///modules/jmap/JmapClient.sys.mjs").JmapClient} */
+  get client() {
+    return this.#client;
+  }
+
+  /**
+   * Account id used for mail methods.
+   *
+   * @param {string} [accountId] - Explicit account id, if any.
+   * @returns {string}
+   */
+  mailAccountId(accountId) {
+    return accountId ?? this.#client.getAccountId(JmapCapability.Mail);
+  }
+
+  /**
+   * Account id used for submission and identity methods.
+   *
+   * @param {string} [accountId] - Explicit account id, if any.
+   * @returns {string}
+   */
+  submissionAccountId(accountId) {
+    return accountId ?? this.#client.getAccountId(JmapCapability.Submission);
+  }
+
+  /**
+   * Whether the mail account is read-only.
+   *
+   * @param {string} [accountId]
+   * @returns {boolean}
+   */
+  isReadOnly(accountId) {
