+++ b/mailnews/protocols/jmap/test/live/test_live_contacts_calendar.js
@@ -0,0 +1,170 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Live tests: JMAP contacts (JmapDirectory) and calendars (CalJmapCalendar).
+ */
+
+var { JmapDirectory } = ChromeUtils.importESModule(
+  "resource:///modules/JmapDirectory.sys.mjs"
+);
+var { cal } = ChromeUtils.importESModule(
+  "resource:///modules/calendar/calUtils.sys.mjs"
+);
+var { createJmapCalendarsForServer, removeJmapCalendarsForServer } =
+  ChromeUtils.importESModule("resource:///modules/CalJmapProvider.sys.mjs");
+var { CalEvent } = ChromeUtils.importESModule(
+  "resource:///modules/CalEvent.sys.mjs"
+);
+
+let alice;
+
+add_setup(async function () {
+  if (!LIVE_CONFIG) {
+    return;
+  }
+  alice = await createLiveAccount("alice@test.localhost");
+});
+
+add_live_task(async function test_contacts() {
+  const client = await jsClient(alice.server);
+  if (!client.supports(JmapCapability.Contacts)) {
+    info("server has no contacts capability; skipping");
+    return;
+  }
+  const dirs = await JmapDirectory.createForServer(alice.server.key);
+  Assert.greater(dirs.length, 0, "at least one JMAP address book");
+  const dir = dirs.find(d => !d.readOnly) ?? dirs[0];
+  registerCleanupFunction(async () => {
+    try {
+      const uri = dir.URI;
+      await dir.cleanUp?.();
+      MailServices.ab.deleteAddressBook(uri);
+    } catch (e) {}
+  });
+  await dir.syncWithServer(false);
+
+  const lastName = `Live${RUN_ID}`;
+  const card = Cc["@mozilla.org/addressbook/cardproperty;1"].createInstance(
+    Ci.nsIAbCard
+  );
+  card.firstName = "Contact";
+  card.lastName = lastName;
+  card.displayName = `Contact ${lastName}`;
+  card.primaryEmail = `contact-${RUN_ID}@test.localhost`;
+  const added = dir.addCard(card);
+
+  const jmapId = await pollUntil(
+    () => dir.getCard(added.UID)?.getProperty("_jmapId", ""),
+    "local card gets a JMAP id"
+  );
+  const contacts = (accountArgs = {}) =>
+    jmapCall(alice.server, "ContactCard/get", { ids: [jmapId], ...accountArgs }, JmapCapability.Contacts);
+  registerCleanupFunction(() =>
+    jmapCall(
+      alice.server,
+      "ContactCard/set",
+      { destroy: [jmapId] },
+      JmapCapability.Contacts
+    ).catch(() => {})
+  );
+  let { list } = await contacts();
+  Assert.equal(list.length, 1, "card exists on server");
+  Assert.ok(
+    JSON.stringify(list[0]).includes(lastName),
+    "server card contains the last name"
+  );
+
+  // Modify on the server, then sync.
+  const changedName = `Changed${RUN_ID}`;
+  await jmapCall(
+    alice.server,
+    "ContactCard/set",
+    {
+      update: {
+        [jmapId]: {
+          name: {
+            "@type": "Name",
+            components: [
+              { "@type": "NameComponent", kind: "given", value: "Contact" },
+              { "@type": "NameComponent", kind: "surname", value: changedName },
+            ],
+            full: `Contact ${changedName}`,
+          },
+        },
+      },
+    },
+    JmapCapability.Contacts
+  );
+  await pollUntil(async () => {
+    await dir.syncWithServer(false);
+    const local = dir.getCard(added.UID);
+    return (
+      local &&
+      (local.lastName == changedName ||
+        local.displayName.includes(changedName))
+    );
+  }, "server change visible locally");
+
+  // Delete locally, verify on server.
+  dir.deleteCards([dir.getCard(added.UID)]);
+  await pollUntil(
+    async () => !(await contacts()).list.length,
+    "card deleted on server"
+  );
+});
+
+add_live_task(async function test_calendar() {
+  const client = await jsClient(alice.server);
+  if (!client.supports(JmapCapability.Calendars)) {
+    info("server has no calendars capability; skipping");
+    return;
+  }
+  const calendars = await createJmapCalendarsForServer(alice.server.key);
+  registerCleanupFunction(() => removeJmapCalendarsForServer(alice.server.key));
+  Assert.greater(calendars.length, 0, "at least one JMAP calendar");
+  const calendar = calendars.find(c => !c.readOnly) ?? calendars[0];
+
+  const title = `Live weekly ${RUN_ID}`;
+  const event = new CalEvent();
+  event.icalString = [
+    "BEGIN:VEVENT",
+    `UID:${RUN_ID}-weekly@test.localhost`,
+    `SUMMARY:${title}`,
+    "DTSTART:20261109T100000Z",
+    "DTEND:20261109T110000Z",
+    "RRULE:FREQ=WEEKLY;COUNT=5",
+    "END:VEVENT",
+  ].join("\r\n");
+  const added = await calendar.addItem(event);
+  const jmapId = added.getProperty("X-JMAP-ID");
+  Assert.ok(jmapId, "event has a JMAP id");
+  registerCleanupFunction(() =>
+    jmapCall(
+      alice.server,
+      "CalendarEvent/set",
+      { destroy: [jmapId] },
+      JmapCapability.Calendars
+    ).catch(() => {})
+  );
+
+  const getEvent = () =>
+    jmapCall(
+      alice.server,
+      "CalendarEvent/get",
+      { ids: [jmapId] },
+      JmapCapability.Calendars
+    );
+  let { list } = await getEvent();
+  Assert.equal(list.length, 1, "event exists on server");
+  Assert.equal(list[0].title, title, "server event title");
+  const rules = list[0].recurrenceRules ?? [];
+  Assert.equal(rules.length, 1, "server event has one recurrence rule");
+  Assert.equal(rules[0].frequency, "weekly", "rule is weekly");
+  Assert.equal(rules[0].count, 5, "rule count is 5");
+
+  await calendar.deleteItem(added);
+  ({ list } = await getEvent());
+  Assert.equal(list.length, 0, "event deleted on server");
+});
diff --git a/mailnews/protocols/jmap/test/live/test_live_files.js b/mailnews/protocols/jmap/test/live/test_live_files.js
new file mode 100644
index 00000000000..3182ddfaaa5
--- /dev/null
+++ b/mailnews/protocols/jmap/test/live/test_live_files.js
@@ -0,0 +1,108 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Live tests: JMAP file storage (JmapFiles) and the FileLink provider.
+ */
+
+var { JmapFiles } = ChromeUtils.importESModule(
+  "resource:///modules/jmapfiles/JmapFiles.sys.mjs"
+);
+var { JmapCloudFileAccount } = ChromeUtils.importESModule(
+  "resource:///modules/jmapfiles/JmapCloudFile.sys.mjs"
+);
+
+let alice;
+
+add_setup(async function () {
+  if (!LIVE_CONFIG) {
+    return;
+  }
+  alice = await createLiveAccount("alice@test.localhost");
+});
+
+async function fileService() {
+  const client = await jsClient(alice.server);
+  if (!client.supports(JmapCapability.FileNode)) {
+    return null;
+  }
+  return JmapFiles.forServer(alice.server.key);
+}
+
+add_live_task(async function test_files() {
+  const service = await fileService();
+  if (!service) {
+    info("server has no FileNode capability; skipping");
+    return;
+  }
+  await service.reload();
+
+  const dir = await service.mkdir(null, `live-dir-${RUN_ID}`);
+  registerCleanupFunction(() => service.remove([dir.id]).catch(() => {}));
+  Assert.ok(dir.id, "directory created");
+  const dir2 = await service.mkdir(null, `live-dir2-${RUN_ID}`);
+  registerCleanupFunction(() => service.remove([dir2.id]).catch(() => {}));
+
+  const bytes = new TextEncoder().encode(`hello jmap files ${RUN_ID}\n`);
+  const uploaded = await service.upload(dir.id, bytes, {
+    name: "hello.txt",
+    mediaType: "text/plain",
+  });
+  Assert.ok(uploaded.id, "file uploaded");
+
+  let children = await service.listChildren(dir.id);
+  Assert.ok(
+    children.some(n => n.id == uploaded.id && n.name == "hello.txt"),
+    "file listed in directory"
+  );
+
+  await service.rename(uploaded.id, "renamed.txt");
+  await service.refresh();
+  Assert.equal(service.getNode(uploaded.id)?.name, "renamed.txt", "renamed");
+
+  await service.move([uploaded.id], dir2.id);
+  await service.refresh();
+  children = await service.listChildren(dir2.id);
+  Assert.ok(children.some(n => n.id == uploaded.id), "file moved");
+  children = await service.listChildren(dir.id);
+  Assert.ok(!children.some(n => n.id == uploaded.id), "file left old dir");
+
+  const blob = await service.download(uploaded.id);
+  const downloaded = new Uint8Array(await blob.arrayBuffer());
+  Assert.deepEqual(Array.from(downloaded), Array.from(bytes), "bytes match");
+
+  await service.remove([uploaded.id]);
+  await service.refresh();
+  Assert.ok(!service.getNode(uploaded.id), "file deleted");
+});
+
+add_live_task(async function test_fileLink() {
+  const service = await fileService();
+  if (!service) {
+    info("server has no FileNode capability; skipping");
+    return;
+  }
+  const account = new JmapCloudFileAccount(`live${RUN_ID}`);
+  account.serverKey = alice.server.key;
+  registerCleanupFunction(() => {
+    Services.prefs.clearUserPref(
+      `mail.cloud_files.accounts.${account.accountKey}.jmapServerKey`
+    );
+  });
+
+  const file = Services.dirsvc.get("TmpD", Ci.nsIFile);
+  file.append(`filelink-${RUN_ID}.txt`);
+  await IOUtils.writeUTF8(file.path, `filelink ${RUN_ID}`);
+  registerCleanupFunction(() => IOUtils.remove(file.path).catch(() => {}));
+
+  const upload = await account.uploadFile(null, file);
+  Assert.ok(upload.url, "FileLink returned a URL");
+  Assert.ok(upload.nodeId, "upload has a node id");
+  Assert.stringContains(upload.url, "http", "URL is http(s)");
+  info(`FileLink url: ${upload.url}`);
+
+  await account.deleteFile(null, upload.id);
+  await service.refresh();
+  Assert.ok(!service.getNode(upload.nodeId), "FileLink upload deleted");
+});
