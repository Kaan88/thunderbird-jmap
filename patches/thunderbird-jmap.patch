+nsresult JmapFolder::CollectJmapIds(
+    const nsTArray<RefPtr<nsIMsgDBHdr>>& messages,
+    nsTArray<nsCString>& ids) {
+  ids.Clear();
+  for (auto message : messages) {
+    if (!message) {
+      continue;
+    }
+    nsCString id;
+    if (NS_SUCCEEDED(message->GetStringProperty("jmapId", id)) &&
+        !id.IsEmpty()) {
+      ids.AppendElement(id);
+    }
+  }
+  return NS_OK;
+}
+
+nsresult JmapFolder::GetClientForMutation(nsCOMPtr<IJmapClient>& client) {
+  return JmapClientForFolder(this, getter_AddRefs(client));
+}
+
+nsresult JmapFolder::SendReadMutation(
+    const nsTArray<RefPtr<nsIMsgDBHdr>>& messages, bool read) {
+  nsTArray<nsCString> ids;
+  nsresult rv = CollectJmapIds(messages, ids);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (ids.IsEmpty()) {
+    return NS_OK;
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  rv = GetClientForMutation(client);
+  if (NS_FAILED(rv) || !client) {
+    NS_WARNING("Could not reach the JMAP client to update read state");
+    return NS_OK;
+  }
+
+  // The local database is already up to date, so a failed server round trip
+  // must not fail the user's action. The next sync reconciles the state.
+  rv = client->SetMessagesRead(ids, read, nullptr);
+  if (NS_FAILED(rv)) {
+    nsPrintfCString message(
+        "JMAP read state update failed: 0x%08x", static_cast<uint32_t>(rv));
+    NS_WARNING(message.get());
+  }
+  return NS_OK;
+}
+
+nsresult JmapFolder::SendFlaggedMutation(
+    const nsTArray<RefPtr<nsIMsgDBHdr>>& messages, bool flagged) {
+  nsTArray<nsCString> ids;
+  nsresult rv = CollectJmapIds(messages, ids);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (ids.IsEmpty()) {
+    return NS_OK;
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  rv = GetClientForMutation(client);
+  if (NS_FAILED(rv) || !client) {
+    NS_WARNING("Could not reach the JMAP client to update flags");
+    return NS_OK;
+  }
+
+  rv = client->SetMessagesFlagged(ids, flagged, nullptr);
+  if (NS_FAILED(rv)) {
+    nsPrintfCString message(
+        "JMAP flag update failed: 0x%08x", static_cast<uint32_t>(rv));
+    NS_WARNING(message.get());
+  }
+  return NS_OK;
+}
+
+nsresult JmapFolder::SendKeywordMutation(
+    const nsTArray<RefPtr<nsIMsgDBHdr>>& messages, const nsACString& keywords,
+    bool add) {
+  nsTArray<nsCString> ids;
+  nsresult rv = CollectJmapIds(messages, ids);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsTArray<nsCString> changed;
+  for (const auto& keyword : keywords.Split(' ')) {
+    if (!keyword.IsEmpty()) {
+      changed.AppendElement(keyword);
+    }
+  }
+  if (ids.IsEmpty() || changed.IsEmpty()) {
+    return NS_OK;
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  rv = GetClientForMutation(client);
+  if (NS_FAILED(rv) || !client) {
+    NS_WARNING("Could not reach the JMAP client to update tags");
+    return NS_OK;
+  }
+
+  nsTArray<nsCString> none;
+  rv = add ? client->SetKeywords(ids, changed, none, nullptr)
+           : client->SetKeywords(ids, none, changed, nullptr);
+  if (NS_FAILED(rv)) {
+    nsPrintfCString message("JMAP keyword update failed: 0x%08x",
+                            static_cast<uint32_t>(rv));
+    NS_WARNING(message.get());
+  }
+  return NS_OK;
+}
