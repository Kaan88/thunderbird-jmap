+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPSEARCH_H_
+#define COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPSEARCH_H_
+
+#include "nsIMsgSearchTerm.h"
+#include "nsString.h"
+#include "nsTArray.h"
+
+class nsIMsgFolder;
+class nsIMsgSearchSession;
+
+/**
+ * Translate Thunderbird search terms into a JMAP `Email/query` filter.
+ *
+ * Supported attributes: subject, sender, recipients (to, cc, to-or-cc, all
+ * addresses), body, any text, date, message status (read, flagged, replied,
+ * forwarded), tags (keywords) and size. Terms are combined left to right
+ * using each term's `booleanAnd`; explicit grouping is not preserved.
+ *
+ * @param terms - The search terms.
+ * @param mailboxId - If not empty, restrict the query to this mailbox.
+ * @param filterJSON - The resulting `FilterOperator`/`FilterCondition`.
+ * @returns NS_ERROR_NOT_IMPLEMENTED when a term cannot be expressed.
+ */
+nsresult JmapBuildSearchFilter(const nsTArray<RefPtr<nsIMsgSearchTerm>>& terms,
+                               const nsACString& mailboxId,
+                               nsACString& filterJSON);
+
+/**
+ * Run the search of `session` against the server for `folder` and report
+ * matching local headers to the session. The session is told the search
+ * finished through its `nsIUrlListener` interface.
+ */
+nsresult JmapRunServerSearch(nsIMsgSearchSession* session,
+                             nsIMsgFolder* folder);
+
+#endif  // COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPSEARCH_H_
