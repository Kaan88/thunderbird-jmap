diff --git a/mailnews/protocols/jmap/test/unit/test_jmap_message_builder.js b/mailnews/protocols/jmap/test/unit/test_jmap_message_builder.js
new file mode 100644
index 00000000000..5e88cab1cab
--- /dev/null
+++ b/mailnews/protocols/jmap/test/unit/test_jmap_message_builder.js
@@ -0,0 +1,461 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+function makeEmail(overrides = {}) {
+  return {
+    id: "e1",
+    from: [{ name: "Alice", email: "alice@example.com" }],
+    to: [{ name: "Bob", email: "bob@example.com" }],
+    subject: "Hello",
+    sentAt: "2026-01-02T03:04:05Z",
+    receivedAt: "2026-01-02T03:04:05Z",
+    messageId: ["<abc@example.com>"],
+    references: [],
+    bodyValues: {},
+    textBody: [],
+    htmlBody: [],
+    attachments: [],
+    ...overrides,
+  };
+}
+
+function textPart(partId = "1", type = "text/plain") {
+  return { partId, type, charset: "utf-8" };
+}
+
+const decode = bytes => new TextDecoder().decode(bytes);
+
+function headerBlockOf(bytes) {
+  const text = decode(bytes);
+  return text.slice(0, text.indexOf("\r\n\r\n"));
+}
+
+function bodyOf(bytes) {
+  const text = decode(bytes);
+  const index = text.indexOf("\r\n\r\n");
+  return text.slice(index + 4);
+}
+
+add_task(async function test_text_only() {
+  const email = makeEmail({
+    textBody: [textPart()],
+    bodyValues: {
+      "1": { value: "Hello\r\nworld\r\n" },
+    },
+  });
+
+  const message = await buildMessage(email);
+  const headers = headerBlockOf(message.bytes);
+
+  Assert.equal(message.rootType, "text/plain");
+  Assert.ok(headers.startsWith("MIME-Version: 1.0\r\n"));
+  Assert.ok(headers.includes("Content-Type: text/plain; charset=utf-8"));
+  Assert.ok(headers.includes("Content-Transfer-Encoding: 7bit"));
+  Assert.ok(headers.includes("Subject: Hello"));
+  Assert.ok(headers.includes("Message-ID: <abc@example.com>"));
+  Assert.equal(bodyOf(message.bytes), "Hello\r\nworld\r\n");
+});
+
+add_task(async function test_text_non_ascii_quoted_printable() {
+  const email = makeEmail({
+    textBody: [textPart()],
+    bodyValues: { "1": { value: "Café\r\n" } },
+  });
+
+  const message = await buildMessage(email);
+  const headers = headerBlockOf(message.bytes);
+
+  Assert.ok(headers.includes("Content-Transfer-Encoding: quoted-printable"));
+  Assert.ok(
+    bodyOf(message.bytes).includes("Caf=C3=A9"),
+    "UTF-8 bytes are quoted-printable encoded"
+  );
+});
+
+add_task(async function test_long_lines_are_soft_broken() {
+  const email = makeEmail({
+    textBody: [textPart()],
+    bodyValues: { "1": { value: "a".repeat(1200) } },
+  });
+
+  const message = await buildMessage(email);
+  for (const line of bodyOf(message.bytes).split("\r\n")) {
+    Assert.ok(line.length <= 77, `line is too long: ${line.length}`);
+  }
+});
+
+add_task(async function test_html_only() {
+  const email = makeEmail({
+    htmlBody: [textPart("1", "text/html")],
+    bodyValues: { "1": { value: "<p>Hello</p>" } },
+  });
+
+  const message = await buildMessage(email);
+  const headers = headerBlockOf(message.bytes);
+
+  Assert.equal(message.rootType, "text/html");
+  Assert.ok(headers.includes("Content-Type: text/html; charset=utf-8"));
+  Assert.ok(!headers.includes("text/plain"), "no synthetic text part");
+});
+
+add_task(async function test_text_and_html_alternative() {
+  const email = makeEmail({
+    textBody: [textPart("1")],
+    htmlBody: [textPart("2", "text/html")],
+    bodyValues: {
+      "1": { value: "Hello" },
+      "2": { value: "<p>Hello</p>" },
+    },
+  });
+
+  const message = await buildMessage(email);
+  const text = decode(message.bytes);
+
+  Assert.equal(message.rootType, "multipart/alternative");
+  Assert.ok(text.includes("multipart/alternative;"));
+  const plainIndex = text.indexOf("Content-Type: text/plain");
+  const htmlIndex = text.indexOf("Content-Type: text/html");
+  Assert.ok(plainIndex > 0, "plain part exists");
+  Assert.ok(htmlIndex > plainIndex, "HTML follows the plain-text part");
+});
+
+add_task(async function test_same_part_in_both_lists() {
+  const part = { partId: "1", type: "text/html" };
+  const email = makeEmail({
+    textBody: [part],
+    htmlBody: [part],
+    bodyValues: { "1": { value: "<p>x</p>" } },
+  });
+
+  const parts = collectBodyParts(email);
+  Assert.equal(parts.plain.length, 0);
+  Assert.equal(parts.html.length, 1);
+
+  const message = await buildMessage(email);
+  Assert.equal(message.rootType, "text/html");
+});
+
+add_task(async function test_attachment_is_lazy() {
+  let blobCalls = 0;
+  const email = makeEmail({
+    textBody: [textPart("1")],
+    bodyValues: { "1": { value: "Hello" } },
+    attachments: [
+      {
+        partId: "2",
+        blobId: "blob-2",
+        type: "application/pdf",
+        name: "report.pdf",
+        size: 3,
+      },
+    ],
+  });
+
+  const message = await buildMessage(email, {
+    getBlob: async () => {
+      blobCalls++;
+      return new TextEncoder().encode("PDF");
+    },
+  });
+
+  Assert.equal(message.rootType, "multipart/mixed");
+  Assert.equal(blobCalls, 0, "attachments are not downloaded for display");
+  Assert.ok(
+    decode(message.bytes).includes(
+      'Content-Disposition: attachment; filename="report.pdf"'
+    )
+  );
+  Assert.equal(message.partMap.get("2").blobId, "blob-2");
+});
+
+add_task(async function test_attachment_can_be_embedded() {
+  const email = makeEmail({
+    textBody: [textPart("1")],
+    bodyValues: { "1": { value: "Hello" } },
+    attachments: [
+      {
+        partId: "2",
+        blobId: "blob-2",
+        type: "application/pdf",
+        name: "report.pdf",
+      },
+    ],
+  });
+
+  const message = await buildMessage(email, {
+    includeAttachmentData: "all",
+    getBlob: async () => new TextEncoder().encode("PDF"),
+  });
+
+  // Base64("PDF") == "UERG"
+  Assert.ok(decode(message.bytes).includes("UERG"));
+});
+
+add_task(async function test_inline_image_related() {
+  const email = makeEmail({
+    htmlBody: [textPart("1", "text/html")],
+    bodyValues: {
+      "1": { value: '<p>Hi <img src="cid:logo@example.com"></p>' },
+    },
+    attachments: [
+      {
+        partId: "2",
+        blobId: "blob-2",
+        type: "image/png",
+        cid: "logo@example.com",
+        name: "logo.png",
+        disposition: "inline",
+      },
+    ],
+  });
+
+  const message = await buildMessage(email);
+  const text = decode(message.bytes);
+
+  Assert.equal(message.rootType, "multipart/related");
+  Assert.ok(text.includes("Content-ID: <logo@example.com>"));
+  Assert.ok(
+    text.includes('cid:logo@example.com'),
+    "HTML is not rewritten; libmime resolves cid:"
+  );
+  Assert.equal(message.partMap.get("2").cid, "logo@example.com");
+});
+
+add_task(async function test_non_ascii_headers() {
+  const email = makeEmail({
+    subject: "Tést",
+    from: [{ name: "Álvaro", email: "alvaro@example.com" }],
+    textBody: [textPart()],
+    bodyValues: { "1": { value: "Hola" } },
+  });
+
+  const message = await buildMessage(email);
+  const headers = headerBlockOf(message.bytes);
+
+  Assert.ok(/^[\x00-\x7F]*$/.test(headers), "header block is ASCII");
+  Assert.ok(headers.includes("=?UTF-8?B?"));
+  Assert.ok(headers.includes("Subject: =?UTF-8?B?"));
+});
+
+add_task(async function test_header_injection_is_neutralized() {
+  const email = makeEmail({
+    subject: "Hello\r\nBcc: evil@example.com",
+    from: [{ name: "Evil\r\nX-Evil: 1", email: "evil@example.com" }],
+    textBody: [textPart()],
+    bodyValues: { "1": { value: "Hi" } },
+  });
+
+  const message = await buildMessage(email);
+  const headers = headerBlockOf(message.bytes);
+
+  Assert.ok(!headers.includes("\r\nBcc:"), "no injected Bcc header");
+  Assert.ok(!headers.includes("\r\nX-Evil:"), "no injected custom header");
+});
+
+add_task(async function test_empty_email() {
+  const message = await buildMessage({ id: "empty" });
+  const headers = headerBlockOf(message.bytes);
+
+  Assert.equal(message.rootType, "text/plain");
+  Assert.ok(headers.includes("MIME-Version: 1.0"));
+  Assert.ok(headers.includes("Content-Type: text/plain; charset=utf-8"));
+  Assert.ok(decode(message.bytes).endsWith("\r\n\r\n\r\n"));
+});
+
+add_task(async function test_references_and_in_reply_to() {
+  const email = makeEmail({
+    messageId: ["<m1@example.com>"],
+    inReplyTo: ["<m0@example.com>"],
+    references: ["<root@example.com>", "m0@example.com"],
+    textBody: [textPart()],
+    bodyValues: { "1": { value: "Reply" } },
+  });
+
+  const message = await buildMessage(email);
+  const headers = headerBlockOf(message.bytes);
+
+  Assert.ok(headers.includes("In-Reply-To: <m0@example.com>"));
+  Assert.ok(
+    headers.includes(
+      "References: <root@example.com> <m0@example.com>"
+    )
+  );
+});
+
+add_task(async function test_truncated_body_uses_blob() {
+  const email = makeEmail({
+    textBody: [textPart()],
+    bodyValues: {
+      "1": { value: "short", isTruncated: true },
+    },
+  });
+  email.textBody[0].blobId = "blob-1";
+
+  const message = await buildMessage(email, {
+    getBlob: async () => new TextEncoder().encode("full body"),
+  });
+  const text = decode(message.bytes);
+
+  Assert.ok(text.includes("full body"));
+  Assert.ok(!text.includes("X-JMAP-Body-Truncated"));
+});
+
+add_task(async function test_truncated_body_without_blob() {
+  const email = makeEmail({
+    textBody: [textPart()],
+    bodyValues: {
+      "1": { value: "short", isTruncated: true },
+    },
+  });
+
+  const message = await buildMessage(email);
+  Assert.ok(
+    headerBlockOf(message.bytes).includes("X-JMAP-Body-Truncated: 1")
+  );
+});
+
+add_task(async function test_encoding_problem_is_marked() {
+  const email = makeEmail({
+    textBody: [textPart()],
+    bodyValues: {
+      "1": { value: "bad \uFFFD", isEncodingProblem: true },
+    },
+  });
+
+  const message = await buildMessage(email);
+  Assert.ok(
+    headerBlockOf(message.bytes).includes("X-JMAP-Encoding-Problem: 1")
+  );
+});
+
+add_task(async function test_part_numbering() {
