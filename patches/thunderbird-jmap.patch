+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import {
+  JmapError,
+  JmapSessionError,
+} from "resource:///modules/jmap/JmapErrors.sys.mjs";
+import {
+  JmapFolderStore,
+} from "resource:///modules/jmap/JmapFolderStore.sys.mjs";
+import {
+  EMAIL_BODY_PART_PROPERTIES,
+  EMAIL_DISPLAY_PROPERTIES,
+  JmapMailClient,
+} from "resource:///modules/jmap/JmapMailClient.sys.mjs";
+import {
+  buildMessage,
+} from "resource:///modules/jmap/JmapMessageBuilder.sys.mjs";
+import {
+  syncMailboxes,
+  toNsresult,
+} from "resource:///modules/jmap/JmapMailboxSync.sys.mjs";
+import { JmapSyncEngine } from "resource:///modules/jmap/JmapSync.sys.mjs";
+import { JmapAccountRegistry } from "resource:///modules/jmap/JmapAccountRegistry.sys.mjs";
+import { JmapAccountServices } from "resource:///modules/jmap/JmapAccountServices.sys.mjs";
+import { JmapTypeClient } from "resource:///modules/jmap/JmapTypeClient.sys.mjs";
+import {
+  JmapCapability,
+  capabilityForMethod,
+} from "resource:///modules/jmap/JmapConstants.sys.mjs";
+import { JmapMutator } from "resource:///modules/jmap/JmapMutations.sys.mjs";
+import { JmapOfflineQueue } from "resource:///modules/jmap/JmapOfflineQueue.sys.mjs";
+import { JmapPush } from "resource:///modules/jmap/JmapPush.sys.mjs";
+import { syncIdentities } from "resource:///modules/jmap/JmapIdentities.sys.mjs";
+
+const log = console.createInstance({
+  prefix: "mail.jmap",
+  maxLogLevel: "Warn",
+  maxLogLevelPref: "mail.jmap.loglevel",
+});
+
+/**
+ * XPCOM implementation of `IJmapClient`.
+ *
+ * The component is deliberately thin: it owns the lifetime of a `JmapClient`
+ * and translates between XPCOM callbacks and the promise-based client API.
+ * All protocol logic lives in the `JmapClient`/`JmapMailClient` modules.
+ */
+export class JmapXPCOMClient {
+  #server = null;
+  #sessionUrl = "";
+  #client = null;
+  #mail = null;
+  #connecting = null;
+  #abortController = null;
+  #activeOperations = 0;
+  #shutdown = true;
+  #syncing = false;
+  #syncWaiters = [];
+  #lastSyncStatus = Cr.NS_OK;
+
+  /**
+   * @param {nsIMsgIncomingServer} incomingServer
+   * @param {string} sessionUrl
+   */
+  initialize(incomingServer, sessionUrl) {
+    this.shutdown();
+
+    this.#server = incomingServer;
+    this.#sessionUrl = sessionUrl ?? "";
+    this.#shutdown = false;
+    this.#abortController = new AbortController();
+
+    if (incomingServer?.key) {
+      const key = incomingServer.key;
+      JmapOfflineQueue.registerExecutor(key, op => this.#replayOp(op));
+    }
+  }
+
+  get incomingServerKey() {
+    return this.#server?.key ?? "";
+  }
+
+  get running() {
+    return (
+      !this.#shutdown &&
+      (Boolean(this.#client) ||
+        Boolean(this.#connecting) ||
+        this.#activeOperations > 0)
+    );
+  }
+
+  get idle() {
+    return (
+      this.running && !this.#connecting && this.#activeOperations === 0
+    );
+  }
+
+  shutdown() {
+    if (this.#server?.key) {
+      JmapPush.stop(this.#server.key);
+      JmapOfflineQueue.unregisterExecutor(this.#server.key);
+    }
+    this.#shutdown = true;
+    this.#abortController?.abort();
+    this.#abortController = null;
+    this.#client = null;
+    this.#mail = null;
+    this.#connecting = null;
+  }
+
+  /**
+   * @param {IJmapMailboxListener} listener
+   */
+  syncMailboxes(listener) {
+    this.#track(this.#syncMailboxes(listener));
+  }
+
+  /**
+   * @param {nsIUrlListener} listener
+   */
+  checkConnectivity(listener) {
+    try {
+      listener.OnStartRunningUrl(null);
+    } catch (error) {
+      log.error("JMAP connectivity listener failed on start", error);
+    }
+
+    this.#track(
+      (async () => {
+        let status = Cr.NS_OK;
+        try {
+          await this.#getMailClient();
+        } catch (error) {
+          log.error("JMAP connectivity check failed", error);
+          status = toNsresult(error);
+        }
+
+        try {
+          listener.OnStopRunningUrl(null, status);
+        } catch (error) {
+          log.error("JMAP connectivity listener failed on stop", error);
+        }
+      })()
+    );
+  }
+
+  /**
+   * Synchronize message metadata for the whole account.
+   *
+   * @param {?nsIUrlListener} listener
+   */
+  syncAccount(listener) {
+    try {
+      listener?.OnStartRunningUrl(null);
+    } catch (error) {
+      log.error("JMAP sync listener failed on start", error);
+    }
+
+    // Coalesce overlapping syncs (for example a biff while the user asked for
+    // a manual check). Every listener is still notified when the running sync
+    // finishes.
+    if (this.#syncing) {
+      this.#syncWaiters.push(listener);
+      return;
+    }
+
+    this.#syncing = true;
+    this.#track(
+      this.#syncAccount(listener).finally(() => {
+        this.#syncing = false;
+        const waiters = this.#syncWaiters;
+        this.#syncWaiters = [];
+        for (const waiter of waiters) {
+          try {
+            waiter?.OnStopRunningUrl(null, this.#lastSyncStatus);
+          } catch (error) {
+            log.error("JMAP sync listener failed on stop", error);
+          }
+        }
+      })
+    );
+  }
+
+  /**
+   * Fetch the mailbox list and deliver it to an XPCOM listener.
+   *
+   * @param {IJmapMailboxListener} listener
+   */
+  async #syncMailboxes(listener) {
+    try {
+      const mail = await this.#getMailClient();
+      await syncMailboxes(mail, listener);
+    } catch (error) {
+      log.error("Failed to sync JMAP mailboxes", error);
+      try {
+        listener.onError(toNsresult(error), error?.message ?? String(error));
+      } catch (listenerError) {
+        log.error("JMAP mailbox listener failed", listenerError);
+      }
+    }
+  }
+
+  /**
+   * Run one account-wide message synchronization.
+   *
+   * @param {?nsIUrlListener} listener
+   */
+  async #syncAccount(listener) {
+    let status = Cr.NS_OK;
+
+    try {
+      const mail = await this.#getMailClient();
+      const server = this.#server.QueryInterface(Ci.IJmapIncomingServer);
+      const store = new JmapFolderStore({
+        server,
+        rootFolder: this.#server.rootFolder,
+        logger: log,
+      });
+      const engine = new JmapSyncEngine({ mail, store, logger: log });
+      const stats = await engine.sync();
+      log.debug(
+        `JMAP sync (${stats.mode}): ${stats.created} created, ` +
+          `${stats.updated} updated, ${stats.deleted} deleted`
+      );
+      try {
+        await syncIdentities(this.#server, mail.client);
+      } catch (error) {
+        log.warn("JMAP identity sync failed", error);
+      }
+    } catch (error) {
+      log.error("JMAP message sync failed", error);
+      status = toNsresult(error);
+    }
+
+    try {
+      listener?.OnStopRunningUrl(null, status);
+    } catch (error) {
+      log.error("JMAP sync listener failed on stop", error);
+    }
+
+    this.#lastSyncStatus = status;
+  }
+
+  /**
+   * Fetch the raw RFC 5322 content of a message.
+   *
+   * @param {IJmapMessageFetchListener} listener
+   * @param {string} id - JMAP email id.
+   */
+  getMessage(listener, id) {
+    this.#track(this.#getMessage(listener, id));
+  }
+
+  /**
+   * Fetch the raw message blob and deliver it as a stream.
+   *
+   * @param {IJmapMessageFetchListener} listener
+   * @param {string} id
+   */
+  async #getMessage(listener, id) {
+    try {
+      const mail = await this.#getMailClient();
+      const cachedBlobId = mail.cachedBlobId(id);
+      const email = cachedBlobId
+        ? { id, blobId: cachedBlobId }
+        : await mail.getEmail(id, { properties: ["id", "blobId"] });
+
+      if (!email) {
+        throw new JmapError(`JMAP message ${id} was not found`);
+      }
+
+      let data;
+      if (email.blobId) {
+        const { blob } = await mail.client.download(email.blobId, {
+          type: "message/rfc822",
+          name: "message.eml",
+        });
+        data = new Uint8Array(await blob.arrayBuffer());
+      } else {
+        // The server does not expose a raw message blob: rebuild an RFC 5322
+        // message from the body values and parts.
+        const full = await mail.getEmail(id, {
+          properties: EMAIL_DISPLAY_PROPERTIES,
+          bodyProperties: EMAIL_BODY_PART_PROPERTIES,
+          fetchTextBodyValues: true,
+          fetchHTMLBodyValues: true,
+          maxBodyValueBytes: 0,
+        });
+        const built = await buildMessage(full, {
+          getBlob: async blobId => {
+            const { blob } = await mail.client.download(blobId, {
+              type: "application/octet-stream",
+              name: "part",
+            });
+            return new Uint8Array(await blob.arrayBuffer());
+          },
+          includeAttachmentData: "inline",
+        });
+        data = built.bytes;
+      }
+
+      const stream = Cc[
+        "@mozilla.org/io/arraybuffer-input-stream;1"
+      ].createInstance(Ci.nsIArrayBufferInputStream);
+      stream.setData(data.buffer, data.byteOffset, data.byteLength);
+
+      listener.onFetchedDataAvailable(stream);
+      listener.onFetchStop(Cr.NS_OK);
+    } catch (error) {
+      log.error("Failed to fetch JMAP message", error);
+      try {
+        listener.onFetchStop(toNsresult(error));
+      } catch (listenerError) {
+        log.error("JMAP message listener failed", listenerError);
+      }
+    }
+  }
+
+  /**
+   * Mark messages read or unread on the server.
+   *
+   * The local database is updated by the folder before this is called; the
+   * server update is best effort and reported through `listener`.
+   *
+   * @param {string[]} ids - JMAP email ids.
+   * @param {boolean} read
+   * @param {?nsIUrlListener} listener
+   */
+  setMessagesRead(ids, read, listener) {
+    this.#track(
+      this.#mutate(listener, "setRead", [[...ids], read])
+    );
+  }
+
+  /**
+   * Flag or unflag messages on the server.
+   *
+   * @param {string[]} ids - JMAP email ids.
+   * @param {boolean} flagged
+   * @param {?nsIUrlListener} listener
+   */
+  setMessagesFlagged(ids, flagged, listener) {
+    this.#track(
+      this.#mutate(listener, "setFlagged", [[...ids], flagged])
+    );
+  }
+
+  /**
+   * Permanently delete messages on the server.
+   *
+   * @param {string[]} ids
+   * @param {?nsIUrlListener} listener
+   */
+  deleteMessages(ids, listener) {
+    this.#track(
+      this.#mutate(listener, "destroy", [[...ids]])
+    );
+  }
+
+  /**
+   * Move messages between mailboxes on the server.
+   *
+   * @param {string[]} ids
+   * @param {string} fromMailboxId
+   * @param {string} toMailboxId
+   * @param {?nsIUrlListener} listener
+   */
+  moveMessages(ids, fromMailboxId, toMailboxId, listener) {
+    this.#track(
+      this.#mutate(listener, "move", [[...ids], fromMailboxId, toMailboxId])
+    );
+  }
+
+  /**
+   * Copy messages into another mailbox on the server.
+   *
+   * @param {string[]} ids
+   * @param {string} toMailboxId
+   * @param {?nsIUrlListener} listener
+   */
+  copyMessages(ids, toMailboxId, listener) {
+    this.#track(
+      this.#mutate(listener, "copy", [[...ids], toMailboxId])
+    );
+  }
+
+  /**
+   * Set or clear the junk classification of messages on the server.
+   *
+   * @param {string[]} ids
+   * @param {boolean} junk
+   * @param {?nsIUrlListener} listener
+   */
+  setMessagesJunk(ids, junk, listener) {
+    this.#track(
+      this.#mutate(listener, "setJunk", [[...ids], junk])
+    );
+  }
+
+  /**
+   * Run a serialisable mutation against the account's mail client. If it
+   * fails with a network error while offline, it is queued in
+   * {@link JmapOfflineQueue} and replayed when back online; the listener then
+   * gets NS_OK since the local change stands.
+   *
+   * @param {?nsIUrlListener} listener
+   * @param {string} kind - One of the cases in {@link #runOp}.
+   * @param {Array} args - JSON-serialisable arguments.
+   */
+  #mutate(listener, kind, args) {
+    return (async () => {
+      let status = Cr.NS_OK;
+      try {
+        listener?.OnStartRunningUrl(null);
+      } catch (error) {
+        log.error("JMAP mutation listener failed on start", error);
+      }
+
+      try {
+        await this.#runOp(kind, args);
+      } catch (error) {
+        if (this.#server?.key && JmapOfflineQueue.shouldQueue(error)) {
+          log.info(`Queuing JMAP ${kind} while offline`);
+          try {
+            await JmapOfflineQueue.enqueue(this.#server.key, { kind, args });
+          } catch (queueError) {
+            log.error("Failed to queue JMAP mutation", queueError);
+            status = toNsresult(error);
+          }
+        } else {
+          log.error("JMAP mutation failed", error);
+          status = toNsresult(error);
+        }
+      }
+
+      try {
+        listener?.OnStopRunningUrl(null, status);
+      } catch (error) {
+        log.error("JMAP mutation listener failed on stop", error);
+      }
+    })();
+  }
+
+  /** Replay an op from the offline queue. */
+  #replayOp({ kind, args }) {
+    return this.#runOp(kind, args);
+  }
+
+  /**
+   * @param {string} kind
+   * @param {Array} args
+   */
+  async #runOp(kind, args) {
+    const mail = await this.#getMailClient();
+    const mutator = new JmapMutator({ mail, logger: log });
+    switch (kind) {
+      case "setRead":
+        return mutator.setRead(args[0], args[1]);
+      case "setFlagged":
+        return mutator.setFlagged(args[0], args[1]);
+      case "setJunk":
+        return mutator.setJunk(args[0], args[1]);
+      case "destroy":
+        return mutator.destroy(args[0]);
+      case "move":
+        return mutator.move(args[0], args[1], args[2]);
+      case "copy": {
+        // Email/copy is only valid between accounts (RFC 8620 5.4). Within
+        // one account an email simply joins the destination mailbox too.
+        const [ids, toMailboxId] = args;
+        const emails = new JmapTypeClient(
+          mail.client,
+          "Email",
+          JmapCapability.Mail
+        );
+        const update = Object.fromEntries(
+          ids.map(id => [id, { [`mailboxIds/${toMailboxId}`]: true }])
+        );
+        return emails.set({ update });
+      }
+      case "setKeywords": {
+        const [ids, add, remove] = args;
+        const emails = new JmapTypeClient(
+          mail.client,
+          "Email",
+          JmapCapability.Mail
+        );
+        const patch = {};
+        for (const keyword of add) {
+          patch[`keywords/${keyword}`] = true;
+        }
+        for (const keyword of remove) {
+          patch[`keywords/${keyword}`] = null;
+        }
+        return emails.set({
+          update: Object.fromEntries(ids.map(id => [id, patch])),
+        });
+      }
+    }
+    throw new JmapError(`Unknown JMAP mutation ${kind}`);
+  }
+
+  /**
+   * Return a connected mail client, creating one if needed.
+   *
+   * @returns {Promise<JmapMailClient>}
+   */
+  async #getMailClient() {
+    if (this.#shutdown) {
+      throw new JmapError("JMAP client has been shut down");
+    }
+    if (this.#mail) {
+      return this.#mail;
+    }
+    if (!this.#connecting) {
+      this.#connecting = this.#connect().finally(() => {
+        this.#connecting = null;
+      });
+    }
+    return this.#connecting;
+  }
+
+  /**
+   * Create the JMAP session and mail client.
+   *
+   * @returns {Promise<JmapMailClient>}
+   */
+  async #connect() {
+    const server = this.#server;
+    if (!server) {
+      throw new JmapSessionError(
+        "JMAP client has not been initialized with an incoming server"
+      );
+    }
+
+    // Share the session with the address book, calendar, files and the
+    // outgoing server of the same account.
+    const client = await JmapAccountRegistry.getClient(server, {
+      signal: this.#abortController?.signal,
+    });
+    const mail = new JmapMailClient(client);
+
+    this.#client = client;
+    this.#mail = mail;
+
+    // Push notifications for this account (mail sync plus listeners from
+    // the address book, calendar and files code).
+    try {
+      JmapPush.start(server, client);
+    } catch (error) {
+      log.warn("Failed to start JMAP push", error);
+    }
+    // Contacts and calendars share this session; create them if missing.
+    JmapAccountServices.ensure(server, client).catch(error =>
+      log.warn("Failed to set up JMAP account services", error)
+    );
+    // Flush mutations queued while offline.
+    JmapOfflineQueue.replay(server.key).catch(error =>
+      log.warn("JMAP offline queue replay failed", error)
+    );
+    return mail;
+  }
+
+  /**
+   * Run a task while tracking it as an active operation.
+   *
+   * @param {Promise} task
+   */
+  #track(task) {
+    this.#activeOperations++;
+    task
+      .catch(error => log.error("JMAP operation failed", error))
+      .finally(() => {
+        this.#activeOperations--;
+      });
+  }
+
+  createMailbox(name, parentId, listener) {
+    this.#operation(listener, async () => {
+      const mailboxes = await this.#types("Mailbox", JmapCapability.Mail);
+      const created = await mailboxes.create({
+        name,
+        parentId: parentId || null,
+      });
+      return created.id;
+    });
+  }
+
+  updateMailbox(id, name, parentId, listener) {
+    this.#operation(listener, async () => {
+      const mailboxes = await this.#types("Mailbox", JmapCapability.Mail);
+      const patch = {};
+      if (name) {
+        patch.name = name;
+      }
+      if (parentId != "-") {
+        patch.parentId = parentId || null;
+      }
+      await mailboxes.update(id, patch);
+      return id;
+    });
+  }
+
+  destroyMailbox(id, removeEmails, listener) {
+    this.#operation(listener, async () => {
+      const mailboxes = await this.#types("Mailbox", JmapCapability.Mail);
+      await mailboxes.destroy([id], { onDestroyRemoveEmails: removeEmails });
+      return id;
+    });
+  }
+
+  emptyMailbox(id, listener) {
+    this.#operation(listener, async () => {
+      const emails = await this.#types("Email", JmapCapability.Mail);
+      const { ids } = await emails.queryAll({ inMailbox: id });
+      if (ids.length) {
+        // Emails that are also in other mailboxes only leave this one.
+        const mail = await this.#getMailClient();
+        await new JmapMutator({ mail, logger: log }).deleteFromMailbox(
+          ids,
+          id
+        );
+      }
+      return String(ids.length);
+    });
+  }
+
+  importMessage(file, mailboxIds, keywords, receivedAt, listener) {
+    this.#operation(listener, async () => {
+      const mail = await this.#getMailClient();
+      const client = mail.client;
+      const bytes = await IOUtils.read(file.path);
+      const accountId = client.getAccountId(JmapCapability.Mail);
+      const { blobId } = await client.upload(bytes, "message/rfc822", {
+        accountId,
+      });
+      const email = {
+        blobId,
+        mailboxIds: Object.fromEntries(mailboxIds.map(m => [m, true])),
+        keywords: Object.fromEntries(keywords.map(k => [k, true])),
+      };
+      if (receivedAt) {
+        email.receivedAt = new Date(receivedAt / 1000)
+          .toISOString()
+          .replace(/\.\d{3}Z$/, "Z");
+      }
+      const response = await client.call("Email/import", {
+        accountId,
+        emails: { new: email },
+      });
+      const created = response.args.created?.new;
+      if (!created) {
+        const failure = response.args.notCreated?.new;
+        throw new JmapError(
+          `Email/import failed: ${failure?.type ?? "unknown"} ${
+            failure?.description ?? ""
+          }`
+        );
+      }
+      return created.id;
+    });
+  }
+
+  setKeywords(ids, add, remove, listener) {
+    this.#track(
+      this.#mutate(listener, "setKeywords", [[...ids], [...add], [...remove]])
+    );
+  }
+
+  queryEmails(filterJSON, limit, listener) {
+    this.#operation(listener, async () => {
+      const emails = await this.#types("Email", JmapCapability.Mail);
+      const filter = filterJSON ? JSON.parse(filterJSON) : null;
+      const sort = [{ property: "receivedAt", isAscending: false }];
+      if (limit) {
+        const result = await emails.invoke("query", { filter, sort, limit });
+        return JSON.stringify(result.ids ?? []);
+      }
+      const { ids } = await emails.queryAll(filter, sort);
+      return JSON.stringify(ids);
+    });
+  }
+
+  getQuota(listener) {
+    this.#operation(listener, async () => {
+      const mail = await this.#getMailClient();
+      if (!mail.client.supports(JmapCapability.Quota)) {
+        return "[]";
+      }
+      const quotas = new JmapTypeClient(
+        mail.client,
+        "Quota",
+        JmapCapability.Quota
+      );
+      const { list } = await quotas.get(null);
+      return JSON.stringify(
+        list.map(q => ({
+          name: q.name ?? q.resourceType,
+          used: q.used ?? 0,
+          hardLimit: q.hardLimit ?? q.limit ?? 0,
+          resourceType: q.resourceType,
+          scope: q.scope,
+        }))
+      );
+    });
+  }
+
+  callMethod(method, argsJSON, listener) {
+    this.#operation(listener, async () => {
+      const mail = await this.#getMailClient();
+      const client = mail.client;
+      const args = argsJSON ? JSON.parse(argsJSON) : {};
+      if (!("accountId" in args)) {
+        const capability = capabilityForMethod(method);
+        args.accountId = client.getAccountId(
+          capability ?? JmapCapability.Mail
+        );
+      }
+      const response = await client.call(method, args);
+      return JSON.stringify(response.args);
+    });
+  }
+
+  /**
+   * Run an operation reporting to an `IJmapOperationListener`.
+   *
+   * @param {?IJmapOperationListener} listener
+   * @param {() => Promise<string>} task
+   */
+  #operation(listener, task) {
+    this.#track(
+      (async () => {
+        let result;
+        try {
+          result = await task();
+        } catch (error) {
+          log.error("JMAP operation failed", error);
+          try {
+            listener?.onFailure(toNsresult(error), String(error?.message ?? error));
+          } catch (e) {
+            log.error("JMAP operation listener failed", e);
+          }
+          return;
+        }
+        try {
+          listener?.onSuccess(String(result ?? ""));
+        } catch (e) {
+          log.error("JMAP operation listener failed", e);
+        }
+      })()
+    );
+  }
+
+  async #types(type, capability) {
+    const mail = await this.#getMailClient();
+    return new JmapTypeClient(mail.client, type, capability);
+  }
+
+  QueryInterface = ChromeUtils.generateQI(["IJmapClient"]);
+}
