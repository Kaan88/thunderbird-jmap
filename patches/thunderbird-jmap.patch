+add_task(function test_rrule_conversion() {
+  const rule = {
+    "@type": "RecurrenceRule",
+    frequency: "monthly",
+    interval: 2,
+    byDay: [{ "@type": "NDay", day: "fr", nthOfPeriod: -1 }],
+    until: "2024-12-31T23:59:59",
+  };
+  const rrule = recurrenceRuleToRRule(rule, null);
+  Assert.equal(rrule, "FREQ=MONTHLY;INTERVAL=2;BYDAY=-1FR;UNTIL=20241231T235959");
+  Assert.deepEqual(rruleToRecurrenceRule("RRULE:" + rrule, null), rule);
+
+  const zoned = recurrenceRuleToRRule(
+    { "@type": "RecurrenceRule", frequency: "daily", until: "2024-06-01T10:00:00" },
+    "Europe/Berlin"
+  );
+  Assert.equal(zoned, "FREQ=DAILY;UNTIL=20240601T080000Z");
+  Assert.equal(rruleToRecurrenceRule(zoned, "Europe/Berlin").until, "2024-06-01T10:00:00");
+});
