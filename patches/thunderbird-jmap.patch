diff --git a/mailnews/protocols/jmap/src/JmapSearch.cpp b/mailnews/protocols/jmap/src/JmapSearch.cpp
new file mode 100644
index 00000000000..0031ca9a16e
--- /dev/null
+++ b/mailnews/protocols/jmap/src/JmapSearch.cpp
@@ -0,0 +1,415 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "JmapSearch.h"
+
+#include "IJmapClient.h"
+#include "JmapListeners.h"
+#include "nsIMsgDatabase.h"
+#include "nsIMsgEnumerator.h"
+#include "nsIMsgFolder.h"
+#include "nsIMsgHdr.h"
+#include "nsIMsgSearchSession.h"
+#include "nsIMsgSearchValue.h"
+#include "nsIUrlListener.h"
+#include "nsMsgMessageFlags.h"
+#include "nsMsgSearchCore.h"
+#include "nsPrintfCString.h"
+#include "nsTHashMap.h"
+#include "prtime.h"
+
+namespace {
+
+constexpr PRTime kJmapSearchDay = PRTime(24) * 60 * 60 * PR_USEC_PER_SEC;
+
+void JmapFormatUTCDate(PRTime time, nsACString& out) {
+  PRExplodedTime exploded;
+  PR_ExplodeTime(time, PR_GMTParameters, &exploded);
+  out.Assign(nsPrintfCString("%04d-%02d-%02dT%02d:%02d:%02dZ",
+                             exploded.tm_year, exploded.tm_month + 1,
+                             exploded.tm_mday, exploded.tm_hour,
+                             exploded.tm_min, exploded.tm_sec));
+}
+
+/** `{"<property>":<json value>}` */
+void JmapFilterCondition(const char* property, const nsACString& jsonValue,
+               nsACString& out) {
+  out.AssignLiteral("{\"");
+  out.Append(property);
+  out.AppendLiteral("\":");
+  out.Append(jsonValue);
+  out.Append('}');
+}
+
+void JmapFilterStringCondition(const char* property, const nsACString& value,
+                     nsACString& out) {
+  nsAutoCString json;
+  JmapAppendJSONString(json, value);
+  JmapFilterCondition(property, json, out);
+}
+
+void JmapFilterDateCondition(const char* property, PRTime time, nsACString& out) {
+  nsAutoCString date;
+  JmapFormatUTCDate(time, date);
+  JmapFilterStringCondition(property, date, out);
+}
+
+/** `{"operator":"<op>","conditions":[a,b...]}` */
+void JmapFilterOperator(const char* op, const nsTArray<nsCString>& conditions,
+              nsACString& out) {
+  out.AssignLiteral("{\"operator\":\"");
+  out.Append(op);
+  out.AppendLiteral("\",\"conditions\":[");
+  for (size_t i = 0; i < conditions.Length(); i++) {
+    if (i) {
+      out.Append(',');
+    }
+    out.Append(conditions[i]);
+  }
+  out.AppendLiteral("]}");
+}
+
+void JmapFilterNegate(const nsACString& condition, nsACString& out) {
+  nsTArray<nsCString> conditions;
+  conditions.AppendElement(condition);
+  JmapFilterOperator("NOT", conditions, out);
+}
+
+/** The JMAP keyword matching a TB message status flag, or null. */
+const char* JmapKeywordForStatus(uint32_t status) {
+  switch (status) {
+    case nsMsgMessageFlags::Read:
+      return "$seen";
+    case nsMsgMessageFlags::Marked:
+      return "$flagged";
+    case nsMsgMessageFlags::Replied:
+      return "$answered";
+    case nsMsgMessageFlags::Forwarded:
+      return "$forwarded";
+    default:
+      return nullptr;
+  }
+}
+
+nsresult JmapTranslateSearchTerm(nsIMsgSearchTerm* term, nsACString& out) {
+  nsMsgSearchAttribValue attrib;
+  nsresult rv = term->GetAttrib(&attrib);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsMsgSearchOpValue op;
+  rv = term->GetOp(&op);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<nsIMsgSearchValue> value;
+  rv = term->GetValue(getter_AddRefs(value));
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(value, NS_ERROR_UNEXPECTED);
+
+  const char* textProperty = nullptr;
+  switch (attrib) {
+    case nsMsgSearchAttrib::Subject:
+      textProperty = "subject";
+      break;
+    case nsMsgSearchAttrib::Sender:
+      textProperty = "from";
+      break;
+    case nsMsgSearchAttrib::To:
+      textProperty = "to";
+      break;
+    case nsMsgSearchAttrib::CC:
+      textProperty = "cc";
+      break;
+    case nsMsgSearchAttrib::Body:
+      textProperty = "body";
+      break;
+    case nsMsgSearchAttrib::AnyText:
+      textProperty = "text";
+      break;
+    default:
+      break;
+  }
+
+  if (textProperty || attrib == nsMsgSearchAttrib::ToOrCC ||
+      attrib == nsMsgSearchAttrib::AllAddresses) {
+    nsAutoCString text;
+    rv = value->GetUtf8Str(text);
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    nsAutoCString positive;
+    if (textProperty) {
+      JmapFilterStringCondition(textProperty, text, positive);
+    } else {
+      nsTArray<nsCString> parts;
+      nsAutoCString part;
+      JmapFilterStringCondition("to", text, part);
+      parts.AppendElement(part);
+      JmapFilterStringCondition("cc", text, part);
+      parts.AppendElement(part);
+      if (attrib == nsMsgSearchAttrib::AllAddresses) {
+        JmapFilterStringCondition("from", text, part);
+        parts.AppendElement(part);
+        JmapFilterStringCondition("bcc", text, part);
+        parts.AppendElement(part);
+      }
+      JmapFilterOperator("OR", parts, positive);
+    }
+
+    switch (op) {
+      // Server text search is token based, so "is" and "begins with" are
+      // approximated by "contains".
+      case nsMsgSearchOp::Contains:
+      case nsMsgSearchOp::Is:
+      case nsMsgSearchOp::BeginsWith:
+      case nsMsgSearchOp::EndsWith:
+        out.Assign(positive);
+        return NS_OK;
+      case nsMsgSearchOp::DoesntContain:
+      case nsMsgSearchOp::Isnt:
+        JmapFilterNegate(positive, out);
+        return NS_OK;
+      default:
+        return NS_ERROR_NOT_IMPLEMENTED;
+    }
+  }
+
+  switch (attrib) {
+    case nsMsgSearchAttrib::Date: {
+      PRTime date = 0;
+      rv = value->GetDate(&date);
+      NS_ENSURE_SUCCESS(rv, rv);
+      switch (op) {
+        case nsMsgSearchOp::IsBefore:
+          JmapFilterDateCondition("before", date, out);
+          return NS_OK;
+        case nsMsgSearchOp::IsAfter:
+          JmapFilterDateCondition("after", date + kJmapSearchDay, out);
+          return NS_OK;
+        case nsMsgSearchOp::Is:
+        case nsMsgSearchOp::Isnt: {
+          nsTArray<nsCString> parts;
+          nsAutoCString part;
+          JmapFilterDateCondition("after", date, part);
+          parts.AppendElement(part);
+          JmapFilterDateCondition("before", date + kJmapSearchDay, part);
+          parts.AppendElement(part);
+          nsAutoCString sameDay;
+          JmapFilterOperator("AND", parts, sameDay);
+          if (op == nsMsgSearchOp::Is) {
+            out.Assign(sameDay);
+          } else {
+            JmapFilterNegate(sameDay, out);
+          }
+          return NS_OK;
+        }
+        default:
+          return NS_ERROR_NOT_IMPLEMENTED;
+      }
+    }
+
+    case nsMsgSearchAttrib::AgeInDays: {
+      int32_t age = 0;
+      rv = value->GetAge(&age);
+      NS_ENSURE_SUCCESS(rv, rv);
+      PRTime cutoff = PR_Now() - PRTime(age) * kJmapSearchDay;
+      switch (op) {
+        case nsMsgSearchOp::IsLessThan:
+          JmapFilterDateCondition("after", cutoff, out);
+          return NS_OK;
+        case nsMsgSearchOp::IsGreaterThan:
+          JmapFilterDateCondition("before", cutoff, out);
+          return NS_OK;
+        default:
+          return NS_ERROR_NOT_IMPLEMENTED;
+      }
+    }
+
+    case nsMsgSearchAttrib::MsgStatus: {
+      uint32_t status = 0;
+      rv = value->GetStatus(&status);
+      NS_ENSURE_SUCCESS(rv, rv);
+      const char* keyword = JmapKeywordForStatus(status);
+      if (!keyword) {
+        return NS_ERROR_NOT_IMPLEMENTED;
+      }
+      if (op == nsMsgSearchOp::Is) {
+        JmapFilterStringCondition("hasKeyword", nsDependentCString(keyword), out);
+      } else if (op == nsMsgSearchOp::Isnt) {
+        JmapFilterStringCondition("notKeyword", nsDependentCString(keyword), out);
+      } else {
+        return NS_ERROR_NOT_IMPLEMENTED;
+      }
+      return NS_OK;
+    }
+
+    case nsMsgSearchAttrib::Keywords: {
+      nsAutoCString keyword;
+      rv = value->GetUtf8Str(keyword);
+      NS_ENSURE_SUCCESS(rv, rv);
+      switch (op) {
+        case nsMsgSearchOp::Contains:
+        case nsMsgSearchOp::Is:
+          JmapFilterStringCondition("hasKeyword", keyword, out);
+          return NS_OK;
+        case nsMsgSearchOp::DoesntContain:
+        case nsMsgSearchOp::Isnt:
+          JmapFilterStringCondition("notKeyword", keyword, out);
+          return NS_OK;
+        default:
+          return NS_ERROR_NOT_IMPLEMENTED;
+      }
+    }
+
+    case nsMsgSearchAttrib::Size: {
+      // The search UI takes sizes in KB.
+      uint32_t size = 0;
+      rv = value->GetSize(&size);
+      NS_ENSURE_SUCCESS(rv, rv);
+      nsAutoCString bytes;
+      bytes.AppendInt(uint64_t(size) * 1024);
+      switch (op) {
+        case nsMsgSearchOp::IsGreaterThan:
+          JmapFilterCondition("minSize", bytes, out);
+          return NS_OK;
+        case nsMsgSearchOp::IsLessThan:
+          JmapFilterCondition("maxSize", bytes, out);
+          return NS_OK;
+        default:
+          return NS_ERROR_NOT_IMPLEMENTED;
+      }
+    }
+
+    default:
+      return NS_ERROR_NOT_IMPLEMENTED;
+  }
+}
+
+/** Reports server hits to the search session. */
+nsresult JmapReportSearchHits(nsIMsgSearchSession* session, nsIMsgFolder* folder,
+                          const nsTArray<nsCString>& ids) {
+  nsTHashMap<nsCStringHashKey, bool> wanted;
+  for (const auto& id : ids) {
+    wanted.InsertOrUpdate(id, true);
+  }
+  if (wanted.IsEmpty()) {
+    return NS_OK;
+  }
+
+  nsCOMPtr<nsIMsgDatabase> db;
+  nsresult rv = folder->GetMsgDatabase(getter_AddRefs(db));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<nsIMsgEnumerator> enumerator;
+  rv = db->EnumerateMessages(getter_AddRefs(enumerator));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  bool hasMore = false;
+  while (NS_SUCCEEDED(enumerator->HasMoreElements(&hasMore)) && hasMore) {
+    nsCOMPtr<nsIMsgDBHdr> header;
+    if (NS_FAILED(enumerator->GetNext(getter_AddRefs(header))) || !header) {
+      continue;
+    }
+    nsCString id;
+    if (NS_SUCCEEDED(header->GetStringProperty("jmapId", id)) &&
+        wanted.Contains(id)) {
+      session->AddSearchHit(header, folder);
+    }
+  }
+  return NS_OK;
+}
+
+}  // namespace
+
+nsresult JmapBuildSearchFilter(const nsTArray<RefPtr<nsIMsgSearchTerm>>& terms,
+                               const nsACString& mailboxId,
+                               nsACString& filterJSON) {
+  nsAutoCString combined;
+  bool first = true;
+  for (nsIMsgSearchTerm* term : terms) {
+    nsAutoCString condition;
+    nsresult rv = JmapTranslateSearchTerm(term, condition);
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    if (first) {
+      combined.Assign(condition);
+      first = false;
+      continue;
+    }
+
+    bool booleanAnd = true;
+    term->GetBooleanAnd(&booleanAnd);
+    nsTArray<nsCString> parts;
+    parts.AppendElement(combined);
+    parts.AppendElement(condition);
+    JmapFilterOperator(booleanAnd ? "AND" : "OR", parts, combined);
+  }
+
+  if (!mailboxId.IsEmpty()) {
+    nsAutoCString inMailbox;
+    JmapFilterStringCondition("inMailbox", mailboxId, inMailbox);
+    if (first) {
+      combined.Assign(inMailbox);
+    } else {
+      nsTArray<nsCString> parts;
+      parts.AppendElement(inMailbox);
+      parts.AppendElement(combined);
+      JmapFilterOperator("AND", parts, combined);
+    }
+  } else if (first) {
+    combined.AssignLiteral("{}");
+  }
+
+  filterJSON.Assign(combined);
+  return NS_OK;
+}
+
+nsresult JmapRunServerSearch(nsIMsgSearchSession* session,
+                             nsIMsgFolder* folder) {
+  NS_ENSURE_ARG_POINTER(session);
+  NS_ENSURE_ARG_POINTER(folder);
+
+  nsCOMPtr<nsIUrlListener> sessionListener = do_QueryInterface(session);
+
+  auto finish = [sessionListener](nsresult status) {
+    if (sessionListener) {
+      sessionListener->OnStopRunningUrl(nullptr, status);
+    }
+    return NS_OK;
+  };
+
+  nsTArray<RefPtr<nsIMsgSearchTerm>> terms;
+  nsresult rv = session->GetSearchTerms(terms);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCString mailboxId;
+  folder->GetStringProperty("jmapId", mailboxId);
+
+  nsAutoCString filter;
+  rv = JmapBuildSearchFilter(terms, mailboxId, filter);
+  if (NS_FAILED(rv)) {
+    // The session expects completion through its URL listener even when the
+    // query could not be expressed.
+    finish(rv);
+    return NS_OK;
+  }
+
+  nsCOMPtr<IJmapClient> client;
+  rv = JmapClientForFolder(folder, getter_AddRefs(client));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<nsIMsgSearchSession> sessionRef = session;
+  nsCOMPtr<nsIMsgFolder> folderRef = folder;
+  RefPtr<JmapOperationListener> listener = new JmapOperationListener(
+      [sessionRef, folderRef, finish](const nsACString& result) {
+        nsTArray<nsCString> ids;
+        JmapParseIdArray(result, ids);
+        nsresult rv = JmapReportSearchHits(sessionRef, folderRef, ids);
+        return finish(rv);
+      },
+      [finish](nsresult status, const nsACString&) { return finish(status); });
+
+  if (sessionListener) {
+    sessionListener->OnStartRunningUrl(nullptr);
+  }
+  return client->QueryEmails(filter, 0, listener);
+}
