+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "JmapFetchMsgsToOffline.h"
+
+#include <utility>
+
+#include "IJmapClient.h"
+#include "IJmapIncomingServer.h"
+#include "MailNewsTypes.h"
+#include "mozilla/RefPtr.h"
+#include "nsCOMPtr.h"
+#include "nsDebug.h"
+#include "nsError.h"
+#include "nsIInputStream.h"
+#include "nsIMsgFolder.h"
+#include "nsIMsgHdr.h"
+#include "nsIMsgIncomingServer.h"
+#include "nsIMsgPluggableStore.h"
+#include "nsIOutputStream.h"
+#include "nsMsgMessageFlags.h"
+#include "nsMsgUtils.h"
+#include "nsThreadUtils.h"
+
+namespace {
+
+/** Header property holding the JMAP email id of a message. */
+constexpr auto kJmapIdProperty = "jmapId";
+
+/**
+ * Helper class for JmapFetchMsgsToOffline().
+ *
+ * It calls `IJmapClient.getMessage()` to download each message in turn,
+ * passing itself as a listener. As data arrives it is written to the local
+ * message store. On completion the database entry is updated with the store
+ * token, the offline size and the `Offline` flag.
+ */
+class MsgFetcher : public IJmapMessageFetchListener {
+ public:
+  NS_DECL_ISUPPORTS
+
+  MsgFetcher() = default;
+  MsgFetcher(nsIMsgFolder* folder, nsTArray<nsMsgKey> const& msgKeys,
+             std::function<void(nsresult)> onDone)
+      : mFolder(folder),
+        mMsgKeys(msgKeys.Length()),
+        mDoneFn(std::move(onDone)) {
+    MOZ_ASSERT(mFolder);
+    // Keys are popped off the end, so reverse the list to preserve order.
+    for (auto it = msgKeys.rbegin(); it != msgKeys.rend(); ++it) {
+      mMsgKeys.AppendElement(*it);
+    }
+  }
+
+  nsresult Go() {
+    if (mMsgKeys.IsEmpty()) {
+      if (mDoneFn) {
+        NS_DispatchToCurrentThread(NS_NewRunnableFunction(
+            "MsgFetcher no-op",
+            [self = RefPtr(this)] { self->mDoneFn(NS_OK); }));
+      }
+      return NS_OK;
+    }
+    return StartNext();
+  }
+
+  NS_IMETHOD OnFetchedDataAvailable(nsIInputStream* inputStream) override {
+    nsresult rv = EnsureOutputStream();
+    NS_ENSURE_SUCCESS(rv, rv);
+    uint64_t bytesCopied;
+    rv = SyncCopyStream(inputStream, mOut, bytesCopied);
+    NS_ENSURE_SUCCESS(rv, rv);
+    mMsgSize += bytesCopied;
+    return NS_OK;
+  }
+
+  NS_IMETHOD OnFetchStop(nsresult status) override {
+    nsresult rv;
+
+    nsMsgKey msgKey = mMsgKeys.PopLastElement();
+
+    nsCOMPtr<nsIMsgPluggableStore> store;
+    rv = mFolder->GetMsgStore(getter_AddRefs(store));
+    if (NS_FAILED(rv)) {
+      status = rv;
+    }
+
+    if (NS_FAILED(status)) {
+      if (mOut && store) {
+        store->DiscardNewMessage(mFolder, mOut);
+      }
+    } else {
+      rv = EnsureOutputStream();
+
+      nsAutoCString storeToken;
+      if (NS_SUCCEEDED(rv)) {
+        rv = store->FinishNewMessage(mFolder, mOut, storeToken);
+      }
+
+      nsCOMPtr<nsIMsgDBHdr> msgHdr;
+      if (NS_SUCCEEDED(rv)) {
+        rv = mFolder->GetMsgHdr(msgKey, getter_AddRefs(msgHdr));
+      }
+      if (NS_SUCCEEDED(rv) && !msgHdr) {
+        rv = NS_MSG_MESSAGE_NOT_FOUND;
+      }
+
+      if (NS_SUCCEEDED(rv)) {
+        rv = msgHdr->SetStoreToken(storeToken);
+      }
+      if (NS_SUCCEEDED(rv)) {
+        rv = msgHdr->SetOfflineMessageSize(mMsgSize);
+      }
+      if (NS_SUCCEEDED(rv)) {
+        uint32_t unused;
+        rv = msgHdr->OrFlags(nsMsgMessageFlags::Offline, &unused);
+      }
+
+      status = rv;
+    }
+
+    mOut = nullptr;
+    mMsgSize = 0;
+
+    if (NS_SUCCEEDED(status) && !mMsgKeys.IsEmpty()) {
+      status = StartNext();
+    }
+
+    if (NS_FAILED(status) || mMsgKeys.IsEmpty()) {
+      if (mDoneFn) {
+        mDoneFn(status);
+      }
+    }
+    return NS_OK;
+  }
+
+ protected:
+  virtual ~MsgFetcher() = default;
+
+  nsresult EnsureOutputStream() {
+    if (mOut) {
+      return NS_OK;
+    }
+    nsCOMPtr<nsIMsgPluggableStore> store;
+    nsresult rv = mFolder->GetMsgStore(getter_AddRefs(store));
+    NS_ENSURE_SUCCESS(rv, rv);
+    return store->GetNewMsgOutputStream(mFolder, getter_AddRefs(mOut));
+  }
+
+  nsresult StartNext() {
+    nsresult rv;
+
+    MOZ_ASSERT(!mMsgKeys.IsEmpty());
+    nsMsgKey msgKey = mMsgKeys.LastElement();
+
+    nsCOMPtr<nsIMsgDBHdr> msgHdr;
+    rv = mFolder->GetMsgHdr(msgKey, getter_AddRefs(msgHdr));
+    NS_ENSURE_SUCCESS(rv, rv);
+    NS_ENSURE_TRUE(msgHdr, NS_MSG_MESSAGE_NOT_FOUND);
+
+    nsCOMPtr<nsIMsgIncomingServer> server;
+    rv = mFolder->GetServer(getter_AddRefs(server));
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    nsCOMPtr<IJmapIncomingServer> jmapServer =
+        do_QueryInterface(server, &rv);
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    nsCOMPtr<IJmapClient> client;
+    rv = jmapServer->GetProtocolClient(getter_AddRefs(client));
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    nsCString emailId;
+    rv = msgHdr->GetStringProperty(kJmapIdProperty, emailId);
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    return client->GetMessage(this, emailId);
+  }
+
+  nsCOMPtr<nsIMsgFolder> mFolder;
+  nsTArray<nsMsgKey> mMsgKeys;
+  std::function<void(nsresult status)> mDoneFn;
+  nsCOMPtr<nsIOutputStream> mOut;
+  uint64_t mMsgSize{0};
+};
+
+NS_IMPL_ISUPPORTS(MsgFetcher, IJmapMessageFetchListener)
+
+}  // namespace
+
+nsresult JmapFetchMsgsToOffline(nsIMsgFolder* folder,
+                                nsTArray<nsMsgKey> const& msgKeys,
+                                std::function<void(nsresult)> onDone) {
+  RefPtr<MsgFetcher> fetcher = new MsgFetcher(folder, msgKeys, onDone);
+  return fetcher->Go();
+}
