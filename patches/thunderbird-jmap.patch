+/**
+ * One JMAP session per Thunderbird JMAP incoming server, shared by the mail
+ * folders, the outgoing server, the address book, the calendar provider and
+ * the file storage UI. Keyed by incoming server key.
+ */
+
+import {
+  JmapClient,
+  getWellKnownSessionUrl,
+} from "resource:///modules/jmap/JmapClient.sys.mjs";
+import { JmapTransport } from "resource:///modules/jmap/JmapTransport.sys.mjs";
+import { JmapTypeClient } from "resource:///modules/jmap/JmapTypeClient.sys.mjs";
+import { getAuthHeaders } from "resource:///modules/jmap/JmapAuth.sys.mjs";
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  MailServices: "resource:///modules/MailServices.sys.mjs",
+});
+
+const log = console.createInstance({
+  prefix: "jmap",
+  maxLogLevel: "Warn",
+  maxLogLevelPref: "mail.jmap.loglevel",
+});
+
+/** @type {Map<string, Promise<JmapClient>>} */
+const sessions = new Map();
+
+export const JmapAccountRegistry = {
+  /**
+   * Get (connecting if needed) the shared session for an incoming server.
+   *
+   * @param {nsIMsgIncomingServer|string} serverOrKey
+   * @param {object} [options]
+   * @param {AbortSignal} [options.signal]
+   * @returns {Promise<JmapClient>}
+   */
+  getClient(serverOrKey, { signal } = {}) {
+    const server =
+      typeof serverOrKey == "string"
+        ? lazy.MailServices.accounts.getIncomingServer(serverOrKey)
+        : serverOrKey;
+    if (server.type != "jmap") {
+      throw new Error(`Server ${server.key} is not a JMAP server`);
+    }
+    let pending = sessions.get(server.key);
+    if (!pending) {
+      pending = this.connect(server, { signal });
+      sessions.set(server.key, pending);
+      // A failed connection must not be cached.
+      pending.catch(() => {
+        if (sessions.get(server.key) === pending) {
+          sessions.delete(server.key);
+        }
+      });
+    }
+    return pending;
+  },
+
+  /** Create a new, unshared session. */
+  async connect(server, { signal } = {}) {
+    let sessionUrl = "";
+    try {
+      sessionUrl = server.getStringValue("jmap_session_url");
+    } catch (e) {}
+    sessionUrl ||= getWellKnownSessionUrl(server.hostName);
+    const transport = new JmapTransport({
+      getAuthHeaders: () => getAuthHeaders(server),
+      logger: log,
+    });
+    return JmapClient.connect({ transport, sessionUrl, logger: log, signal });
+  },
+
+  /** Get a {@link JmapTypeClient} for a data type on a server's session. */
+  async getTypeClient(serverOrKey, type, capability, accountId) {
+    const client = await this.getClient(serverOrKey);
+    return new JmapTypeClient(client, type, capability, accountId);
+  },
+
+  /** Drop a cached session (on shutdown, password change or removal). */
+  forget(serverKey) {
+    sessions.delete(serverKey);
+  },
+
+  /** All JMAP incoming servers in the profile. */
+  get servers() {
+    return lazy.MailServices.accounts.allServers.filter(s => s.type == "jmap");
+  },
+};
diff --git a/mailnews/protocols/jmap/modules/JmapAccountServices.sys.mjs b/mailnews/protocols/jmap/modules/JmapAccountServices.sys.mjs
new file mode 100644
index 00000000000..e39b922b7c8
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapAccountServices.sys.mjs
@@ -0,0 +1,147 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Lifecycle glue between a JMAP mail account and the other Thunderbird
+ * components that use the same JMAP session: address books, calendars and
+ * file storage.
+ *
+ * - After an account first connects in a session, its address books and
+ *   calendars are created or refreshed (so books/calendars added on the
+ *   server later also show up).
+ * - When the account is removed, they are removed too, and cached sessions
+ *   are dropped.
+ *
+ * Every component is optional: a missing module or capability is logged and
+ * skipped.
+ */
+
+import { JmapAccountRegistry } from "resource:///modules/jmap/JmapAccountRegistry.sys.mjs";
+import { JmapCapability } from "resource:///modules/jmap/JmapConstants.sys.mjs";
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  MailServices: "resource:///modules/MailServices.sys.mjs",
+});
+
+const log = console.createInstance({
+  prefix: "mail.jmap",
+  maxLogLevel: "Warn",
+  maxLogLevelPref: "mail.jmap.loglevel",
+});
+
+const ADDRESS_BOOK_MODULE = "resource:///modules/JmapDirectory.sys.mjs";
+const CALENDAR_MODULE = "resource:///modules/CalJmapProvider.sys.mjs";
+const FILES_MODULE = "resource:///modules/jmapfiles/JmapFiles.sys.mjs";
+
+/** Server keys already set up in this session. */
+const ensured = new Set();
+let observing = false;
+
+function importOptional(url) {
+  try {
+    return ChromeUtils.importESModule(url);
+  } catch (e) {
+    log.debug(`Optional JMAP component ${url} is not available`, e);
+    return null;
+  }
+}
+
+export const JmapAccountServices = {
+  /**
+   * Make sure contacts and calendars of a connected account are present.
+   * Called after each successful connect; runs once per session per account.
+   *
+   * @param {nsIMsgIncomingServer} server
+   * @param {JmapClient} client - Connected session, used to check
+   *   capabilities without another request.
+   */
+  async ensure(server, client) {
+    this.observeRemovals();
+    if (ensured.has(server.key)) {
+      return;
+    }
+    ensured.add(server.key);
+
+    if (client.supports(JmapCapability.Contacts)) {
+      try {
+        const mod = importOptional(ADDRESS_BOOK_MODULE);
+        await mod?.JmapDirectory?.createForServer(server.key);
+      } catch (e) {
+        log.warn(`Could not set up JMAP address books for ${server.key}`, e);
+      }
+    }
+    if (client.supports(JmapCapability.Calendars)) {
+      try {
+        const mod = importOptional(CALENDAR_MODULE);
+        await mod?.createJmapCalendarsForServer?.(server.key);
+      } catch (e) {
+        log.warn(`Could not set up JMAP calendars for ${server.key}`, e);
+      }
+    }
+  },
+
+  /** Register the account-removal observer once. */
+  observeRemovals() {
+    if (observing) {
+      return;
+    }
+    observing = true;
+    Services.obs.addObserver(this, "message-server-removed");
+  },
+
+  /**
+   * Remove everything that belongs to a JMAP account.
+   *
+   * @param {string} serverKey
+   */
+  removeServer(serverKey) {
+    ensured.delete(serverKey);
+
+    for (const dir of lazy.MailServices.ab.directories) {
+      try {
+        if (dir.getStringValue("jmap.serverKey", "") == serverKey) {
+          lazy.MailServices.ab.deleteAddressBook(dir.URI);
+        }
+      } catch (e) {
+        log.warn(`Could not remove JMAP address book ${dir.dirName}`, e);
+      }
+    }
+
+    try {
+      importOptional(CALENDAR_MODULE)?.removeJmapCalendarsForServer?.(
+        serverKey
+      );
+    } catch (e) {
+      log.warn(`Could not remove JMAP calendars for ${serverKey}`, e);
+    }
+
+    try {
+      importOptional(FILES_MODULE)?.JmapFiles?.forget(serverKey);
+    } catch (e) {
+      log.warn(`Could not drop JMAP files for ${serverKey}`, e);
+    }
+
+    try {
+      const { JmapPush } = ChromeUtils.importESModule(
+        "resource:///modules/jmap/JmapPush.sys.mjs"
+      );
+      JmapPush.stop(serverKey);
+    } catch (e) {}
+
+    JmapAccountRegistry.forget(serverKey);
+  },
+
+  observe(subject, topic) {
+    if (topic != "message-server-removed") {
+      return;
+    }
+    const server = subject.QueryInterface(Ci.nsIMsgIncomingServer);
+    if (server.type == "jmap") {
+      this.removeServer(server.key);
+    }
+  },
+
+  QueryInterface: ChromeUtils.generateQI(["nsIObserver"]),
+};
diff --git a/mailnews/protocols/jmap/modules/JmapAuth.sys.mjs b/mailnews/protocols/jmap/modules/JmapAuth.sys.mjs
new file mode 100644
index 00000000000..b0890974e80
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapAuth.sys.mjs
@@ -0,0 +1,131 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { JmapAuthError } from "resource:///modules/jmap/JmapErrors.sys.mjs";
+import { MailStringUtils } from "resource:///modules/MailStringUtils.sys.mjs";
+import { OAuth2Module } from "resource:///modules/OAuth2Module.sys.mjs";
+
+const log = console.createInstance({
+  prefix: "mail.jmap",
+  maxLogLevel: "Warn",
+  maxLogLevelPref: "mail.jmap.loglevel",
+});
+
+/**
+ * Produce the `Authorization` header for a request to a JMAP server.
+ *
+ * OAuth2 accounts use a bearer token obtained from the account's OAuth2
+ * configuration. All other accounts fall back to HTTP Basic authentication
+ * with the password stored in the login manager.
+ *
+ * The function is called for every request rather than once per session, so
+ * expired OAuth2 tokens are refreshed transparently.
+ *
+ * @param {nsIMsgIncomingServer} incomingServer
+ * @returns {Promise<?object>} An object of headers, or null when the account
+ *   has no credentials to send.
+ * @throws {JmapAuthError} If credentials are configured but cannot be
+ *   obtained.
+ */
+export async function getAuthHeaders(incomingServer) {
+  if (!incomingServer) {
+    throw new JmapAuthError("No incoming server for JMAP authentication", {
+      status: 401,
+    });
+  }
+
+  if (incomingServer.authMethod == Ci.nsMsgAuthMethod.OAuth2) {
+    const token = await getOAuth2AccessToken(incomingServer);
+    return { Authorization: `Bearer ${token}` };
+  }
+
+  const password = getPassword(incomingServer);
+  if (!password) {
+    return null;
+  }
+
+  const username = incomingServer.username ?? "";
+  const credentials = MailStringUtils.stringToByteString(
+    `${username}:${password}`
+  );
+  return { Authorization: `Basic ${btoa(credentials)}` };
+}
+
+/**
+ * Read the account password without letting a login failure abort the
+ * request. An empty password is handled by the caller as "no credentials".
+ *
+ * @param {nsIMsgIncomingServer} incomingServer
+ * @returns {string}
+ */
+function getPassword(incomingServer) {
+  try {
+    return incomingServer.password ?? "";
+  } catch (error) {
+    log.warn("failed to read the JMAP account password", error);
+    return "";
+  }
+}
+
+/**
+ * Request a raw OAuth2 access token for an account.
+ *
+ * @param {nsIMsgIncomingServer} incomingServer
+ * @returns {Promise<string>}
+ * @throws {JmapAuthError}
+ */
+function getOAuth2AccessToken(incomingServer) {
+  return new Promise((resolve, reject) => {
+    const module = new OAuth2Module();
+    let initialized = false;
+    try {
+      initialized = module.initFromMail(incomingServer);
+    } catch (error) {
+      reject(
+        new JmapAuthError(
+          "Failed to read the OAuth2 configuration for this account",
+          { status: 401, cause: error }
+        )
+      );
+      return;
+    }
+    if (!initialized) {
+      reject(
+        new JmapAuthError(
+          "This account has no usable OAuth2 configuration for JMAP",
+          { status: 401 }
+        )
+      );
+      return;
+    }
+
+    const listener = {
+      QueryInterface: ChromeUtils.generateQI(["msgIOAuth2ModuleListener"]),
+      onSuccess(token) {
+        resolve(token);
+      },
+      onFailure(error) {
+        reject(
+          new JmapAuthError("OAuth2 authentication failed for JMAP", {
+            status: 401,
+            cause: new Error(
+              `nsresult 0x${(error >>> 0).toString(16).padStart(8, "0")}`
+            ),
+          })
+        );
+      },
+    };
+
+    try {
+      module.getAccessToken(listener);
+    } catch (error) {
+      reject(
+        new JmapAuthError("Failed to request an OAuth2 access token", {
+          status: 401,
+          cause: error,
+        })
+      );
+    }
+  });
+}
diff --git a/mailnews/protocols/jmap/modules/JmapClient.sys.mjs b/mailnews/protocols/jmap/modules/JmapClient.sys.mjs
new file mode 100644
index 00000000000..499664bb9d9
--- /dev/null
+++ b/mailnews/protocols/jmap/modules/JmapClient.sys.mjs
@@ -0,0 +1,771 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import {
+  JmapCapability,
+  JmapRequestErrorType,
+  capabilityForMethod,
+} from "resource:///modules/jmap/JmapConstants.sys.mjs";
+import {
+  JmapCapabilityError,
+  JmapError,
+  JmapMethodError,
+  JmapNetworkError,
+  JmapRequestError,
+  JmapSessionError,
+} from "resource:///modules/jmap/JmapErrors.sys.mjs";
+
+/** Path of the session resource, relative to the server origin. */
+const WELL_KNOWN_PATH = "/.well-known/jmap";
+
+/**
+ * Timeout for blob uploads and downloads. Message bodies and attachments can
+ * be much larger than API requests, so they get a longer budget than the
+ * transport default.
+ */
+const TRANSFER_TIMEOUT_MS = 120000;
+
+/**
+ * Build the well-known session URL for a server.
+ *
+ * RFC 8620 section 2.1 requires the session resource to be discoverable at
+ * `https://<host>/.well-known/jmap`. Servers commonly redirect that URL to
+ * the actual session resource; `fetch` follows the redirect.
+ *
+ * @param {string|URL} serverUrl - Server origin, for example
+ *   `https://api.example.com` or an email address domain.
+ * @returns {string}
+ */
+export function getWellKnownSessionUrl(serverUrl) {
+  let url;
+  try {
+    url = new URL(serverUrl);
+  } catch {
+    url = new URL(`https://${serverUrl}`);
+  }
+  return new URL(WELL_KNOWN_PATH, url.origin).toString();
+}
+
+/**
+ * Expand the simple `{name}` placeholders used in JMAP URL templates.
+ *
+ * RFC 8620 uses a small subset of RFC 6570. Only simple string expansion is
+ * needed by the standard upload and download URLs.
+ *
+ * @param {string} template
+ * @param {object} variables
+ * @returns {string}
+ */
+export function expandUrlTemplate(template, variables) {
+  return template.replace(/\{([^{}]+)\}/g, (match, name) => {
+    if (!Object.hasOwn(variables, name)) {
+      return match;
+    }
+    const value = variables[name];
+    return value === undefined || value === null
+      ? ""
+      : encodeURIComponent(String(value));
+  });
+}
+
+/**
+ * Verify that a session-provided URL is safe to send credentials to.
+ *
+ * JMAP is an HTTPS protocol. Plain HTTP is only tolerated for loopback
+ * addresses, which keeps local test servers (and `localhost` development
+ * setups) working without weakening the guarantee for real accounts.
+ *
+ * @param {string} value
+ * @param {string} name - Property name, used in error messages.
+ * @throws {JmapSessionError} If the URL is malformed or insecure.
+ */
+function assertSecureUrl(value, name) {
+  let url;
+  try {
+    url = new URL(value);
+  } catch {
+    throw new JmapSessionError(`${name} is not a valid URL: ${value}`);
+  }
+  if (url.protocol === "https:") {
+    return;
+  }
+  if (url.protocol === "http:" && isLoopbackHost(url.hostname)) {
+    return;
+  }
+  throw new JmapSessionError(`${name} must use HTTPS: ${value}`);
+}
+
+/**
+ * @param {string} hostname
+ * @returns {boolean}
+ */
+function isLoopbackHost(hostname) {
+  return (
+    hostname === "localhost" ||
+    hostname === "127.0.0.1" ||
+    hostname === "::1" ||
+    hostname === "[::1]"
+  );
+}
+
+/**
+ * Client for the JMAP core protocol (RFC 8620).
+ *
+ * A client is bound to one session and one transport. It is safe to reuse it
+ * for the lifetime of an account; it serialises requests according to the
+ * server's `maxConcurrentRequests` limit and keeps track of the session state.
+ */
+export class JmapClient {
+  #transport;
+  #session = null;
+  #sessionState = null;
+  #onSessionStateChange;
+  #logger;
+  #activeRequests = 0;
+  #waiters = [];
+
+  /**
+   * @param {object} options
+   * @param {import("resource:///modules/jmap/JmapTransport.sys.mjs").JmapTransport} options.transport
+   * @param {Function} [options.onSessionStateChange] - Called with
+   *   `(newState, oldState)` when a response reports a new session state.
+   * @param {Console} [options.logger]
+   */
+  constructor({ transport, onSessionStateChange = null, logger = null }) {
+    if (!transport || typeof transport.request != "function") {
+      throw new TypeError("JmapClient requires a JMAP transport");
+    }
+    this.#transport = transport;
+    this.#onSessionStateChange = onSessionStateChange;
+    this.#logger = logger;
+  }
+
+  /**
+   * Create a client from a session document or by fetching a session URL.
+   *
+   * @param {object} options
+   * @param {import("resource:///modules/jmap/JmapTransport.sys.mjs").JmapTransport} options.transport
+   * @param {object} [options.session] - Already fetched session document.
+   * @param {string} [options.sessionUrl] - Session URL to fetch.
+   * @param {Function} [options.onSessionStateChange]
+   * @param {Console} [options.logger]
+   * @param {AbortSignal} [options.signal] - Only used while fetching.
+   * @returns {Promise<JmapClient>}
+   */
+  static async connect({
+    transport,
+    session = null,
+    sessionUrl = null,
+    onSessionStateChange = null,
+    logger = null,
+    signal,
+  }) {
+    if (session && sessionUrl) {
+      throw new JmapError("Pass either session or sessionUrl, not both");
+    }
+    if (!session && !sessionUrl) {
+      throw new JmapError("A session or a session URL is required");
+    }
+
+    const client = new JmapClient({
+      transport,
+      onSessionStateChange,
+      logger,
+    });
+    if (session) {
+      client.setSession(session);
+    } else {
+      await client.fetchSession(sessionUrl, { signal });
+    }
+    return client;
+  }
+
+  /**
+   * Fetch and install a session document.
+   *
+   * @param {string} sessionUrl
+   * @param {object} [options]
+   * @param {AbortSignal} [options.signal]
+   * @returns {Promise<object>} The session document.
+   */
+  async fetchSession(sessionUrl, { signal } = {}) {
+    const { body } = await this.#transport.request(sessionUrl, {
+      method: "GET",
+      headers: { Accept: "application/json" },
+      signal,
+    });
+    this.setSession(body);
+    return body;
+  }
+
+  /**
+   * Validate and install a session document.
+   *
+   * @param {object} session
+   * @returns {JmapClient}
+   * @throws {JmapSessionError} If the document is not a usable JMAP session.
+   * @throws {JmapCapabilityError} If the core capability is missing.
+   */
+  setSession(session) {
+    if (!session || typeof session != "object" || Array.isArray(session)) {
+      throw new JmapSessionError("JMAP session is not an object");
+    }
+
+    const core = session.capabilities?.[JmapCapability.Core];
+    if (!core) {
+      throw new JmapCapabilityError(
+        "Server does not advertise the JMAP core capability",
+        { capability: JmapCapability.Core }
+      );
+    }
+    if (!Array.isArray(core.versions) || core.versions.length == 0) {
+      // RFC 8620 requires `versions`, but some servers (notably Stalwart)
+      // omit it. Treat the capability as JMAP 1.0 rather than refusing to
+      // connect.
+      core.versions = ["1.0"];
+    }
+    if (typeof session.apiUrl != "string" || !session.apiUrl) {
+      throw new JmapSessionError("JMAP session is missing apiUrl");
+    }
+    assertSecureUrl(session.apiUrl, "apiUrl");
+    if (!session.accounts || typeof session.accounts != "object") {
+      throw new JmapSessionError("JMAP session is missing accounts");
+    }
+    if (
+      !session.primaryAccounts ||
+      typeof session.primaryAccounts != "object"
+    ) {
+      // Defensive: derive the primary account from each account's advertised
+      // capabilities when the server omits `primaryAccounts`.
+      const primaryAccounts = {};
+      for (const [accountId, account] of Object.entries(
+        session.accounts ?? {}
+      )) {
+        for (const capability of Object.keys(
+          account?.accountCapabilities ?? {}
+        )) {
+          primaryAccounts[capability] ??= accountId;
+        }
+      }
+      session.primaryAccounts = primaryAccounts;
+    }
+
+    this.#session = session;
+    this.#sessionState = session.state ?? null;
+    return this;
+  }
+
+  /**
+   * The raw session document.
+   *
+   * @returns {object}
+   */
+  get session() {
+    return this.#session;
+  }
+
+  /**
+   * The most recent session state seen by this client.
+   *
+   * @returns {?string}
+   */
+  get sessionState() {
+    return this.#sessionState;
+  }
+
+  /** @returns {object} Capabilities advertised by the session. */
+  get capabilities() {
+    return this.#session?.capabilities ?? {};
+  }
+
+  /** @returns {object} Accounts in the session, keyed by account id. */
+  get accounts() {
+    return this.#session?.accounts ?? {};
+  }
+
+  /** @returns {object} Primary account ids, keyed by capability URI. */
+  get primaryAccounts() {
+    return this.#session?.primaryAccounts ?? {};
+  }
+
+  /** @returns {?string} The user name from the session, if any. */
+  get username() {
+    return this.#session?.username ?? null;
+  }
+
+  /** @returns {?string} The JMAP API endpoint. */
+  get apiUrl() {
+    return this.#session?.apiUrl ?? null;
+  }
+
+  /** @returns {?string} The blob download URL template. */
+  get downloadUrl() {
+    return this.#session?.downloadUrl ?? null;
+  }
+
+  /** @returns {?string} The blob upload URL template. */
+  get uploadUrl() {
+    return this.#session?.uploadUrl ?? null;
+  }
+
+  /** @returns {?string} The push notification URL template. */
+  get eventSourceUrl() {
+    return this.#session?.eventSourceUrl ?? null;
+  }
+
+  /**
+   * Get the capability description advertised by the session.
+   *
+   * @param {string} capability - Capability URI.
+   * @returns {?object}
+   */
+  getCapability(capability) {
+    return this.#session?.capabilities?.[capability] ?? null;
+  }
+
+  /**
+   * Whether the server advertises a capability.
+   *
+   * @param {string} capability - Capability URI.
+   * @returns {boolean}
+   */
+  supports(capability) {
+    return this.getCapability(capability) !== null;
+  }
+
+  /**
+   * Whether a specific account supports a capability.
+   *
+   * @param {string} capability - Capability URI.
+   * @param {string} accountId
+   * @returns {boolean}
+   */
+  supportsAccount(capability, accountId) {
+    return Boolean(
+      this.#session?.accounts?.[accountId]?.accountCapabilities?.[capability]
+    );
+  }
+
+  /**
+   * Pick the account to use for a capability.
+   *
+   * @param {string} [capability] - Capability URI, defaults to JMAP mail.
+   * @returns {string} Account id.
+   * @throws {JmapCapabilityError} If no account supports the capability.
+   */
+  getAccountId(capability = JmapCapability.Mail) {
+    if (!this.#session) {
+      throw new JmapSessionError("No JMAP session has been loaded");
+    }
+
+    const primary = this.#session.primaryAccounts?.[capability];
+    if (primary && this.#session.accounts[primary]) {
+      return primary;
+    }
+
+    for (const [accountId, account] of Object.entries(this.#session.accounts)) {
+      if (account.accountCapabilities?.[capability]) {
+        return accountId;
+      }
+    }
+
+    // Some servers omit accountCapabilities for the only account they have.
+    // Accept that rather than rendering the account unusable, but do not
+    // ignore an explicitly empty capability list.
+    const accountIds = Object.keys(this.#session.accounts);
+    if (
+      accountIds.length == 1 &&
+      !this.#session.accounts[accountIds[0]].accountCapabilities
+    ) {
+      return accountIds[0];
+    }
+
+    throw new JmapCapabilityError(
+      `No JMAP account supports the ${capability} capability`,
+      { capability }
+    );
+  }
+
+  /**
+   * Whether an account is read-only.
+   *
+   * @param {string} [accountId]
+   * @returns {boolean}
+   */
+  isReadOnly(accountId = this.getAccountId()) {
+    return Boolean(this.#session?.accounts?.[accountId]?.isReadOnly);
+  }
+
+  /**
+   * Maximum number of concurrent requests allowed by the server.
+   *
+   * @returns {number}
+   */
+  get maxConcurrentRequests() {
+    const max = this.getCapability(JmapCapability.Core)?.maxConcurrentRequests;
+    return Number.isFinite(max) && max > 0 ? max : Infinity;
+  }
+
+  /**
+   * Perform one or more JMAP method calls in a single request.
+   *
+   * @param {Array<{name: string, args: object, callId?: string}>} methodCalls
+   *   Method calls, in order. Call ids are generated when omitted.
+   * @param {object} [options]
+   * @param {string[]} [options.using] - Extra capabilities to declare. The
+   *   capabilities required by the calls are added automatically.
+   * @param {object} [options.createdIds] - Creation ids from a previous
+   *   request, needed when arguments reference `#creationId` values.
+   * @param {AbortSignal} [options.signal]
+   * @param {boolean} [options.allowErrors] - Return `error` method responses
+   *   instead of throwing. Defaults to false.
+   * @returns {Promise<{
+   *   responses: Array<{method: string, args: object, callId: string}>,
+   *   createdIds: object,
+   *   sessionState: ?string,
+   * }>}
+   * @throws {JmapCapabilityError} If a required capability is not advertised.
+   * @throws {JmapRequestError} If the request itself is rejected.
+   * @throws {JmapMethodError} If a method call fails and `allowErrors` is
+   *   false.
+   */
+  async request(
+    methodCalls,
+    { using = [], createdIds, signal, allowErrors = false } = {}
+  ) {
+    if (!Array.isArray(methodCalls) || methodCalls.length == 0) {
+      throw new JmapError("At least one JMAP method call is required");
+    }
+
+    const core = this.getCapability(JmapCapability.Core);
+    const maxCalls = core?.maxCallsInRequest;
+    if (Number.isFinite(maxCalls) && methodCalls.length > maxCalls) {
+      throw new JmapError(
+        `Request contains ${methodCalls.length} calls, but the server allows at most ${maxCalls}`
+      );
+    }
+
+    const capabilities = new Set([JmapCapability.Core, ...using]);
+    for (const call of methodCalls) {
+      const capability = capabilityForMethod(call?.name);
+      if (capability) {
+        capabilities.add(capability);
+      }
+    }
+    for (const capability of capabilities) {
+      if (!this.supports(capability)) {
+        throw new JmapCapabilityError(
+          `Server does not advertise the ${capability} capability`,
+          { capability }
+        );
+      }
+    }
+
+    const usedCallIds = new Set();
+    const callNames = new Map();
+    const wireCalls = methodCalls.map((call, index) => {
+      if (!call || typeof call.name != "string" || !call.name) {
+        throw new JmapError("JMAP method call is missing a method name");
+      }
+      const callId = call.callId ?? `c${index}`;
+      if (usedCallIds.has(callId)) {
+        throw new JmapError(`Duplicate JMAP call id: ${callId}`);
+      }
+      usedCallIds.add(callId);
+      callNames.set(callId, call.name);
+      return [call.name, call.args ?? {}, callId];
+    });
+
+    if (typeof this.apiUrl != "string") {
+      throw new JmapSessionError("No JMAP API URL in the session");
+    }
+
+    const payload = { using: [...capabilities], methodCalls: wireCalls };
+    if (createdIds) {
+      payload.createdIds = createdIds;
+    }
+    const body = JSON.stringify(payload);
+
+    const maxSize = core?.maxSizeRequest;
+    if (Number.isFinite(maxSize) && byteLength(body) > maxSize) {
+      throw new JmapRequestError(
+        `JMAP request is larger than the server limit of ${maxSize} bytes`,
+        { type: JmapRequestErrorType.Limit, limit: maxSize }
+      );
+    }
+
+    const { body: responseBody } = await this.#transport.request(
+      this.apiUrl,
+      {
+        method: "POST",
+        headers: {
+          Accept: "application/json",
+          "Content-Type": "application/json",
+        },
+        body,
+        signal,
+        retry: false,
+        slot: this.#slot,
+      }
+    );
+
+    if (
+      !responseBody ||
+      typeof responseBody != "object" ||
+      !Array.isArray(responseBody.methodResponses)
+    ) {
+      throw new JmapRequestError("Malformed JMAP response");
+    }
+
+    await this.#updateSessionState(responseBody.sessionState);
+
+    const responses = responseBody.methodResponses.map(entry => {
+      if (
+        !Array.isArray(entry) ||
+        entry.length != 3 ||
+        typeof entry[0] != "string" ||
+        typeof entry[2] != "string"
+      ) {
+        throw new JmapRequestError("Malformed method response");
+      }
+      return { method: entry[0], args: entry[1] ?? {}, callId: entry[2] };
+    });
+
+    const errors = [];
+    for (const response of responses) {
+      if (response.method != "error") {
+        continue;
+      }
+      const args = response.args;
+      const detail = args.detail ?? args.description ?? null;
+      errors.push(
+        new JmapMethodError(
+          detail ??
+            `JMAP method ${callNames.get(response.callId)} failed`,
+          {
+            method: callNames.get(response.callId) ?? null,
+            callId: response.callId,
+            type: args.type ?? null,
+            detail,
+            args,
+          }
+        )
+      );
+    }
+    if (errors.length && !allowErrors) {
+      throw errors[0];
+    }
+
+    return {
+      responses,
+      createdIds: { ...(createdIds ?? {}), ...(responseBody.createdIds ?? {}) },
+      sessionState: responseBody.sessionState ?? this.#sessionState,
+      errors,
+    };
+  }
+
+  /**
+   * Perform a single method call.
+   *
+   * @param {string} name - JMAP method name.
+   * @param {object} [args] - Method arguments.
+   * @param {object} [options] - Same options as {@link JmapClient#request}.
+   * @returns {Promise<{method: string, args: object, callId: string}>}
+   */
+  async call(name, args = {}, options = {}) {
+    const { responses } = await this.request([{ name, args }], options);
+    return responses[0];
+  }
+
+  /**
+   * Upload a blob.
+   *
+   * @param {Blob|ArrayBuffer|ArrayBufferView|string} data
+   * @param {string} contentType - MIME type of the data.
+   * @param {object} [options]
+   * @param {string} [options.accountId] - Defaults to the primary mail
+   *   account.
+   * @param {AbortSignal} [options.signal]
+   * @returns {Promise<{accountId: string, blobId: string, type: string, size: number}>}
+   */
+  async upload(data, contentType, { accountId, signal } = {}) {
+    if (!this.uploadUrl) {
+      throw new JmapError("Session does not provide an upload URL");
+    }
+    accountId ??= this.getAccountId();
+
+    const size = byteLength(data);
+    const maxSize = this.getCapability(JmapCapability.Core)?.maxSizeUpload;
+    if (Number.isFinite(maxSize) && size > maxSize) {
+      throw new JmapRequestError(
+        `Upload is larger than the server limit of ${maxSize} bytes`,
+        { type: JmapRequestErrorType.Limit, limit: maxSize }
+      );
+    }
+
+    const url = expandUrlTemplate(this.uploadUrl, { accountId });
+    const { body } = await this.#transport.request(url, {
+      method: "POST",
+      headers: { "Content-Type": contentType },
+      body: data,
+      signal,
+      retry: false,
+      slot: this.#slot,
+      timeout: TRANSFER_TIMEOUT_MS,
+    });
+
+    if (!body || typeof body.blobId != "string") {
+      throw new JmapRequestError("Malformed blob upload response", {
+        type: JmapRequestErrorType.NotRequest,
+      });
+    }
+
+    return {
+      accountId,
+      blobId: body.blobId,
+      type: body.type ?? contentType,
+      size: body.size ?? size,
+    };
+  }
+
+  /**
+   * Download a blob.
+   *
+   * @param {string} blobId
+   * @param {object} [options]
+   * @param {string} [options.accountId] - Defaults to the primary mail
+   *   account.
+   * @param {string} [options.type] - MIME type to request in the `Accept`
+   *   parameter of the URL.
+   * @param {string} [options.name] - Suggested file name.
+   * @param {AbortSignal} [options.signal]
+   * @returns {Promise<{blob: Blob, contentType: string}>}
+   */
+  async download(blobId, { accountId, type, name, signal } = {}) {
+    if (!this.downloadUrl) {
+      throw new JmapError("Session does not provide a download URL");
+    }
+    accountId ??= this.getAccountId();
+
+    // Some servers (Stalwart among them) build the download path from the
+    // `name` and `type` placeholders; empty segments make the URL invalid.
+    const acceptType = type || "application/octet-stream";
+    const url = expandUrlTemplate(this.downloadUrl, {
+      accountId,
+      blobId,
+      type: acceptType,
+      name: name || "attachment",
+    });
+    const { headers, body } = await this.#transport.request(url, {
+      method: "GET",
+      headers: { Accept: acceptType },
+      signal,
+      responseType: "blob",
+      retry: true,
+      timeout: TRANSFER_TIMEOUT_MS,
+    });
+
+    return {
+      blob: body,
+      contentType: headers.get("content-type") ?? type ?? "",
+    };
+  }
+
+  /**
+   * Update the cached session state and notify the listener.
+   *
+   * @param {?string} newState
+   */
+  async #updateSessionState(newState) {
+    if (typeof newState != "string" || newState === this.#sessionState) {
+      return;
+    }
+    const oldState = this.#sessionState;
+    this.#sessionState = newState;
+    if (this.#session) {
+      this.#session.state = newState;
+    }
+    if (!this.#onSessionStateChange) {
+      return;
+    }
+    try {
+      await this.#onSessionStateChange(newState, oldState);
+    } catch (error) {
+      // A listener must never make a successful request fail.
+      this.#logger?.error?.(error);
+    }
+  }
+
+  /**
+   * Concurrency slot hooks handed to the transport, which holds a slot only
+   * while a request is actually on the wire (not while it waits out a rate
+   * limit).
+   */
+  #slot = {
+    acquire: signal => this.#acquireSlot(signal),
+    release: () => this.#releaseSlot(),
+  };
+
+  /**
+   * @param {AbortSignal} [signal] - Gives up waiting for a slot when aborted.
+   */
+  async #acquireSlot(signal) {
+    const aborted = () =>
+      new JmapNetworkError("JMAP request was aborted", { aborted: true });
+    if (signal?.aborted) {
+      throw aborted();
+    }
+    if (this.#activeRequests < this.maxConcurrentRequests) {
+      this.#activeRequests++;
+      return;
+    }
+    await new Promise((resolve, reject) => {
+      const onAbort = () => {
+        const index = this.#waiters.indexOf(waiter);
+        if (index != -1) {
+          this.#waiters.splice(index, 1);
+        }
+        reject(aborted());
+      };
+      // Called by #releaseSlot, which hands its slot over to this waiter.
+      const waiter = () => {
+        signal?.removeEventListener("abort", onAbort);
+        resolve();
+      };
+      this.#waiters.push(waiter);
+      signal?.addEventListener("abort", onAbort, { once: true });
+    });
+  }
+
+  #releaseSlot() {
+    const next = this.#waiters.shift();
+    if (next) {
+      // Hand the slot directly to the next waiter.
+      next();
+      return;
+    }
+    this.#activeRequests--;
+  }
+}
+
+/**
+ * Byte length of a JMAP request body or upload.
+ *
+ * @param {Blob|ArrayBuffer|ArrayBufferView|string} data
+ * @returns {number}
+ */
+export function byteLength(data) {
+  if (typeof data == "string") {
+    return new TextEncoder().encode(data).length;
+  }
+  // Duck-typed rather than `instanceof`: data created in another global (a
+  // window, a test scope) has different `ArrayBuffer`/`Blob` constructors.
+  if (typeof data?.byteLength == "number") {
+    return data.byteLength;
+  }
+  if (typeof data?.size == "number") {
+    return data.size;
+  }
+  return 0;
+}
