diff --git a/mailnews/protocols/jmap/test/unit/test_jmap_mutations.js b/mailnews/protocols/jmap/test/unit/test_jmap_mutations.js
new file mode 100644
index 00000000000..8915eb4846b
--- /dev/null
+++ b/mailnews/protocols/jmap/test/unit/test_jmap_mutations.js
@@ -0,0 +1,273 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+function makeMail({ maxObjectsInSet = 500, onSet = null } = {}) {
+  const calls = [];
+  const mail = {
+    calls,
+    client: {
+      capabilities: {
+        "urn:ietf:params:jmap:core": { maxObjectsInSet },
+      },
+    },
+
+    async setEmails(args) {
+      calls.push(args);
+      if (onSet) {
+        const result = await onSet(args, calls.length - 1);
+        if (result !== undefined) {
+          return result;
+        }
+      }
+
+      const result = {};
+      if (args.update) {
+        result.updated = Object.fromEntries(
+          Object.keys(args.update).map(id => [id, null])
+        );
+      }
+      if (args.destroy) {
+        result.destroyed = [...args.destroy];
+      }
+      if (args.create) {
+        result.created = Object.fromEntries(
+          Object.keys(args.create).map(id => [id, { id: `server-${id}` }])
+        );
+      }
+      return result;
+    },
+
+    async copyEmails(args) {
+      calls.push(args);
+      return { created: {}, notCreated: {} };
+    },
+  };
+  return mail;
+}
+
+add_task(async function test_set_read() {
+  const mail = makeMail();
+  const mutator = new JmapMutator({ mail });
+
+  const result = await mutator.setRead(["e1", "e2"], true, {
+    ifInState: "state-1",
+  });
+
+  Assert.deepEqual(mail.calls[0].update, {
+    e1: { "keywords/$seen": true },
+    e2: { "keywords/$seen": true },
+  });
+  Assert.equal(mail.calls[0].ifInState, "state-1");
+  Assert.ok("e1" in result.updated);
+});
+
+add_task(async function test_set_unread_uses_null() {
+  const mail = makeMail();
+  await new JmapMutator({ mail }).setRead(["e1"], false);
+  Assert.deepEqual(mail.calls[0].update.e1, { "keywords/$seen": null });
+});
+
+add_task(async function test_set_flagged() {
+  const mail = makeMail();
+  const mutator = new JmapMutator({ mail });
+
+  await mutator.setFlagged(["e1"], true);
+  Assert.deepEqual(mail.calls[0].update.e1, {
+    "keywords/$flagged": true,
+  });
+});
+
+add_task(async function test_answered_and_forwarded() {
+  const mail = makeMail();
+  const mutator = new JmapMutator({ mail });
+
+  await mutator.setAnswered(["e1"], true);
+  await mutator.setForwarded(["e1"], true);
+
+  Assert.deepEqual(mail.calls[0].update.e1, {
+    "keywords/$answered": true,
+  });
+  Assert.deepEqual(mail.calls[1].update.e1, {
+    "keywords/$forwarded": true,
+  });
+});
+
+add_task(async function test_junk_keywords() {
+  const mail = makeMail();
+  const mutator = new JmapMutator({ mail });
+
+  await mutator.setJunk(["e1"], true);
+  Assert.deepEqual(mail.calls[0].update.e1, {
+    "keywords/$junk": true,
+    "keywords/$notjunk": null,
+  });
+
+  await mutator.setJunk(["e2"], false);
+  Assert.deepEqual(mail.calls[1].update.e2, {
+    "keywords/$junk": null,
+    "keywords/$notjunk": true,
+  });
+
+  for (const call of mail.calls) {
+    for (const patch of Object.values(call.update)) {
+      for (const value of Object.values(patch)) {
+        Assert.ok(value !== false, "JMAP patches never contain false");
+      }
+    }
+  }
+});
+
+add_task(async function test_move_between_mailboxes() {
+  const mail = makeMail();
+  await new JmapMutator({ mail }).move(["e1"], "inbox", "archive");
+
+  Assert.deepEqual(mail.calls[0].update.e1, {
+    "mailboxIds/inbox": null,
+    "mailboxIds/archive": true,
+  });
+});
+
+add_task(async function test_add_and_remove_keywords() {
+  const mail = makeMail();
+  const mutator = new JmapMutator({ mail });
+
+  await mutator.addKeywords(["e1"], ["$seen", "custom"]);
+  await mutator.removeKeywords(["e1"], ["custom"]);
+
+  Assert.deepEqual(mail.calls[0].update.e1, {
+    "keywords/$seen": true,
+    "keywords/custom": true,
+  });
+  Assert.deepEqual(mail.calls[1].update.e1, {
+    "keywords/custom": null,
+  });
+});
+
+add_task(async function test_update_chunking() {
+  const mail = makeMail({ maxObjectsInSet: 2 });
+  await new JmapMutator({ mail }).setRead(["e1", "e2", "e3"], true);
+
+  Assert.equal(mail.calls.length, 2);
+  Assert.deepEqual(Object.keys(mail.calls[0].update), ["e1", "e2"]);
+  Assert.deepEqual(Object.keys(mail.calls[1].update), ["e3"]);
