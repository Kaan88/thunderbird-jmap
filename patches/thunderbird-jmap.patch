diff --git a/mailnews/addrbook/modules/JmapDirectory.sys.mjs b/mailnews/addrbook/modules/JmapDirectory.sys.mjs
new file mode 100644
index 00000000000..f00eeaf80c9
--- /dev/null
+++ b/mailnews/addrbook/modules/JmapDirectory.sys.mjs
@@ -0,0 +1,541 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, you can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { SQLiteDirectory } from "resource:///modules/SQLiteDirectory.sys.mjs";
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  JmapAccountRegistry: "resource:///modules/jmap/JmapAccountRegistry.sys.mjs",
+  JmapJSContact: "resource:///modules/JmapJSContact.sys.mjs",
+  MailServices: "resource:///modules/MailServices.sys.mjs",
+  VCardUtils: "resource:///modules/VCardUtils.sys.mjs",
+  clearInterval: "resource://gre/modules/Timer.sys.mjs",
+  clearTimeout: "resource://gre/modules/Timer.sys.mjs",
+  setInterval: "resource://gre/modules/Timer.sys.mjs",
+  setTimeout: "resource://gre/modules/Timer.sys.mjs",
+});
+
+const CONTACTS = "urn:ietf:params:jmap:contacts";
+const CONTACTS_PARSE = "urn:ietf:params:jmap:contacts:parse";
+
+/** Card properties set by this directory. */
+const ID_PROP = "_jmapId";
+const EXTRA_PROP = "_jmapExtra";
+// The server photo entry and the data: URI it was downloaded as.
+const PHOTO_PROP = "_jmapPhoto";
+
+/** Top-level ContactCard properties we replace on update. */
+const PATCHABLE = [
+  "kind",
+  "name",
+  "nicknames",
+  "emails",
+  "phones",
+  "addresses",
+  "organizations",
+  "titles",
+  "onlineServices",
+  "links",
+  "anniversaries",
+  "notes",
+  "media",
+  "members",
+];
+
+const log = console.createInstance({
+  prefix: "jmap.contacts",
+  maxLogLevel: "Warn",
+  maxLogLevelPref: "mail.jmap.loglevel",
+});
+
+async function blobToDataURL(blob, type) {
+  const bytes = new Uint8Array(await blob.arrayBuffer());
+  let binary = "";
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
+  }
+  return `data:${type || blob.type || "image/jpeg"};base64,${btoa(binary)}`;
+}
+
+/**
+ * An address book backed by a JMAP AddressBook (RFC 9610). Cards are kept in
+ * SQLite like CardDAVDirectory; the server is the source of truth.
+ *
+ * Directory prefs: jmap.serverKey, jmap.addressBookId, jmap.state.
+ */
+export class JmapDirectory extends SQLiteDirectory {
+  _syncTimer = null;
+  _syncInProgress = null;
+  _pushListener = null;
+
+  init(uri) {
+    super.init(uri);
+    if (this._serverKey && this._addressBookId) {
+      if (this.getIntValue("carddav.syncinterval", 30) > 0) {
+        this._syncTimer = lazy.setTimeout(() => this.syncWithServer(), 30000);
+      }
+      this._subscribePush();
+    }
+  }
+
+  async cleanUp() {
+    await super.cleanUp();
+    lazy.clearTimeout(this._syncTimer);
+    lazy.clearInterval(this._syncTimer);
+    this._syncTimer = null;
+    this._pushListener?.();
+    this._pushListener = null;
+  }
+
+  get dirType() {
+    return Ci.nsIAbManager.JMAP_DIRECTORY_TYPE;
+  }
+  get propertiesChromeURI() {
+    return "chrome://messenger/content/addressbook/abAddressBookNameDialog.xhtml";
+  }
+  get supportsMailingLists() {
+    // TODO: map JSContact kind "group" cards to mailing lists.
+    return false;
+  }
+  addMailList() {
+    throw Components.Exception(
+      "JmapDirectory does not implement addMailList",
+      Cr.NS_ERROR_NOT_IMPLEMENTED
+    );
+  }
+
+  setIntValue(name, value) {
+    super.setIntValue(name, value);
+    if (name == "carddav.syncinterval") {
+      this._scheduleNextSync();
+    }
+  }
+
+  get _serverKey() {
+    return this.getStringValue("jmap.serverKey", "");
+  }
+  get _addressBookId() {
+    return this.getStringValue("jmap.addressBookId", "");
+  }
+  get _state() {
+    return this.getStringValue("jmap.state", "");
+  }
+  set _state(value) {
+    this.setStringValue("jmap.state", value ?? "");
+  }
+
+  /** Local changes. */
+
+  addCard(card, withNewUID) {
+    const newCard = super.addCard(card, withNewUID);
+    this._sendCardToServer(newCard).catch(console.error);
+    return newCard;
+  }
+
+  modifyCard(card) {
+    const oldProperties = this.loadCardProperties(card.UID);
+    const newCard = super.modifyCard(card);
+    if (oldProperties.get("_vCard") != newCard.getProperty("_vCard", "")) {
+      this._sendCardToServer(newCard).catch(console.error);
+    }
+  }
+
+  deleteCards(cards) {
+    const ids = cards
+      .map(c => c.getProperty(ID_PROP, ""))
+      .filter(Boolean);
+    super.deleteCards(cards);
+    if (ids.length) {
+      this._withStateRetry(client =>
+        client.set({ destroy: ids, ifInState: this._state || undefined })
+      ).catch(console.error);
+    }
+  }
+
+  async _typeClient(type = "ContactCard") {
+    return lazy.JmapAccountRegistry.getTypeClient(
+      this._serverKey,
+      type,
+      CONTACTS
+    );
+  }
+
+  /**
+   * Run a ContactCard/set. On stateMismatch, sync and retry once. When the
+   * call succeeds with ifInState, the new state is safe to store.
+   *
+   * @param {function(JmapTypeClient): Promise<object>} fn
+   */
+  async _withStateRetry(fn) {
+    const client = await this._typeClient();
+    let result;
+    try {
+      result = await fn(client);
+    } catch (ex) {
+      if (ex?.type != "stateMismatch") {
+        throw ex;
+      }
+      if (this._syncInProgress) {
+        // Called from within a sync: waiting for it would deadlock, so just
+        // refresh the state.
+        log.log("stateMismatch during sync, refreshing state before retry");
+        this._state = (await client.get([])).state;
+      } else {
+        log.log("stateMismatch, syncing before retry");
+        await this.syncWithServer(false);
+      }
+      result = await fn(client);
+    }
+    if (result?.newState && result.oldState == this._state) {
+      this._state = result.newState;
+    }
+    return result;
+  }
+
+  /** Convert a local card to a JSContact Card, server-side if possible. */
+  async _cardToJSContact(card, client) {
+    const vCard =
+      card.getProperty("_vCard", "") ||
+      lazy.VCardUtils.abCardToVCard(card, "4.0");
+    let extra = {};
+    try {
+      extra = JSON.parse(card.getProperty(EXTRA_PROP, "") || "{}");
+    } catch (ex) {}
+
+    let jsCard = null;
+    if (client.client.supports(CONTACTS_PARSE)) {
+      try {
+        const { blobId } = await client.client.upload(vCard, "text/vcard", {
+          accountId: client.accountId,
+        });
+        const result = await client.invoke("parse", { blobIds: [blobId] });
+        jsCard = result.parsed?.[blobId] ?? null;
+        if (jsCard) {
+          for (const [key, value] of Object.entries(extra)) {
+            if (key == "media" && jsCard.media) {
+              jsCard.media = { ...value, ...jsCard.media };
+            } else {
+              jsCard[key] ??= value;
+            }
+          }
+        }
+      } catch (ex) {
+        log.warn("ContactCard/parse failed, converting locally", ex);
+      }
+    }
+    jsCard ??= lazy.JmapJSContact.fromVCard(vCard, extra);
+    jsCard.uid ??= `urn:uuid:${card.UID}`;
+    this._restorePhoto(card, jsCard);
+    delete jsCard.id;
+    delete jsCard.blobId;
+    return jsCard;
+  }
+
+  /**
+   * Replace an unchanged downloaded photo with the server's original
+   * blobId entry, so it isn't re-uploaded as an inline data: URI.
+   *
+   * @param {nsIAbCard} card
+   * @param {object} jsCard
+   */
+  _restorePhoto(card, jsCard) {
+    let saved;
+    try {
+      saved = JSON.parse(card.getProperty(PHOTO_PROP, "") || "null");
+    } catch (ex) {}
+    if (!saved || !jsCard.media) {
+      return;
+    }
+    for (const [mediaId, media] of Object.entries(jsCard.media)) {
+      if (media?.kind == "photo" && media.uri == saved.uri) {
+        delete jsCard.media[mediaId];
+        jsCard.media[saved.id] = saved.media;
+        return;
+      }
+    }
+  }
+
+  async _sendCardToServer(card) {
+    const client = await this._typeClient();
+    const jsCard = await this._cardToJSContact(card, client);
+    const id = card.getProperty(ID_PROP, "");
+
+    if (id) {
+      const patch = {};
+      for (const key of PATCHABLE) {
+        patch[key] = jsCard[key] ?? null;
+      }
+      // An unchanged photo keeps its blobId reference (see _restorePhoto).
+      await this._withStateRetry(c =>
+        c.set({ update: { [id]: patch }, ifInState: this._state || undefined })
+      );
+      return;
+    }
+
+    jsCard.addressBookIds = { [this._addressBookId]: true };
+    const result = await this._withStateRetry(c =>
+      c.set({ create: { c: jsCard }, ifInState: this._state || undefined })
+    );
+    const created = result.created?.c;
+    if (created?.id) {
+      card.setProperty(ID_PROP, created.id);
+      super.modifyCardInternal(card);
+    }
+  }
+
+  /** Server sync. */
+
+  _scheduleNextSync() {
+    lazy.clearTimeout(this._syncTimer);
+    lazy.clearInterval(this._syncTimer);
+    this._syncTimer = null;
+    const interval = this.getIntValue("carddav.syncinterval", 30);
+    if (interval > 0) {
+      this._syncTimer = lazy.setInterval(
+        () => this.syncWithServer(false),
+        interval * 60000
+      );
+    }
+  }
+
+  async _subscribePush() {
+    let JmapPush;
+    try {
+      ({ JmapPush } = ChromeUtils.importESModule(
+        "resource:///modules/jmap/JmapPush.sys.mjs"
+      ));
+    } catch (ex) {
+      return;
+    }
+    try {
+      const remove = JmapPush?.addListener?.(
+        this._serverKey,
+        ["ContactCard", "AddressBook"],
+        () => this.syncWithServer(false).catch(console.error)
+      );
+      this._pushListener = typeof remove == "function" ? remove : null;
+    } catch (ex) {
+      log.warn("Push subscription failed", ex);
+    }
+  }
+
+  _cardsByJmapId() {
+    const map = new Map();
+    for (const [uid, properties] of this.cards) {
+      const id = properties.get(ID_PROP);
+      if (id) {
+        map.set(id, uid);
+      }
+    }
+    return map;
+  }
+
+  /** Download blobId-only photos as data URLs. */
+  async _fetchPhotos(jsCard, client) {
+    const photos = new Map();
+    for (const [mediaId, media] of Object.entries(jsCard.media ?? {})) {
+      if (media.kind == "photo" && !media.uri && media.blobId) {
+        try {
+          const { blob, contentType } = await client.client.download(
+            media.blobId,
+            { accountId: client.accountId, type: media.mediaType, name: "photo" }
+          );
+          photos.set(mediaId, await blobToDataURL(blob, contentType));
+        } catch (ex) {
+          log.warn(`Photo download failed for ${jsCard.id}`, ex);
+        }
+        break;
+      }
+    }
+    return photos;
+  }
+
+  /** Store server cards. Cards no longer in this book are removed. */
+  async _storeCards(list, client, byId = this._cardsByJmapId()) {
+    const abId = this._addressBookId;
+    const toDelete = [];
+    for (const jsCard of list) {
+      const existingUID = byId.get(jsCard.id);
+      if (!jsCard.addressBookIds?.[abId] || jsCard.kind == "group") {
+        // Groups aren't supported as mailing lists yet.
+        if (existingUID) {
+          toDelete.push(existingUID);
+        }
+        continue;
+      }
+      const photos = await this._fetchPhotos(jsCard, client);
+      const { vCard, extra } = lazy.JmapJSContact.toVCard(jsCard, { photos });
+      const uid =
+        existingUID ??
+        (jsCard.uid?.replace(/^urn:uuid:/i, "") || Services.uuid
+          .generateUUID()
+          .toString()
+          .slice(1, -1));
+      const abCard = lazy.VCardUtils.vCardToAbCard(vCard, uid);
+      abCard.setProperty(ID_PROP, jsCard.id);
+      abCard.setProperty(EXTRA_PROP, JSON.stringify(extra));
+      const [photoId, photoURI] = [...photos][0] ?? [];
+      abCard.setProperty(
+        PHOTO_PROP,
+        photoId
+          ? JSON.stringify({
+              id: photoId,
+              media: jsCard.media[photoId],
+              uri: photoURI,
+            })
+          : ""
+      );
+      if (existingUID || this.loadCardProperties(uid).size) {
+        super.modifyCardInternal(abCard);
+      } else {
+        super.addCardInternal(abCard);
+      }
+      byId.set(jsCard.id, uid);
+    }
+    this._deleteLocal(toDelete);
+  }
+
+  _deleteLocal(uids) {
+    if (!uids.length) {
+      return;
+    }
+    const cards = uids.map(uid => this.getCard(uid)).filter(Boolean);
+    if (cards.length) {
+      super.deleteCardsInternal(cards);
+    }
+  }
+
+  /** Full (re)sync of this book. */
+  async fetchAllFromServer() {
+    const client = await this._typeClient();
+    const { ids } = await client.queryAll({
+      inAddressBook: this._addressBookId,
+    });
+    const { list, state } = await client.get(ids);
+    const byId = this._cardsByJmapId();
+    const seen = new Set(list.map(c => c.id));
+    await this._storeCards(list, client, byId);
+    this._deleteLocal(
+      [...byId].filter(([id]) => !seen.has(id)).map(([, uid]) => uid)
+    );
+    // Set the state first: sending pending cards uses it for ifInState.
+    this._state = state;
+    // Locally-created cards never sent to the server.
+    for (const [uid, properties] of this.cards) {
+      if (!properties.has(ID_PROP)) {
+        const card = this.getCard(uid);
+        if (card) {
+          await this._sendCardToServer(card).catch(console.error);
+        }
+      }
+    }
+    Services.obs.notifyObservers(this, "addrbook-directory-synced");
+  }
+
+  /** Incremental sync with ContactCard/changes. */
+  async syncWithServer(shouldResetTimer = true) {
+    if (this._syncInProgress) {
+      return this._syncInProgress;
+    }
+    this._syncInProgress = (async () => {
+      try {
+        if (!this._state) {
+          await this.fetchAllFromServer();
+          return;
+        }
+        const client = await this._typeClient();
+        const changes = await client.changesSince(this._state);
+        if (!changes) {
+          await this.fetchAllFromServer();
+          return;
+        }
+        const fetchIds = [...changes.created, ...changes.updated];
+        if (fetchIds.length) {
+          const { list } = await client.get(fetchIds);
+          await this._storeCards(list, client);
+        }
+        const byId = this._cardsByJmapId();
+        this._deleteLocal(
+          changes.destroyed.map(id => byId.get(id)).filter(Boolean)
+        );
+        this._state = changes.newState;
+        Services.obs.notifyObservers(this, "addrbook-directory-synced");
+      } catch (ex) {
+        console.error(ex);
+        Services.obs.notifyObservers(this, "addrbook-directory-sync-failed");
+      } finally {
+        this._syncInProgress = null;
+      }
+    })();
+    if (shouldResetTimer) {
+      this._scheduleNextSync();
+    }
+    return this._syncInProgress;
+  }
+
+  static forFile(fileName) {
+    const directory = super.forFile(fileName);
+    return directory instanceof JmapDirectory ? directory : undefined;
+  }
+
+  /**
+   * Create (or find) one Thunderbird address book per JMAP AddressBook of an
+   * incoming server, and start syncing them.
+   *
+   * @param {string} serverKey
+   * @returns {Promise<JmapDirectory[]>}
+   */
+  static async createForServer(serverKey) {
+    const client = await lazy.JmapAccountRegistry.getClient(serverKey);
+    if (!client.supports(CONTACTS)) {
+      return [];
+    }
+    const books = await lazy.JmapAccountRegistry.getTypeClient(
+      serverKey,
+      "AddressBook",
+      CONTACTS
+    );
+    const { list } = await books.get(null);
+    const existing = new Map();
+    for (const dir of lazy.MailServices.ab.directories) {
+      if (
+        dir.dirType == Ci.nsIAbManager.JMAP_DIRECTORY_TYPE &&
+        dir.getStringValue("jmap.serverKey", "") == serverKey
+      ) {
+        existing.set(dir.getStringValue("jmap.addressBookId", ""), dir);
+      }
+    }
+
+    const result = [];
+    for (const book of list) {
+      let dir = existing.get(book.id);
+      if (!dir) {
+        const prefName = lazy.MailServices.ab.newAddressBook(
+          book.name || book.id,
+          null,
+          Ci.nsIAbManager.JMAP_DIRECTORY_TYPE
+        );
+        dir = lazy.MailServices.ab.getDirectoryFromId(prefName);
+        dir.setStringValue("jmap.serverKey", serverKey);
+        dir.setStringValue("jmap.addressBookId", book.id);
+        if (book.myRights && !book.myRights.mayWrite) {
+          dir.setBoolValue("readOnly", true);
+        }
+      }
+      const jmapDir = JmapDirectory.forFile(dir.fileName);
+      if (jmapDir) {
+        if (!existing.has(book.id)) {
+          jmapDir._subscribePush();
+        }
+        jmapDir.syncWithServer().catch(console.error);
+        result.push(jmapDir);
+      }
+    }
+    return result;
+  }
+}
+
+JmapDirectory.prototype.classID = Components.ID(
+  "{3c3f3a4e-6d1b-4f8e-9a52-0b7c2d9e4f11}"
+);
