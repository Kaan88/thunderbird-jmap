diff --git a/mail/components/jmapfiles/modules/JmapCloudFile.sys.mjs b/mail/components/jmapfiles/modules/JmapCloudFile.sys.mjs
new file mode 100644
index 00000000000..d51178692eb
--- /dev/null
+++ b/mail/components/jmapfiles/modules/JmapCloudFile.sys.mjs
@@ -0,0 +1,311 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * Built-in FileLink provider storing attachments in JMAP File Storage
+ * (Stalwart Files). Implements the same account interface as the
+ * WebExtension wrapper in ext-cloudFile.js.
+ */
+
+export const PROVIDER_TYPE = "jmap-files";
+const ATTACHMENTS_FOLDER = "Thunderbird Attachments";
+const ACCOUNT_ROOT = "mail.cloud_files.accounts.";
+const ICON = "chrome://messenger/skin/icons/new/compact/folder.svg";
+
+// Lazy, because cloudFileAccounts.sys.mjs imports this module.
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  cloudFileAccounts: "resource:///modules/cloudFileAccounts.sys.mjs",
+  JmapFiles: "resource:///modules/jmapfiles/JmapFiles.sys.mjs",
+});
+ChromeUtils.defineLazyGetter(
+  lazy,
+  "l10n",
+  () => new Localization(["messenger/jmapFiles.ftl"], true)
+);
+
+function providerName() {
+  try {
+    return (
+      lazy.l10n.formatValueSync("jmap-files-filelink-name") ||
+      "Stalwart Files (JMAP)"
+    );
+  } catch (e) {
+    return "Stalwart Files (JMAP)";
+  }
+}
+
+function cloudError(message, code) {
+  return Components.Exception(message, code);
+}
+
+export class JmapCloudFileAccount {
+  constructor(accountKey) {
+    this.accountKey = accountKey;
+    this.type = PROVIDER_TYPE;
+    this.lastError = "";
+    this.reuseUploads = true;
+    this.browserStyle = false;
+    this.quota = { uploadSizeLimit: -1, spaceRemaining: -1, spaceUsed: -1 };
+    this._nextId = 1;
+    /** @type {Map<number, object>} */
+    this._uploads = new Map();
+    /** @type {Map<string, AbortController>} */
+    this._pending = new Map();
+    this._initLimits();
+  }
+
+  get displayName() {
+    return Services.prefs.getCharPref(
+      `${ACCOUNT_ROOT}${this.accountKey}.displayName`,
+      providerName()
+    );
+  }
+  get iconURL() {
+    return ICON;
+  }
+  get fileUploadSizeLimit() {
+    return this.quota.uploadSizeLimit;
+  }
+  get remainingFileSpace() {
+    return this.quota.spaceRemaining;
+  }
+  get fileSpaceUsed() {
+    return this.quota.spaceUsed;
+  }
+  get configured() {
+    return !!this.serverKey;
+  }
+  get createNewAccountUrl() {
+    return "";
+  }
+  get managementURL() {
+    // The preferences pane appends "?accountId=..."; keep it in a comment.
+    const server = this.serverKey
+      ? lazy.JmapFiles.servers.find(s => s.key == this.serverKey)
+      : null;
+    const text = server
+      ? `${providerName()}: ${server.prettyName}`
+      : providerName();
+    return `data:text/html;charset=utf-8,<p style="font:message-box">${encodeURIComponent(
+      text
+    )}</p><!--`;
+  }
+
+  /** The JMAP incoming server used by this account. */
+  get serverKey() {
+    const configured = Services.prefs.getCharPref(
+      `${ACCOUNT_ROOT}${this.accountKey}.jmapServerKey`,
+      ""
+    );
+    if (configured && lazy.JmapFiles.servers.some(s => s.key == configured)) {
+      return configured;
+    }
+    return lazy.JmapFiles.servers[0]?.key ?? "";
+  }
+  set serverKey(key) {
+    Services.prefs.setCharPref(
+      `${ACCOUNT_ROOT}${this.accountKey}.jmapServerKey`,
+      key
+    );
+    this._initLimits();
+    lazy.cloudFileAccounts.emit("accountConfigured", this);
+  }
+
+  async _service() {
+    const key = this.serverKey;
+    if (!key) {
+      throw cloudError(
+        "No JMAP account with file storage",
+        lazy.cloudFileAccounts.constants.accountErr
+      );
+    }
+    const service = await lazy.JmapFiles.forServer(key);
+    this.quota.uploadSizeLimit = service.maxFileSize;
+    return service;
+  }
+
+  _initLimits() {
+    this._service().catch(() => {});
+  }
+
+  newUploadForFile(file, data = {}) {
+    const id = this._nextId++;
+    const upload = {
+      id,
+      name: data.name ?? file.leafName,
+      url: data.url ?? null,
+      path: file.path,
+      size: file.exists() ? file.fileSize : data.size || 0,
+      serviceName: data.serviceName ?? this.displayName,
+      serviceIcon: data.serviceIcon ?? this.iconURL,
+      serviceUrl: data.serviceUrl ?? "",
+      downloadPasswordProtected: data.downloadPasswordProtected ?? false,
+      downloadLimit: data.downloadLimit ?? 0,
+      downloadExpiryDate: data.downloadExpiryDate ?? null,
+      immutable: data.immutable ?? false,
+    };
+    this._uploads.set(id, upload);
+    return upload;
+  }
+
+  markAsImmutable(id) {
+    const upload = this._uploads.get(id);
+    if (upload) {
+      upload.immutable = true;
+    }
+  }
+
+  isReusedUpload(upload) {
+    if (!upload) {
+      return false;
+    }
+    if (
+      [...this._uploads.values()].some(u => u.immutable && u.url == upload.url)
+    ) {
+      return true;
+    }
+    let count = 0;
+    for (const win of Services.wm.getEnumerator("msgcompose")) {
+      const bucket = win.document.getElementById("attachmentBucket");
+      count += [...(bucket?.childNodes ?? [])].filter(
+        n => n.attachment?.contentLocation == upload.url
+      ).length;
+    }
+    return count > 1;
+  }
+
+  async uploadFile(window, file, name = file.leafName, related) {
+    if (related && this.reuseUploads && !this.isReusedUpload(related)) {
+      // Same content as a previous upload: rename if needed, reuse the link.
+      const previous = this._uploads.get(related.id);
+      if (previous?.nodeId && related.name != name) {
+        return this.renameFile(window, related.id, name);
+      }
+    }
+    const service = await this._service();
+    if (
+      this.fileUploadSizeLimit != -1 &&
+      file.fileSize > this.fileUploadSizeLimit
+    ) {
+      throw cloudError(
+        "File too large",
+        lazy.cloudFileAccounts.constants.uploadExceedsFileLimit
+      );
+    }
+    const upload = this.newUploadForFile(file, { name });
+    const controller = new AbortController();
+    this._pending.set(file.path, controller);
+    try {
+      const folder = await service.ensureDirectory([ATTACHMENTS_FOLDER]);
+      const node = await service.upload(folder.id, file, {
+        name,
+        onExists: "rename",
+        signal: controller.signal,
+      });
+      const link = service.linkFor(node.id);
+      upload.nodeId = node.id;
+      upload.name = node.name;
+      upload.url = link.url;
+      upload.downloadPasswordProtected = link.requiresLogin;
+      upload.serviceUrl = service.capability.webUrlTemplate
+        ? link.url
+        : upload.serviceUrl;
+      return { ...upload };
+    } catch (e) {
+      this._uploads.delete(upload.id);
+      if (controller.signal.aborted) {
+        throw cloudError(
+          "Upload cancelled.",
+          lazy.cloudFileAccounts.constants.uploadCancelled
+        );
+      }
+      if (e.code == "overQuota") {
+        throw cloudError(e.message, lazy.cloudFileAccounts.constants.uploadWouldExceedQuota);
+      }
+      if (e.code == "tooLarge") {
+        throw cloudError(e.message, lazy.cloudFileAccounts.constants.uploadExceedsFileLimit);
+      }
+      throw cloudError(
+        e.message,
+        lazy.cloudFileAccounts.constants.uploadErrWithCustomMessage
+      );
+    } finally {
+      this._pending.delete(file.path);
+    }
+  }
+
+  async cancelFileUpload(window, file) {
+    const controller = this._pending.get(file.path);
+    if (!controller) {
+      return false;
+    }
+    controller.abort();
+    return true;
+  }
+
+  async renameFile(window, uploadId, newName) {
+    const upload = this._uploads.get(uploadId);
+    if (!upload?.nodeId) {
+      throw cloudError("Rename error.", lazy.cloudFileAccounts.constants.renameErr);
+    }
+    try {
+      const service = await this._service();
+      await service.rename(upload.nodeId, newName, { onExists: "rename" });
+      upload.name = service.getNode(upload.nodeId)?.name ?? newName;
+      upload.url = service.linkFor(upload.nodeId).url;
+    } catch (e) {
+      throw cloudError(
+        e.message,
+        lazy.cloudFileAccounts.constants.renameErrWithCustomMessage
+      );
+    }
+    return { ...upload };
+  }
+
+  urlForFile(uploadId) {
+    return this._uploads.get(uploadId)?.url;
+  }
+
+  getPreviousUploads() {
+    return [...this._uploads.values()].map(u => ({ ...u }));
+  }
+
+  async deleteFile(window, uploadId) {
+    const upload = this._uploads.get(uploadId);
+    if (!upload || this.isReusedUpload(upload)) {
+      return;
+    }
+    try {
+      if (upload.nodeId) {
+        const service = await this._service();
+        await service.remove([upload.nodeId]);
+      }
+      this._uploads.delete(uploadId);
+    } catch (e) {
+      throw cloudError(
+        `Delete error: ${e.message}`,
+        lazy.cloudFileAccounts.constants.deleteErr
+      );
+    }
+  }
+}
+
+export const JmapCloudFileProvider = {
+  type: PROVIDER_TYPE,
+  get displayName() {
+    return providerName();
+  },
+  iconURL: ICON,
+  initAccount(accountKey) {
+    return new JmapCloudFileAccount(accountKey);
+  },
+};
+
+/** Register the provider (idempotent). Call once at startup. */
+export function registerJmapCloudFileProvider(accounts) {
+  if (!accounts.getProviderForType(PROVIDER_TYPE)) {
+    accounts.registerProvider(PROVIDER_TYPE, JmapCloudFileProvider);
+  }
+}
diff --git a/mail/components/jmapfiles/modules/JmapFiles.sys.mjs b/mail/components/jmapfiles/modules/JmapFiles.sys.mjs
new file mode 100644
index 00000000000..7294988c2da
--- /dev/null
+++ b/mail/components/jmapfiles/modules/JmapFiles.sys.mjs
@@ -0,0 +1,927 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * JMAP File Storage (draft-ietf-jmap-filenode) access for one JMAP incoming
+ * server. Keeps a cache of the FileNode tree, kept fresh with
+ * FileNode/changes (and push, when JmapPush is available), and offers the
+ * file operations used by the Files tab, the FileLink provider and the
+ * attachment pickers.
+ */
+
+import { JmapTypeClient } from "resource:///modules/jmap/JmapTypeClient.sys.mjs";
+import { JmapCapability } from "resource:///modules/jmap/JmapConstants.sys.mjs";
+import { JmapMethodError } from "resource:///modules/jmap/JmapErrors.sys.mjs";
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  JmapAccountRegistry: "resource:///modules/jmap/JmapAccountRegistry.sys.mjs",
+});
+ChromeUtils.defineLazyGetter(
+  lazy,
+  "l10n",
+  () => new Localization(["messenger/jmapFiles.ftl"], true)
+);
+
+const FILENODE = JmapCapability.FileNode ?? "urn:ietf:params:jmap:filenode";
+const DEFAULT_MAX_SIZE = 25 * 1024 * 1024;
+const NODE_PROPERTIES = [
+  "id",
+  "parentId",
+  "name",
+  "@type",
+  "type",
+  "created",
+  "modified",
+  "blobId",
+  "size",
+  "mediaType",
+  "myRights",
+  "role",
+];
+
+export const ATTACHMENTS_FOLDER = "Thunderbird Attachments";
+
+export const FileNodeType = Object.freeze({
+  File: "File",
+  Directory: "Directory",
+  SymLink: "SymLink",
+});
+
+/**
+ * Error with a user-presentable message.
+ */
+export class JmapFilesError extends Error {
+  /**
+   * @param {string} code - Short machine code: overQuota, tooLarge,
+   *   alreadyExists, forbidden, notFound, invalidName, depth, unknown.
+   * @param {string} message - Localized message.
+   * @param {Error} [cause]
+   */
+  constructor(code, message, cause) {
+    super(message, cause ? { cause } : undefined);
+    this.code = code;
+  }
+}
+
+function fmt(id, args) {
+  try {
+    return lazy.l10n.formatValueSync(id, args) || id;
+  } catch (e) {
+    return `${id} ${args ? JSON.stringify(args) : ""}`.trim();
+  }
+}
+
+/**
+ * Normalize the `@type` of a node ("file", "directory" also accepted).
+ *
+ * @param {object} raw
+ * @returns {string} One of FileNodeType.
+ */
+export function nodeType(raw) {
+  const t = String(raw["@type"] ?? raw.type ?? "").toLowerCase();
+  if (t == "directory" || t == "folder") {
+    return FileNodeType.Directory;
+  }
+  if (t == "symlink") {
+    return FileNodeType.SymLink;
+  }
+  if (t == "file") {
+    return FileNodeType.File;
+  }
+  // No type: a node without content is a directory.
+  return raw.blobId ? FileNodeType.File : FileNodeType.Directory;
+}
+
+function normalize(raw) {
+  return {
+    id: raw.id,
+    parentId: raw.parentId ?? null,
+    name: raw.name ?? "",
+    type: nodeType(raw),
+    isDirectory: nodeType(raw) == FileNodeType.Directory,
+    created: raw.created ?? null,
+    modified: raw.modified ?? raw.created ?? null,
+    blobId: raw.blobId ?? null,
+    size: raw.size ?? 0,
+    mediaType: raw.mediaType ?? null,
+    myRights: raw.myRights ?? null,
+    role: raw.role ?? null,
+  };
+}
+
+/** Convert a JMAP failure into a JmapFilesError with a clear message. */
+export function translateError(error, context = {}) {
+  if (error instanceof JmapFilesError) {
+    return error;
+  }
+  const type = error?.type ?? error?.args?.type ?? "";
+  const name = context.name ?? "";
+  switch (type) {
+    case "overQuota":
+      return new JmapFilesError(
+        "overQuota",
+        fmt("jmap-files-error-over-quota"),
+        error
+      );
+    case "tooLarge":
+    case "requestTooLarge":
+    case "urn:ietf:params:jmap:error:limit":
+      return new JmapFilesError(
+        "tooLarge",
+        fmt("jmap-files-error-too-large", {
+          name,
+          limit: formatSize(error?.limit ?? context.limit ?? DEFAULT_MAX_SIZE),
+        }),
+        error
+      );
+    case "alreadyExists":
+      return new JmapFilesError(
+        "alreadyExists",
+        fmt("jmap-files-error-exists", { name }),
+        error
+      );
+    case "forbidden":
+    case "accountReadOnly":
+      return new JmapFilesError(
+        "forbidden",
+        fmt("jmap-files-error-forbidden"),
+        error
+      );
+    case "notFound":
+      return new JmapFilesError(
+        "notFound",
+        fmt("jmap-files-error-not-found", { name }),
+        error
+      );
+    case "invalidProperties":
+      return new JmapFilesError(
+        "invalidName",
+        error?.detail || fmt("jmap-files-error-invalid-name", { name }),
+        error
+      );
+  }
+  return new JmapFilesError(
+    "unknown",
+    error?.message || fmt("jmap-files-error-generic"),
+    error
+  );
+}
+
+/** Human readable size (binary units). */
+export function formatSize(bytes) {
+  if (!Number.isFinite(bytes)) {
+    return "";
+  }
+  const units = ["B", "KiB", "MiB", "GiB", "TiB"];
+  let i = 0;
+  let n = bytes;
+  while (n >= 1024 && i < units.length - 1) {
+    n /= 1024;
+    i++;
+  }
+  return `${i ? n.toFixed(1) : n} ${units[i]}`;
+}
