@@ -0,0 +1,82 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPINCOMINGSERVER_H_
+#define COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPINCOMINGSERVER_H_
+
+#include "IJmapClient.h"
+#include "IJmapIncomingServer.h"
+#include "nsMsgIncomingServer.h"
+
+#define JMAP_INCOMING_SERVER_IID \
+  {0x1f4b7c2a, 0x8d3e, 0x4a61, {0x9b, 0x7c, 0x5e, 0x2d, 0x1f, 0x3a, 0x6b, 0x71}}
+
+/**
+ * Incoming server for a JMAP account.
+ *
+ * The server owns the protocol client and translates the JMAP mailbox list
+ * into Thunderbird's local folder tree. Message metadata synchronization is
+ * implemented; mutations and submission are added in later milestones.
+ */
+class JmapIncomingServer : public nsMsgIncomingServer,
+                           public IJmapIncomingServer {
+ public:
+  NS_DECL_ISUPPORTS_INHERITED
+  NS_DECL_IJMAPINCOMINGSERVER
+
+  JmapIncomingServer();
+
+  NS_INLINE_DECL_STATIC_IID(JMAP_INCOMING_SERVER_IID)
+
+  /**
+   * Locally create a folder for a JMAP mailbox, unless it already exists.
+   *
+   * This is called from the mailbox sync listener and is public only because
+   * that listener lives in an anonymous namespace in the implementation file.
+   *
+   * @param id - JMAP mailbox id.
+   * @param parentId - JMAP id of the parent mailbox, empty for top-level
+   *   mailboxes.
+   * @param name - Display name of the mailbox.
+   * @param flags - `nsMsgFolderFlags` derived from the mailbox role.
+   */
+  nsresult MaybeCreateFolderWithDetails(const nsACString& id,
+                                        const nsACString& parentId,
+                                        const nsACString& name, uint32_t flags);
+
+ protected:
+  virtual ~JmapIncomingServer();
+
+  // nsIMsgIncomingServer
+  NS_IMETHOD GetPassword(nsAString& password) override;
+  NS_IMETHOD GetPort(int32_t* aPort) override;
+  NS_IMETHOD GetLocalStoreType(nsACString& aLocalStoreType) override;
+  NS_IMETHOD GetLocalDatabaseType(nsACString& aLocalDatabaseType) override;
+  NS_IMETHOD GetCanBeDefaultServer(bool* canBeDefaultServer) override;
+  NS_IMETHOD GetOfflineSupportLevel(int32_t* aSupportLevel) override;
+  NS_IMETHOD GetCanSearchMessages(bool* canSearchMessages) override;
+  NS_IMETHOD GetSearchScope(nsMsgSearchScopeValue* searchScope) override;
+
+  NS_IMETHOD GetNewMessages(nsIMsgFolder* aFolder, nsIMsgWindow* aMsgWindow,
+                            nsIUrlListener* aUrlListener) override;
+  NS_IMETHOD PerformBiff(nsIMsgWindow* aMsgWindow) override;
+  NS_IMETHOD PerformExpand(nsIMsgWindow* aMsgWindow) override;
+  NS_IMETHOD Shutdown() override;
+  NS_IMETHOD VerifyLogon(nsIUrlListener* aUrlListener, nsIMsgWindow* aMsgWindow,
+                         nsIURI** _retval) override;
+
+ private:
+  /**
+   * Find the folder representing a JMAP mailbox id. An empty id resolves to
+   * the account's root folder.
+   *
+   * @returns `NS_OK` if a matching folder was found.
+   */
+  nsresult FindFolderWithId(const nsACString& id, nsIMsgFolder** _retval);
+
+  /** Protocol client shared by all folders in this account. */
+  nsCOMPtr<IJmapClient> mClient;
+};
+
+#endif  // COMM_MAILNEWS_PROTOCOLS_JMAP_SRC_JMAPINCOMINGSERVER_H_
