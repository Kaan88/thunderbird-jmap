+        accountId: this.accountId,
+        blobId: node?.blobId ?? "",
+        type: node?.mediaType || "application/octet-stream",
+        name: node?.name || "file",
+      }),
+      requiresLogin: true,
+    };
+  }
+}
+
+function expandTemplate(template, vars) {
+  return template.replace(/\{([a-zA-Z]+)\}/g, (m, key) =>
+    key in vars ? encodeURIComponent(vars[key]) : m
+  );
+}
+
+/** @type {Map<string, Promise<JmapFileService>>} */
+const services = new Map();
+
+export const JmapFiles = {
+  /**
+   * The shared file service for a JMAP incoming server.
+   *
+   * @param {string} serverKey
+   * @returns {Promise<JmapFileService>}
+   */
+  forServer(serverKey) {
+    let pending = services.get(serverKey);
+    if (!pending) {
+      pending = (async () => {
+        const client = await lazy.JmapAccountRegistry.getClient(serverKey);
+        const service = new JmapFileService(client, { serverKey });
+        service.subscribePush().catch(console.error);
+        return service;
+      })();
+      services.set(serverKey, pending);
+      pending.catch(() => services.delete(serverKey));
+    }
+    return pending;
+  },
+
+  /** Forget the service of a server (e.g. after removal). */
+  async forget(serverKey) {
+    const pending = services.get(serverKey);
+    services.delete(serverKey);
+    (await pending?.catch(() => null))?.shutdown();
+  },
+
+  /** JMAP incoming servers (all; capability is checked on connection). */
+  get servers() {
+    try {
+      return lazy.JmapAccountRegistry.servers;
+    } catch (e) {
+      return [];
+    }
+  },
+
+  /**
+   * Servers whose session offers the FileNode capability.
+   *
+   * @returns {Promise<nsIMsgIncomingServer[]>}
+   */
+  async availableServers() {
+    const result = [];
+    for (const server of this.servers) {
+      try {
+        const client = await lazy.JmapAccountRegistry.getClient(server.key);
+        if (client.supports(FILENODE)) {
+          result.push(server);
+        }
+      } catch (e) {
+        console.warn(`JMAP files unavailable for ${server.key}`, e);
+      }
+    }
+    return result;
+  },
+
+  /** Test hook. */
+  _setService(serverKey, service) {
+    services.set(serverKey, Promise.resolve(service));
+  },
+};
+
+export { JmapMethodError };
