@@ -0,0 +1,217 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "JmapListeners.h"
+
+#include "IJmapIncomingServer.h"
+#include "nsCharSeparatedTokenizer.h"
+#include "nsIMsgDatabase.h"
+#include "nsIMsgEnumerator.h"
+#include "nsIMsgFolder.h"
+#include "nsIMsgHdr.h"
+#include "nsMsgMessageFlags.h"
+#include "nsIMsgIncomingServer.h"
+#include "nsPrintfCString.h"
+
+NS_IMPL_ISUPPORTS(JmapOperationListener, IJmapOperationListener)
+
+NS_IMETHODIMP JmapOperationListener::OnSuccess(const nsACString& result) {
+  if (mOnSuccess) {
+    return mOnSuccess(result);
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP JmapOperationListener::OnFailure(nsresult status,
+                                               const nsACString& message) {
+  NS_WARNING(nsPrintfCString("JMAP operation failed: 0x%08x %s",
+                             static_cast<uint32_t>(status),
+                             PromiseFlatCString(message).get())
+                 .get());
+  if (mOnFailure) {
+    return mOnFailure(status, message);
+  }
+  return NS_OK;
+}
+
+NS_IMPL_ISUPPORTS(JmapUrlStopListener, nsIUrlListener)
+
+NS_IMETHODIMP JmapUrlStopListener::OnStartRunningUrl(nsIURI*) { return NS_OK; }
+
+NS_IMETHODIMP JmapUrlStopListener::OnStopRunningUrl(nsIURI*,
+                                                    nsresult status) {
+  if (mOnStop) {
+    return mOnStop(status);
+  }
+  return NS_OK;
+}
+
+void JmapParseIdArray(const nsACString& json, nsTArray<nsCString>& ids) {
+  ids.Clear();
+  const nsCString flat(json);
+  int32_t pos = 0;
+  while (true) {
+    int32_t start = flat.FindChar('"', pos);
+    if (start < 0) {
+      break;
+    }
+    int32_t end = flat.FindChar('"', start + 1);
+    if (end < 0) {
+      break;
+    }
+    ids.AppendElement(Substring(flat, start + 1, end - start - 1));
+    pos = end + 1;
+  }
+}
+
+void JmapAppendJSONString(nsACString& out, const nsACString& value) {
+  out.Append('"');
+  const char* cursor = value.BeginReading();
+  const char* end = value.EndReading();
+  for (; cursor != end; ++cursor) {
+    const char c = *cursor;
+    switch (c) {
+      case '"':
+        out.AppendLiteral("\\\"");
+        break;
+      case '\\':
+        out.AppendLiteral("\\\\");
+        break;
+      case '\n':
+        out.AppendLiteral("\\n");
+        break;
+      case '\r':
+        out.AppendLiteral("\\r");
+        break;
+      case '\t':
+        out.AppendLiteral("\\t");
+        break;
+      default:
+        if (static_cast<unsigned char>(c) < 0x20) {
+          out.Append(nsPrintfCString("\\u%04x", static_cast<unsigned>(c)));
+        } else {
+          out.Append(c);
+        }
+    }
+  }
+  out.Append('"');
+}
+
+void JmapBuildMailboxMembershipArgs(const nsTArray<nsCString>& ids,
+                                    const nsACString& mailboxId, bool add,
+                                    nsACString& argsJSON) {
+  nsAutoCString path("mailboxIds/");
+  path.Append(mailboxId);
+
+  argsJSON.AssignLiteral("{\"update\":{");
+  bool first = true;
+  for (const auto& id : ids) {
+    if (!first) {
+      argsJSON.Append(',');
+    }
+    first = false;
+    JmapAppendJSONString(argsJSON, id);
+    argsJSON.AppendLiteral(":{");
+    JmapAppendJSONString(argsJSON, path);
+    argsJSON.Append(':');
+    if (add) {
+      argsJSON.AppendLiteral("true");
+    } else {
+      argsJSON.AppendLiteral("null");
+    }
+    argsJSON.Append('}');
+  }
+  argsJSON.AppendLiteral("}}");
+}
+
+nsresult JmapClientForFolder(nsIMsgFolder* folder, IJmapClient** client) {
+  NS_ENSURE_ARG_POINTER(folder);
+  NS_ENSURE_ARG_POINTER(client);
+
+  nsCOMPtr<nsIMsgIncomingServer> server;
+  nsresult rv = folder->GetServer(getter_AddRefs(server));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<IJmapIncomingServer> jmapServer = do_QueryInterface(server, &rv);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  return jmapServer->GetProtocolClient(client);
+}
+
+nsresult JmapSyncAccountForFolder(nsIMsgFolder* folder,
+                                  nsIUrlListener* listener) {
+  NS_ENSURE_ARG_POINTER(folder);
+
+  nsCOMPtr<nsIMsgIncomingServer> server;
+  nsresult rv = folder->GetServer(getter_AddRefs(server));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<IJmapIncomingServer> jmapServer = do_QueryInterface(server, &rv);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  return jmapServer->SyncMessages(listener);
+}
+
+nsresult JmapFindHeaderByEmailId(nsIMsgFolder* folder,
+                                 const nsACString& emailId,
+                                 nsIMsgDBHdr** header) {
+  NS_ENSURE_ARG_POINTER(folder);
+  NS_ENSURE_ARG_POINTER(header);
+  *header = nullptr;
+
+  nsCOMPtr<nsIMsgDatabase> db;
+  nsresult rv = folder->GetMsgDatabase(getter_AddRefs(db));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<nsIMsgEnumerator> enumerator;
+  rv = db->EnumerateMessages(getter_AddRefs(enumerator));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  bool hasMore = false;
+  while (NS_SUCCEEDED(enumerator->HasMoreElements(&hasMore)) && hasMore) {
+    nsCOMPtr<nsIMsgDBHdr> candidate;
+    if (NS_FAILED(enumerator->GetNext(getter_AddRefs(candidate))) ||
+        !candidate) {
+      continue;
+    }
+    nsCString id;
+    if (NS_SUCCEEDED(candidate->GetStringProperty("jmapId", id)) &&
+        id.Equals(emailId)) {
+      candidate.forget(header);
+      return NS_OK;
+    }
+  }
+  return NS_OK;
+}
+
+void JmapKeywordsForHeader(nsIMsgDBHdr* header,
+                           nsTArray<nsCString>& keywords) {
+  if (!header) {
+    return;
+  }
+
+  uint32_t flags = 0;
+  header->GetFlags(&flags);
+  if (flags & nsMsgMessageFlags::Read) {
+    keywords.AppendElement("$seen"_ns);
+  }
+  if (flags & nsMsgMessageFlags::Marked) {
+    keywords.AppendElement("$flagged"_ns);
+  }
+  if (flags & nsMsgMessageFlags::Replied) {
+    keywords.AppendElement("$answered"_ns);
+  }
+  if (flags & nsMsgMessageFlags::Forwarded) {
+    keywords.AppendElement("$forwarded"_ns);
+  }
+
+  nsCString tags;
+  if (NS_SUCCEEDED(header->GetStringProperty("keywords", tags))) {
+    for (const auto& tag : tags.Split(' ')) {
+      if (!tag.IsEmpty() && !keywords.Contains(tag)) {
+        keywords.AppendElement(tag);
+      }
+    }
+  }
+}
