{
  "manifest_version": 3,
  "name": "AI Assistant",
  "short_name": "AI Assistant",
  "version": "1.2.2",
  "description": "An assistant next to your mail. Ask about a message, write and rewrite, look things up and get things done in your mail, folders, calendar, contacts and JMAP account. Works with an OpenAI-compatible service (OpenAI, Ollama, ...), Anthropic, or Claude Code on your computer. Nothing is sent until you ask; sending and deleting always ask first.",
  "author": "Kaan88",
  "homepage_url": "https://github.com/Kaan88/thunderbird-jmap",
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-assistant@thunderbird-jmap",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "menus",
    "scripting",
    "compose",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesDelete",
    "accountsRead",
    "addressBooks",
    "sensitiveDataUpload",
    "accountsFolders",
    "messagesTags",
    "compose.send",
    "compose.save",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "message_display_action": {
    "default_title": "AI assistant",
    "default_label": "AI assistant",
    "default_icon": "icons/icon.svg"
  },
  "compose_action": {
    "default_title": "AI writing help",
    "default_label": "AI",
    "default_icon": "icons/icon.svg",
    "default_popup": "compose/compose.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Show or hide the AI assistant next to the message"
    }
  },
  "experiment_apis": {
    "aiPanel": {
      "schema": "experiments/aiPanel/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "aiPanel"
          ]
        ],
        "script": "experiments/aiPanel/implementation.js"
      }
    },
    "aiCalendar": {
      "schema": "experiments/aiCalendar/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "aiCalendar"
          ]
        ],
        "script": "experiments/aiCalendar/implementation.js"
      }
    },
    "aiJmap": {
      "schema": "experiments/aiJmap/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "aiJmap"
          ]
        ],
        "script": "experiments/aiJmap/implementation.js"
      }
    }
  }
}
